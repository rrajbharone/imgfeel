---
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CanvaWatermarkRemover from '@/components/CanvaWatermarkRemover.astro';
import CanvaWatermarkRemoverContent from '@/components/CanvaWatermarkRemoverContent.astro';
import SEOHead from '@/components/SEOHead.astro';
import { t } from '@/i18n/utils';
import { getToolUrl } from '@/data/tools';

const locale = 'en';
const toolUrl = getToolUrl('canva-watermark-remover', locale);
---

<MainLayout
  locale={locale}
  title={t(locale, 'canvawatermark.meta.title')}
  description={t(locale, 'canvawatermark.meta.description')}
  canonicalUrl={`https://imgfeel.com${toolUrl}`}
  basePath={toolUrl}
>
  <Fragment slot="head">
    <SEOHead schema={{
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Canva Watermark Remover",
      "url": `https://imgfeel.com${toolUrl}`,
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    }} />
  </Fragment>

  <div class="section">
    <div class="container">
      <Breadcrumbs locale={locale} items={[
        { label: t(locale, 'breadcrumb.home'), href: '/' },
        { label: t(locale, 'breadcrumb.tools'), href: '/tools/' },
        { label: t(locale, 'canvawatermark.hero.title') }
      ]} />
      
      <div class="tool-header">
        <h1 class="tool-title">{t(locale, 'canvawatermark.hero.title')}</h1>
        <p class="tool-subtitle">{t(locale, 'canvawatermark.hero.subtitle')}</p>
      </div>

      <CanvaWatermarkRemover locale={locale} />
    </div>
  </div>

  <CanvaWatermarkRemoverContent locale={locale} />
</MainLayout>

<style>
  .tool-header {
    text-align: center;
    max-width: var(--container-narrow);
    margin-inline: auto;
    margin-top: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .tool-title {
    font-size: var(--font-size-3xl);
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin-bottom: var(--space-3);
  }

  .tool-subtitle {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-inline: auto;
  }

  @media (max-width: 640px) {
    .tool-title {
      font-size: var(--font-size-2xl);
    }
    .tool-subtitle {
      font-size: var(--font-size-sm);
    }
  }
</style>

---
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SrcsetGenerator from '@/components/SrcsetGenerator.astro';
import SrcsetGeneratorContent from '@/components/SrcsetGeneratorContent.astro';
import SEOHead from '@/components/SEOHead.astro';
import { t } from '@/i18n/utils';
import { getToolUrl } from '@/data/tools';

const locale = 'en';
const toolUrl = getToolUrl('image-srcset-generator', locale);
---

<MainLayout
  locale={locale}
  title={t(locale, 'srcset.meta.title')}
  description={t(locale, 'srcset.meta.description')}
  canonicalUrl={`https://imgfeel.com${toolUrl}`}
  basePath={toolUrl}
>
  <Fragment slot="head">
    <SEOHead schema={{
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Image Srcset Generator",
      "url": `https://imgfeel.com${toolUrl}`,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    }} />
  </Fragment>

  <div class="section">
    <div class="container">
      <Breadcrumbs locale={locale} items={[
        { label: t(locale, 'breadcrumb.home'), href: '/' },
        { label: t(locale, 'breadcrumb.tools'), href: '/tools/' },
        { label: t(locale, 'srcset.hero.title') }
      ]} />
      
      <div class="tool-header">
        <h1 class="tool-title">{t(locale, 'srcset.hero.title')}</h1>
        <p class="tool-subtitle">{t(locale, 'srcset.hero.subtitle')}</p>
      </div>

      <SrcsetGenerator locale={locale} />
    </div>
  </div>

  <SrcsetGeneratorContent locale={locale} />
</MainLayout>

<style>
  .tool-header {
    text-align: center;
    max-width: var(--container-narrow);
    margin-inline: auto;
    margin-top: var(--space-6);
    margin-bottom: var(--space-8);
    width: 100%;
    box-sizing: border-box;
  }
  .tool-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--space-2);
    word-break: break-word;
    overflow-wrap: break-word;
  }
  .tool-subtitle {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    word-break: break-word;
    overflow-wrap: break-word;
  }
  @media (max-width: 640px) {
    .tool-title {
      font-size: var(--text-2xl);
    }
    .tool-subtitle {
      font-size: var(--text-sm);
    }
  }
</style>

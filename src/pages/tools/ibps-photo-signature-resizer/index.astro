---
/**
 * IBPS Photo & Signature Resizer
 * Dedicated India-specific tool for IBPS PO, Clerk, SO, RRB PO, and RRB Clerk.
 * English-only tool with language switcher disabled.
 */
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import IbpsResizer from '@/components/IbpsResizer.astro';
import IbpsContent from '@/components/IbpsContent.astro';
import SEOHead from '@/components/SEOHead.astro';

const locale = 'en';
const toolUrl = '/tools/ibps-photo-signature-resizer/';
---

<MainLayout
  locale={locale}
  title="IBPS Photo & Signature Resizer 2026 | PO, Clerk, SO, RRB (10–20 KB)"
  description="Resize and compress photograph (20–50 KB) and signature (10–20 KB) to official IBPS 2026 specifications for PO, Clerk, SO & RRB exams. 100% client-side & private."
  canonicalUrl={`https://imgfeel.com${toolUrl}`}
  basePath={toolUrl}
  showLanguageSwitcher={false}
>
  <Fragment slot="head">
    <SEOHead schema={{
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "IBPS Photo & Signature Resizer",
      "url": `https://imgfeel.com${toolUrl}`,
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Free client-side tool to resize, crop, and compress photograph (20–50 KB) and signature (10–20 KB) for IBPS online applications."
    }} />
  </Fragment>

  <div class="section">
    <div class="container">
      <Breadcrumbs locale={locale} items={[
        { label: 'Home', href: '/' },
        { label: 'Tools', href: '/tools/' },
        { label: 'IBPS Photo & Signature Resizer' }
      ]} />

      <div class="tool-header">
        <h1 class="tool-title">IBPS Photo &amp; Signature Resizer</h1>
        <p class="tool-subtitle">Automatically resize, crop, and compress photograph (strictly 20–50 KB) and signature (strictly 10–20 KB) to official IBPS 2026 specifications for PO, Clerk, SO, and RRB.</p>
      </div>

      <IbpsResizer />
    </div>
  </div>

  <IbpsContent />
</MainLayout>

<style>
  .tool-header {
    text-align: center;
    max-width: var(--container-narrow);
    margin-inline: auto;
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .tool-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--space-2);
    letter-spacing: var(--tracking-tight);
    line-height: 1.25;
  }

  @media (max-width: 640px) {
    .tool-title {
      font-size: var(--text-2xl);
    }
  }

  .tool-subtitle {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }
</style>

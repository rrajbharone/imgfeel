---
/**
 * Indian Army Photo & Signature Resizer
 * Dedicated India-specific recruitment tool for Indian Army Agniveer, GD, Technical, and Clerk.
 * English-only tool with language switcher disabled.
 */
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ArmyResizer from '@/components/ArmyResizer.astro';
import ArmyContent from '@/components/ArmyContent.astro';
import SEOHead from '@/components/SEOHead.astro';

const locale = 'en';
const toolUrl = '/tools/indian-army-photo-signature-resizer/';
---

<MainLayout
  locale={locale}
  title="Indian Army Photo & Signature Resizer 2026 | Agniveer, GD, Clerk, Tech"
  description="Resize and compress photograph (10–50 KB) and signature (5–20 KB) to official Join Indian Army 2026 specifications for Agniveer GD, Tech & Clerk. 100% private."
  canonicalUrl={`https://imgfeel.com${toolUrl}`}
  basePath={toolUrl}
  showLanguageSwitcher={false}
>
  <Fragment slot="head">
    <SEOHead schema={{
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Indian Army Photo & Signature Resizer",
      "url": `https://imgfeel.com${toolUrl}`,
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Free client-side tool to resize, crop, and compress photograph (10–50 KB) and signature (5–20 KB) for Join Indian Army & Agniveer online applications."
    }} />
  </Fragment>

  <div class="section">
    <div class="container">
      <Breadcrumbs locale={locale} items={[
        { label: 'Home', href: '/' },
        { label: 'Tools', href: '/tools/' },
        { label: 'Indian Army Photo & Signature Resizer' }
      ]} />

      <div class="tool-header">
        <h1 class="tool-title">Indian Army Photo &amp; Signature Resizer</h1>
        <p class="tool-subtitle">Automatically resize, crop, and compress photograph (strictly 10–50 KB) and signature (strictly 5–20 KB) to official Join Indian Army &amp; Agniveer 2026 specifications.</p>
      </div>

      <ArmyResizer />
    </div>
  </div>

  <ArmyContent />
</MainLayout>

<style>
  .tool-header {
    text-align: center;
    max-width: var(--container-narrow);
    margin-inline: auto;
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .tool-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--space-2);
    letter-spacing: var(--tracking-tight);
    line-height: 1.25;
  }

  @media (max-width: 640px) {
    .tool-title {
      font-size: var(--text-2xl);
    }
  }

  .tool-subtitle {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }
</style>

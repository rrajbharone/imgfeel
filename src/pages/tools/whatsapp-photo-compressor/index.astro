---
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import WhatsAppPhotoCompressor from '@/components/WhatsAppPhotoCompressor.astro';
import WhatsAppPhotoCompressorContent from '@/components/WhatsAppPhotoCompressorContent.astro';
import SEOHead from '@/components/SEOHead.astro';
import { t } from '@/i18n/utils';
import { getToolUrl } from '@/data/tools';

const locale = 'en';
const toolUrl = getToolUrl('whatsapp-photo-compressor', locale);
---

<MainLayout
  locale={locale}
  title={t(locale, 'whatsappComp.meta.title')}
  description={t(locale, 'whatsappComp.meta.description')}
  canonicalUrl={`https://imgfeel.com${toolUrl}`}
  basePath={toolUrl}
>
  <Fragment slot="head">
    <SEOHead schema={{
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "WhatsApp Photo Compressor",
      "url": `https://imgfeel.com${toolUrl}`,
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    }} />
  </Fragment>

  <div class="section">
    <div class="container">
      <Breadcrumbs locale={locale} items={[
        { label: t(locale, 'breadcrumb.home'), href: '/' },
        { label: t(locale, 'breadcrumb.tools'), href: '/tools/' },
        { label: t(locale, 'whatsappComp.hero.title') }
      ]} />
      
      <div class="tool-header">
        <h1 class="tool-title">{t(locale, 'whatsappComp.hero.title')}</h1>
        <p class="tool-subtitle">{t(locale, 'whatsappComp.hero.subtitle')}</p>
      </div>

      <WhatsAppPhotoCompressor locale={locale} />
    </div>
  </div>

  <WhatsAppPhotoCompressorContent locale={locale} />
</MainLayout>

<style>
  .tool-header {
    text-align: center;
    max-width: var(--container-narrow);
    margin-inline: auto;
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .tool-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-text);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-2);
  }

  .tool-subtitle {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  @media (min-width: 640px) {
    .tool-title {
      font-size: var(--text-4xl);
    }
    
    .tool-subtitle {
      font-size: var(--text-lg);
    }
  }
</style>

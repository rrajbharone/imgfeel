---
/**
 * UPSC Photo & Signature Resizer
 * Dedicated India-specific tool for UPSC CSE, OTR, NDA, CDS, CMS, and CAPF applications.
 * English-only tool with language switcher disabled.
 */
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import UpscResizer from '@/components/UpscResizer.astro';
import UpscContent from '@/components/UpscContent.astro';
import SEOHead from '@/components/SEOHead.astro';

const locale = 'en';
const toolUrl = '/tools/upsc-photo-signature-resizer/';
---

<MainLayout
  locale={locale}
  title="UPSC Photo & Signature Resizer 2026 | Resize to 350–1000 px (Photo 20–300 KB, Sig 20–100 KB)"
  description="Resize and compress photograph (20–300 KB) and signature (20–100 KB) to official UPSC 2026 specifications for Civil Services, OTR, NDA & CDS. Auto-resizes to 350–1000 px JPG with white background."
  canonicalUrl={`https://imgfeel.com${toolUrl}`}
  basePath={toolUrl}
  showLanguageSwitcher={false}
>
  <Fragment slot="head">
    <SEOHead schema={{
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "UPSC Photo & Signature Resizer",
      "url": `https://imgfeel.com${toolUrl}`,
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Free client-side tool to resize, crop, and compress photographs and signatures for UPSC online applications."
    }} />
  </Fragment>

  <div class="section">
    <div class="container">
      <Breadcrumbs locale={locale} items={[
        { label: 'Home', href: '/' },
        { label: 'Tools', href: '/tools/' },
        { label: 'UPSC Photo & Signature Resizer' }
      ]} />

      <div class="tool-header">
        <h1 class="tool-title">UPSC Photo &amp; Signature Resizer</h1>
        <p class="tool-subtitle">Automatically resize, crop, and compress photo (20–300 KB) and signature (20–100 KB) to latest official UPSC 2026 requirements (350–1000 px JPG, pure white background).</p>
      </div>

      <UpscResizer />
    </div>
  </div>

  <UpscContent />
</MainLayout>

<style>
  .tool-header {
    text-align: center;
    max-width: var(--container-narrow);
    margin-inline: auto;
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .tool-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--space-2);
    letter-spacing: var(--tracking-tight);
    line-height: 1.25;
  }

  @media (max-width: 640px) {
    .tool-title {
      font-size: var(--text-2xl);
    }
  }

  .tool-subtitle {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }
</style>

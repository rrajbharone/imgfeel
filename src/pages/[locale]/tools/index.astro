---
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ToolCard from '@/components/ToolCard.astro';
import ToolSearch from '@/components/ToolSearch.astro';
import { t, getLocalizedPath } from '@/i18n/utils';
import { NON_DEFAULT_LOCALES, type Locale } from '@/i18n/config';
import { getSearchableTools } from '@/data/tools';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
const searchableTools = getSearchableTools(locale);
---

<MainLayout
  locale={locale}
  title={t(locale, 'tools.meta.title')}
  description={t(locale, 'tools.meta.description')}
  canonicalUrl={`https://imgfeel.com${getLocalizedPath('/tools/', locale)}`}
  basePath="/tools/"
>
  <div class="section tools-page">
    <div class="container">
      <Breadcrumbs locale={locale} items={[
        { label: t(locale, 'breadcrumb.home'), href: getLocalizedPath('/', locale) },
        { label: t(locale, 'breadcrumb.tools') }
      ]} />
      
      <div class="tools-page-header">
        <h1 class="page-title">{t(locale, 'tools.page.title')}</h1>
        <p class="page-subtitle">{t(locale, 'tools.page.subtitle')}</p>
      </div>

      <!-- Dynamic Search Bar consuming single source of truth -->
      <ToolSearch locale={locale} searchableTools={searchableTools} />

      <!-- Compact 2-Column Mobile & Multi-Column Desktop Tools Grid -->
      <div class="tools-grid">
        {searchableTools.map((tool) => (
          <ToolCard
            locale={locale}
            id={tool.id}
            title={tool.title}
            description={tool.description}
            href={tool.href}
            icon={tool.icon}
            badge={tool.badge}
          />
        ))}
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .tools-page {
    padding-top: var(--space-6);
    padding-bottom: var(--space-12);
  }
  .tools-page-header {
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .page-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-1);
  }
  .page-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    max-width: 600px;
    line-height: 1.5;
  }

  /* 2-column mobile grid by default */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  @media (min-width: 480px) {
    .tools-page {
      padding-top: var(--space-8);
      padding-bottom: var(--space-16);
    }
    .tools-page-header {
      margin-top: var(--space-4);
      margin-bottom: var(--space-5);
    }
    .tools-grid {
      gap: 12px;
    }
  }

  /* Tablet (3 cards per row) */
  @media (min-width: 740px) {
    .tools-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }
    .page-title {
      font-size: var(--text-3xl);
    }
  }

  /* Desktop (4 cards per row) */
  @media (min-width: 980px) {
    .tools-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
  }

  /* Large Desktop (5 cards per row) */
  @media (min-width: 1200px) {
    .tools-grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 16px;
    }
  }
</style>

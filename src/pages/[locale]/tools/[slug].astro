---
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ExactResizer from '@/components/ExactResizer.astro';
import ExactResizerContent from '@/components/ExactResizerContent.astro';
import WebpCompressor from '@/components/WebpCompressor.astro';
import WebpCompressorContent from '@/components/WebpCompressorContent.astro';
import CmMmResizer from '@/components/CmMmResizer.astro';
import CmMmContent from '@/components/CmMmContent.astro';
import PanResizer from '@/components/PanResizer.astro';
import PanContent from '@/components/PanContent.astro';
import WhatsAppResizer from '@/components/WhatsAppResizer.astro';
import WhatsAppContent from '@/components/WhatsAppContent.astro';
import SscResizer from '@/components/SscResizer.astro';
import SscContent from '@/components/SscContent.astro';
import YouTubeResizer from '@/components/YouTubeResizer.astro';
import YouTubeContent from '@/components/YouTubeContent.astro';
import Base64Converter from '@/components/Base64Converter.astro';
import Base64Content from '@/components/Base64Content.astro';
import DataUriConverter from '@/components/DataUriConverter.astro';
import DataUriContent from '@/components/DataUriContent.astro';
import DimensionsChecker from '@/components/DimensionsChecker.astro';
import DimensionsCheckerContent from '@/components/DimensionsCheckerContent.astro';
import FileSizeChecker from '@/components/FileSizeChecker.astro';
import FileSizeCheckerContent from '@/components/FileSizeCheckerContent.astro';
import ResolutionChecker from '@/components/ResolutionChecker.astro';
import ResolutionCheckerContent from '@/components/ResolutionCheckerContent.astro';
import AspectRatioChecker from '@/components/AspectRatioChecker.astro';
import AspectRatioCheckerContent from '@/components/AspectRatioCheckerContent.astro';
import VideoTrimmer from '@/components/VideoTrimmer.astro';
import VideoTrimmerContent from '@/components/VideoTrimmerContent.astro';
import VideoRotator from '@/components/VideoRotator.astro';
import VideoRotatorContent from '@/components/VideoRotatorContent.astro';
import DpiChecker from '@/components/DpiChecker.astro';
import DpiCheckerContent from '@/components/DpiCheckerContent.astro';
import FormatChecker from '@/components/FormatChecker.astro';
import FormatCheckerContent from '@/components/FormatCheckerContent.astro';
import SquareResizer from '@/components/SquareResizer.astro';
import SquareResizerContent from '@/components/SquareResizerContent.astro';
import CircleCropper from '@/components/CircleCropper.astro';
import CircleCropperContent from '@/components/CircleCropperContent.astro';
import GrayscaleConverter from '@/components/GrayscaleConverter.astro';
import GrayscaleConverterContent from '@/components/GrayscaleConverterContent.astro';
import ImageInverter from '@/components/ImageInverter.astro';
import ImageInverterContent from '@/components/ImageInverterContent.astro';
import ImageBlur from '@/components/ImageBlur.astro';
import ImageBlurContent from '@/components/ImageBlurContent.astro';
import ImageStitcher from '@/components/ImageStitcher.astro';
import ImageStitcherContent from '@/components/ImageStitcherContent.astro';
import SEOHead from '@/components/SEOHead.astro';
import { t, getLocalizedPath } from '@/i18n/utils';
import { NON_DEFAULT_LOCALES, type Locale } from '@/i18n/config';
import { TOOL_SLUGS, getToolUrl } from '@/data/tools';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.flatMap((locale) => {
    return Object.entries(TOOL_SLUGS).map(([toolId, slugs]) => ({
      params: {
        locale,
        slug: slugs[locale],
      },
      props: {
        toolId,
      },
    }));
  });
}

const { locale } = Astro.params as { locale: Locale };
const { toolId } = Astro.props as { toolId: string };

const toolUrl = getToolUrl(toolId, locale);

const isExact = toolId === 'exact-dimension-resizer';
const isWebp = toolId === 'webp-compressor';
const isCmMm = toolId === 'cm-mm-resizer';
const isPan = toolId === 'pan-card-resizer';
const isWa = toolId === 'whatsapp-dp-resizer';
const isSsc = toolId === 'ssc-photo-signature-resizer';
const isYt = toolId === 'youtube-banner-resizer';
const isB64 = toolId === 'image-to-base64-converter';
const isDataUri = toolId === 'image-to-data-uri-converter';
const isDimCheck = toolId === 'image-dimensions-checker';
const isFileSize = toolId === 'image-file-size-checker';
const isResCheck = toolId === 'image-resolution-checker';
const isRatioCheck = toolId === 'image-aspect-ratio-checker';
const isDpiCheck = toolId === 'image-dpi-checker';
const isFmtCheck = toolId === 'image-format-checker';
const isSquareResizer = toolId === 'resize-image-to-1-1';
const isCircleCropper = toolId === 'circle-image-cropper';
const isGrayscale = toolId === 'image-grayscale-converter';
const isInverter = toolId === 'image-inverter';
const isBlur = toolId === 'image-blur-tool';
const isStitch = toolId === 'image-stitcher';
const isVidTrim = toolId === 'video-trimmer';
const isVidRotate = toolId === 'video-rotator';

const metaTitle = isExact
  ? t(locale, 'exactresizer.meta.title')
  : isWebp
    ? t(locale, 'webpcomp.meta.title')
    : isCmMm
      ? t(locale, 'cmresizer.meta.title')
      : isPan
        ? t(locale, 'panresizer.meta.title')
        : isWa
          ? t(locale, 'waresizer.meta.title')
          : isSsc
            ? t(locale, 'sscresizer.meta.title')
            : isYt
              ? t(locale, 'ytresizer.meta.title')
              : isB64
                ? t(locale, 'b64.meta.title')
                : isDataUri
                  ? t(locale, 'datauri.meta.title')
                  : isDimCheck
                    ? t(locale, 'dimcheck.meta.title')
                    : isFileSize
                      ? t(locale, 'sizecheck.meta.title')
                      : isResCheck
                        ? t(locale, 'rescheck.meta.title')
                        : isRatioCheck
                          ? t(locale, 'ratiocheck.meta.title')
                          : isDpiCheck
                            ? t(locale, 'dpicheck.meta.title')
                            : isFmtCheck
                              ? t(locale, 'fmtcheck.meta.title')
                              : isSquareResizer
                                ? t(locale, 'squareresizer.meta.title')
                                : isCircleCropper
                                  ? t(locale, 'circlecrop.meta.title')
                                  : isGrayscale
                                    ? t(locale, 'grayconv.meta.title')
                                    : isInverter
                                      ? t(locale, 'inverter.meta.title')
                                      : isBlur
                                        ? t(locale, 'blur.meta.title')
                                        : isStitch
                                          ? t(locale, 'stitch.meta.title')
                                          : isVidTrim
                                            ? t(locale, 'vidtrim.meta.title')
                                            : t(locale, 'vidrot.meta.title');

const metaDesc = isExact
  ? t(locale, 'exactresizer.meta.description')
  : isWebp
    ? t(locale, 'webpcomp.meta.description')
    : isCmMm
      ? t(locale, 'cmresizer.meta.description')
      : isPan
        ? t(locale, 'panresizer.meta.description')
        : isWa
          ? t(locale, 'waresizer.meta.description')
          : isSsc
            ? t(locale, 'sscresizer.meta.description')
            : isYt
              ? t(locale, 'ytresizer.meta.description')
              : isB64
                ? t(locale, 'b64.meta.description')
                : isDataUri
                  ? t(locale, 'datauri.meta.description')
                  : isDimCheck
                    ? t(locale, 'dimcheck.meta.description')
                    : isFileSize
                      ? t(locale, 'sizecheck.meta.description')
                      : isResCheck
                        ? t(locale, 'rescheck.meta.description')
                        : isRatioCheck
                          ? t(locale, 'ratiocheck.meta.description')
                          : isDpiCheck
                            ? t(locale, 'dpicheck.meta.description')
                            : isFmtCheck
                              ? t(locale, 'fmtcheck.meta.description')
                              : isSquareResizer
                                ? t(locale, 'squareresizer.meta.description')
                                : isCircleCropper
                                  ? t(locale, 'circlecrop.meta.description')
                                  : isGrayscale
                                    ? t(locale, 'grayconv.meta.description')
                                    : isInverter
                                      ? t(locale, 'inverter.meta.description')
                                      : isBlur
                                        ? t(locale, 'blur.meta.description')
                                        : isStitch
                                          ? t(locale, 'stitch.meta.description')
                                          : isVidTrim
                                            ? t(locale, 'vidtrim.meta.description')
                                            : t(locale, 'vidrot.meta.description');

const heroTitle = isExact
  ? t(locale, 'exactresizer.hero.title')
  : isWebp
    ? t(locale, 'webpcomp.hero.title')
    : isCmMm
      ? t(locale, 'cmresizer.hero.title')
      : isPan
        ? t(locale, 'panresizer.hero.title')
        : isWa
          ? t(locale, 'waresizer.hero.title')
          : isSsc
            ? t(locale, 'sscresizer.hero.title')
            : isYt
              ? t(locale, 'ytresizer.hero.title')
              : isB64
                ? t(locale, 'b64.hero.title')
                : isDataUri
                  ? t(locale, 'datauri.hero.title')
                  : isDimCheck
                    ? t(locale, 'dimcheck.hero.title')
                    : isFileSize
                      ? t(locale, 'sizecheck.hero.title')
                      : isResCheck
                        ? t(locale, 'rescheck.hero.title')
                        : isRatioCheck
                          ? t(locale, 'ratiocheck.hero.title')
                          : isDpiCheck
                            ? t(locale, 'dpicheck.hero.title')
                            : isFmtCheck
                              ? t(locale, 'fmtcheck.hero.title')
                              : isSquareResizer
                                ? t(locale, 'squareresizer.hero.title')
                                : isCircleCropper
                                  ? t(locale, 'circlecrop.hero.title')
                                  : isGrayscale
                                    ? t(locale, 'grayconv.hero.title')
                                    : isInverter
                                      ? t(locale, 'inverter.hero.title')
                                      : isBlur
                                        ? t(locale, 'blur.hero.title')
                                        : isStitch
                                          ? t(locale, 'stitch.hero.title')
                                          : isVidTrim
                                            ? t(locale, 'vidtrim.hero.title')
                                            : t(locale, 'vidrot.hero.title');

const heroSubtitle = isExact
  ? t(locale, 'exactresizer.hero.subtitle')
  : isWebp
    ? t(locale, 'webpcomp.hero.subtitle')
    : isCmMm
      ? t(locale, 'cmresizer.hero.subtitle')
      : isPan
        ? t(locale, 'panresizer.hero.subtitle')
        : isWa
          ? t(locale, 'waresizer.hero.subtitle')
          : isSsc
            ? t(locale, 'sscresizer.hero.subtitle')
            : isYt
              ? t(locale, 'ytresizer.hero.subtitle')
              : isB64
                ? t(locale, 'b64.hero.subtitle')
                : isDataUri
                  ? t(locale, 'datauri.hero.subtitle')
                  : isDimCheck
                    ? t(locale, 'dimcheck.hero.subtitle')
                    : isFileSize
                      ? t(locale, 'sizecheck.hero.subtitle')
                      : isResCheck
                        ? t(locale, 'rescheck.hero.subtitle')
                        : isRatioCheck
                          ? t(locale, 'ratiocheck.hero.subtitle')
                          : isDpiCheck
                            ? t(locale, 'dpicheck.hero.subtitle')
                            : isFmtCheck
                              ? t(locale, 'fmtcheck.hero.subtitle')
                              : isSquareResizer
                                ? t(locale, 'squareresizer.hero.subtitle')
                                : isCircleCropper
                                  ? t(locale, 'circlecrop.hero.subtitle')
                                  : isGrayscale
                                    ? t(locale, 'grayconv.hero.subtitle')
                                    : isInverter
                                      ? t(locale, 'inverter.hero.subtitle')
                                      : isBlur
                                        ? t(locale, 'blur.hero.subtitle')
                                        : isStitch
                                          ? t(locale, 'stitch.hero.subtitle')
                                          : isVidTrim
                                            ? t(locale, 'vidtrim.hero.subtitle')
                                            : t(locale, 'vidrot.hero.subtitle');
---

<MainLayout
  locale={locale}
  title={metaTitle}
  description={metaDesc}
  canonicalUrl={`https://imgfeel.com${toolUrl}`}
  basePath={toolUrl}
>
  <Fragment slot="head">
    <SEOHead schema={{
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": heroTitle,
      "url": `https://imgfeel.com${toolUrl}`,
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    }} />
  </Fragment>

  <div class="section">
    <div class="container">
      <Breadcrumbs locale={locale} items={[
        { label: t(locale, 'breadcrumb.home'), href: getLocalizedPath('/', locale) },
        { label: t(locale, 'breadcrumb.tools'), href: getLocalizedPath('/tools/', locale) },
        { label: heroTitle }
      ]} />

      <div class="tool-header">
        <h1 class="tool-title">{heroTitle}</h1>
        <p class="tool-subtitle">{heroSubtitle}</p>
      </div>

      {isExact && <ExactResizer locale={locale} />}
      {isWebp && <WebpCompressor locale={locale} />}
      {isCmMm && <CmMmResizer locale={locale} />}
      {isPan && <PanResizer locale={locale} />}
      {isWa && <WhatsAppResizer locale={locale} />}
      {isSsc && <SscResizer locale={locale} />}
      {isYt && <YouTubeResizer locale={locale} />}
      {isB64 && <Base64Converter locale={locale} />}
      {isDataUri && <DataUriConverter locale={locale} />}
      {isDimCheck && <DimensionsChecker locale={locale} />}
      {isFileSize && <FileSizeChecker locale={locale} />}
      {isResCheck && <ResolutionChecker locale={locale} />}
      {isRatioCheck && <AspectRatioChecker locale={locale} />}
      {isDpiCheck && <DpiChecker locale={locale} />}
      {isFmtCheck && <FormatChecker locale={locale} />}
      {isSquareResizer && <SquareResizer locale={locale} />}
      {isCircleCropper && <CircleCropper locale={locale} />}
      {isGrayscale && <GrayscaleConverter locale={locale} />}
      {isInverter && <ImageInverter locale={locale} />}
      {isBlur && <ImageBlur locale={locale} />}
      {isStitch && <ImageStitcher locale={locale} />}
      {isVidTrim && <VideoTrimmer locale={locale} />}
      {isVidRotate && <VideoRotator locale={locale} />}
    </div>
  </div>

  {isExact && <ExactResizerContent locale={locale} />}
  {isWebp && <WebpCompressorContent locale={locale} />}
  {isCmMm && <CmMmContent locale={locale} />}
  {isPan && <PanContent locale={locale} />}
  {isWa && <WhatsAppContent locale={locale} />}
  {isSsc && <SscContent locale={locale} />}
  {isYt && <YouTubeContent locale={locale} />}
  {isB64 && <Base64Content locale={locale} />}
  {isDataUri && <DataUriContent locale={locale} />}
  {isDimCheck && <DimensionsCheckerContent locale={locale} />}
  {isFileSize && <FileSizeCheckerContent locale={locale} />}
  {isResCheck && <ResolutionCheckerContent locale={locale} />}
  {isRatioCheck && <AspectRatioCheckerContent locale={locale} />}
  {isDpiCheck && <DpiCheckerContent locale={locale} />}
  {isFmtCheck && <FormatCheckerContent locale={locale} />}
  {isSquareResizer && <SquareResizerContent locale={locale} />}
  {isCircleCropper && <CircleCropperContent locale={locale} />}
  {isGrayscale && <GrayscaleConverterContent locale={locale} />}
  {isInverter && <ImageInverterContent locale={locale} />}
  {isBlur && <ImageBlurContent locale={locale} />}
  {isStitch && <ImageStitcherContent locale={locale} />}
  {isVidTrim && <VideoTrimmerContent locale={locale} />}
  {isVidRotate && <VideoRotatorContent locale={locale} />}
</MainLayout>

<style>
  .tool-header {
    text-align: center;
    max-width: var(--container-narrow);
    margin-inline: auto;
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
  }
  @media (min-width: 640px) {
    .tool-header {
      margin-top: var(--space-6);
      margin-bottom: var(--space-8);
    }
  }
  .tool-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--space-2);
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  @media (min-width: 640px) {
    .tool-title {
      font-size: var(--text-3xl);
    }
  }
  .tool-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
  @media (min-width: 640px) {
    .tool-subtitle {
      font-size: var(--text-base);
    }
  }
</style>

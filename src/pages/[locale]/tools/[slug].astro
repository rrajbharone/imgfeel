import GifExtractorContent from '@/components/GifExtractorContent.astro';
import PassportPhotoMaker from '@/components/PassportPhotoMaker.astro';
import PassportPhotoMakerContent from '@/components/PassportPhotoMakerContent.astro';
import SrcsetGenerator from '@/components/SrcsetGenerator.astro';
import SrcsetGeneratorContent from '@/components/SrcsetGeneratorContent.astro';
import PptResizer from '@/components/PptResizer.astro';
import PptResizerContent from '@/components/PptResizerContent.astro';
import Base64Converter from '@/components/Base64Converter.astro';
import Base64Content from '@/components/Base64Content.astro';
import DataUriConverter from '@/components/DataUriConverter.astro';
import DataUriContent from '@/components/DataUriContent.astro';
import DimensionsChecker from '@/components/DimensionsChecker.astro';
import DimensionsCheckerContent from '@/components/DimensionsCheckerContent.astro';
import FileSizeChecker from '@/components/FileSizeChecker.astro';
import FileSizeCheckerContent from '@/components/FileSizeCheckerContent.astro';
import ResolutionChecker from '@/components/ResolutionChecker.astro';
import ResolutionCheckerContent from '@/components/ResolutionCheckerContent.astro';
import AspectRatioChecker from '@/components/AspectRatioChecker.astro';
import AspectRatioCheckerContent from '@/components/AspectRatioCheckerContent.astro';
import VideoTrimmer from '@/components/VideoTrimmer.astro';
import VideoTrimmerContent from '@/components/VideoTrimmerContent.astro';
import VideoRotator from '@/components/VideoRotator.astro';
import VideoRotatorContent from '@/components/VideoRotatorContent.astro';
import DpiChecker from '@/components/DpiChecker.astro';
import DpiCheckerContent from '@/components/DpiCheckerContent.astro';
import FormatChecker from '@/components/FormatChecker.astro';
import FormatCheckerContent from '@/components/FormatCheckerContent.astro';
import SquareResizer from '@/components/SquareResizer.astro';
import SquareResizerContent from '@/components/SquareResizerContent.astro';
import CircleCropper from '@/components/CircleCropper.astro';
import CircleCropperContent from '@/components/CircleCropperContent.astro';
import GrayscaleConverter from '@/components/GrayscaleConverter.astro';
import GrayscaleConverterContent from '@/components/GrayscaleConverterContent.astro';
import ImageInverter from '@/components/ImageInverter.astro';
import ImageInverterContent from '@/components/ImageInverterContent.astro';
import ImageBlur from '@/components/ImageBlur.astro';
import ImageBlurContent from '@/components/ImageBlurContent.astro';
import ImageStitcher from '@/components/ImageStitcher.astro';
import ImageStitcherContent from '@/components/ImageStitcherContent.astro';
import ScreenshotBeautifier from '@/components/ScreenshotBeautifier.astro';
import ScreenshotBeautifierContent from '@/components/ScreenshotBeautifierContent.astro';
import ImagePlaceholderGenerator from '@/components/ImagePlaceholderGenerator.astro';
import ImagePlaceholderContent from '@/components/ImagePlaceholderContent.astro';
import ImageOverlayTool from '@/components/ImageOverlayTool.astro';
import ImageOverlayContent from '@/components/ImageOverlayContent.astro';
import ImageMosaicTool from '@/components/ImageMosaicTool.astro';
import ImageMosaicContent from '@/components/ImageMosaicContent.astro';
import FreeformCropTool from '@/components/FreeformCropTool.astro';
import FreeformCropContent from '@/components/FreeformCropContent.astro';
import ImageNoiseReducer from '@/components/ImageNoiseReducer.astro';
import ImageNoiseReducerContent from '@/components/ImageNoiseReducerContent.astro';
import ProductWhiteBackground from '@/components/ProductWhiteBackground.astro';
import ProductWhiteBackgroundContent from '@/components/ProductWhiteBackgroundContent.astro';
import SEOHead from '@/components/SEOHead.astro';
import { t, getLocalizedPath } from '@/i18n/utils';
import { NON_DEFAULT_LOCALES, type Locale } from '@/i18n/config';
import { TOOL_SLUGS, getToolUrl } from '@/data/tools';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.flatMap((locale) => {
    return Object.entries(TOOL_SLUGS).map(([toolId, slugs]) => ({
      params: {
        locale,
        slug: slugs[locale],
      },
      props: {
        toolId,
      },
    }));
  });
}

const { locale } = Astro.params as { locale: Locale };
const { toolId } = Astro.props as { toolId: string };

const toolUrl = getToolUrl(toolId, locale);

const toolPrefixMap: Record<string, string> = {
  'batch-rename-images': 'renamer',
  'exact-dimension-resizer': 'exactresizer',
  'webp-compressor': 'webpcomp',
  'cm-mm-resizer': 'cmresizer',
  'pan-card-resizer': 'panresizer',
  'whatsapp-dp-resizer': 'waresizer',
  'ssc-photo-signature-resizer': 'sscresizer',
  'youtube-banner-resizer': 'ytresizer',
  'ppt-resizer': 'pptresize',
  'image-srcset-generator': 'srcset',
  'passport-photo-maker': 'passport',
  'gif-frame-extractor': 'gifext',
  'image-to-text-converter': 'imgtotext',
  'image-dpi-converter': 'dpiconv',
  'svg-resizer': 'svgresizer',
  'facebook-cover-resizer': 'fbcover',
  'youtube-thumbnail-resizer': 'ytthumb',
  'image-to-base64-converter': 'b64',
  'image-to-data-uri-converter': 'datauri',
  'image-dimensions-checker': 'dimcheck',
  'image-file-size-checker': 'sizecheck',
  'image-resolution-checker': 'rescheck',
  'image-aspect-ratio-checker': 'ratiocheck',
  'image-dpi-checker': 'dpicheck',
  'image-format-checker': 'fmtcheck',
  'resize-image-to-1-1': 'squareresizer',
  'circle-image-cropper': 'circlecrop',
  'image-grayscale-converter': 'grayconv',
  'image-inverter': 'inverter',
  'image-blur-tool': 'blur',
  'image-stitcher': 'stitch',
  'screenshot-beautifier': 'beautify',
  'image-placeholder-generator': 'placeholder',
  'image-overlay-tool': 'overlay',
  'image-mosaic-generator': 'mosaic',
  'freeform-image-cropper': 'freeformCrop',
  'image-noise-reducer': 'noiseReducer',
  'product-image-white-background': 'productWhiteBg',
  'video-trimmer': 'vidtrim',
  'video-rotator': 'vidrot',
};

const prefix = toolPrefixMap[toolId] || 'exactresizer';
const metaTitle = t(locale, `${prefix}.meta.title`);
const metaDesc = t(locale, `${prefix}.meta.description`);
const heroTitle = t(locale, `${prefix}.hero.title`);
const heroSubtitle = t(locale, `${prefix}.hero.subtitle`);
---

<MainLayout
  locale={locale}
  title={metaTitle}
  description={metaDesc}
  canonicalUrl={`https://imgfeel.com${toolUrl}`}
  basePath={toolUrl}
>
  <Fragment slot="head">
    <SEOHead schema={{
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": heroTitle,
      "url": `https://imgfeel.com${toolUrl}`,
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    }} />
  </Fragment>

  <div class="section">
    <div class="container">
      <Breadcrumbs locale={locale} items={[
        { label: t(locale, 'breadcrumb.home'), href: getLocalizedPath('/', locale) },
        { label: t(locale, 'breadcrumb.tools'), href: getLocalizedPath('/tools/', locale) },
        { label: heroTitle }
      ]} />
      
      <div class="tool-header">
        <h1 class="tool-title">{heroTitle}</h1>
        <p class="tool-subtitle">{heroSubtitle}</p>
      </div>

      {toolId === 'batch-rename-images' && <BatchRenamer locale={locale} />}
      {toolId === 'exact-dimension-resizer' && <ExactResizer locale={locale} />}
      {toolId === 'webp-compressor' && <WebpCompressor locale={locale} />}
      {toolId === 'cm-mm-resizer' && <CmMmResizer locale={locale} />}
      {toolId === 'pan-card-resizer' && <PanResizer locale={locale} />}
      {toolId === 'whatsapp-dp-resizer' && <WhatsAppResizer locale={locale} />}
      {toolId === 'ssc-photo-signature-resizer' && <SscResizer locale={locale} />}
      {toolId === 'youtube-banner-resizer' && <YouTubeResizer locale={locale} />}
      {toolId === 'ppt-resizer' && <PptResizer locale={locale} />}
      {toolId === 'image-srcset-generator' && <SrcsetGenerator locale={locale} />}
      {toolId === 'passport-photo-maker' && <PassportPhotoMaker locale={locale} />}
      {toolId === 'gif-frame-extractor' && <GifExtractor locale={locale} />}
      {toolId === 'image-to-text-converter' && <ImageToText locale={locale} />}
      {toolId === 'image-dpi-converter' && <DpiConverter locale={locale} />}
      {toolId === 'svg-resizer' && <SvgResizer locale={locale} />}
      {toolId === 'facebook-cover-resizer' && <FacebookCoverResizer locale={locale} />}
      {toolId === 'youtube-thumbnail-resizer' && <YouTubeThumbnailResizer locale={locale} />}
      {toolId === 'image-to-base64-converter' && <Base64Converter locale={locale} />}
      {toolId === 'image-to-data-uri-converter' && <DataUriConverter locale={locale} />}
      {toolId === 'image-dimensions-checker' && <DimensionsChecker locale={locale} />}
      {toolId === 'image-file-size-checker' && <FileSizeChecker locale={locale} />}
      {toolId === 'image-resolution-checker' && <ResolutionChecker locale={locale} />}
      {toolId === 'image-aspect-ratio-checker' && <AspectRatioChecker locale={locale} />}
      {toolId === 'image-dpi-checker' && <DpiChecker locale={locale} />}
      {toolId === 'image-format-checker' && <FormatChecker locale={locale} />}
      {toolId === 'resize-image-to-1-1' && <SquareResizer locale={locale} />}
      {toolId === 'circle-image-cropper' && <CircleCropper locale={locale} />}
      {toolId === 'image-grayscale-converter' && <GrayscaleConverter locale={locale} />}
      {toolId === 'image-inverter' && <ImageInverter locale={locale} />}
      {toolId === 'image-blur-tool' && <ImageBlur locale={locale} />}
      {toolId === 'image-stitcher' && <ImageStitcher locale={locale} />}
      {toolId === 'screenshot-beautifier' && <ScreenshotBeautifier locale={locale} />}
      {toolId === 'image-placeholder-generator' && <ImagePlaceholderGenerator locale={locale} />}
      {toolId === 'image-overlay-tool' && <ImageOverlayTool locale={locale} />}
      {toolId === 'image-mosaic-generator' && <ImageMosaicTool locale={locale} />}
      {toolId === 'freeform-image-cropper' && <FreeformCropTool locale={locale} />}
      {toolId === 'image-noise-reducer' && <ImageNoiseReducer locale={locale} />}
      {toolId === 'product-image-white-background' && <ProductWhiteBackground locale={locale} />}
      {toolId === 'video-trimmer' && <VideoTrimmer locale={locale} />}
      {toolId === 'video-rotator' && <VideoRotator locale={locale} />}
    </div>
  </div>

  {toolId === 'batch-rename-images' && <BatchRenamerContent locale={locale} />}
  {toolId === 'exact-dimension-resizer' && <ExactResizerContent locale={locale} />}
  {toolId === 'webp-compressor' && <WebpCompressorContent locale={locale} />}
  {toolId === 'cm-mm-resizer' && <CmMmContent locale={locale} />}
  {toolId === 'pan-card-resizer' && <PanContent locale={locale} />}
  {toolId === 'whatsapp-dp-resizer' && <WhatsAppContent locale={locale} />}
  {toolId === 'ssc-photo-signature-resizer' && <SscContent locale={locale} />}
  {toolId === 'youtube-banner-resizer' && <YouTubeContent locale={locale} />}
  {toolId === 'ppt-resizer' && <PptResizerContent locale={locale} />}
  {toolId === 'image-srcset-generator' && <SrcsetGeneratorContent locale={locale} />}
  {toolId === 'passport-photo-maker' && <PassportPhotoMakerContent locale={locale} />}
  {toolId === 'gif-frame-extractor' && <GifExtractorContent locale={locale} />}
  {toolId === 'image-to-text-converter' && <ImageToTextContent locale={locale} />}
  {toolId === 'image-dpi-converter' && <DpiConverterContent locale={locale} />}
  {toolId === 'svg-resizer' && <SvgResizerContent locale={locale} />}
  {toolId === 'facebook-cover-resizer' && <FacebookCoverResizerContent locale={locale} />}
  {toolId === 'youtube-thumbnail-resizer' && <YouTubeThumbnailResizerContent locale={locale} />}
  {toolId === 'image-to-base64-converter' && <Base64Content locale={locale} />}
  {toolId === 'image-to-data-uri-converter' && <DataUriContent locale={locale} />}
  {toolId === 'image-dimensions-checker' && <DimensionsCheckerContent locale={locale} />}
  {toolId === 'image-file-size-checker' && <FileSizeCheckerContent locale={locale} />}
  {toolId === 'image-resolution-checker' && <ResolutionCheckerContent locale={locale} />}
  {toolId === 'image-aspect-ratio-checker' && <AspectRatioCheckerContent locale={locale} />}
  {toolId === 'image-dpi-checker' && <DpiCheckerContent locale={locale} />}
  {toolId === 'image-format-checker' && <FormatCheckerContent locale={locale} />}
  {toolId === 'resize-image-to-1-1' && <SquareResizerContent locale={locale} />}
  {toolId === 'circle-image-cropper' && <CircleCropperContent locale={locale} />}
  {toolId === 'image-grayscale-converter' && <GrayscaleConverterContent locale={locale} />}
  {toolId === 'image-inverter' && <ImageInverterContent locale={locale} />}
  {toolId === 'image-blur-tool' && <ImageBlurContent locale={locale} />}
  {toolId === 'image-stitcher' && <ImageStitcherContent locale={locale} />}
  {toolId === 'screenshot-beautifier' && <ScreenshotBeautifierContent locale={locale} />}
  {toolId === 'image-placeholder-generator' && <ImagePlaceholderContent locale={locale} />}
  {toolId === 'image-overlay-tool' && <ImageOverlayContent locale={locale} />}
  {toolId === 'image-mosaic-generator' && <ImageMosaicContent locale={locale} />}
  {toolId === 'freeform-image-cropper' && <FreeformCropContent locale={locale} />}
  {toolId === 'image-noise-reducer' && <ImageNoiseReducerContent locale={locale} />}
  {toolId === 'product-image-white-background' && <ProductWhiteBackgroundContent locale={locale} />}
  {toolId === 'video-trimmer' && <VideoTrimmerContent locale={locale} />}
  {toolId === 'video-rotator' && <VideoRotatorContent locale={locale} />}
</MainLayout>

<style>
  .tool-header {
    text-align: center;
    max-width: var(--container-narrow);
    margin-inline: auto;
    margin-top: var(--space-6);
    margin-bottom: var(--space-8);
  }
  .tool-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }
  .tool-subtitle {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
  }
</style>

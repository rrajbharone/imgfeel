---
import MainLayout from '@/layouts/MainLayout.astro';
import BatchRenamer from '@/components/BatchRenamer.astro';
import BatchRenamerContent from '@/components/BatchRenamerContent.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ExactResizer from '@/components/ExactResizer.astro';

---
import '@/styles/global.css';
import { getAlternateLinks } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  showLanguageSwitcher?: boolean;
  basePath?: string;
}

const {
  locale,
  title,
  description,
  canonicalUrl,
  ogImage,
  showLanguageSwitcher = true,
  basePath = '/',
} = Astro.props;

const alternateLinks = showLanguageSwitcher ? getAlternateLinks(basePath) : [];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preload critical Inter weights for instant rendering and zero layout shift -->
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-600.woff2" as="font" type="font/woff2" crossorigin />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ImgFeel" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

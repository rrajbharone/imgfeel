---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div
  class="exact-resizer"
  id="exact-resizer-app"
  data-i18n-info-filename={t(locale, 'exactresizer.info.filename')}
  data-i18n-info-orig-dimensions={t(locale, 'exactresizer.info.origDimensions')}
  data-i18n-info-orig-size={t(locale, 'exactresizer.info.origSize')}
  data-i18n-info-target-dimensions={t(locale, 'exactresizer.info.targetDimensions')}
  data-i18n-info-output-size={t(locale, 'exactresizer.info.outputSize')}
  data-i18n-action-resize={t(locale, 'exactresizer.action.resize')}
  data-i18n-action-download={t(locale, 'exactresizer.action.download')}
  data-i18n-action-new-image={t(locale, 'exactresizer.action.newImage')}
  data-i18n-error-invalid={t(locale, 'exactresizer.error.invalidFile')}
  data-i18n-error-load={t(locale, 'exactresizer.error.loadFailed')}
  data-i18n-error-process={t(locale, 'exactresizer.error.processFailed')}
  data-i18n-status-processing={t(locale, 'exactresizer.status.processing')}
>
  <!-- Upload State -->
  <div class="resizer-upload" id="exact-upload">
    <div class="dropzone" id="exact-dropzone">
      <svg class="dropzone-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <circle cx="8.5" cy="8.5" r="1.5" />
        <path d="m21 15-5-5L5 21" />
      </svg>
      <p class="dropzone-title">{t(locale, 'exactresizer.dropzone.title')}</p>
      <p class="dropzone-subtitle">{t(locale, 'exactresizer.dropzone.subtitle')}</p>
      <button type="button" class="btn btn-primary btn-browse">{t(locale, 'exactresizer.dropzone.browse')}</button>
      <p class="dropzone-formats">{t(locale, 'exactresizer.dropzone.formats')}</p>
      <input
        type="file"
        id="exact-file-input"
        accept="image/jpeg,image/png,image/webp"
        class="sr-only"
      />
    </div>
  </div>

  <!-- Editor State (hidden initially) -->
  <div class="resizer-editor" id="exact-editor" hidden>
    <div class="editor-layout">
      <!-- Preview Area -->
      <div class="preview-area">
        <div class="preview-container">
          <img id="exact-preview" class="preview-image" alt="Image preview" />
        </div>
        <div class="image-info" id="exact-info"></div>
      </div>

      <!-- Controls Area -->
      <div class="controls-area">
        <!-- Exact Dimensions Input -->
        <div class="control-group">
          <label class="control-group-title">{t(locale, 'exactresizer.label.unit')}</label>
          <div class="input-row">
            <div class="input-field">
              <label for="exact-width">{t(locale, 'exactresizer.label.width')} (px)</label>
              <input type="number" id="exact-width" min="1" max="10000" step="1" />
            </div>
            <div class="input-field">
              <label for="exact-height">{t(locale, 'exactresizer.label.height')} (px)</label>
              <input type="number" id="exact-height" min="1" max="10000" step="1" />
            </div>
          </div>
          <label class="checkbox-label">
            <input type="checkbox" id="exact-lock-aspect" checked />
            <span>{t(locale, 'exactresizer.label.lockAspect')}</span>
          </label>
        </div>

        <!-- Quick Dimension Presets -->
        <div class="control-group">
          <label class="control-group-title">{t(locale, 'exactresizer.preset.label')}</label>
          <div class="presets-grid">
            <button type="button" class="preset-pill exact-preset-btn" data-w="1920" data-h="1080">{t(locale, 'exactresizer.preset.fhd')}</button>
            <button type="button" class="preset-pill exact-preset-btn" data-w="1280" data-h="720">{t(locale, 'exactresizer.preset.hd')}</button>
            <button type="button" class="preset-pill exact-preset-btn" data-w="1080" data-h="1080">{t(locale, 'exactresizer.preset.square')}</button>
            <button type="button" class="preset-pill exact-preset-btn" data-w="1200" data-h="630">{t(locale, 'exactresizer.preset.social')}</button>
            <button type="button" class="preset-pill exact-preset-btn" data-w="800" data-h="600">{t(locale, 'exactresizer.preset.web')}</button>
            <button type="button" class="preset-pill exact-preset-btn" data-w="400" data-h="400">{t(locale, 'exactresizer.preset.thumb')}</button>
          </div>
        </div>

        <!-- Fit Mode -->
        <div class="control-group">
          <label class="control-group-title">{t(locale, 'exactresizer.label.resizeMode')}</label>
          <div class="mode-radios">
            <label class="radio-card">
              <input type="radio" name="exact-fit-mode" value="fit" checked />
              <span class="radio-card-body">
                <strong>{t(locale, 'exactresizer.mode.fit')}</strong>
              </span>
            </label>
            <label class="radio-card">
              <input type="radio" name="exact-fit-mode" value="crop" />
              <span class="radio-card-body">
                <strong>{t(locale, 'exactresizer.mode.crop')}</strong>
              </span>
            </label>
            <label class="radio-card">
              <input type="radio" name="exact-fit-mode" value="pad" />
              <span class="radio-card-body">
                <strong>{t(locale, 'exactresizer.mode.pad')}</strong>
              </span>
            </label>
          </div>
        </div>

        <!-- Pad Background Color (conditional for Pad mode) -->
        <div class="control-group" id="exact-pad-color-group" style="display: none;">
          <label for="exact-pad-color">{t(locale, 'exactresizer.padColor.label')}</label>
          <select id="exact-pad-color" class="custom-select">
            <option value="white">{t(locale, 'exactresizer.padColor.white')}</option>
            <option value="black">{t(locale, 'exactresizer.padColor.black')}</option>
            <option value="transparent">{t(locale, 'exactresizer.padColor.transparent')}</option>
          </select>
        </div>

        <!-- Output Format & Quality -->
        <div class="control-row">
          <div class="control-group flex-1">
            <label for="exact-format">{t(locale, 'exactresizer.label.format')}</label>
            <select id="exact-format" class="custom-select">
              <option value="image/jpeg">JPG / JPEG</option>
              <option value="image/png">PNG</option>
              <option value="image/webp">WebP</option>
            </select>
          </div>
          <div class="control-group flex-1" id="exact-quality-group">
            <label for="exact-quality">{t(locale, 'exactresizer.label.quality')}: <span id="exact-quality-val">90</span>%</label>
            <input type="range" id="exact-quality" min="10" max="100" value="90" />
          </div>
        </div>

        <!-- Actions -->
        <div class="actions">
          <button type="button" class="btn btn-primary btn-lg action-resize" id="exact-btn-resize">
            {t(locale, 'exactresizer.action.resize')}
          </button>
        </div>
      </div>
    </div>

    <!-- Result Area -->
    <div class="result-area" id="exact-result" hidden>
      <h3 class="result-title">{t(locale, 'exactresizer.result.title')}</h3>
      <div class="result-info" id="exact-result-info"></div>
      <div class="result-actions">
        <button type="button" class="btn btn-primary btn-lg" id="exact-btn-download">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>{t(locale, 'exactresizer.action.download')}</span>
        </button>
        <button type="button" class="btn btn-secondary" id="exact-btn-new">
          {t(locale, 'exactresizer.action.newImage')}
        </button>
      </div>
    </div>
  </div>

  <!-- Error State -->
  <div class="resizer-error" id="exact-error" hidden>
    <p id="exact-error-msg"></p>
  </div>
</div>

<script src="@/scripts/exact-resizer.ts"></script>

<style>
  .exact-resizer {
    max-width: var(--container-narrow);
    margin-inline: auto;
  }

  .dropzone {
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-10) var(--space-6);
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .dropzone:hover,
  .dropzone-active {
    border-color: var(--color-accent);
    background: var(--color-accent-light);
  }

  .dropzone-icon {
    color: var(--color-accent);
    margin-bottom: var(--space-1);
  }

  .dropzone-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .dropzone-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .btn-browse {
    margin-block: var(--space-2);
    pointer-events: none;
  }

  .dropzone-formats {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
  }

  .resizer-editor {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .editor-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .editor-layout {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .preview-area {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .preview-container {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 220px;
    max-height: 380px;
    overflow: hidden;
  }

  .preview-image {
    max-width: 100%;
    max-height: 340px;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .image-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-xs);
  }

  :global(.info-row) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--color-text-secondary);
  }

  :global(.info-label) {
    font-weight: 500;
  }

  :global(.info-val) {
    font-weight: 600;
    color: var(--color-text);
  }

  .controls-area {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
  }

  .control-group-title {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
  }

  .control-row {
    display: flex;
    gap: var(--space-3);
  }

  .flex-1 {
    flex: 1;
  }

  .input-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .input-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .input-field label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text);
  }

  .input-field input,
  .custom-select {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-family: inherit;
    transition: border-color 0.15s ease;
  }

  .input-field input:focus,
  .custom-select:focus {
    border-color: var(--color-accent);
    outline: none;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    margin-top: var(--space-1);
  }

  .presets-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
  }

  @media (min-width: 480px) {
    .presets-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .preset-pill {
    padding: 6px 8px;
    font-size: 11px;
    font-weight: 600;
    border: 1px solid var(--color-border);
    background: var(--color-surface-subtle);
    color: var(--color-text);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .preset-pill:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-light);
    color: var(--color-accent);
  }

  .mode-radios {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .radio-card {
    display: block;
    cursor: pointer;
  }

  .radio-card input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .radio-card-body {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 6px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
    font-size: 11px;
    color: var(--color-text);
    transition: all 0.15s ease;
    text-align: center;
  }

  .radio-card input:checked + .radio-card-body {
    border-color: var(--color-accent);
    background: var(--color-accent-light);
    color: var(--color-accent);
  }

  .action-resize {
    width: 100%;
    margin-top: var(--space-2);
  }

  .result-area {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .result-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .result-info {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-5);
    font-size: var(--text-xs);
  }

  :global(.highlight) {
    color: var(--color-accent) !important;
    font-weight: 700 !important;
  }

  .result-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    width: 100%;
  }

  .result-actions .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .resizer-error {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #b91c1c;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    text-align: center;
  }
</style>

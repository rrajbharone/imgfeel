---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": t(locale, 'circlecrop.faq.q1'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'circlecrop.faq.a1')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'circlecrop.faq.q2'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'circlecrop.faq.a2')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'circlecrop.faq.q3'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'circlecrop.faq.a3')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'circlecrop.faq.q4'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'circlecrop.faq.a4')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'circlecrop.faq.q5'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'circlecrop.faq.a5')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'circlecrop.faq.q6'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'circlecrop.faq.a6')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'circlecrop.faq.q7'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'circlecrop.faq.a7')
      }
    }
  ]
};
---

<section class="section content-section">
  <div class="container">
    <div class="content-body">
      <!-- Section 1 -->
      <h2>{t(locale, 'circlecrop.content.h1')}</h2>
      <p>{t(locale, 'circlecrop.content.p1a')}</p>
      <p>{t(locale, 'circlecrop.content.p1b')}</p>

      <div class="feature-cards-grid">
        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="4"></circle>
            </svg>
          </div>
          <h3>{t(locale, 'circlecrop.content.feat1Title')}</h3>
          <p>{t(locale, 'circlecrop.content.feat1Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3>{t(locale, 'circlecrop.content.feat2Title')}</h3>
          <p>{t(locale, 'circlecrop.content.feat2Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 7v5l3 3"></path>
            </svg>
          </div>
          <h3>{t(locale, 'circlecrop.content.feat3Title')}</h3>
          <p>{t(locale, 'circlecrop.content.feat3Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h3>{t(locale, 'circlecrop.content.feat4Title')}</h3>
          <p>{t(locale, 'circlecrop.content.feat4Desc')}</p>
        </div>
      </div>

      <!-- Section 2 -->
      <h2>{t(locale, 'circlecrop.content.h2')}</h2>
      <p>{t(locale, 'circlecrop.content.p2a')}</p>
      <p>{t(locale, 'circlecrop.content.p2b')}</p>

      <!-- Section 3 -->
      <h2>{t(locale, 'circlecrop.content.h3')}</h2>
      <p>{t(locale, 'circlecrop.content.p3a')}</p>
      <p>{t(locale, 'circlecrop.content.p3b')}</p>

      <!-- Section 4: Table -->
      <h2>{t(locale, 'circlecrop.content.h4')}</h2>
      <p>{t(locale, 'circlecrop.content.p4a')}</p>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Platform / Usage</th>
              <th>Recommended Size</th>
              <th>Minimum Display</th>
              <th>Best Format</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Instagram Profile Picture</strong></td>
              <td>1080 × 1080 px</td>
              <td>320 × 320 px</td>
              <td>PNG / JPG</td>
            </tr>
            <tr>
              <td><strong>WhatsApp Profile DP</strong></td>
              <td>500 × 500 px</td>
              <td>192 × 192 px</td>
              <td>PNG / WebP</td>
            </tr>
            <tr>
              <td><strong>Discord Avatar</strong></td>
              <td>512 × 512 px</td>
              <td>128 × 128 px</td>
              <td>PNG / WebP (Transparent)</td>
            </tr>
            <tr>
              <td><strong>YouTube Channel Icon</strong></td>
              <td>800 × 800 px</td>
              <td>98 × 98 px</td>
              <td>PNG / JPG</td>
            </tr>
            <tr>
              <td><strong>X / Twitter Profile</strong></td>
              <td>400 × 400 px</td>
              <td>200 × 200 px</td>
              <td>PNG / JPG</td>
            </tr>
            <tr>
              <td><strong>LinkedIn Profile Avatar</strong></td>
              <td>400 × 400 px</td>
              <td>200 × 200 px</td>
              <td>PNG / JPG</td>
            </tr>
            <tr>
              <td><strong>Slack &amp; Zoom Profile</strong></td>
              <td>512 × 512 px</td>
              <td>192 × 192 px</td>
              <td>PNG / WebP</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 5 -->
      <h2>{t(locale, 'circlecrop.content.h5')}</h2>
      <p>{t(locale, 'circlecrop.content.p5a')}</p>
      <p>{t(locale, 'circlecrop.content.p5b')}</p>

      <!-- Section 6 -->
      <h2>{t(locale, 'circlecrop.content.h6')}</h2>
      <p>{t(locale, 'circlecrop.content.p6a')}</p>
      <p>{t(locale, 'circlecrop.content.p6b')}</p>

      <!-- Section 7: Native OS Cropping -->
      <h2>{t(locale, 'circlecrop.content.h7')}</h2>
      <p>{t(locale, 'circlecrop.content.p7Intro')}</p>
      <ul>
        <li><strong>iPhone / iOS Photos:</strong> Open the photo in the Photos app, tap <em>Edit</em> &rarr; tap the <em>Crop</em> icon &rarr; tap the aspect ratio icon in the top right &rarr; choose <em>Square</em>. While iOS creates a 1:1 square image, upload the square directly to Instagram or WhatsApp which automatically applies their circular mask.</li>
        <li><strong>Android / Google Photos:</strong> Open the photo, tap <em>Edit</em> &rarr; <em>Crop</em> &rarr; tap the ratio selector &rarr; choose <em>1:1 Square</em> and center the subject's face before saving.</li>
        <li><strong>Mac (Preview / Photos):</strong> Open image in Preview, choose the Rectangular Selection tool, hold <code>Shift</code> to lock 1:1 square proportions, select the face area, and press <code>Cmd + K</code> to crop.</li>
        <li><strong>Windows (Photos / Paint):</strong> Open the image in the Windows Photos app, press <code>Ctrl + E</code> to open the editor, select <em>Aspect Ratio &rarr; Square</em>, center the face, and save a copy.</li>
      </ul>

      <!-- Section 8: FAQ -->
      <div class="faq-container">
        <h2>{t(locale, 'circlecrop.faq.heading')}</h2>
        
        <div class="faq-accordion">
          <details class="faq-item" open>
            <summary class="faq-question"><h3>{t(locale, 'circlecrop.faq.q1')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'circlecrop.faq.a1')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'circlecrop.faq.q2')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'circlecrop.faq.a2')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'circlecrop.faq.q3')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'circlecrop.faq.a3')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'circlecrop.faq.q4')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'circlecrop.faq.a4')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'circlecrop.faq.q5')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'circlecrop.faq.a5')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'circlecrop.faq.q6')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'circlecrop.faq.a6')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'circlecrop.faq.q7')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'circlecrop.faq.a7')}</p></div>
          </details>
        </div>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .content-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-12) 0;
  }

  .content-body {
    max-width: var(--container-narrow);
    margin-inline: auto;
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.75;
  }

  .content-body h2 {
    color: var(--color-text);
    font-size: var(--text-2xl);
    font-weight: 800;
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .content-body h2:first-child {
    margin-top: 0;
  }

  .content-body p {
    margin-bottom: var(--space-4);
  }

  .content-body ul {
    margin-bottom: var(--space-6);
    padding-left: var(--space-5);
  }

  .content-body li {
    margin-bottom: var(--space-2-5);
  }

  .content-body strong {
    color: var(--color-text);
  }

  .feature-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin: var(--space-6) 0 var(--space-8) 0;
  }

  @media (min-width: 640px) {
    .feature-cards-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .feature-card {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .feature-card-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-card h3 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .feature-card p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .table-responsive {
    overflow-x: auto;
    margin: var(--space-6) 0 var(--space-8) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .data-table th,
  .data-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  .data-table th {
    background: var(--color-surface-subtle);
    font-weight: 700;
    color: var(--color-text);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  /* FAQ */
  .faq-container {
    margin-top: var(--space-12);
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
    overflow: hidden;
  }

  .faq-question {
    padding: var(--space-4);
    cursor: pointer;
    font-weight: 600;
    user-select: none;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question h3 {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: 700;
  }

  .faq-answer {
    padding: 0 var(--space-4) var(--space-4) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .faq-answer p {
    margin: 0;
  }
</style>

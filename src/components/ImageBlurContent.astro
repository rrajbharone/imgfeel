---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": t(locale, 'blur.faq.q1'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'blur.faq.a1')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'blur.faq.q2'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'blur.faq.a2')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'blur.faq.q3'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'blur.faq.a3')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'blur.faq.q4'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'blur.faq.a4')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'blur.faq.q5'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'blur.faq.a5')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'blur.faq.q6'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'blur.faq.a6')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'blur.faq.q7'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'blur.faq.a7')
      }
    }
  ]
};
---

<section class="section content-section">
  <div class="container">
    <div class="content-body">
      <!-- Section 1 -->
      <h2>{t(locale, 'blur.content.h1')}</h2>
      <p>{t(locale, 'blur.content.p1a')}</p>
      <p>{t(locale, 'blur.content.p1b')}</p>

      <div class="feature-cards-grid">
        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke-dasharray="2 3"></circle>
              <circle cx="12" cy="12" r="5" stroke-dasharray="1 2"></circle>
              <circle cx="12" cy="12" r="1.5" fill="currentColor"></circle>
            </svg>
          </div>
          <h3>{t(locale, 'blur.content.feat1Title')}</h3>
          <p>{t(locale, 'blur.content.feat1Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="3" x2="12" y2="21"></line>
              <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            </svg>
          </div>
          <h3>{t(locale, 'blur.content.feat2Title')}</h3>
          <p>{t(locale, 'blur.content.feat2Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3>{t(locale, 'blur.content.feat3Title')}</h3>
          <p>{t(locale, 'blur.content.feat3Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <h3>{t(locale, 'blur.content.feat4Title')}</h3>
          <p>{t(locale, 'blur.content.feat4Desc')}</p>
        </div>
      </div>

      <!-- Section 2 -->
      <h2>{t(locale, 'blur.content.h2')}</h2>
      <p>{t(locale, 'blur.content.p2a')}</p>
      <p>{t(locale, 'blur.content.p2b')}</p>

      <!-- Section 3 -->
      <h2>{t(locale, 'blur.content.h3')}</h2>
      <p>{t(locale, 'blur.content.p3a')}</p>
      <p>{t(locale, 'blur.content.p3b')}</p>

      <!-- Section 4: Table -->
      <h2>{t(locale, 'blur.content.h4')}</h2>
      <p>{t(locale, 'blur.content.p4a')}</p>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Blur Style</th>
              <th>Mathematical Method</th>
              <th>Visual Characteristic</th>
              <th>Best Practical Applications</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Gaussian Blur</strong></td>
              <td>2D Normal Distribution Bell Curve</td>
              <td>Silky smooth, natural optical defocus</td>
              <td>Background defocus, glassmorphism UI, website banners</td>
            </tr>
            <tr>
              <td><strong>Privacy Redaction</strong></td>
              <td>Multi-Pass Heavy Diffusion</td>
              <td>Total obliteration of high-frequency detail</td>
              <td>ID cards, passwords, license plates, confidential documents</td>
            </tr>
            <tr>
              <td><strong>Dreamy Portrait Glow</strong></td>
              <td>Dual-Layer Soft Light Blend</td>
              <td>Luminous highlights with retained edge sharpness</td>
              <td>Glamour portraiture, romantic aesthetics, soft focus</td>
            </tr>
            <tr>
              <td><strong>Motion Blur</strong></td>
              <td>Directional Linear Multi-Sampling</td>
              <td>Horizontal or vertical dynamic streak</td>
              <td>Simulating vehicle speed, sports action, dynamic energy</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 5 -->
      <h2>{t(locale, 'blur.content.h5')}</h2>
      <p>{t(locale, 'blur.content.p5a')}</p>
      <p>{t(locale, 'blur.content.p5b')}</p>

      <!-- Section 6 -->
      <h2>{t(locale, 'blur.content.h6')}</h2>
      <p>{t(locale, 'blur.content.p6a')}</p>
      <p>{t(locale, 'blur.content.p6b')}</p>

      <!-- Section 7: Native OS Guides -->
      <h2>{t(locale, 'blur.content.h7')}</h2>
      <p>{t(locale, 'blur.content.p7Intro')}</p>
      <ul>
        <li><strong>iPhone / iPad (iOS):</strong> In the <strong>Photos</strong> app, select an image taken in Portrait Mode &rarr; tap <strong>Edit</strong> &rarr; adjust the <strong>Depth (f-stop)</strong> slider to intensify or soften background bokeh. For redaction, use the Markup tool with a solid opaque pen.</li>
        <li><strong>Android:</strong> Open <strong>Google Photos</strong> &rarr; tap <strong>Edit &rarr; Tools &rarr; Blur</strong> to apply AI depth blur to any photo. To redact text, use the markup tool or Magic Eraser camouflage.</li>
        <li><strong>Mac (macOS):</strong> Open the image in <strong>Preview</strong> &rarr; use the <strong>Markup Toolbar</strong> or use the Freeform app to blur elements. For system UI backdrops, macOS automatically applies real-time GPU Gaussian blur.</li>
        <li><strong>Windows 10 / 11:</strong> Open <strong>Snipping Tool</strong> (press <code>Win + Shift + S</code>) &rarr; click the <strong>Text Actions &rarr; Quick Redact</strong> button to automatically blur email addresses and phone numbers, or use the Blur brush tool in the latest Windows Photos app.</li>
      </ul>

      <!-- Section 8: FAQ -->
      <div class="faq-container">
        <h2>{t(locale, 'blur.faq.heading')}</h2>
        
        <div class="faq-accordion">
          <details class="faq-item" open>
            <summary class="faq-question"><h3>{t(locale, 'blur.faq.q1')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'blur.faq.a1')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'blur.faq.q2')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'blur.faq.a2')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'blur.faq.q3')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'blur.faq.a3')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'blur.faq.q4')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'blur.faq.a4')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'blur.faq.q5')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'blur.faq.a5')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'blur.faq.q6')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'blur.faq.a6')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'blur.faq.q7')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'blur.faq.a7')}</p></div>
          </details>
        </div>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .content-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-12) 0;
  }

  .content-body {
    max-width: var(--container-narrow);
    margin-inline: auto;
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.75;
  }

  .content-body h2 {
    color: var(--color-text);
    font-size: var(--text-2xl);
    font-weight: 800;
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .content-body h2:first-child {
    margin-top: 0;
  }

  .content-body p {
    margin-bottom: var(--space-4);
  }

  .content-body ul {
    margin-bottom: var(--space-6);
    padding-left: var(--space-5);
  }

  .content-body li {
    margin-bottom: var(--space-2-5);
  }

  .content-body strong {
    color: var(--color-text);
  }

  .feature-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin: var(--space-6) 0 var(--space-8) 0;
  }

  @media (min-width: 640px) {
    .feature-cards-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .feature-card {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .feature-card-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-card h3 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .feature-card p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .table-responsive {
    overflow-x: auto;
    margin: var(--space-6) 0 var(--space-8) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .data-table th,
  .data-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  .data-table th {
    background: var(--color-surface-subtle);
    font-weight: 700;
    color: var(--color-text);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  /* FAQ */
  .faq-container {
    margin-top: var(--space-12);
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
    overflow: hidden;
  }

  .faq-question {
    padding: var(--space-4);
    cursor: pointer;
    font-weight: 600;
    user-select: none;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question h3 {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: 700;
  }

  .faq-answer {
    padding: 0 var(--space-4) var(--space-4) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .faq-answer p {
    margin: 0;
  }
</style>

---
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';
import { getToolUrl } from '@/data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const bannerUrl = getToolUrl('youtube-banner-resizer', locale);
const squareUrl = getToolUrl('resize-image-to-1-1', locale);
const circleUrl = getToolUrl('circle-image-cropper', locale);
const blurUrl = getToolUrl('image-blur-tool', locale);
const noiseReducerUrl = getToolUrl('image-noise-reducer', locale);
---

<div class="yt-app-container" id="ytApp" data-locale={locale} data-i18n={JSON.stringify({
  copiedSuccess: t(locale, 'ytthumb.action.copied'),
  sizeOk: t(locale, 'ytthumb.size.ok'),
  sizeWarning: t(locale, 'ytthumb.size.warning'),
})}>
  <!-- State 1: Upload Dropzone Card -->
  <div class="yt-dropzone-card" id="ytDropzone">
    <div class="dropzone-inner">
      <div class="dropzone-icon-ring">
        <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
          <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
        </svg>
      </div>

      <h2 class="dropzone-headline">{t(locale, 'ytthumb.dropzone.title')}</h2>
      <p class="dropzone-subheadline">{t(locale, 'ytthumb.dropzone.subtitle')}</p>

      <div class="dropzone-action-group">
        <label for="ytFileInput" class="btn btn-primary dropzone-browse-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'ytthumb.dropzone.browse')}</span>
        </label>
        <input type="file" id="ytFileInput" accept="image/jpeg,image/png,image/webp,image/avif,image/bmp" class="visually-hidden" />

        <button type="button" class="btn btn-secondary sample-demo-btn" id="ytSampleBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span>{t(locale, 'ytthumb.dropzone.sample')}</span>
        </button>
      </div>

      <div class="dropzone-badges-row">
        <span class="badge-pill">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          16:9 • 1280×720 HD • Under 2MB
        </span>
        <span class="badge-pill badge-pill-green">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          {t(locale, 'ytthumb.privacy.badge')}
        </span>
      </div>
    </div>
  </div>

  <!-- Loading State Card -->
  <div class="yt-loading-card" id="ytLoadingCard" style="display: none;">
    <div class="loading-spinner"></div>
    <p class="loading-text">{t(locale, 'ytthumb.status.processing')}</p>
  </div>

  <!-- State 2: Active Workspace -->
  <div class="yt-workspace-card" id="ytWorkspace" style="display: none;">
    <!-- Workspace Top Header Bar -->
    <div class="workspace-header-bar">
      <div class="image-meta-info">
        <span class="file-name-tag" id="ytFileName">thumbnail.jpg</span>
        <span class="file-dim-pill" id="ytOriginalDimsTag">-- × -- px</span>
        <span class="file-size-pill" id="ytOriginalSizeTag">-- KB</span>
      </div>

      <div class="workspace-header-actions">
        <button type="button" class="btn btn-secondary btn-sm change-image-btn" id="ytChangeImageBtn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'ytthumb.action.changeImage')}</span>
        </button>
      </div>
    </div>

    <!-- 2-Column Responsive Layout -->
    <div class="yt-main-grid">
      <!-- Left Column: Interactive Canvas & Previews -->
      <div class="yt-preview-column">
        <!-- Interactive 16:9 Canvas Box with Safe Zone -->
        <div class="canvas-viewport-box" id="ytCanvasViewport">
          <canvas id="ytMainCanvas" class="yt-master-canvas"></canvas>
          
          <!-- YouTube Bottom-Right Timestamp Badge Safe Zone Overlay -->
          <div class="yt-timestamp-overlay" id="ytTimestampOverlay">
            <span class="timestamp-box">14:20</span>
          </div>

          <span class="safe-zone-hint-badge" id="ytSafeZoneHint">
            {t(locale, 'ytthumb.safeZoneTip')}
          </span>
        </div>

        <!-- Safe Zone Toggle Checkbox Row -->
        <div class="safezone-toggle-bar">
          <label class="toggle-checkbox-label">
            <input type="checkbox" id="ytSafeZoneCheckbox" checked class="yt-checkbox" />
            <span>{t(locale, 'ytthumb.safeZoneToggle')}</span>
          </label>
        </div>

        <!-- Live YouTube Mockup Previews Strip -->
        <div class="live-previews-panel">
          <!-- Desktop Video Card Mockup -->
          <div class="preview-item desktop-card-mockup">
            <span class="preview-title-tag">{t(locale, 'ytthumb.preview.desktop')}</span>
            <div class="yt-video-card-mockup">
              <div class="yt-card-thumb-frame">
                <canvas id="ytDesktopThumbCanvas" width="240" height="135"></canvas>
                <span class="yt-thumb-badge">{t(locale, 'ytthumb.mockup.duration')}</span>
              </div>
              <div class="yt-card-meta">
                <div class="yt-channel-avatar"></div>
                <div class="yt-card-text">
                  <strong class="yt-video-title">{t(locale, 'ytthumb.mockup.title')}</strong>
                  <span class="yt-channel-name">{t(locale, 'ytthumb.mockup.channel')}</span>
                  <span class="yt-video-views">{t(locale, 'ytthumb.mockup.views')}</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Mobile App Feed Mockup -->
          <div class="preview-item mobile-feed-mockup">
            <span class="preview-title-tag">{t(locale, 'ytthumb.preview.mobile')}</span>
            <div class="yt-mobile-feed-card">
              <div class="yt-mobile-thumb-frame">
                <canvas id="ytMobileThumbCanvas" width="200" height="112"></canvas>
                <span class="yt-thumb-badge">{t(locale, 'ytthumb.mockup.duration')}</span>
              </div>
              <div class="yt-mobile-meta">
                <strong class="yt-mobile-title">{t(locale, 'ytthumb.mockup.title')}</strong>
                <span class="yt-mobile-sub">{t(locale, 'ytthumb.mockup.channel')} • {t(locale, 'ytthumb.mockup.views')}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Primary Action Buttons Row -->
        <div class="yt-action-buttons-grid">
          <button type="button" class="btn btn-primary yt-download-btn" id="ytDownloadBtn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>{t(locale, 'ytthumb.action.download')}</span>
          </button>

          <button type="button" class="btn btn-secondary yt-copy-btn" id="ytCopyBtn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="ytCopyBtnText">{t(locale, 'ytthumb.action.copyImage')}</span>
          </button>

          <button type="button" class="btn btn-secondary yt-reset-btn" id="ytResetBtn" title={t(locale, 'ytthumb.action.reset')}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
              <path d="M3 3v5h5"></path>
            </svg>
            <span>{t(locale, 'ytthumb.action.reset')}</span>
          </button>
        </div>
      </div>

      <!-- Right Column: Settings & Controls Panel -->
      <div class="yt-controls-panel">
        <!-- Section 1: Quick Presets -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'ytthumb.section.presets')}</label>
          <div class="preset-chips-grid">
            <button type="button" class="preset-chip-btn active" data-preset="fullBlur">
              <strong>{t(locale, 'ytthumb.preset.fullBlur')}</strong>
              <span>{t(locale, 'ytthumb.preset.fullBlurDesc')}</span>
            </button>

            <button type="button" class="preset-chip-btn" data-preset="sixteenNineCrop">
              <strong>{t(locale, 'ytthumb.preset.sixteenNineCrop')}</strong>
              <span>{t(locale, 'ytthumb.preset.sixteenNineCropDesc')}</span>
            </button>

            <button type="button" class="preset-chip-btn" data-preset="cleanWhite">
              <strong>{t(locale, 'ytthumb.preset.cleanWhite')}</strong>
              <span>{t(locale, 'ytthumb.preset.cleanWhiteDesc')}</span>
            </button>

            <button type="button" class="preset-chip-btn" data-preset="darkStudio">
              <strong>{t(locale, 'ytthumb.preset.darkStudio')}</strong>
              <span>{t(locale, 'ytthumb.preset.darkStudioDesc')}</span>
            </button>

            <button type="button" class="preset-chip-btn" data-preset="youtubeRed">
              <strong>{t(locale, 'ytthumb.preset.youtubeRed')}</strong>
              <span>{t(locale, 'ytthumb.preset.youtubeRedDesc')}</span>
            </button>
          </div>
        </div>

        <!-- Section 2: Mode Switcher -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'ytthumb.section.framing')}</label>
          <div class="segmented-mode-bar">
            <button type="button" class="seg-btn active" data-mode="fit">
              {t(locale, 'ytthumb.mode.fit')}
            </button>
            <button type="button" class="seg-btn" data-mode="fill">
              {t(locale, 'ytthumb.mode.fill')}
            </button>
          </div>
        </div>

        <!-- Section 3: Background Style (Fit Mode) -->
        <div class="control-group" id="ytBgSection">
          <label class="control-label">{t(locale, 'ytthumb.section.bg')}</label>
          <div class="segmented-mode-bar">
            <button type="button" class="seg-bg-btn active" data-bg="blur">
              {t(locale, 'ytthumb.bg.blur')}
            </button>
            <button type="button" class="seg-bg-btn" data-bg="solid">
              {t(locale, 'ytthumb.bg.solid')}
            </button>
          </div>

          <!-- Blur controls -->
          <div id="ytBlurControlsBox" class="sub-controls-box">
            <div class="slider-header-row">
              <label for="ytBlurSlider" class="sub-label">{t(locale, 'ytthumb.label.blurStrength')}</label>
              <span class="val-pill" id="ytBlurValPill">25 px</span>
            </div>
            <input type="range" id="ytBlurSlider" min="5" max="50" value="25" step="1" class="yt-range" />

            <div class="slider-header-row" style="margin-top: 6px;">
              <label for="ytBgDimSlider" class="sub-label">{t(locale, 'ytthumb.label.bgDim')}</label>
              <span class="val-pill" id="ytBgDimValPill">15%</span>
            </div>
            <input type="range" id="ytBgDimSlider" min="0" max="50" value="15" step="1" class="yt-range" />
          </div>

          <!-- Solid color swatches -->
          <div id="ytColorControlsBox" class="sub-controls-box" style="display: none;">
            <label class="sub-label">{t(locale, 'ytthumb.bg.color')}</label>
            <div class="color-swatches-grid">
              <button type="button" class="color-swatch-btn" data-color="#ffffff" style="background:#ffffff" title="Pure White"></button>
              <button type="button" class="color-swatch-btn active" data-color="#0f172a" style="background:#0f172a" title="Midnight Slate"></button>
              <button type="button" class="color-swatch-btn" data-color="#FF0000" style="background:#FF0000" title="YouTube Red"></button>
              <button type="button" class="color-swatch-btn" data-color="#1e1b4b" style="background:#1e1b4b" title="Royal Navy"></button>
              <button type="button" class="color-swatch-btn" data-color="#000000" style="background:#000000" title="Deep Black"></button>
              <input type="color" id="ytCustomColorPicker" value="#0f172a" class="custom-color-input" title="Custom color picker" />
            </div>
          </div>
        </div>

        <!-- Section 4: Zoom & Quick Transforms -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'ytthumb.section.adjust')}</label>
          
          <div class="slider-header-row">
            <label for="ytZoomSlider" class="sub-label">{t(locale, 'ytthumb.label.zoom')}</label>
            <span class="val-pill" id="ytZoomValPill">1.00×</span>
          </div>
          <input type="range" id="ytZoomSlider" min="0.5" max="3.0" step="0.05" value="1.0" class="yt-range" />

          <div class="transform-buttons-row">
            <button type="button" class="btn btn-secondary btn-sm transform-btn" id="ytRotateBtn" title="Rotate 90° Clockwise">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
              <span>{t(locale, 'ytthumb.action.rotate')}</span>
            </button>

            <button type="button" class="btn btn-secondary btn-sm transform-btn" id="ytFlipBtn" title="Flip Horizontal">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 3 21 3 21 8"></polyline><line x1="4" y1="20" x2="21" y2="3"></line><polyline points="21 16 21 21 16 21"></polyline><line x1="15" y1="15" x2="21" y2="21"></line><line x1="4" y1="4" x2="9" y2="9"></line></svg>
              <span>{t(locale, 'ytthumb.action.flip')}</span>
            </button>

            <button type="button" class="btn btn-secondary btn-sm transform-btn" id="ytCenterBtn" title="Reset Subject Center">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
              <span>{t(locale, 'ytthumb.action.center')}</span>
            </button>
          </div>
        </div>

        <!-- Section 5: Resolution Preset Selector -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'ytthumb.section.resolution')}</label>
          <div class="resolution-pills-grid">
            <button type="button" class="res-pill-btn active" data-w="1280" data-h="720">
              <strong>1280 × 720 px</strong>
              <span>{t(locale, 'ytthumb.preset.1280')}</span>
            </button>
            <button type="button" class="res-pill-btn" data-w="1920" data-h="1080">
              <strong>1920 × 1080 px</strong>
              <span>{t(locale, 'ytthumb.preset.1920')}</span>
            </button>
            <button type="button" class="res-pill-btn" data-w="640" data-h="360">
              <strong>640 × 360 px</strong>
              <span>{t(locale, 'ytthumb.preset.640')}</span>
            </button>
          </div>
        </div>

        <!-- Section 6: Export Format & 2MB Safeguard -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'ytthumb.section.export')}</label>
          <div class="select-field">
            <label for="ytExportFormatSelect" class="sub-label">{t(locale, 'ytthumb.export.format')}</label>
            <select id="ytExportFormatSelect" class="yt-select">
              <option value="image/jpeg" selected>JPG / JPEG (Recommended for YouTube)</option>
              <option value="image/webp">WebP (Lightweight & High Quality)</option>
              <option value="image/png">PNG (Lossless Sharpness)</option>
            </select>
          </div>

          <div class="quality-field" id="ytQualityFieldBox">
            <div class="slider-header-row">
              <label for="ytExportQualitySlider" class="sub-label">{t(locale, 'ytthumb.export.quality')}</label>
              <span class="val-pill" id="ytQualityValPill">92%</span>
            </div>
            <input type="range" id="ytExportQualitySlider" min="10" max="100" value="92" step="1" class="yt-range" />
          </div>

          <!-- Real-Time Estimated Size Badge -->
          <div class="size-estimate-box">
            <span class="estimate-label">{t(locale, 'ytthumb.size.estimate')}:</span>
            <span class="estimate-pill" id="ytSizeEstimatePill">~180 KB</span>
            <span class="size-status-pill ok" id="ytSizeStatusPill">{t(locale, 'ytthumb.size.ok')}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Cross Navigation Links -->
    <div class="yt-cross-links-row">
      <a href={bannerUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
        <span>{t(locale, 'ytthumb.cross.banner')}</span>
      </a>

      <a href={squareUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect></svg>
        <span>{t(locale, 'ytthumb.cross.square')}</span>
      </a>

      <a href={circleUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle></svg>
        <span>{t(locale, 'ytthumb.cross.circle')}</span>
      </a>

      <a href={blurUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" stroke-dasharray="2 3"></circle></svg>
        <span>{t(locale, 'ytthumb.cross.blur')}</span>
      </a>

      <a href={noiseReducerUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path><circle cx="12" cy="12" r="3"></circle></svg>
        <span>{t(locale, 'ytthumb.cross.noiseReducer')}</span>
      </a>
    </div>
  </div>
</div>

<script>
  import {
    loadYouTubeThumbnailFromFile,
    renderYouTubeThumbnailCanvas,
    renderThumbnailPreview,
    generateSampleYouTubeThumbnail,
    exportYouTubeThumbnail,
    copyYouTubeThumbnailToClipboard,
    DEFAULT_YT_THUMBNAIL_OPTIONS,
    YT_THUMBNAIL_PRESETS,
    type YouTubeThumbnailOptions,
    type LoadedImageInfo,
  } from '@/scripts/youtube-thumbnail-resizer';

  function initYouTubeThumbnailResizer() {
    const appEl = document.getElementById('ytApp');
    if (!appEl) return;

    const i18n = appEl.dataset.i18n ? JSON.parse(appEl.dataset.i18n) : {};

    // State
    let loadedImageObj: LoadedImageInfo | null = null;
    let ytOptions: YouTubeThumbnailOptions = { ...DEFAULT_YT_THUMBNAIL_OPTIONS };
    let exportFormat: 'image/jpeg' | 'image/png' | 'image/webp' = 'image/jpeg';
    let exportQuality: number = 0.92;

    // Dragging State
    let isDraggingCanvas = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let initOffsetX = 0;
    let initOffsetY = 0;

    // DOM Elements
    const dropzone = document.getElementById('ytDropzone') as HTMLElement;
    const fileInput = document.getElementById('ytFileInput') as HTMLInputElement;
    const sampleBtn = document.getElementById('ytSampleBtn') as HTMLButtonElement;
    const loadingCard = document.getElementById('ytLoadingCard') as HTMLElement;
    const workspace = document.getElementById('ytWorkspace') as HTMLElement;

    const fileNameEl = document.getElementById('ytFileName') as HTMLElement;
    const origDimsTag = document.getElementById('ytOriginalDimsTag') as HTMLElement;
    const origSizeTag = document.getElementById('ytOriginalSizeTag') as HTMLElement;
    const changeImageBtn = document.getElementById('ytChangeImageBtn') as HTMLButtonElement;

    const canvasViewport = document.getElementById('ytCanvasViewport') as HTMLElement;
    const mainCanvas = document.getElementById('ytMainCanvas') as HTMLCanvasElement;
    const timestampOverlay = document.getElementById('ytTimestampOverlay') as HTMLElement;
    const safeZoneHint = document.getElementById('ytSafeZoneHint') as HTMLElement;
    const safeZoneCheckbox = document.getElementById('ytSafeZoneCheckbox') as HTMLInputElement;

    const desktopThumbCanvas = document.getElementById('ytDesktopThumbCanvas') as HTMLCanvasElement;
    const mobileThumbCanvas = document.getElementById('ytMobileThumbCanvas') as HTMLCanvasElement;

    const presetBtns = document.querySelectorAll('.preset-chip-btn') as NodeListOf<HTMLButtonElement>;
    const modeBtns = document.querySelectorAll('.seg-btn') as NodeListOf<HTMLButtonElement>;
    const bgSection = document.getElementById('ytBgSection') as HTMLElement;
    const segBgBtns = document.querySelectorAll('.seg-bg-btn') as NodeListOf<HTMLButtonElement>;

    const blurControlsBox = document.getElementById('ytBlurControlsBox') as HTMLElement;
    const colorControlsBox = document.getElementById('ytColorControlsBox') as HTMLElement;

    const blurSlider = document.getElementById('ytBlurSlider') as HTMLInputElement;
    const blurValPill = document.getElementById('ytBlurValPill') as HTMLElement;
    const bgDimSlider = document.getElementById('ytBgDimSlider') as HTMLInputElement;
    const bgDimValPill = document.getElementById('ytBgDimValPill') as HTMLElement;

    const colorSwatches = document.querySelectorAll('.color-swatch-btn') as NodeListOf<HTMLButtonElement>;
    const customColorPicker = document.getElementById('ytCustomColorPicker') as HTMLInputElement;

    const zoomSlider = document.getElementById('ytZoomSlider') as HTMLInputElement;
    const zoomValPill = document.getElementById('ytZoomValPill') as HTMLElement;

    const rotateBtn = document.getElementById('ytRotateBtn') as HTMLButtonElement;
    const flipBtn = document.getElementById('ytFlipBtn') as HTMLButtonElement;
    const centerBtn = document.getElementById('ytCenterBtn') as HTMLButtonElement;

    const resPillBtns = document.querySelectorAll('.res-pill-btn') as NodeListOf<HTMLButtonElement>;

    const exportFormatSelect = document.getElementById('ytExportFormatSelect') as HTMLSelectElement;
    const qualityFieldBox = document.getElementById('ytQualityFieldBox') as HTMLElement;
    const exportQualitySlider = document.getElementById('ytExportQualitySlider') as HTMLInputElement;
    const qualityValPill = document.getElementById('ytQualityValPill') as HTMLElement;

    const sizeEstimatePill = document.getElementById('ytSizeEstimatePill') as HTMLElement;
    const sizeStatusPill = document.getElementById('ytSizeStatusPill') as HTMLElement;

    const downloadBtn = document.getElementById('ytDownloadBtn') as HTMLButtonElement;
    const copyBtn = document.getElementById('ytCopyBtn') as HTMLButtonElement;
    const copyBtnText = document.getElementById('ytCopyBtnText') as HTMLElement;
    const resetBtn = document.getElementById('ytResetBtn') as HTMLButtonElement;

    function render() {
      if (!loadedImageObj || !mainCanvas) return;

      const rendered = renderYouTubeThumbnailCanvas(
        loadedImageObj.img,
        ytOptions,
        ytOptions.targetWidth,
        ytOptions.targetHeight
      );

      mainCanvas.width = rendered.width;
      mainCanvas.height = rendered.height;

      const ctx = mainCanvas.getContext('2d');
      if (ctx) {
        ctx.drawImage(rendered, 0, 0);
      }

      if (desktopThumbCanvas) {
        renderThumbnailPreview(rendered, desktopThumbCanvas, 240, 135);
      }
      if (mobileThumbCanvas) {
        renderThumbnailPreview(rendered, mobileThumbCanvas, 200, 112);
      }

      updateEstimatedSize(rendered);
    }

    function updateEstimatedSize(canvas: HTMLCanvasElement) {
      if (!sizeEstimatePill || !sizeStatusPill) return;

      try {
        const dataUrl = canvas.toDataURL(exportFormat, exportFormat === 'image/png' ? undefined : exportQuality);
        const approxBytes = Math.round((dataUrl.length - dataUrl.indexOf(',') - 1) * 0.75);
        const approxKB = Math.round(approxBytes / 1024);

        if (approxKB > 1024) {
          sizeEstimatePill.textContent = `${(approxKB / 1024).toFixed(2)} MB`;
        } else {
          sizeEstimatePill.textContent = `${approxKB} KB`;
        }

        const isOver2MB = approxBytes > 2 * 1024 * 1024;
        if (isOver2MB) {
          sizeStatusPill.className = 'size-status-pill warning';
          sizeStatusPill.textContent = i18n.sizeWarning || '⚠ Over 2MB limit';
        } else {
          sizeStatusPill.className = 'size-status-pill ok';
          sizeStatusPill.textContent = i18n.sizeOk || '✓ Under YouTube 2MB Limit';
        }
      } catch (e) {
        // ignore
      }
    }

    function triggerUpdate() {
      render();
    }

    async function loadFile(file: File) {
      if (!dropzone || !loadingCard || !workspace) return;

      dropzone.style.display = 'none';
      workspace.style.display = 'none';
      loadingCard.style.display = 'flex';

      try {
        loadedImageObj = await loadYouTubeThumbnailFromFile(file);
        ytOptions = { ...DEFAULT_YT_THUMBNAIL_OPTIONS };

        if (fileNameEl) fileNameEl.textContent = loadedImageObj.name;
        if (origDimsTag) origDimsTag.textContent = `${loadedImageObj.originalWidth} × ${loadedImageObj.originalHeight} px`;
        if (origSizeTag) origSizeTag.textContent = `${(loadedImageObj.fileSize / 1024).toFixed(1)} KB`;

        syncControlsToState();
        render();

        loadingCard.style.display = 'none';
        workspace.style.display = 'block';
      } catch (err) {
        alert(err instanceof Error ? err.message : 'Failed to load image');
        resetToDropzone();
      }
    }

    function resetToDropzone() {
      loadedImageObj = null;
      if (fileInput) fileInput.value = '';
      if (loadingCard) loadingCard.style.display = 'none';
      if (workspace) workspace.style.display = 'none';
      if (dropzone) dropzone.style.display = 'block';
    }

    function syncControlsToState() {
      modeBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-mode') === ytOptions.mode));
      if (bgSection) bgSection.style.display = ytOptions.mode === 'fit' ? 'flex' : 'none';

      segBgBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-bg') === ytOptions.bgType));
      if (blurControlsBox) blurControlsBox.style.display = ytOptions.bgType === 'blur' ? 'block' : 'none';
      if (colorControlsBox) colorControlsBox.style.display = ytOptions.bgType === 'solid' ? 'block' : 'none';

      if (blurSlider) blurSlider.value = String(ytOptions.blurStrength);
      if (blurValPill) blurValPill.textContent = `${ytOptions.blurStrength} px`;

      if (bgDimSlider) bgDimSlider.value = String(ytOptions.bgDim);
      if (bgDimValPill) bgDimValPill.textContent = `${ytOptions.bgDim}%`;

      if (zoomSlider) zoomSlider.value = String(ytOptions.zoom);
      if (zoomValPill) zoomValPill.textContent = `${ytOptions.zoom.toFixed(2)}×`;

      resPillBtns.forEach((b) => {
        const w = parseInt(b.getAttribute('data-w') || '1280', 10);
        b.classList.toggle('active', w === ytOptions.targetWidth);
      });

      if (safeZoneCheckbox) safeZoneCheckbox.checked = ytOptions.showSafeZone;
      if (timestampOverlay) timestampOverlay.style.display = ytOptions.showSafeZone ? 'block' : 'none';
      if (safeZoneHint) safeZoneHint.style.display = ytOptions.showSafeZone ? 'block' : 'none';
    }

    if (changeImageBtn) changeImageBtn.addEventListener('click', resetToDropzone);

    // Canvas Drag / Pan Handling
    function handleDragStart(clientX: number, clientY: number) {
      if (!loadedImageObj) return;
      isDraggingCanvas = true;
      dragStartX = clientX;
      dragStartY = clientY;
      initOffsetX = ytOptions.offsetX;
      initOffsetY = ytOptions.offsetY;
    }

    function handleDragMove(clientX: number, clientY: number) {
      if (!isDraggingCanvas || !loadedImageObj || !mainCanvas) return;
      const rect = mainCanvas.getBoundingClientRect();
      const deltaX = (clientX - dragStartX) / (rect.width / 2);
      const deltaY = (clientY - dragStartY) / (rect.height / 2);

      ytOptions.offsetX = Math.max(-1.5, Math.min(1.5, initOffsetX + deltaX));
      ytOptions.offsetY = Math.max(-1.5, Math.min(1.5, initOffsetY + deltaY));
      triggerUpdate();
    }

    function handleDragEnd() {
      isDraggingCanvas = false;
    }

    if (canvasViewport) {
      canvasViewport.addEventListener('mousedown', (e) => {
        e.preventDefault();
        handleDragStart(e.clientX, e.clientY);
      });

      window.addEventListener('mousemove', (e) => {
        if (isDraggingCanvas) {
          handleDragMove(e.clientX, e.clientY);
        }
      });

      window.addEventListener('mouseup', handleDragEnd);

      // Touch events for mobile
      canvasViewport.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          handleDragStart(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: true });

      canvasViewport.addEventListener('touchmove', (e) => {
        if (isDraggingCanvas && e.touches.length === 1) {
          handleDragMove(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: true });

      canvasViewport.addEventListener('touchend', handleDragEnd);

      // Mouse wheel zoom
      canvasViewport.addEventListener('wheel', (e) => {
        e.preventDefault();
        const zoomDelta = e.deltaY < 0 ? 0.05 : -0.05;
        ytOptions.zoom = Math.max(0.5, Math.min(3.0, ytOptions.zoom + zoomDelta));
        if (zoomSlider) zoomSlider.value = String(ytOptions.zoom);
        if (zoomValPill) zoomValPill.textContent = `${ytOptions.zoom.toFixed(2)}×`;
        triggerUpdate();
      }, { passive: false });
    }

    // Safe Zone Checkbox
    if (safeZoneCheckbox) {
      safeZoneCheckbox.addEventListener('change', () => {
        ytOptions.showSafeZone = safeZoneCheckbox.checked;
        if (timestampOverlay) timestampOverlay.style.display = ytOptions.showSafeZone ? 'block' : 'none';
        if (safeZoneHint) safeZoneHint.style.display = ytOptions.showSafeZone ? 'block' : 'none';
      });
    }

    // Presets
    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        presetBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const presetKey = btn.getAttribute('data-preset') || 'fullBlur';
        const config = YT_THUMBNAIL_PRESETS[presetKey];
        if (config) {
          ytOptions = { ...ytOptions, ...config };
          syncControlsToState();
          triggerUpdate();
        }
      });
    });

    // Mode Switcher
    modeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        modeBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        ytOptions.mode = (btn.getAttribute('data-mode') as any) || 'fit';
        if (bgSection) bgSection.style.display = ytOptions.mode === 'fit' ? 'flex' : 'none';
        triggerUpdate();
      });
    });

    // Background Style Switcher
    segBgBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        segBgBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        ytOptions.bgType = (btn.getAttribute('data-bg') as any) || 'blur';
        if (blurControlsBox) blurControlsBox.style.display = ytOptions.bgType === 'blur' ? 'block' : 'none';
        if (colorControlsBox) colorControlsBox.style.display = ytOptions.bgType === 'solid' ? 'block' : 'none';
        triggerUpdate();
      });
    });

    // Sliders
    if (blurSlider) {
      blurSlider.addEventListener('input', () => {
        ytOptions.blurStrength = parseInt(blurSlider.value, 10);
        if (blurValPill) blurValPill.textContent = `${ytOptions.blurStrength} px`;
        triggerUpdate();
      });
    }

    if (bgDimSlider) {
      bgDimSlider.addEventListener('input', () => {
        ytOptions.bgDim = parseInt(bgDimSlider.value, 10);
        if (bgDimValPill) bgDimValPill.textContent = `${ytOptions.bgDim}%`;
        triggerUpdate();
      });
    }

    if (zoomSlider) {
      zoomSlider.addEventListener('input', () => {
        ytOptions.zoom = parseFloat(zoomSlider.value);
        if (zoomValPill) zoomValPill.textContent = `${ytOptions.zoom.toFixed(2)}×`;
        triggerUpdate();
      });
    }

    // Color Swatches
    colorSwatches.forEach((btn) => {
      btn.addEventListener('click', () => {
        colorSwatches.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        ytOptions.bgColor = btn.getAttribute('data-color') || '#0f172a';
        if (customColorPicker) customColorPicker.value = ytOptions.bgColor;
        triggerUpdate();
      });
    });

    if (customColorPicker) {
      customColorPicker.addEventListener('input', () => {
        ytOptions.bgColor = customColorPicker.value;
        colorSwatches.forEach((b) => b.classList.remove('active'));
        triggerUpdate();
      });
    }

    // Transform Actions
    if (rotateBtn) {
      rotateBtn.addEventListener('click', () => {
        ytOptions.rotation = (ytOptions.rotation + 90) % 360;
        triggerUpdate();
      });
    }

    if (flipBtn) {
      flipBtn.addEventListener('click', () => {
        ytOptions.flipH = !ytOptions.flipH;
        triggerUpdate();
      });
    }

    if (centerBtn) {
      centerBtn.addEventListener('click', () => {
        ytOptions.offsetX = 0;
        ytOptions.offsetY = 0;
        ytOptions.zoom = 1.0;
        if (zoomSlider) zoomSlider.value = '1.0';
        if (zoomValPill) zoomValPill.textContent = '1.00×';
        triggerUpdate();
      });
    }

    // Resolution Pills
    resPillBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        resPillBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        ytOptions.targetWidth = parseInt(btn.getAttribute('data-w') || '1280', 10);
        ytOptions.targetHeight = parseInt(btn.getAttribute('data-h') || '720', 10);
        triggerUpdate();
      });
    });

    // Export Settings
    if (exportFormatSelect) {
      exportFormatSelect.addEventListener('change', () => {
        exportFormat = exportFormatSelect.value as any;
        if (qualityFieldBox) {
          qualityFieldBox.style.display = exportFormat === 'image/png' ? 'none' : 'block';
        }
        triggerUpdate();
      });
    }

    if (exportQualitySlider) {
      exportQualitySlider.addEventListener('input', () => {
        const q = parseInt(exportQualitySlider.value, 10);
        exportQuality = q / 100;
        if (qualityValPill) qualityValPill.textContent = `${q}%`;
        triggerUpdate();
      });
    }

    // Reset Button
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        ytOptions = { ...DEFAULT_YT_THUMBNAIL_OPTIONS };
        presetBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-preset') === 'fullBlur'));
        syncControlsToState();
        triggerUpdate();
      });
    }

    // Download Action
    if (downloadBtn) {
      downloadBtn.addEventListener('click', () => {
        if (!loadedImageObj) return;

        const baseName = loadedImageObj.name.replace(/\.[^/.]+$/, '');
        const fullCanvas = renderYouTubeThumbnailCanvas(
          loadedImageObj.img,
          ytOptions,
          ytOptions.targetWidth,
          ytOptions.targetHeight
        );
        exportYouTubeThumbnail(fullCanvas, exportFormat, exportQuality, `${baseName}-youtube-thumbnail`);
      });
    }

    // Copy to Clipboard Action
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        if (!loadedImageObj) return;
        try {
          const fullCanvas = renderYouTubeThumbnailCanvas(
            loadedImageObj.img,
            ytOptions,
            ytOptions.targetWidth,
            ytOptions.targetHeight
          );
          const success = await copyYouTubeThumbnailToClipboard(fullCanvas);
          if (success) {
            if (copyBtnText) copyBtnText.textContent = i18n.copiedSuccess || 'Copied!';
            copyBtn.classList.add('btn-success');
            setTimeout(() => {
              if (copyBtnText) copyBtnText.textContent = 'Copy Image';
              copyBtn.classList.remove('btn-success');
            }, 2000);
          } else {
            alert('Clipboard copy is not supported in this browser.');
          }
        } catch (err) {
          alert('Could not copy thumbnail to clipboard.');
        }
      });
    }

    // File Upload Handlers
    if (fileInput) {
      fileInput.addEventListener('change', (e) => {
        const files = (e.target as HTMLInputElement).files;
        if (files && files[0]) loadFile(files[0]);
      });
    }

    if (sampleBtn) {
      sampleBtn.addEventListener('click', async () => {
        showLoading(true);
        try {
          loadedImageObj = await generateSampleYouTubeThumbnail();
          ytOptions = { ...DEFAULT_YT_THUMBNAIL_OPTIONS };

          if (fileNameEl) fileNameEl.textContent = loadedImageObj.name;
          if (origDimsTag) origDimsTag.textContent = `${loadedImageObj.originalWidth} × ${loadedImageObj.originalHeight} px`;
          if (origSizeTag) origSizeTag.textContent = `${(loadedImageObj.fileSize / 1024).toFixed(1)} KB`;

          syncControlsToState();
          render();

          loadingCard.style.display = 'none';
          dropzone.style.display = 'none';
          workspace.style.display = 'block';
        } catch (err) {
          showLoading(false);
        }
      });
    }

    function showLoading(show: boolean) {
      if (show) {
        loadingCard.style.display = 'flex';
        workspace.style.display = 'none';
        dropzone.style.display = 'none';
      } else {
        loadingCard.style.display = 'none';
      }
    }

    // Drag & Drop
    if (dropzone) {
      ['dragenter', 'dragover'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          dropzone.classList.add('dragover');
        });
      });
      ['dragleave', 'drop'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          dropzone.classList.remove('dragover');
        });
      });
      dropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        if (dt?.files?.[0]) loadFile(dt.files[0]);
      });
    }

    // Global Clipboard Paste
    window.addEventListener('paste', (e) => {
      const items = e.clipboardData?.items;
      if (!items) return;
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.startsWith('image/')) {
          const file = items[i].getAsFile();
          if (file) loadFile(file);
          break;
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initYouTubeThumbnailResizer);
  } else {
    initYouTubeThumbnailResizer();
  }
</script>


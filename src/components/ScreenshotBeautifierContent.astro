---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": t(locale, 'beautify.faq.q1'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'beautify.faq.a1')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'beautify.faq.q2'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'beautify.faq.a2')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'beautify.faq.q3'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'beautify.faq.a3')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'beautify.faq.q4'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'beautify.faq.a4')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'beautify.faq.q5'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'beautify.faq.a5')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'beautify.faq.q6'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'beautify.faq.a6')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'beautify.faq.q7'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'beautify.faq.a7')
      }
    }
  ]
};
---

<section class="section content-section">
  <div class="container">
    <div class="content-body">
      <!-- Section 1 -->
      <h2>{t(locale, 'beautify.content.h1')}</h2>
      <p>{t(locale, 'beautify.content.p1a')}</p>
      <p>{t(locale, 'beautify.content.p1b')}</p>

      <div class="feature-cards-grid">
        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
              <path d="M2 12h20"></path>
            </svg>
          </div>
          <h3>{t(locale, 'beautify.content.feat1Title')}</h3>
          <p>{t(locale, 'beautify.content.feat1Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2"></rect>
              <line x1="3" y1="9" x2="21" y2="9"></line>
              <circle cx="6" cy="6" r="1" fill="currentColor"></circle>
              <circle cx="9" cy="6" r="1" fill="currentColor"></circle>
              <circle cx="12" cy="6" r="1" fill="currentColor"></circle>
            </svg>
          </div>
          <h3>{t(locale, 'beautify.content.feat2Title')}</h3>
          <p>{t(locale, 'beautify.content.feat2Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3>{t(locale, 'beautify.content.feat3Title')}</h3>
          <p>{t(locale, 'beautify.content.feat3Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
          </div>
          <h3>{t(locale, 'beautify.content.feat4Title')}</h3>
          <p>{t(locale, 'beautify.content.feat4Desc')}</p>
        </div>
      </div>

      <!-- Section 2 -->
      <h2>{t(locale, 'beautify.content.h2')}</h2>
      <p>{t(locale, 'beautify.content.p2a')}</p>
      <p>{t(locale, 'beautify.content.p2b')}</p>

      <!-- Section 3 -->
      <h2>{t(locale, 'beautify.content.h3')}</h2>
      <p>{t(locale, 'beautify.content.p3a')}</p>
      <p>{t(locale, 'beautify.content.p3b')}</p>

      <!-- Section 4: Comparison Table -->
      <h2>{t(locale, 'beautify.content.h4')}</h2>
      <p>{t(locale, 'beautify.content.p4a')}</p>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Canvas Aspect Ratio</th>
              <th>Optimal Resolution</th>
              <th>Visual Feel</th>
              <th>Best Practical Platforms</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Auto (Fit Padding)</strong></td>
              <td>Dynamic Pixel Scale</td>
              <td>Compact, snug framing</td>
              <td>Technical blog posts, Notion docs, GitHub READMEs, Jira tickets</td>
            </tr>
            <tr>
              <td><strong>16:9 Landscape</strong></td>
              <td>1920 × 1080 px</td>
              <td>Cinematic, wide horizon</td>
              <td>Twitter / X feed cards, LinkedIn carousel headers, YouTube thumbnails</td>
            </tr>
            <tr>
              <td><strong>1:1 Square</strong></td>
              <td>1200 × 1200 px</td>
              <td>Balanced, modern matrix</td>
              <td>Instagram main feed, Product Hunt launch badges, Discord announcements</td>
            </tr>
            <tr>
              <td><strong>4:3 Classic</strong></td>
              <td>1600 × 1200 px</td>
              <td>Editorial, presentation format</td>
              <td>Keynote & PowerPoint pitch decks, tablet previews, investor updates</td>
            </tr>
            <tr>
              <td><strong>9:16 Story / Reel</strong></td>
              <td>1080 × 1920 px</td>
              <td>Full-screen mobile immersive</td>
              <td>Instagram Stories, TikTok videos, YouTube Shorts, mobile app showcases</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 5 -->
      <h2>{t(locale, 'beautify.content.h5')}</h2>
      <p>{t(locale, 'beautify.content.p5a')}</p>
      <p>{t(locale, 'beautify.content.p5b')}</p>

      <!-- Section 6 -->
      <h2>{t(locale, 'beautify.content.h6')}</h2>
      <p>{t(locale, 'beautify.content.p6a')}</p>
      <p>{t(locale, 'beautify.content.p6b')}</p>

      <!-- Section 7: Native OS Guides -->
      <h2>{t(locale, 'beautify.content.h7')}</h2>
      <p>{t(locale, 'beautify.content.p7Intro')}</p>
      <ul>
        <li><strong>macOS:</strong> Press <strong>Cmd + Shift + 4</strong> and tap <strong>Spacebar</strong> to capture a specific application window with native rounded corners and transparent background, or <strong>Cmd + Shift + 5</strong> for interactive area capture.</li>
        <li><strong>Windows 10 / 11:</strong> Press <strong>Win + Shift + S</strong> to trigger the Snipping Tool, select rectangular or window snip, and immediately paste into ImgFeel with <strong>Ctrl + V</strong>.</li>
        <li><strong>iPhone / iPad (iOS):</strong> Press <strong>Side Button + Volume Up</strong> to take a screenshot &rarr; tap the thumbnail to crop or save to Photos.</li>
        <li><strong>Android:</strong> Press <strong>Power + Volume Down</strong> simultaneously, or use quick settings / gesture swipe to capture and upload.</li>
      </ul>

      <!-- Section 8: FAQ -->
      <div class="faq-container">
        <h2>{t(locale, 'beautify.faq.heading')}</h2>
        
        <div class="faq-accordion">
          <details class="faq-item" open>
            <summary class="faq-question"><h3>{t(locale, 'beautify.faq.q1')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'beautify.faq.a1')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'beautify.faq.q2')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'beautify.faq.a2')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'beautify.faq.q3')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'beautify.faq.a3')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'beautify.faq.q4')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'beautify.faq.a4')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'beautify.faq.q5')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'beautify.faq.a5')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'beautify.faq.q6')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'beautify.faq.a6')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'beautify.faq.q7')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'beautify.faq.a7')}</p></div>
          </details>
        </div>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .content-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-12) 0;
  }

  .content-body {
    max-width: var(--container-narrow);
    margin-inline: auto;
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.75;
  }

  .content-body h2 {
    color: var(--color-text);
    font-size: var(--text-xl);
    font-weight: 800;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    letter-spacing: -0.02em;
    line-height: 1.3;
    word-break: break-word;
  }

  @media (min-width: 640px) {
    .content-body h2 {
      font-size: var(--text-2xl);
      margin-top: var(--space-10);
      margin-bottom: var(--space-4);
    }
  }

  .content-body h2:first-child {
    margin-top: 0;
  }

  .content-body p {
    margin-bottom: var(--space-4);
  }

  .content-body ul {
    margin-bottom: var(--space-6);
    padding-left: var(--space-5);
  }

  .content-body li {
    margin-bottom: var(--space-2-5);
  }

  .content-body strong {
    color: var(--color-text);
  }

  .feature-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin: var(--space-6) 0 var(--space-8) 0;
  }

  @media (min-width: 640px) {
    .feature-cards-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .feature-card {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .feature-card-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-card h3 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .feature-card p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .table-responsive {
    overflow-x: auto;
    margin: var(--space-6) 0 var(--space-8) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .data-table th,
  .data-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  .data-table th {
    background: var(--color-surface-subtle);
    font-weight: 700;
    color: var(--color-text);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  /* FAQ */
  .faq-container {
    margin-top: var(--space-12);
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
    overflow: hidden;
  }

  .faq-question {
    padding: var(--space-4);
    cursor: pointer;
    font-weight: 600;
    user-select: none;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question h3 {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: 700;
  }

  .faq-answer {
    padding: 0 var(--space-4) var(--space-4) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .faq-answer p {
    margin: 0;
  }
</style>

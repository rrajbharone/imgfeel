---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div
  class="cm-resizer"
  id="cm-mm-resizer-app"
  data-i18n-dropzone-title={t(locale, 'resizer.dropzone.title')}
  data-i18n-dropzone-subtitle={t(locale, 'resizer.dropzone.subtitle')}
  data-i18n-dropzone-formats={t(locale, 'resizer.dropzone.formats')}
  data-i18n-info-filename={t(locale, 'resizer.info.filename')}
  data-i18n-info-format={t(locale, 'resizer.info.format')}
  data-i18n-info-original-size={t(locale, 'resizer.info.originalSize')}
  data-i18n-info-dimensions={t(locale, 'resizer.info.dimensions')}
  data-i18n-result-title={t(locale, 'resizer.result.title')}
  data-i18n-result-new-dimensions={t(locale, 'resizer.result.newDimensions')}
  data-i18n-result-new-size={t(locale, 'resizer.result.newSize')}
  data-i18n-action-resize={t(locale, 'resizer.action.resize')}
  data-i18n-action-download={t(locale, 'resizer.action.download')}
  data-i18n-action-new-image={t(locale, 'resizer.action.newImage')}
  data-i18n-error-invalid={t(locale, 'resizer.error.invalidFile')}
  data-i18n-error-load={t(locale, 'resizer.error.loadFailed')}
  data-i18n-error-resize={t(locale, 'resizer.error.resizeFailed')}
  data-i18n-status-processing={t(locale, 'resizer.status.processing')}
  data-i18n-status-complete={t(locale, 'resizer.status.complete')}
  data-i18n-calc-label={t(locale, 'cmresizer.calc.label')}
>
  <!-- Upload State -->
  <div class="resizer-upload" id="cm-upload">
    <div class="dropzone" id="cm-dropzone">
      <svg class="dropzone-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <circle cx="8.5" cy="8.5" r="1.5" />
        <path d="m21 15-5-5L5 21" />
      </svg>
      <p class="dropzone-title">{t(locale, 'resizer.dropzone.title')}</p>
      <p class="dropzone-subtitle">{t(locale, 'resizer.dropzone.subtitle')}</p>
      <p class="dropzone-formats">{t(locale, 'resizer.dropzone.formats')}</p>
      <input
        type="file"
        id="cm-file-input"
        accept="image/jpeg,image/png,image/webp"
        class="sr-only"
      />
    </div>
  </div>

  <!-- Editor State (hidden initially) -->
  <div class="resizer-editor" id="cm-editor" hidden>
    <div class="editor-layout">
      <!-- Preview -->
      <div class="preview-area">
        <img id="cm-preview" class="preview-image" alt="" />
        <div class="image-info" id="cm-info"></div>
      </div>

      <!-- Controls -->
      <div class="controls-area">
        <!-- Unit Selector -->
        <div class="control-group">
          <label>{t(locale, 'cmresizer.label.unit')}</label>
          <div class="unit-tabs" role="tablist">
            <button type="button" class="unit-tab active" data-unit="cm" id="unit-cm">{t(locale, 'cmresizer.unit.cm')}</button>
            <button type="button" class="unit-tab" data-unit="mm" id="unit-mm">{t(locale, 'cmresizer.unit.mm')}</button>
          </div>
        </div>

        <!-- Width & Height in CM/MM -->
        <div class="control-group">
          <div class="input-row">
            <div class="input-field">
              <label for="cm-width">{t(locale, 'resizer.label.width')} (<span id="unit-label-w">cm</span>)</label>
              <input type="number" id="cm-width" step="0.1" min="0.1" max="1000" value="10" />
            </div>
            <div class="input-field">
              <label for="cm-height">{t(locale, 'resizer.label.height')} (<span id="unit-label-h">cm</span>)</label>
              <input type="number" id="cm-height" step="0.1" min="0.1" max="1000" value="15" />
            </div>
          </div>
          <label class="checkbox-label">
            <input type="checkbox" id="cm-lock-aspect" checked />
            <span>{t(locale, 'resizer.label.lockAspectRatio')}</span>
          </label>
        </div>

        <!-- DPI/PPI Selection -->
        <div class="control-group">
          <label for="cm-dpi">{t(locale, 'cmresizer.label.dpi')}</label>
          <div class="dpi-input-wrapper">
            <input type="number" id="cm-dpi" min="10" max="2400" value="300" />
            <span class="dpi-unit">DPI</span>
          </div>
          <div class="dpi-presets">
            <button type="button" class="dpi-btn" data-dpi="72">{t(locale, 'cmresizer.preset.dpiWeb')}</button>
            <button type="button" class="dpi-btn" data-dpi="150">{t(locale, 'cmresizer.preset.dpiMedium')}</button>
            <button type="button" class="dpi-btn active" data-dpi="300">{t(locale, 'cmresizer.preset.dpiHigh')}</button>
            <button type="button" class="dpi-btn" data-dpi="600">{t(locale, 'cmresizer.preset.dpiUltra')}</button>
          </div>
        </div>

        <!-- Calculated Pixel Readout -->
        <div class="calc-readout" id="calc-readout">
          <span class="calc-label">{t(locale, 'cmresizer.calc.label')}:</span>
          <span class="calc-value" id="calc-value">1181 × 1772 px</span>
        </div>

        <!-- Quality -->
        <div class="control-group" id="cm-quality-group">
          <label for="cm-quality">{t(locale, 'resizer.label.quality')}: <span id="cm-quality-val">90</span>%</label>
          <input type="range" id="cm-quality" min="10" max="100" value="90" />
        </div>

        <!-- Actions -->
        <div class="actions">
          <button class="btn btn-primary btn-lg action-resize" id="cm-btn-resize">{t(locale, 'resizer.action.resize')}</button>
        </div>
      </div>
    </div>

    <!-- Result -->
    <div class="result-area" id="cm-result" hidden>
      <h3 class="result-title">{t(locale, 'resizer.result.title')}</h3>
      <div class="result-info" id="cm-result-info"></div>
      <div class="result-actions">
        <button class="btn btn-primary" id="cm-btn-download">{t(locale, 'resizer.action.download')}</button>
        <button class="btn btn-secondary" id="cm-btn-new">{t(locale, 'resizer.action.newImage')}</button>
      </div>
    </div>
  </div>

  <!-- Error State -->
  <div class="resizer-error" id="cm-error" hidden>
    <p id="cm-error-msg"></p>
  </div>
</div>

<script src="@/scripts/cm-mm-resizer.ts"></script>

<style>
  .cm-resizer {
    max-width: var(--container-narrow);
    margin-inline: auto;
  }

  [hidden] {
    display: none !important;
  }

  .dropzone {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-10) var(--space-4);
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition: border-color 0.15s, background-color 0.15s;
    text-align: center;
  }
  .dropzone:hover,
  .dropzone.dragging {
    border-color: var(--color-accent);
    background: var(--color-accent-light);
  }
  .dropzone-icon {
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }
  .dropzone-title {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
  }
  .dropzone-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  .dropzone-formats {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }

  .editor-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .preview-area {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .preview-image {
    width: 100%;
    max-height: 400px;
    object-fit: contain;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .image-info {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }
  .image-info :global(.info-label) {
    font-weight: 600;
    color: var(--color-text);
  }

  .controls-area {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .unit-tabs {
    display: flex;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .unit-tab {
    flex: 1;
    padding: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    background: var(--color-bg);
    border: none;
    cursor: pointer;
    min-height: 44px;
    transition: background 0.15s, color 0.15s;
  }
  .unit-tab.active {
    background: var(--color-accent);
    color: #fff;
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .control-group label {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
  }

  .input-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }
  .input-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .input-field input[type="number"] {
    width: 100%;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    min-height: 44px;
    background: var(--color-bg);
  }
  .input-field input[type="number"]:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: -1px;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 400 !important;
    cursor: pointer;
    min-height: 44px;
  }
  .checkbox-label input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: var(--color-accent);
  }

  .dpi-input-wrapper {
    position: relative;
  }
  .dpi-input-wrapper input {
    width: 100%;
    padding: var(--space-3) var(--space-10) var(--space-3) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    min-height: 44px;
  }
  .dpi-unit {
    position: absolute;
    right: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .dpi-presets {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
    margin-top: var(--space-1);
  }
  .dpi-btn {
    padding: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
    min-height: 36px;
    text-align: center;
  }
  .dpi-btn:hover,
  .dpi-btn.active {
    background: var(--color-accent-light);
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .calc-readout {
    padding: var(--space-3) var(--space-4);
    background: var(--color-accent-light);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-sm);
  }
  .calc-label {
    font-weight: 500;
    color: var(--color-text);
  }
  .calc-value {
    font-weight: 700;
    color: var(--color-accent);
  }

  input[type="range"] {
    width: 100%;
    accent-color: var(--color-accent);
    min-height: 44px;
  }

  .actions {
    display: flex;
    gap: var(--space-3);
  }
  .action-resize {
    width: 100%;
  }

  .result-area {
    margin-top: var(--space-6);
    padding: var(--space-5);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }
  .result-title {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }
  .result-info {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }
  .result-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .resizer-error {
    padding: var(--space-4);
    background: var(--color-error-bg);
    border-radius: var(--radius-md);
    color: var(--color-error);
    font-size: var(--text-sm);
    margin-top: var(--space-4);
  }

  @media (min-width: 768px) {
    .editor-layout {
      flex-direction: row;
    }
    .preview-area {
      flex: 1;
      min-width: 0;
    }
    .controls-area {
      width: 300px;
      flex-shrink: 0;
    }
  }
</style>

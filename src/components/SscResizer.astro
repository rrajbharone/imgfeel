---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div id="ssc-resizer-container" class="ssc-card">
  <!-- Exam Disclaimer Banner -->
  <div class="ssc-disclaimer">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
      <line x1="12" y1="9" x2="12" y2="13"></line>
      <line x1="12" y1="17" x2="12.01" y2="17"></line>
    </svg>
    <span>{t(locale, 'sscresizer.disclaimer')}</span>
  </div>

  <!-- Main Mode Tabs: Photo vs Signature -->
  <div class="mode-tabs">
    <button type="button" id="ssc-tab-photo" class="tab-btn active">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span>{t(locale, 'sscresizer.tab.photo')}</span>
    </button>
    <button type="button" id="ssc-tab-sig" class="tab-btn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
      </svg>
      <span>{t(locale, 'sscresizer.tab.signature')}</span>
    </button>
  </div>

  <!-- Hidden File Input -->
  <input type="file" id="ssc-file-input" accept="image/jpeg,image/png,image/webp" class="sr-only" />

  <!-- Preset Selector -->
  <div class="control-group preset-group">
    <label for="ssc-preset-select" class="control-label">{t(locale, 'sscresizer.label.selectPreset')}</label>
    <select
      id="ssc-preset-select"
      class="ssc-select"
      data-photo1-title={t(locale, 'sscresizer.preset.photo1.title')}
      data-photo2-title={t(locale, 'sscresizer.preset.photo2.title')}
      data-sig1-title={t(locale, 'sscresizer.preset.sig1.title')}
      data-sig2-title={t(locale, 'sscresizer.preset.sig2.title')}
      data-custom-title={t(locale, 'sscresizer.preset.custom')}
    >
      <option value="photo-cgl" selected>{t(locale, 'sscresizer.preset.photo1.title')}</option>
      <option value="photo-otr">{t(locale, 'sscresizer.preset.photo2.title')}</option>
      <option value="custom">{t(locale, 'sscresizer.preset.custom')}</option>
    </select>
  </div>

  <!-- Custom Specification Controls (Conditional: Hidden by default) -->
  <div id="ssc-custom-controls" class="custom-panel" hidden>
    <div class="custom-grid">
      <div class="sub-group">
        <label for="ssc-custom-width" class="sub-label">{t(locale, 'sscresizer.label.width')}</label>
        <input type="number" id="ssc-custom-width" value="200" min="10" max="2000" class="ssc-input" />
      </div>
      <div class="sub-group">
        <label for="ssc-custom-height" class="sub-label">{t(locale, 'sscresizer.label.height')}</label>
        <input type="number" id="ssc-custom-height" value="230" min="10" max="2000" class="ssc-input" />
      </div>
      <div class="sub-group">
        <label for="ssc-custom-unit" class="sub-label">{t(locale, 'sscresizer.label.unit')}</label>
        <select id="ssc-custom-unit" class="ssc-select">
          <option value="px" selected>px</option>
          <option value="cm">cm</option>
          <option value="mm">mm</option>
        </select>
      </div>
      <div class="sub-group">
        <label for="ssc-custom-kb" class="sub-label">{t(locale, 'sscresizer.label.targetKb')}</label>
        <input type="number" id="ssc-custom-kb" value="35" min="5" max="500" class="ssc-input" />
      </div>
    </div>
  </div>

  <!-- Upload Dropzone -->
  <div id="ssc-dropzone" class="ssc-dropzone">
    <div class="dropzone-icon">
      <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="17 8 12 3 7 8"></polyline>
        <line x1="12" y1="3" x2="12" y2="15"></line>
      </svg>
    </div>
    <h3 id="ssc-dropzone-title" class="dropzone-title" data-photo-title={t(locale, 'sscresizer.dropzone.photoTitle')} data-sig-title={t(locale, 'sscresizer.dropzone.sigTitle')}>
      {t(locale, 'sscresizer.dropzone.photoTitle')}
    </h3>
    <p class="dropzone-subtitle">{t(locale, 'sscresizer.dropzone.subtitle')}</p>
  </div>

  <!-- Editor Area (Hidden until file is uploaded) -->
  <div id="ssc-editor-area" class="ssc-editor-area" hidden>
    <div class="editor-grid">
      <!-- Live Preview Canvas -->
      <div class="preview-box">
        <div class="canvas-frame">
          <canvas id="ssc-main-canvas" width="200" height="230"></canvas>
        </div>
      </div>

      <!-- Compliance Verification Checklist Card -->
      <div class="validation-card">
        <h4 class="val-card-title">{t(locale, 'sscresizer.validation.title')}</h4>

        <div class="val-row">
          <span class="val-label">{t(locale, 'sscresizer.validation.dim')}:</span>
          <span id="ssc-val-dim-text" class="val-value">200 × 230 px (3.5 × 4.5 cm)</span>
          <span id="ssc-val-dim-status" class="val-badge pass" data-pass={t(locale, 'sscresizer.validation.pass')} data-fail={t(locale, 'sscresizer.validation.fail')}>
            {t(locale, 'sscresizer.validation.pass')}
          </span>
        </div>

        <div class="val-row">
          <span class="val-label">{t(locale, 'sscresizer.validation.size')}:</span>
          <span id="ssc-val-size-text" class="val-value">34.5 KB (20–50 KB)</span>
          <span id="ssc-val-size-status" class="val-badge pass" data-pass={t(locale, 'sscresizer.validation.pass')} data-fail={t(locale, 'sscresizer.validation.fail')}>
            {t(locale, 'sscresizer.validation.pass')}
          </span>
        </div>

        <div class="val-row">
          <span class="val-label">{t(locale, 'sscresizer.validation.format')}:</span>
          <span class="val-value">JPG / JPEG</span>
          <span id="ssc-val-format-status" class="val-badge pass" data-pass={t(locale, 'sscresizer.validation.pass')} data-fail={t(locale, 'sscresizer.validation.fail')}>
            {t(locale, 'sscresizer.validation.pass')}
          </span>
        </div>

        <div class="actions-row">
          <button type="button" id="ssc-download-btn" class="btn btn-primary btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>{t(locale, 'sscresizer.action.download')}</span>
          </button>
          <button type="button" id="ssc-change-img-btn" class="btn btn-secondary">
            {t(locale, 'sscresizer.action.new')}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import '@/scripts/ssc-resizer';
</script>

<style>
  .ssc-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-md);
    max-width: var(--container-narrow);
    margin-inline: auto;
  }

  .ssc-disclaimer {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    margin-bottom: var(--space-6);
  }
  .ssc-disclaimer svg {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .mode-tabs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .tab-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 700;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    transition: all .15s;
  }
  .tab-btn.active {
    background: var(--color-accent-light);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .preset-group {
    margin-bottom: var(--space-6);
  }

  .control-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
    display: block;
  }

  .ssc-select,
  .ssc-input {
    width: 100%;
    padding: var(--space-3);
    font-size: var(--text-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .custom-panel {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .custom-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  @media (min-width: 600px) {
    .custom-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .sub-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-1);
    display: block;
  }

  .ssc-dropzone {
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-12) var(--space-6);
    text-align: center;
    cursor: pointer;
    background: var(--color-surface);
    transition: all .15s;
  }
  .ssc-dropzone:hover,
  .ssc-dropzone.drag-over {
    border-color: var(--color-accent);
    background: var(--color-accent-light);
  }
  .dropzone-icon {
    color: var(--color-accent);
    margin-bottom: var(--space-3);
    display: flex;
    justify-content: center;
  }
  .dropzone-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }
  .dropzone-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 650px) {
    .editor-grid {
      grid-template-columns: 220px 1fr;
    }
  }

  .preview-box {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .canvas-frame {
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    background: #fff;
  }

  .canvas-frame canvas {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .validation-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .val-card-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-2);
  }

  .val-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-sm);
    gap: var(--space-2);
  }

  .val-label {
    font-weight: 600;
    color: var(--color-text);
  }

  .val-value {
    color: var(--color-text-secondary);
  }

  .val-badge {
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }
  .val-badge.pass {
    background: #dcfce7;
    color: #166534;
  }
  .val-badge.fail {
    background: #fee2e2;
    color: #991b1b;
  }

  .actions-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  @media (min-width: 500px) {
    .actions-row {
      flex-direction: row;
    }
  }
</style>

---
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';
import { getToolUrl } from '@/data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const bannerUrl = getToolUrl('youtube-banner-resizer', locale);
const ytThumbUrl = getToolUrl('youtube-thumbnail-resizer', locale);
const squareUrl = getToolUrl('resize-image-to-1-1', locale);
const circleUrl = getToolUrl('circle-image-cropper', locale);
const blurUrl = getToolUrl('image-blur-tool', locale);
const noiseReducerUrl = getToolUrl('image-noise-reducer', locale);
---

<div class="fb-app-container" id="fbApp" data-locale={locale} data-i18n={JSON.stringify({
  copiedSuccess: t(locale, 'fbcover.action.copied'),
})}>
  <!-- State 1: Upload Dropzone Card -->
  <div class="fb-dropzone-card" id="fbDropzone">
    <div class="dropzone-inner">
      <div class="dropzone-icon-ring">
        <svg width="38" height="38" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
        </svg>
      </div>

      <h2 class="dropzone-headline">{t(locale, 'fbcover.dropzone.title')}</h2>
      <p class="dropzone-subheadline">{t(locale, 'fbcover.dropzone.subtitle')}</p>

      <div class="dropzone-action-group">
        <label for="fbFileInput" class="btn btn-primary dropzone-browse-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'fbcover.dropzone.browse')}</span>
        </label>
        <input type="file" id="fbFileInput" accept="image/jpeg,image/png,image/webp,image/avif,image/bmp" class="visually-hidden" />

        <button type="button" class="btn btn-secondary sample-demo-btn" id="fbSampleBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span>{t(locale, 'fbcover.dropzone.sample')}</span>
        </button>
      </div>

      <div class="dropzone-badges-row">
        <span class="badge-pill">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          820×312 • 1640×720 Retina • Safe Zone
        </span>
        <span class="badge-pill badge-pill-green">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          {t(locale, 'fbcover.privacy.badge')}
        </span>
      </div>
    </div>
  </div>

  <!-- Loading State Card -->
  <div class="fb-loading-card" id="fbLoadingCard" style="display: none;">
    <div class="loading-spinner"></div>
    <p class="loading-text">{t(locale, 'fbcover.status.processing')}</p>
  </div>

  <!-- State 2: Active Workspace -->
  <div class="fb-workspace-card" id="fbWorkspace" style="display: none;">
    <!-- Workspace Top Header Bar -->
    <div class="workspace-header-bar">
      <div class="image-meta-info">
        <span class="file-name-tag" id="fbFileName">cover.jpg</span>
        <span class="file-dim-pill" id="fbOriginalDimsTag">-- × -- px</span>
        <span class="file-size-pill" id="fbOriginalSizeTag">-- KB</span>
      </div>

      <div class="workspace-header-actions">
        <button type="button" class="btn btn-secondary btn-sm change-image-btn" id="fbChangeImageBtn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'fbcover.action.changeImage')}</span>
        </button>
      </div>
    </div>

    <!-- 2-Column Responsive Layout -->
    <div class="fb-main-grid">
      <!-- Left Column: Interactive Master Canvas & Live Previews -->
      <div class="fb-preview-column">
        <!-- Interactive Banner Canvas Box with Dual Safe-Zone Overlay -->
        <div class="canvas-viewport-box" id="fbCanvasViewport">
          <canvas id="fbMainCanvas" class="fb-master-canvas"></canvas>
          
          <!-- Dual Safe Zone Overlay Lines -->
          <div class="safe-zone-overlay-frame" id="fbSafeZoneOverlay">
            <div class="sz-desktop-crop-top"></div>
            <div class="sz-desktop-crop-bottom"></div>
            <div class="sz-mobile-crop-left"></div>
            <div class="sz-mobile-crop-right"></div>
            <div class="sz-central-box">
              <span class="sz-badge-label">SAFE ZONE (820 × 312)</span>
            </div>
          </div>

          <span class="safe-zone-hint-badge" id="fbSafeZoneHint">
            {t(locale, 'fbcover.safeZoneTip')}
          </span>
        </div>

        <!-- Safe Zone Toggle Checkbox Row -->
        <div class="safezone-toggle-bar">
          <label class="toggle-checkbox-label">
            <input type="checkbox" id="fbSafeZoneCheckbox" checked class="fb-checkbox" />
            <span>{t(locale, 'fbcover.safeZoneToggle')}</span>
          </label>
        </div>

        <!-- Live Simulated Facebook Previews Strip -->
        <div class="live-previews-panel">
          <!-- Desktop Page View Mockup -->
          <div class="preview-item desktop-card-mockup">
            <span class="preview-title-tag">{t(locale, 'fbcover.preview.desktop')}</span>
            <div class="fb-desktop-card">
              <div class="fb-card-thumb-frame">
                <canvas id="fbDesktopThumbCanvas" width="320" height="122"></canvas>
              </div>
              <div class="fb-desktop-profile-strip">
                <div class="fb-profile-avatar-circle"></div>
                <div class="fb-desktop-info">
                  <strong class="fb-profile-name">{t(locale, 'fbcover.mockup.pageName')}</strong>
                  <span class="fb-profile-sub">{t(locale, 'fbcover.mockup.category')}</span>
                </div>
                <div class="fb-desktop-btns">
                  <span class="fb-mock-btn-blue">{t(locale, 'fbcover.mockup.follow')}</span>
                  <span class="fb-mock-btn-gray">{t(locale, 'fbcover.mockup.message')}</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Mobile App View Mockup -->
          <div class="preview-item mobile-feed-mockup">
            <span class="preview-title-tag">{t(locale, 'fbcover.preview.mobile')}</span>
            <div class="fb-mobile-card">
              <div class="fb-mobile-thumb-frame">
                <canvas id="fbMobileThumbCanvas" width="200" height="112"></canvas>
              </div>
              <div class="fb-mobile-profile-strip">
                <div class="fb-mobile-avatar"></div>
                <strong class="fb-mobile-name">{t(locale, 'fbcover.mockup.pageName')}</strong>
                <span class="fb-mobile-sub">{t(locale, 'fbcover.mockup.category')}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Primary Action Buttons Row -->
        <div class="fb-action-buttons-grid">
          <button type="button" class="btn btn-primary fb-download-btn" id="fbDownloadBtn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>{t(locale, 'fbcover.action.download')}</span>
          </button>

          <button type="button" class="btn btn-secondary fb-copy-btn" id="fbCopyBtn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="fbCopyBtnText">{t(locale, 'fbcover.action.copyImage')}</span>
          </button>

          <button type="button" class="btn btn-secondary fb-reset-btn" id="fbResetBtn" title={t(locale, 'fbcover.action.reset')}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
              <path d="M3 3v5h5"></path>
            </svg>
            <span>{t(locale, 'fbcover.action.reset')}</span>
          </button>
        </div>
      </div>

      <!-- Right Column: Settings & Controls Panel -->
      <div class="fb-controls-panel">
        <!-- Section 1: Quick Framing Presets -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'fbcover.section.presets')}</label>
          <div class="preset-chips-grid">
            <button type="button" class="preset-chip-btn active" data-preset="fullBlur">
              <strong>{t(locale, 'fbcover.preset.fullBlur')}</strong>
              <span>{t(locale, 'fbcover.preset.fullBlurDesc')}</span>
            </button>

            <button type="button" class="preset-chip-btn" data-preset="coverCrop">
              <strong>{t(locale, 'fbcover.preset.coverCrop')}</strong>
              <span>{t(locale, 'fbcover.preset.coverCropDesc')}</span>
            </button>

            <button type="button" class="preset-chip-btn" data-preset="cleanWhite">
              <strong>{t(locale, 'fbcover.preset.cleanWhite')}</strong>
              <span>{t(locale, 'fbcover.preset.cleanWhiteDesc')}</span>
            </button>

            <button type="button" class="preset-chip-btn" data-preset="facebookBlue">
              <strong>{t(locale, 'fbcover.preset.facebookBlue')}</strong>
              <span>{t(locale, 'fbcover.preset.facebookBlueDesc')}</span>
            </button>

            <button type="button" class="preset-chip-btn" data-preset="darkStudio">
              <strong>{t(locale, 'fbcover.preset.darkStudio')}</strong>
              <span>{t(locale, 'fbcover.preset.darkStudioDesc')}</span>
            </button>
          </div>
        </div>

        <!-- Section 2: Mode Switcher -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'fbcover.section.framing')}</label>
          <div class="segmented-mode-bar">
            <button type="button" class="seg-btn active" data-mode="fit">
              {t(locale, 'fbcover.mode.fit')}
            </button>
            <button type="button" class="seg-btn" data-mode="fill">
              {t(locale, 'fbcover.mode.fill')}
            </button>
          </div>
        </div>

        <!-- Section 3: Background Style (Fit Mode) -->
        <div class="control-group" id="fbBgSection">
          <label class="control-label">{t(locale, 'fbcover.section.bg')}</label>
          <div class="segmented-mode-bar">
            <button type="button" class="seg-bg-btn active" data-bg="blur">
              {t(locale, 'fbcover.bg.blur')}
            </button>
            <button type="button" class="seg-bg-btn" data-bg="solid">
              {t(locale, 'fbcover.bg.solid')}
            </button>
          </div>

          <!-- Blur controls -->
          <div id="fbBlurControlsBox" class="sub-controls-box">
            <div class="slider-header-row">
              <label for="fbBlurSlider" class="sub-label">{t(locale, 'fbcover.label.blurStrength')}</label>
              <span class="val-pill" id="fbBlurValPill">25 px</span>
            </div>
            <input type="range" id="fbBlurSlider" min="5" max="50" value="25" step="1" class="fb-range" />

            <div class="slider-header-row" style="margin-top: 6px;">
              <label for="fbBgDimSlider" class="sub-label">{t(locale, 'fbcover.label.bgDim')}</label>
              <span class="val-pill" id="fbBgDimValPill">15%</span>
            </div>
            <input type="range" id="fbBgDimSlider" min="0" max="50" value="15" step="1" class="fb-range" />
          </div>

          <!-- Solid color swatches -->
          <div id="fbColorControlsBox" class="sub-controls-box" style="display: none;">
            <label class="sub-label">{t(locale, 'fbcover.bg.color')}</label>
            <div class="color-swatches-grid">
              <button type="button" class="color-swatch-btn" data-color="#ffffff" style="background:#ffffff" title="Pure White"></button>
              <button type="button" class="color-swatch-btn active" data-color="#1877F2" style="background:#1877F2" title="Facebook Blue"></button>
              <button type="button" class="color-swatch-btn" data-color="#0f172a" style="background:#0f172a" title="Midnight Slate"></button>
              <button type="button" class="color-swatch-btn" data-color="#1e1b4b" style="background:#1e1b4b" title="Royal Navy"></button>
              <button type="button" class="color-swatch-btn" data-color="#000000" style="background:#000000" title="Deep Black"></button>
              <input type="color" id="fbCustomColorPicker" value="#1877F2" class="custom-color-input" title="Custom color picker" />
            </div>
          </div>
        </div>

        <!-- Section 4: Zoom & Quick Transforms -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'fbcover.section.adjust')}</label>
          
          <div class="slider-header-row">
            <label for="fbZoomSlider" class="sub-label">{t(locale, 'fbcover.label.zoom')}</label>
            <span class="val-pill" id="fbZoomValPill">1.00×</span>
          </div>
          <input type="range" id="fbZoomSlider" min="0.5" max="3.0" step="0.05" value="1.0" class="fb-range" />

          <div class="transform-buttons-row">
            <button type="button" class="btn btn-secondary btn-sm transform-btn" id="fbRotateBtn" title="Rotate 90° Clockwise">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
              <span>{t(locale, 'fbcover.action.rotate')}</span>
            </button>

            <button type="button" class="btn btn-secondary btn-sm transform-btn" id="fbFlipBtn" title="Flip Horizontal">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 3 21 3 21 8"></polyline><line x1="4" y1="20" x2="21" y2="3"></line><polyline points="21 16 21 21 16 21"></polyline><line x1="15" y1="15" x2="21" y2="21"></line><line x1="4" y1="4" x2="9" y2="9"></line></svg>
              <span>{t(locale, 'fbcover.action.flip')}</span>
            </button>

            <button type="button" class="btn btn-secondary btn-sm transform-btn" id="fbCenterBtn" title="Reset Center">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
              <span>{t(locale, 'fbcover.action.center')}</span>
            </button>
          </div>
        </div>

        <!-- Section 5: Cover Target Selector -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'fbcover.section.coverType')}</label>
          <div class="resolution-pills-grid">
            <button type="button" class="res-pill-btn active" data-type="pageMaster" data-w="1640" data-h="720">
              <strong>1640 × 720 px</strong>
              <span>{t(locale, 'fbcover.type.pageMaster')}</span>
            </button>
            <button type="button" class="res-pill-btn" data-type="desktopStandard" data-w="820" data-h="312">
              <strong>820 × 312 px</strong>
              <span>{t(locale, 'fbcover.type.desktopStandard')}</span>
            </button>
            <button type="button" class="res-pill-btn" data-type="groupCover" data-w="1640" data-h="856">
              <strong>1640 × 856 px</strong>
              <span>{t(locale, 'fbcover.type.groupCover')}</span>
            </button>
            <button type="button" class="res-pill-btn" data-type="eventCover" data-w="1200" data-h="628">
              <strong>1200 × 628 px</strong>
              <span>{t(locale, 'fbcover.type.eventCover')}</span>
            </button>
          </div>
        </div>

        <!-- Section 6: Export Format & Quality -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'fbcover.section.export')}</label>
          <div class="select-field">
            <label for="fbExportFormatSelect" class="sub-label">{t(locale, 'fbcover.export.format')}</label>
            <select id="fbExportFormatSelect" class="fb-select">
              <option value="image/png" selected>PNG (Lossless — Best for Graphics & Text)</option>
              <option value="image/jpeg">JPG / JPEG (Compact File Size)</option>
              <option value="image/webp">WebP (Modern High-Efficiency)</option>
            </select>
          </div>

          <div class="quality-field" id="fbQualityFieldBox" style="display: none;">
            <div class="slider-header-row">
              <label for="fbExportQualitySlider" class="sub-label">{t(locale, 'fbcover.export.quality')}</label>
              <span class="val-pill" id="fbQualityValPill">95%</span>
            </div>
            <input type="range" id="fbExportQualitySlider" min="10" max="100" value="95" step="1" class="fb-range" />
          </div>

          <!-- Real-Time Estimated Size Badge -->
          <div class="size-estimate-box">
            <span class="estimate-label">{t(locale, 'fbcover.size.estimate')}:</span>
            <span class="estimate-pill" id="fbSizeEstimatePill">~350 KB</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Cross Navigation Links -->
    <div class="fb-cross-links-row">
      <a href={ytThumbUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
        <span>{t(locale, 'fbcover.cross.ytThumb')}</span>
      </a>

      <a href={bannerUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
        <span>{t(locale, 'fbcover.cross.banner')}</span>
      </a>

      <a href={squareUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect></svg>
        <span>{t(locale, 'fbcover.cross.square')}</span>
      </a>

      <a href={circleUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle></svg>
        <span>{t(locale, 'fbcover.cross.circle')}</span>
      </a>

      <a href={blurUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" stroke-dasharray="2 3"></circle></svg>
        <span>{t(locale, 'fbcover.cross.blur')}</span>
      </a>

      <a href={noiseReducerUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path><circle cx="12" cy="12" r="3"></circle></svg>
        <span>{t(locale, 'fbcover.cross.noiseReducer')}</span>
      </a>
    </div>
  </div>
</div>

<script>
  import {
    loadFacebookCoverFromFile,
    renderFacebookCoverCanvas,
    renderFacebookCoverPreview,
    generateSampleFacebookCover,
    exportFacebookCover,
    copyFacebookCoverToClipboard,
    DEFAULT_FB_COVER_OPTIONS,
    FB_COVER_PRESETS,
    type FacebookCoverOptions,
    type LoadedCoverInfo,
  } from '@/scripts/facebook-cover-resizer';

  function initFacebookCoverResizer() {
    const appEl = document.getElementById('fbApp');
    if (!appEl) return;

    const i18n = appEl.dataset.i18n ? JSON.parse(appEl.dataset.i18n) : {};

    // State
    let loadedImageObj: LoadedCoverInfo | null = null;
    let fbOptions: FacebookCoverOptions = { ...DEFAULT_FB_COVER_OPTIONS };
    let exportFormat: 'image/png' | 'image/jpeg' | 'image/webp' = 'image/png';
    let exportQuality: number = 0.95;

    // Dragging State
    let isDraggingCanvas = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let initOffsetX = 0;
    let initOffsetY = 0;

    // DOM Elements
    const dropzone = document.getElementById('fbDropzone') as HTMLElement;
    const fileInput = document.getElementById('fbFileInput') as HTMLInputElement;
    const sampleBtn = document.getElementById('fbSampleBtn') as HTMLButtonElement;
    const loadingCard = document.getElementById('fbLoadingCard') as HTMLElement;
    const workspace = document.getElementById('fbWorkspace') as HTMLElement;

    const fileNameEl = document.getElementById('fbFileName') as HTMLElement;
    const origDimsTag = document.getElementById('fbOriginalDimsTag') as HTMLElement;
    const origSizeTag = document.getElementById('fbOriginalSizeTag') as HTMLElement;
    const changeImageBtn = document.getElementById('fbChangeImageBtn') as HTMLButtonElement;

    const canvasViewport = document.getElementById('fbCanvasViewport') as HTMLElement;
    const mainCanvas = document.getElementById('fbMainCanvas') as HTMLCanvasElement;
    const safeZoneOverlay = document.getElementById('fbSafeZoneOverlay') as HTMLElement;
    const safeZoneHint = document.getElementById('fbSafeZoneHint') as HTMLElement;
    const safeZoneCheckbox = document.getElementById('fbSafeZoneCheckbox') as HTMLInputElement;

    const desktopThumbCanvas = document.getElementById('fbDesktopThumbCanvas') as HTMLCanvasElement;
    const mobileThumbCanvas = document.getElementById('fbMobileThumbCanvas') as HTMLCanvasElement;

    const presetBtns = document.querySelectorAll('.preset-chip-btn') as NodeListOf<HTMLButtonElement>;
    const modeBtns = document.querySelectorAll('.seg-btn') as NodeListOf<HTMLButtonElement>;
    const bgSection = document.getElementById('fbBgSection') as HTMLElement;
    const segBgBtns = document.querySelectorAll('.seg-bg-btn') as NodeListOf<HTMLButtonElement>;

    const blurControlsBox = document.getElementById('fbBlurControlsBox') as HTMLElement;
    const colorControlsBox = document.getElementById('fbColorControlsBox') as HTMLElement;

    const blurSlider = document.getElementById('fbBlurSlider') as HTMLInputElement;
    const blurValPill = document.getElementById('fbBlurValPill') as HTMLElement;
    const bgDimSlider = document.getElementById('fbBgDimSlider') as HTMLInputElement;
    const bgDimValPill = document.getElementById('fbBgDimValPill') as HTMLElement;

    const colorSwatches = document.querySelectorAll('.color-swatch-btn') as NodeListOf<HTMLButtonElement>;
    const customColorPicker = document.getElementById('fbCustomColorPicker') as HTMLInputElement;

    const zoomSlider = document.getElementById('fbZoomSlider') as HTMLInputElement;
    const zoomValPill = document.getElementById('fbZoomValPill') as HTMLElement;

    const rotateBtn = document.getElementById('fbRotateBtn') as HTMLButtonElement;
    const flipBtn = document.getElementById('fbFlipBtn') as HTMLButtonElement;
    const centerBtn = document.getElementById('fbCenterBtn') as HTMLButtonElement;

    const resPillBtns = document.querySelectorAll('.res-pill-btn') as NodeListOf<HTMLButtonElement>;

    const exportFormatSelect = document.getElementById('fbExportFormatSelect') as HTMLSelectElement;
    const qualityFieldBox = document.getElementById('fbQualityFieldBox') as HTMLElement;
    const exportQualitySlider = document.getElementById('fbExportQualitySlider') as HTMLInputElement;
    const qualityValPill = document.getElementById('fbQualityValPill') as HTMLElement;

    const sizeEstimatePill = document.getElementById('fbSizeEstimatePill') as HTMLElement;

    const downloadBtn = document.getElementById('fbDownloadBtn') as HTMLButtonElement;
    const copyBtn = document.getElementById('fbCopyBtn') as HTMLButtonElement;
    const copyBtnText = document.getElementById('fbCopyBtnText') as HTMLElement;
    const resetBtn = document.getElementById('fbResetBtn') as HTMLButtonElement;

    function render() {
      if (!loadedImageObj || !mainCanvas) return;

      const rendered = renderFacebookCoverCanvas(
        loadedImageObj.img,
        fbOptions,
        fbOptions.targetWidth,
        fbOptions.targetHeight
      );

      mainCanvas.width = rendered.width;
      mainCanvas.height = rendered.height;

      const ctx = mainCanvas.getContext('2d');
      if (ctx) {
        ctx.drawImage(rendered, 0, 0);
      }

      if (desktopThumbCanvas) {
        renderFacebookCoverPreview(rendered, desktopThumbCanvas, 'desktopCrop');
      }
      if (mobileThumbCanvas) {
        renderFacebookCoverPreview(rendered, mobileThumbCanvas, 'mobileCrop');
      }

      updateEstimatedSize(rendered);
    }

    function updateEstimatedSize(canvas: HTMLCanvasElement) {
      if (!sizeEstimatePill) return;

      try {
        const dataUrl = canvas.toDataURL(exportFormat, exportFormat === 'image/png' ? undefined : exportQuality);
        const approxBytes = Math.round((dataUrl.length - dataUrl.indexOf(',') - 1) * 0.75);
        const approxKB = Math.round(approxBytes / 1024);

        if (approxKB > 1024) {
          sizeEstimatePill.textContent = `${(approxKB / 1024).toFixed(2)} MB`;
        } else {
          sizeEstimatePill.textContent = `${approxKB} KB`;
        }
      } catch (e) {
        // ignore
      }
    }

    function triggerUpdate() {
      render();
    }

    async function loadFile(file: File) {
      if (!dropzone || !loadingCard || !workspace) return;

      dropzone.style.display = 'none';
      workspace.style.display = 'none';
      loadingCard.style.display = 'flex';

      try {
        loadedImageObj = await loadFacebookCoverFromFile(file);
        fbOptions = { ...DEFAULT_FB_COVER_OPTIONS };

        if (fileNameEl) fileNameEl.textContent = loadedImageObj.name;
        if (origDimsTag) origDimsTag.textContent = `${loadedImageObj.originalWidth} × ${loadedImageObj.originalHeight} px`;
        if (origSizeTag) origSizeTag.textContent = `${(loadedImageObj.fileSize / 1024).toFixed(1)} KB`;

        syncControlsToState();
        render();

        loadingCard.style.display = 'none';
        workspace.style.display = 'block';
      } catch (err) {
        alert(err instanceof Error ? err.message : 'Failed to load image');
        resetToDropzone();
      }
    }

    function resetToDropzone() {
      loadedImageObj = null;
      if (fileInput) fileInput.value = '';
      if (loadingCard) loadingCard.style.display = 'none';
      if (workspace) workspace.style.display = 'none';
      if (dropzone) dropzone.style.display = 'block';
    }

    function syncControlsToState() {
      modeBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-mode') === fbOptions.mode));
      if (bgSection) bgSection.style.display = fbOptions.mode === 'fit' ? 'flex' : 'none';

      segBgBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-bg') === fbOptions.bgType));
      if (blurControlsBox) blurControlsBox.style.display = fbOptions.bgType === 'blur' ? 'block' : 'none';
      if (colorControlsBox) colorControlsBox.style.display = fbOptions.bgType === 'solid' ? 'block' : 'none';

      if (blurSlider) blurSlider.value = String(fbOptions.blurStrength);
      if (blurValPill) blurValPill.textContent = `${fbOptions.blurStrength} px`;

      if (bgDimSlider) bgDimSlider.value = String(fbOptions.bgDim);
      if (bgDimValPill) bgDimValPill.textContent = `${fbOptions.bgDim}%`;

      if (zoomSlider) zoomSlider.value = String(fbOptions.zoom);
      if (zoomValPill) zoomValPill.textContent = `${fbOptions.zoom.toFixed(2)}×`;

      resPillBtns.forEach((b) => {
        const w = parseInt(b.getAttribute('data-w') || '1640', 10);
        b.classList.toggle('active', w === fbOptions.targetWidth);
      });

      if (safeZoneCheckbox) safeZoneCheckbox.checked = fbOptions.showSafeZone;
      if (safeZoneOverlay) safeZoneOverlay.style.display = fbOptions.showSafeZone ? 'block' : 'none';
      if (safeZoneHint) safeZoneHint.style.display = fbOptions.showSafeZone ? 'block' : 'none';
    }

    if (changeImageBtn) changeImageBtn.addEventListener('click', resetToDropzone);

    // Canvas Drag / Pan Handling
    function handleDragStart(clientX: number, clientY: number) {
      if (!loadedImageObj) return;
      isDraggingCanvas = true;
      dragStartX = clientX;
      dragStartY = clientY;
      initOffsetX = fbOptions.offsetX;
      initOffsetY = fbOptions.offsetY;
    }

    function handleDragMove(clientX: number, clientY: number) {
      if (!isDraggingCanvas || !loadedImageObj || !mainCanvas) return;
      const rect = mainCanvas.getBoundingClientRect();
      const deltaX = (clientX - dragStartX) / (rect.width / 2);
      const deltaY = (clientY - dragStartY) / (rect.height / 2);

      fbOptions.offsetX = Math.max(-1.5, Math.min(1.5, initOffsetX + deltaX));
      fbOptions.offsetY = Math.max(-1.5, Math.min(1.5, initOffsetY + deltaY));
      triggerUpdate();
    }

    function handleDragEnd() {
      isDraggingCanvas = false;
    }

    if (canvasViewport) {
      canvasViewport.addEventListener('mousedown', (e) => {
        e.preventDefault();
        handleDragStart(e.clientX, e.clientY);
      });

      window.addEventListener('mousemove', (e) => {
        if (isDraggingCanvas) {
          handleDragMove(e.clientX, e.clientY);
        }
      });

      window.addEventListener('mouseup', handleDragEnd);

      // Touch events for mobile
      canvasViewport.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          handleDragStart(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: true });

      canvasViewport.addEventListener('touchmove', (e) => {
        if (isDraggingCanvas && e.touches.length === 1) {
          handleDragMove(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: true });

      canvasViewport.addEventListener('touchend', handleDragEnd);

      // Mouse wheel zoom
      canvasViewport.addEventListener('wheel', (e) => {
        e.preventDefault();
        const zoomDelta = e.deltaY < 0 ? 0.05 : -0.05;
        fbOptions.zoom = Math.max(0.5, Math.min(3.0, fbOptions.zoom + zoomDelta));
        if (zoomSlider) zoomSlider.value = String(fbOptions.zoom);
        if (zoomValPill) zoomValPill.textContent = `${fbOptions.zoom.toFixed(2)}×`;
        triggerUpdate();
      }, { passive: false });
    }

    // Safe Zone Checkbox
    if (safeZoneCheckbox) {
      safeZoneCheckbox.addEventListener('change', () => {
        fbOptions.showSafeZone = safeZoneCheckbox.checked;
        if (safeZoneOverlay) safeZoneOverlay.style.display = fbOptions.showSafeZone ? 'block' : 'none';
        if (safeZoneHint) safeZoneHint.style.display = fbOptions.showSafeZone ? 'block' : 'none';
      });
    }

    // Presets
    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        presetBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const presetKey = btn.getAttribute('data-preset') || 'fullBlur';
        const config = FB_COVER_PRESETS[presetKey];
        if (config) {
          fbOptions = { ...fbOptions, ...config };
          syncControlsToState();
          triggerUpdate();
        }
      });
    });

    // Mode Switcher
    modeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        modeBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        fbOptions.mode = (btn.getAttribute('data-mode') as any) || 'fit';
        if (bgSection) bgSection.style.display = fbOptions.mode === 'fit' ? 'flex' : 'none';
        triggerUpdate();
      });
    });

    // Background Style Switcher
    segBgBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        segBgBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        fbOptions.bgType = (btn.getAttribute('data-bg') as any) || 'blur';
        if (blurControlsBox) blurControlsBox.style.display = fbOptions.bgType === 'blur' ? 'block' : 'none';
        if (colorControlsBox) colorControlsBox.style.display = fbOptions.bgType === 'solid' ? 'block' : 'none';
        triggerUpdate();
      });
    });

    // Sliders
    if (blurSlider) {
      blurSlider.addEventListener('input', () => {
        fbOptions.blurStrength = parseInt(blurSlider.value, 10);
        if (blurValPill) blurValPill.textContent = `${fbOptions.blurStrength} px`;
        triggerUpdate();
      });
    }

    if (bgDimSlider) {
      bgDimSlider.addEventListener('input', () => {
        fbOptions.bgDim = parseInt(bgDimSlider.value, 10);
        if (bgDimValPill) bgDimValPill.textContent = `${fbOptions.bgDim}%`;
        triggerUpdate();
      });
    }

    if (zoomSlider) {
      zoomSlider.addEventListener('input', () => {
        fbOptions.zoom = parseFloat(zoomSlider.value);
        if (zoomValPill) zoomValPill.textContent = `${fbOptions.zoom.toFixed(2)}×`;
        triggerUpdate();
      });
    }

    // Color Swatches
    colorSwatches.forEach((btn) => {
      btn.addEventListener('click', () => {
        colorSwatches.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        fbOptions.bgColor = btn.getAttribute('data-color') || '#1877F2';
        if (customColorPicker) customColorPicker.value = fbOptions.bgColor;
        triggerUpdate();
      });
    });

    if (customColorPicker) {
      customColorPicker.addEventListener('input', () => {
        fbOptions.bgColor = customColorPicker.value;
        colorSwatches.forEach((b) => b.classList.remove('active'));
        triggerUpdate();
      });
    }

    // Transform Actions
    if (rotateBtn) {
      rotateBtn.addEventListener('click', () => {
        fbOptions.rotation = (fbOptions.rotation + 90) % 360;
        triggerUpdate();
      });
    }

    if (flipBtn) {
      flipBtn.addEventListener('click', () => {
        fbOptions.flipH = !fbOptions.flipH;
        triggerUpdate();
      });
    }

    if (centerBtn) {
      centerBtn.addEventListener('click', () => {
        fbOptions.offsetX = 0;
        fbOptions.offsetY = 0;
        fbOptions.zoom = 1.0;
        if (zoomSlider) zoomSlider.value = '1.0';
        if (zoomValPill) zoomValPill.textContent = '1.00×';
        triggerUpdate();
      });
    }

    // Resolution / Cover Type Pills
    resPillBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        resPillBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        fbOptions.coverType = (btn.getAttribute('data-type') as any) || 'pageMaster';
        fbOptions.targetWidth = parseInt(btn.getAttribute('data-w') || '1640', 10);
        fbOptions.targetHeight = parseInt(btn.getAttribute('data-h') || '720', 10);
        triggerUpdate();
      });
    });

    // Export Settings
    if (exportFormatSelect) {
      exportFormatSelect.addEventListener('change', () => {
        exportFormat = exportFormatSelect.value as any;
        if (qualityFieldBox) {
          qualityFieldBox.style.display = exportFormat === 'image/png' ? 'none' : 'block';
        }
        triggerUpdate();
      });
    }

    if (exportQualitySlider) {
      exportQualitySlider.addEventListener('input', () => {
        const q = parseInt(exportQualitySlider.value, 10);
        exportQuality = q / 100;
        if (qualityValPill) qualityValPill.textContent = `${q}%`;
        triggerUpdate();
      });
    }

    // Reset Button
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        fbOptions = { ...DEFAULT_FB_COVER_OPTIONS };
        presetBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-preset') === 'fullBlur'));
        syncControlsToState();
        triggerUpdate();
      });
    }

    // Download Action
    if (downloadBtn) {
      downloadBtn.addEventListener('click', () => {
        if (!loadedImageObj) return;

        const baseName = loadedImageObj.name.replace(/\.[^/.]+$/, '');
        const fullCanvas = renderFacebookCoverCanvas(
          loadedImageObj.img,
          fbOptions,
          fbOptions.targetWidth,
          fbOptions.targetHeight
        );
        exportFacebookCover(fullCanvas, exportFormat, exportQuality, `${baseName}-facebook-cover`);
      });
    }

    // Copy to Clipboard Action
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        if (!loadedImageObj) return;
        try {
          const fullCanvas = renderFacebookCoverCanvas(
            loadedImageObj.img,
            fbOptions,
            fbOptions.targetWidth,
            fbOptions.targetHeight
          );
          const success = await copyFacebookCoverToClipboard(fullCanvas);
          if (success) {
            if (copyBtnText) copyBtnText.textContent = i18n.copiedSuccess || 'Cover Copied!';
            copyBtn.classList.add('btn-success');
            setTimeout(() => {
              if (copyBtnText) copyBtnText.textContent = 'Copy Image';
              copyBtn.classList.remove('btn-success');
            }, 2000);
          } else {
            alert('Clipboard copy is not supported in this browser.');
          }
        } catch (err) {
          alert('Could not copy cover to clipboard.');
        }
      });
    }

    // File Upload Handlers
    if (fileInput) {
      fileInput.addEventListener('change', (e) => {
        const files = (e.target as HTMLInputElement).files;
        if (files && files[0]) loadFile(files[0]);
      });
    }

    if (sampleBtn) {
      sampleBtn.addEventListener('click', async () => {
        showLoading(true);
        try {
          loadedImageObj = await generateSampleFacebookCover();
          fbOptions = { ...DEFAULT_FB_COVER_OPTIONS };

          if (fileNameEl) fileNameEl.textContent = loadedImageObj.name;
          if (origDimsTag) origDimsTag.textContent = `${loadedImageObj.originalWidth} × ${loadedImageObj.originalHeight} px`;
          if (origSizeTag) origSizeTag.textContent = `${(loadedImageObj.fileSize / 1024).toFixed(1)} KB`;

          syncControlsToState();
          render();

          loadingCard.style.display = 'none';
          dropzone.style.display = 'none';
          workspace.style.display = 'block';
        } catch (err) {
          showLoading(false);
        }
      });
    }

    function showLoading(show: boolean) {
      if (show) {
        loadingCard.style.display = 'flex';
        workspace.style.display = 'none';
        dropzone.style.display = 'none';
      } else {
        loadingCard.style.display = 'none';
      }
    }

    // Drag & Drop
    if (dropzone) {
      ['dragenter', 'dragover'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          dropzone.classList.add('dragover');
        });
      });
      ['dragleave', 'drop'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          dropzone.classList.remove('dragover');
        });
      });
      dropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        if (dt?.files?.[0]) loadFile(dt.files[0]);
      });
    }

    // Global Clipboard Paste
    window.addEventListener('paste', (e) => {
      const items = e.clipboardData?.items;
      if (!items) return;
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.startsWith('image/')) {
          const file = items[i].getAsFile();
          if (file) loadFile(file);
          break;
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFacebookCoverResizer);
  } else {
    initFacebookCoverResizer();
  }
</script>


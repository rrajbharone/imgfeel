---
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div
  class="canva-remover"
  id="canvaRemoverApp"
  data-str-detected={t(locale, 'canvawatermark.status.detected')}
  data-str-not-detected={t(locale, 'canvawatermark.status.notDetected')}
  data-str-analyzing={t(locale, 'canvawatermark.status.analyzing')}
  data-str-remove={t(locale, 'canvawatermark.action.remove')}
  data-str-processing={t(locale, 'canvawatermark.action.processing')}
  data-str-complete={t(locale, 'canvawatermark.action.complete')}
  data-str-error-load={t(locale, 'canvawatermark.error.load')}
  data-str-error-process={t(locale, 'canvawatermark.error.process')}
  data-str-auth-required={t(locale, 'canvawatermark.error.authRequired')}
  data-str-sample-loaded={t(locale, 'canvawatermark.sample.loaded')}
  data-str-auto-desc={t(locale, 'canvawatermark.mode.autoDesc')}
  data-str-brush-desc={t(locale, 'canvawatermark.mode.brushDesc')}
>
  <!-- Hidden File Input used across upload & change image -->
  <input
    type="file"
    id="fileInput"
    accept="image/jpeg,image/png,image/webp"
    class="sr-only"
  />

  <!-- 1. Upload State (Visible initially; completely hidden when image is loaded) -->
  <div class="canva-upload-card" id="uploadState">
    <div
      class="dropzone-area"
      id="dropzone"
      tabindex="0"
      role="button"
      aria-label={t(locale, 'canvawatermark.dropzone.title')}
    >
      <div class="dropzone-icon">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
      </div>
      <h2 class="dropzone-title">{t(locale, 'canvawatermark.dropzone.title')}</h2>
      <p class="dropzone-subtitle">{t(locale, 'canvawatermark.dropzone.subtitle')}</p>
      <div class="dropzone-actions">
        <button type="button" class="btn btn-primary dropzone-browse-btn" id="browseBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path>
            <path d="M12 12v9"></path>
            <path d="m16 16-4-4-4 4"></path>
          </svg>
          <span>{t(locale, 'canvawatermark.dropzone.browse')}</span>
        </button>
        <button type="button" class="btn btn-secondary dropzone-sample-btn" id="sampleBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polygon points="10 8 16 12 10 16 10 8"></polygon>
          </svg>
          <span>{t(locale, 'canvawatermark.dropzone.sample')}</span>
        </button>
      </div>
      <div class="privacy-pill">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>{t(locale, 'canvawatermark.privacy.badge')}</span>
      </div>
    </div>
  </div>

  <!-- 2. Editor State (Two-column desktop / stacked mobile layout; hidden initially) -->
  <div class="canva-editor" id="editorState" hidden>
    <div class="editor-layout">
      <!-- Left Column: Image Preview, Comparison & Metadata -->
      <div class="preview-area">
        <!-- Preview Header Bar (Side-by-Side only, clean & uncluttered) -->
        <div class="preview-header">
          <h3 class="preview-title">{t(locale, 'canvawatermark.preview.title')}</h3>
          <button type="button" class="btn btn-secondary btn-sm change-image-btn" id="changeImageBtn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 16l4.586-4.586a2 2 0 0 1 2.828 0L16 16m-2-2l1.586-1.586a2 2 0 0 1 2.828 0L20 14m-6-6h.01M6 20h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z"></path>
            </svg>
            <span>{t(locale, 'canvawatermark.action.changeImage')}</span>
          </button>
        </div>

        <!-- Preview Stage Box: Side-by-Side Comparison -->
        <div class="preview-stage">
          <div class="side-by-side-grid" id="sideBySideGrid">
            <!-- Left Side: Original Watermarked Image + Brush Canvas Overlay -->
            <div class="side-item side-item-before">
              <div class="side-badge">{t(locale, 'canvawatermark.preview.badgeBefore')}</div>
              <div class="side-img-box" id="sideBeforeBox">
                <div class="side-img-inner">
                  <img id="beforeImg" class="side-img before" alt="Original Watermarked Image" />
                  <!-- Interactive Brush Mask Canvas (active only in manual brush mode) -->
                  <canvas id="brushCanvas" class="brush-canvas" style="display: none;"></canvas>
                </div>
              </div>
            </div>

            <!-- Right Side: Clean Reconstructed Result -->
            <div class="side-item side-item-after">
              <div class="side-badge side-badge-processed">{t(locale, 'canvawatermark.preview.badgeAfter')}</div>
              <div class="side-img-box">
                <div class="side-img-inner">
                  <img id="afterImg" class="side-img after" alt="Watermark Removed Result" />
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- File Details & Detection Summary Bar -->
        <div class="image-meta-bar" id="detectionCard">
          <div class="meta-status-wrap">
            <div class="detection-indicator" id="detectionIndicator">
              <span class="pulse-dot"></span>
              <span id="detectionStatusText">{t(locale, 'canvawatermark.status.analyzing')}</span>
            </div>
            <div class="file-meta-pill" id="fileMetaPill">
              <span id="metaDimensions">-- × --</span>
              <span class="meta-sep">•</span>
              <span id="metaFileSize">-- KB</span>
            </div>
          </div>
          <div class="meta-stats-grid" id="detectionDetails">
            <div class="meta-stat-item">
              <span class="meta-stat-label">{t(locale, 'canvawatermark.detail.confidence')}</span>
              <span class="meta-stat-value" id="confidenceVal">--%</span>
            </div>
            <div class="meta-stat-item">
              <span class="meta-stat-label">{t(locale, 'canvawatermark.detail.pattern')}</span>
              <span class="meta-stat-value" id="patternVal">--</span>
            </div>
            <div class="meta-stat-item">
              <span class="meta-stat-label">{t(locale, 'canvawatermark.detail.coverage')}</span>
              <span class="meta-stat-value" id="coverageVal">--%</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Settings, Processing Options & Action Buttons -->
      <div class="controls-area">
        <!-- Authorization Notice Card -->
        <div class="auth-notice-card">
          <div class="auth-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <div class="auth-text-box">
            <h4 class="auth-title">{t(locale, 'canvawatermark.auth.title')}</h4>
            <p class="auth-desc">{t(locale, 'canvawatermark.auth.desc')}</p>
            <label class="auth-checkbox-label">
              <input type="checkbox" id="authCheckbox" checked />
              <span class="auth-checkbox-text">{t(locale, 'canvawatermark.auth.checkbox')}</span>
            </label>
          </div>
        </div>

        <!-- Controls Card -->
        <div class="settings-card">
          <!-- Removal Mode -->
          <div class="control-group">
            <label class="control-label">
              {t(locale, 'canvawatermark.label.mode')}
            </label>
            <div class="mode-toggle-group">
              <button type="button" class="mode-btn active" data-mode="auto" id="modeAutoBtn">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
                </svg>
                <span>{t(locale, 'canvawatermark.mode.auto')}</span>
              </button>
              <button type="button" class="mode-btn" data-mode="brush" id="modeBrushBtn">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m9.06 11.9 8.07-8.06a2.85 2.85 0 1 1 4.03 4.03l-8.06 8.08"></path>
                  <path d="M7.07 14.94c-1.66 0-3 1.35-3 3.02 0 1.33-2.5 1.52-2 2.02 1.08 1.1 2.49 2.02 4 2.02 2.2 0 4-1.8 4-4.04a3.01 3.01 0 0 0-3-3.02z"></path>
                </svg>
                <span>{t(locale, 'canvawatermark.mode.brush')}</span>
              </button>
            </div>
            <p class="control-helper" id="modeHelper">{t(locale, 'canvawatermark.mode.autoDesc')}</p>
          </div>

          <!-- Brush Settings Sub-Panel (Clean stacked layout, no button overflow) -->
          <div class="brush-settings-panel" id="brushSettingsPanel" style="display: none;">
            <div class="brush-slider-wrap">
              <div class="brush-label-row">
                <label for="brushSize" class="brush-label">{t(locale, 'canvawatermark.brush.size')}</label>
                <span class="brush-size-val" id="brushSizeVal">28px</span>
              </div>
              <input type="range" id="brushSize" min="8" max="80" value="28" class="form-range brush-range" />
            </div>
            <button type="button" class="btn btn-secondary btn-sm clear-mask-btn" id="clearMaskBtn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 6h18"></path>
                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
              </svg>
              <span>{t(locale, 'canvawatermark.brush.clear')}</span>
            </button>
          </div>

          <!-- Sensitivity Level -->
          <div class="control-group">
            <label class="control-label">
              {t(locale, 'canvawatermark.label.sensitivity')}
            </label>
            <div class="segmented-control" id="sensitivityControl">
              <button type="button" class="segment-btn" data-val="low">{t(locale, 'canvawatermark.sensitivity.low')}</button>
              <button type="button" class="segment-btn active" data-val="medium">{t(locale, 'canvawatermark.sensitivity.medium')}</button>
              <button type="button" class="segment-btn" data-val="high">{t(locale, 'canvawatermark.sensitivity.high')}</button>
            </div>
            <p class="control-helper">{t(locale, 'canvawatermark.sensitivity.helper')}</p>
          </div>

          <!-- Quality Mode -->
          <div class="control-group">
            <label class="control-label" for="qualitySelect">
              {t(locale, 'canvawatermark.label.quality')}
            </label>
            <select id="qualitySelect" class="form-select">
              <option value="balanced" selected>{t(locale, 'canvawatermark.quality.balanced')}</option>
              <option value="deep">{t(locale, 'canvawatermark.quality.deep')}</option>
            </select>
            <p class="control-helper">{t(locale, 'canvawatermark.quality.helper')}</p>
          </div>

          <!-- Main Action Buttons -->
          <div class="action-buttons-wrap">
            <button type="button" class="btn btn-primary btn-lg action-btn action-btn-process" id="processBtn">
              <span class="btn-spinner" id="processSpinner" style="display: none;"></span>
              <svg class="btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 21-4.3-4.3c-1-1-1-2.5 0-3.4l9.6-9.6c1-1 2.5-1 3.4 0l5.6 5.6c1 1 1 2.5 0 3.4L13 21"></path>
                <path d="M22 21H7"></path>
                <path d="m5 11 9 9"></path>
              </svg>
              <span id="processBtnText">{t(locale, 'canvawatermark.action.remove')}</span>
            </button>
            <button type="button" class="btn btn-secondary action-btn action-btn-reset" id="resetBtn">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                <path d="M3 3v5h5"></path>
              </svg>
              <span>{t(locale, 'canvawatermark.action.reset')}</span>
            </button>
          </div>
        </div>

        <!-- Download & Result Card (Visible after processing) -->
        <div class="download-card" id="downloadBar" style="display: none;">
          <div class="download-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-success" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <h4 class="download-title">{t(locale, 'canvawatermark.action.complete')}</h4>
          </div>
          <div class="download-format-wrap">
            <label class="download-format-label" for="downloadFormat">
              {t(locale, 'canvawatermark.download.format')}
            </label>
            <select id="downloadFormat" class="form-select">
              <option value="original" selected>{t(locale, 'canvawatermark.download.originalFormat')}</option>
              <option value="png">PNG (Lossless)</option>
              <option value="jpeg">JPG (Photo)</option>
              <option value="webp">WebP (Modern)</option>
            </select>
          </div>
          <button type="button" class="btn btn-primary btn-lg download-btn" id="downloadBtn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>{t(locale, 'canvawatermark.download.action')}</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    loadImageFromFile,
    detectCanvaWatermark,
    generateAutoWatermarkMask,
    removeWatermark,
    generateSampleCanvaImage,
    exportCanvasAsBlob,
    type LoadedImageInfo,
    type WatermarkDetectionResult,
    type RemovalOptions,
  } from '@/scripts/canva-watermark-remover';

  document.addEventListener('DOMContentLoaded', () => {
    const app = document.getElementById('canvaRemoverApp');
    if (!app) return;

    // Strings from data attributes (100% localized, zero hardcoded fallback)
    const strDetected = app.dataset.strDetected || '';
    const strNotDetected = app.dataset.strNotDetected || '';
    const strAnalyzing = app.dataset.strAnalyzing || '';
    const strRemove = app.dataset.strRemove || '';
    const strProcessing = app.dataset.strProcessing || '';
    const strComplete = app.dataset.strComplete || '';
    const strErrorLoad = app.dataset.strErrorLoad || '';
    const strErrorProcess = app.dataset.strErrorProcess || '';
    const strAuthRequired = app.dataset.strAuthRequired || '';
    const strAutoDesc = app.dataset.strAutoDesc || '';
    const strBrushDesc = app.dataset.strBrushDesc || '';

    // Elements
    const dropzone = document.getElementById('dropzone') as HTMLElement;
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const browseBtn = document.getElementById('browseBtn') as HTMLButtonElement;
    const sampleBtn = document.getElementById('sampleBtn') as HTMLButtonElement;
    const uploadState = document.getElementById('uploadState') as HTMLElement;
    const editorState = document.getElementById('editorState') as HTMLElement;
    const changeImageBtn = document.getElementById('changeImageBtn') as HTMLButtonElement;
    const authCheckbox = document.getElementById('authCheckbox') as HTMLInputElement;

    const detectionIndicator = document.getElementById('detectionIndicator') as HTMLElement;
    const detectionStatusText = document.getElementById('detectionStatusText') as HTMLElement;
    const metaDimensions = document.getElementById('metaDimensions') as HTMLElement;
    const metaFileSize = document.getElementById('metaFileSize') as HTMLElement;
    const confidenceVal = document.getElementById('confidenceVal') as HTMLElement;
    const patternVal = document.getElementById('patternVal') as HTMLElement;
    const coverageVal = document.getElementById('coverageVal') as HTMLElement;

    const modeAutoBtn = document.getElementById('modeAutoBtn') as HTMLButtonElement;
    const modeBrushBtn = document.getElementById('modeBrushBtn') as HTMLButtonElement;
    const modeHelper = document.getElementById('modeHelper') as HTMLElement;
    const sensitivityControl = document.getElementById('sensitivityControl') as HTMLElement;
    const qualitySelect = document.getElementById('qualitySelect') as HTMLSelectElement;

    const brushSettingsPanel = document.getElementById('brushSettingsPanel') as HTMLElement;
    const brushSizeInput = document.getElementById('brushSize') as HTMLInputElement;
    const brushSizeVal = document.getElementById('brushSizeVal') as HTMLElement;
    const clearMaskBtn = document.getElementById('clearMaskBtn') as HTMLButtonElement;

    const processBtn = document.getElementById('processBtn') as HTMLButtonElement;
    const processBtnText = document.getElementById('processBtnText') as HTMLElement;
    const processSpinner = document.getElementById('processSpinner') as HTMLElement;
    const resetBtn = document.getElementById('resetBtn') as HTMLButtonElement;

    const beforeImg = document.getElementById('beforeImg') as HTMLImageElement;
    const afterImg = document.getElementById('afterImg') as HTMLImageElement;
    const brushCanvas = document.getElementById('brushCanvas') as HTMLCanvasElement;

    const downloadBar = document.getElementById('downloadBar') as HTMLElement;
    const downloadFormat = document.getElementById('downloadFormat') as HTMLSelectElement;
    const downloadBtn = document.getElementById('downloadBtn') as HTMLButtonElement;

    // State
    let currentImage: LoadedImageInfo | null = null;
    let detectionResult: WatermarkDetectionResult | null = null;
    let currentMode: 'auto' | 'brush' = 'auto';
    let currentSensitivity: 'low' | 'medium' | 'high' = 'medium';
    let processedImageData: ImageData | null = null;

    // Brush state
    let brushMask: Uint8Array | null = null;
    let isDrawing = false;
    let brushRadius = 14;

    // Switch between Upload and Editor states
    const showEditor = () => {
      uploadState.style.display = 'none';
      editorState.removeAttribute('hidden');
      editorState.style.display = 'block';
    };

    const showUpload = () => {
      editorState.setAttribute('hidden', '');
      editorState.style.display = 'none';
      uploadState.style.display = 'block';
      fileInput.value = '';
      currentImage = null;
      processedImageData = null;
      downloadBar.style.display = 'none';
    };

    // 1. File Handling
    const handleFile = async (file: File) => {
      try {
        detectionStatusText.textContent = strAnalyzing;
        showEditor();
        downloadBar.style.display = 'none';

        const info = await loadImageFromFile(file);
        setLoadedImage(info);
      } catch (err) {
        alert(strErrorLoad);
        console.error(err);
      }
    };

    const setLoadedImage = (info: LoadedImageInfo) => {
      currentImage = info;
      metaDimensions.textContent = `${info.originalWidth} × ${info.originalHeight} px`;
      metaFileSize.textContent = `${(info.fileSize / 1024).toFixed(1)} KB`;

      // Set image sources
      beforeImg.src = info.img.src;
      afterImg.src = info.img.src;

      // Setup brush canvas matching original image coordinates
      brushCanvas.width = info.originalWidth;
      brushCanvas.height = info.originalHeight;
      brushMask = new Uint8Array(info.originalWidth * info.originalHeight);
      clearBrushCanvas();

      // Run automatic watermark detection
      detectionResult = detectCanvaWatermark(info.imageData);

      confidenceVal.textContent = `${detectionResult.confidence}%`;
      patternVal.textContent = detectionResult.patternType === 'combined'
        ? 'Grid & Text Overlay'
        : detectionResult.patternType === 'grid'
        ? 'Diagonal Grid Pattern'
        : detectionResult.patternType === 'text'
        ? 'Translucent Text Overlay'
        : 'Clean / None';
      coverageVal.textContent = `${detectionResult.estimatedCoverage}%`;

      if (detectionResult.detected) {
        detectionIndicator.className = 'detection-indicator detected';
        detectionStatusText.textContent = strDetected;
      } else {
        detectionIndicator.className = 'detection-indicator clean';
        detectionStatusText.textContent = strNotDetected;
      }
    };

    // Load sample design
    sampleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      try {
        showEditor();
        downloadBar.style.display = 'none';

        const sampleImageData = generateSampleCanvaImage();
        const canvas = document.createElement('canvas');
        canvas.width = sampleImageData.width;
        canvas.height = sampleImageData.height;
        const ctx = canvas.getContext('2d')!;
        ctx.putImageData(sampleImageData, 0, 0);

        const img = new Image();
        img.onload = () => {
          setLoadedImage({
            img,
            name: 'canva-design-sample.png',
            originalWidth: sampleImageData.width,
            originalHeight: sampleImageData.height,
            fileSize: 420 * 1024,
            fileType: 'image/png',
            imageData: sampleImageData,
          });
        };
        img.src = canvas.toDataURL('image/png');
      } catch (err) {
        console.error(err);
      }
    });

    // File Input / Browse
    browseBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput.click();
    });

    // Change Image button inside editor
    changeImageBtn.addEventListener('click', () => {
      fileInput.click();
    });

    dropzone.addEventListener('click', (e) => {
      if (e.target !== sampleBtn && !sampleBtn.contains(e.target as Node)) {
        fileInput.click();
      }
    });

    dropzone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files[0]) {
        handleFile(fileInput.files[0]);
      }
    });

    // Drag & Drop
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('drag-active');
    });

    dropzone.addEventListener('dragleave', () => {
      dropzone.classList.remove('drag-active');
    });

    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('drag-active');
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
        handleFile(e.dataTransfer.files[0]);
      }
    });

    // Mode Toggles
    modeAutoBtn.addEventListener('click', () => {
      currentMode = 'auto';
      modeAutoBtn.classList.add('active');
      modeBrushBtn.classList.remove('active');
      brushSettingsPanel.style.display = 'none';
      brushCanvas.style.display = 'none';
      modeHelper.textContent = strAutoDesc;
    });

    modeBrushBtn.addEventListener('click', () => {
      currentMode = 'brush';
      modeBrushBtn.classList.add('active');
      modeAutoBtn.classList.remove('active');
      brushSettingsPanel.style.display = 'flex';
      brushCanvas.style.display = 'block';
      modeHelper.textContent = strBrushDesc;
    });

    // Sensitivity Segmented Control
    const segmentBtns = sensitivityControl.querySelectorAll('.segment-btn');
    segmentBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        segmentBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentSensitivity = btn.getAttribute('data-val') as 'low' | 'medium' | 'high';
      });
    });

    // Brush Settings
    brushSizeInput.addEventListener('input', () => {
      const val = parseInt(brushSizeInput.value, 10);
      brushRadius = Math.round(val / 2);
      brushSizeVal.textContent = `${val}px`;
    });

    clearMaskBtn.addEventListener('click', () => {
      if (currentImage && brushMask) {
        brushMask.fill(0);
        clearBrushCanvas();
      }
    });

    const clearBrushCanvas = () => {
      const ctx = brushCanvas.getContext('2d');
      if (ctx) {
        ctx.clearRect(0, 0, brushCanvas.width, brushCanvas.height);
      }
    };

    // Brush Mask Drawing on Canvas
    const getCanvasCoordinates = (e: MouseEvent | TouchEvent) => {
      const rect = brushCanvas.getBoundingClientRect();
      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;

      const scaleX = brushCanvas.width / rect.width;
      const scaleY = brushCanvas.height / rect.height;

      return {
        x: Math.round((clientX - rect.left) * scaleX),
        y: Math.round((clientY - rect.top) * scaleY),
      };
    };

    const paintBrush = (x: number, y: number) => {
      if (!currentImage || !brushMask) return;
      const ctx = brushCanvas.getContext('2d');
      if (!ctx) return;

      const w = brushCanvas.width;
      const h = brushCanvas.height;
      const r = brushRadius;

      ctx.fillStyle = 'rgba(239, 68, 68, 0.45)';
      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fill();

      const r2 = r * r;
      const x0 = Math.max(0, x - r);
      const x1 = Math.min(w - 1, x + r);
      const y0 = Math.max(0, y - r);
      const y1 = Math.min(h - 1, y + r);

      for (let py = y0; py <= y1; py++) {
        const dy = py - y;
        for (let px = x0; px <= x1; px++) {
          const dx = px - x;
          if (dx * dx + dy * dy <= r2) {
            brushMask[py * w + px] = 255;
          }
        }
      }
    };

    brushCanvas.addEventListener('mousedown', (e) => {
      if (currentMode !== 'brush') return;
      isDrawing = true;
      const { x, y } = getCanvasCoordinates(e);
      paintBrush(x, y);
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDrawing || currentMode !== 'brush') return;
      const { x, y } = getCanvasCoordinates(e);
      paintBrush(x, y);
    });

    window.addEventListener('mouseup', () => {
      isDrawing = false;
    });

    brushCanvas.addEventListener('touchstart', (e) => {
      if (currentMode !== 'brush') return;
      isDrawing = true;
      e.preventDefault();
      const { x, y } = getCanvasCoordinates(e);
      paintBrush(x, y);
    }, { passive: false });

    brushCanvas.addEventListener('touchmove', (e) => {
      if (!isDrawing || currentMode !== 'brush') return;
      e.preventDefault();
      const { x, y } = getCanvasCoordinates(e);
      paintBrush(x, y);
    }, { passive: false });

    brushCanvas.addEventListener('touchend', () => {
      isDrawing = false;
    });

    // 2. Watermark Removal Processing
    processBtn.addEventListener('click', async () => {
      if (!currentImage) return;

      if (!authCheckbox.checked) {
        alert(strAuthRequired);
        authCheckbox.focus();
        return;
      }

      processBtn.disabled = true;
      processSpinner.style.display = 'inline-block';
      processBtnText.textContent = strProcessing;

      await new Promise((r) => setTimeout(r, 60));

      try {
        let maskToUse: Uint8Array;

        if (currentMode === 'brush' && brushMask) {
          maskToUse = brushMask;
        } else {
          maskToUse = generateAutoWatermarkMask(currentImage.imageData, currentSensitivity);
        }

        const options: RemovalOptions = {
          mode: currentMode,
          sensitivity: currentSensitivity,
          quality: qualitySelect.value as 'balanced' | 'deep',
          blendRadius: 2,
          alphaStrength: currentSensitivity === 'low' ? 0.20 : currentSensitivity === 'medium' ? 0.27 : 0.35,
        };

        const resultImageData = removeWatermark(currentImage.imageData, maskToUse, options);
        processedImageData = resultImageData;

        const resCanvas = document.createElement('canvas');
        resCanvas.width = resultImageData.width;
        resCanvas.height = resultImageData.height;
        const resCtx = resCanvas.getContext('2d')!;
        resCtx.putImageData(resultImageData, 0, 0);

        const resDataUrl = resCanvas.toDataURL('image/png');
        afterImg.src = resDataUrl;

        downloadBar.style.display = 'block';
        processBtnText.textContent = strComplete;

        if (currentMode === 'brush') {
          brushCanvas.style.display = 'none';
        }

        setTimeout(() => {
          processBtnText.textContent = strRemove;
        }, 2200);
      } catch (err) {
        console.error(err);
        alert(strErrorProcess);
      } finally {
        processBtn.disabled = false;
        processSpinner.style.display = 'none';
      }
    });

    // Reset button / Upload another image
    resetBtn.addEventListener('click', () => {
      showUpload();
      uploadState.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    // 3. Download Processed Image
    downloadBtn.addEventListener('click', async () => {
      if (!processedImageData || !currentImage) return;

      const formatVal = downloadFormat.value;
      let mimeType: 'image/jpeg' | 'image/png' | 'image/webp' = 'image/png';
      let extension = 'png';

      if (formatVal === 'original') {
        if (currentImage.fileType === 'image/jpeg') {
          mimeType = 'image/jpeg';
          extension = 'jpg';
        } else if (currentImage.fileType === 'image/webp') {
          mimeType = 'image/webp';
          extension = 'webp';
        } else {
          mimeType = 'image/png';
          extension = 'png';
        }
      } else if (formatVal === 'jpeg') {
        mimeType = 'image/jpeg';
        extension = 'jpg';
      } else if (formatVal === 'webp') {
        mimeType = 'image/webp';
        extension = 'webp';
      }

      const canvas = document.createElement('canvas');
      canvas.width = processedImageData.width;
      canvas.height = processedImageData.height;
      const ctx = canvas.getContext('2d')!;
      ctx.putImageData(processedImageData, 0, 0);

      const blob = await exportCanvasAsBlob(canvas, mimeType, 0.95);
      const url = URL.createObjectURL(blob);

      const originalBaseName = currentImage.name.replace(/\.[^/.]+$/, '');
      const downloadName = `${originalBaseName}-watermark-removed.${extension}`;

      const link = document.createElement('a');
      link.href = url;
      link.download = downloadName;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
    });
  });
</script>


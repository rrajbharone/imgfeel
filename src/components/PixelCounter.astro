---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const i18nDict = {
  statusReady: t(locale, 'pixelcounter.status.ready'),
  statusAnalyzed: t(locale, 'pixelcounter.status.analyzed'),
  actionNew: t(locale, 'pixelcounter.action.newImage'),
  actionCopyTotal: t(locale, 'pixelcounter.action.copyTotal'),
  actionCopyDim: t(locale, 'pixelcounter.action.copyDim'),
  actionCopySpecs: t(locale, 'pixelcounter.action.copySpecs'),
  actionCopied: t(locale, 'pixelcounter.action.copied'),
  errorLoad: t(locale, 'pixelcounter.error.load'),
  heroMainLabel: t(locale, 'pixelcounter.hero.mainLabel'),
  heroTotalLabel: t(locale, 'pixelcounter.hero.totalLabel'),
  metricWidth: t(locale, 'pixelcounter.metric.width'),
  metricHeight: t(locale, 'pixelcounter.metric.height'),
  metricTotalPixels: t(locale, 'pixelcounter.metric.totalPixels'),
  metricMegapixels: t(locale, 'pixelcounter.metric.megapixels'),
  metricAspectRatio: t(locale, 'pixelcounter.metric.aspectRatio'),
  metricFormat: t(locale, 'pixelcounter.metric.format'),
  metricFileSize: t(locale, 'pixelcounter.metric.fileSize'),
  metricRawMemory: t(locale, 'pixelcounter.metric.rawMemory'),
  orientationLandscape: t(locale, 'pixelcounter.orientation.landscape'),
  orientationPortrait: t(locale, 'pixelcounter.orientation.portrait'),
  orientationSquare: t(locale, 'pixelcounter.orientation.square'),
};
---

<div
  class="pixel-counter-tool"
  id="pixelCounterApp"
  data-i18n={JSON.stringify(i18nDict)}
>
  <!-- Upload State -->
  <div class="pc-upload-view" id="pcUploadView">
    <div class="dropzone" id="pcDropzone" role="region" aria-label={t(locale, 'pixelcounter.dropzone.title')}>
      <div class="dropzone-icon-box">
        <svg class="dropzone-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" y1="9" x2="20" y2="9"></line>
          <line x1="4" y1="15" x2="20" y2="15"></line>
          <line x1="10" y1="3" x2="8" y2="21"></line>
          <line x1="16" y1="3" x2="14" y2="21"></line>
        </svg>
      </div>
      <p class="dropzone-title">{t(locale, 'pixelcounter.dropzone.title')}</p>
      <p class="dropzone-subtitle">{t(locale, 'pixelcounter.dropzone.subtitle')}</p>
      
      <div class="dropzone-actions">
        <button type="button" class="btn btn-primary btn-browse" id="pcBrowseBtn">{t(locale, 'pixelcounter.dropzone.browse')}</button>
        <button type="button" class="btn btn-secondary btn-sm" id="pcSampleBtn">{t(locale, 'pixelcounter.dropzone.sample')}</button>
      </div>

      <div class="dropzone-footer">
        <p class="dropzone-formats">{t(locale, 'pixelcounter.dropzone.formats')}</p>
        <span class="privacy-badge">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>{t(locale, 'pixelcounter.privacy.badge')}</span>
        </span>
      </div>

      <input
        type="file"
        id="pcFileInput"
        accept="image/*,.jpg,.jpeg,.png,.webp,.gif,.svg,.avif,.bmp,.ico,.tiff"
        class="sr-only"
        aria-label={t(locale, 'pixelcounter.dropzone.browse')}
      />
    </div>
  </div>

  <!-- Results State (Hidden initially) -->
  <div class="pc-results-view" id="pcResultsView" hidden>
    <!-- Top Action Bar -->
    <div class="top-action-bar">
      <div class="bar-left">
        <span class="status-indicator"></span>
        <span class="status-text" id="pcStatusText">{t(locale, 'pixelcounter.status.analyzed')}</span>
      </div>
      <div class="bar-right">
        <button type="button" class="btn btn-secondary btn-sm action-btn" id="pcNewBtn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'pixelcounter.action.newImage')}</span>
        </button>
      </div>
    </div>

    <!-- Hero Result Card -->
    <div class="hero-result-card">
      <div class="hero-main-content">
        <span class="hero-tag">{t(locale, 'pixelcounter.hero.mainLabel')}</span>
        <div class="hero-dimensions" id="pcHeroDimensions">1920 × 1080 px</div>
        <div class="hero-total-pixels">
          <span class="total-label">{t(locale, 'pixelcounter.hero.totalLabel')}:</span>
          <span class="total-number" id="pcHeroTotalPixels">2,073,600</span>
          <span class="hero-mp-badge" id="pcHeroMegapixels">2.07 MP</span>
        </div>
      </div>
      <div class="hero-actions">
        <button type="button" class="btn btn-primary btn-sm copy-btn" id="pcBtnCopyTotal">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span id="pcTextCopyTotal">{t(locale, 'pixelcounter.action.copyTotal')}</span>
        </button>
        <button type="button" class="btn btn-secondary btn-sm copy-btn" id="pcBtnCopyDim">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 3 21 3 21 9"></polyline>
            <polyline points="9 21 3 21 3 15"></polyline>
            <line x1="21" y1="3" x2="14" y2="10"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
          <span id="pcTextCopyDim">{t(locale, 'pixelcounter.action.copyDim')}</span>
        </button>
        <button type="button" class="btn btn-secondary btn-sm copy-btn" id="pcBtnCopySpecs">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
          </svg>
          <span id="pcTextCopySpecs">{t(locale, 'pixelcounter.action.copySpecs')}</span>
        </button>
      </div>
    </div>

    <!-- Main Content Grid: Small Preview & Specs Cards -->
    <div class="results-grid">
      <!-- Left: Compact Image Preview -->
      <div class="preview-card">
        <div class="preview-thumbnail-wrap">
          <img id="pcPreviewImg" class="preview-thumbnail" alt="Uploaded photo preview" />
          <div class="preview-overlay-tags">
            <span class="preview-badge badge-orientation" id="pcBadgeOrientation">—</span>
            <span class="preview-badge badge-format" id="pcBadgeFormat">—</span>
          </div>
        </div>
        <div class="file-info-bar">
          <span class="file-name" id="pcFileName">—</span>
          <span class="file-size" id="pcFileSize">—</span>
        </div>
      </div>

      <!-- Right: Detailed Metrics Grid -->
      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-icon-box">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="21" y1="12" x2="3" y2="12"></line>
              <polyline points="7 8 3 12 7 16"></polyline>
              <polyline points="17 8 21 12 17 16"></polyline>
            </svg>
          </div>
          <div class="metric-details">
            <span class="metric-label">{t(locale, 'pixelcounter.metric.width')}</span>
            <span class="metric-val" id="pcValWidth">—</span>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon-box">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="3" x2="12" y2="21"></line>
              <polyline points="8 7 12 3 16 7"></polyline>
              <polyline points="8 17 12 21 16 17"></polyline>
            </svg>
          </div>
          <div class="metric-details">
            <span class="metric-label">{t(locale, 'pixelcounter.metric.height')}</span>
            <span class="metric-val" id="pcValHeight">—</span>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon-box">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="6" x2="12" y2="18"></line>
              <line x1="6" y1="12" x2="18" y2="12"></line>
            </svg>
          </div>
          <div class="metric-details">
            <span class="metric-label">{t(locale, 'pixelcounter.metric.megapixels')}</span>
            <span class="metric-val" id="pcValMegapixels">—</span>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon-box">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <div class="metric-details">
            <span class="metric-label">{t(locale, 'pixelcounter.metric.aspectRatio')}</span>
            <span class="metric-val" id="pcValAspectRatio">—</span>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon-box">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
          </div>
          <div class="metric-details">
            <span class="metric-label">{t(locale, 'pixelcounter.metric.format')}</span>
            <span class="metric-val" id="pcValFormat">—</span>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon-box">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
              <rect x="9" y="9" width="6" height="6"></rect>
              <line x1="9" y1="1" x2="9" y2="4"></line>
              <line x1="15" y1="1" x2="15" y2="4"></line>
              <line x1="9" y1="20" x2="9" y2="23"></line>
              <line x1="15" y1="20" x2="15" y2="23"></line>
            </svg>
          </div>
          <div class="metric-details">
            <span class="metric-label">{t(locale, 'pixelcounter.metric.rawMemory')}</span>
            <span class="metric-val" id="pcValMemory">—</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { PixelCounterEngine, type PixelMetrics } from '@/scripts/pixel-counter';

  function initPixelCounter() {
    const appEl = document.getElementById('pixelCounterApp');
    if (!appEl) return;

    let i18n = {
      statusReady: 'Ready to Analyze',
      statusAnalyzed: 'Image Analyzed Successfully',
      actionNew: 'Analyze Another Image',
      actionCopyTotal: 'Copy Pixels',
      actionCopyDim: 'Copy Dimensions',
      actionCopySpecs: 'Copy All Specs',
      actionCopied: 'Copied!',
      errorLoad: 'Failed to inspect image. Please upload a valid image file.',
      heroMainLabel: 'Exact Dimensions',
      heroTotalLabel: 'Total Pixels',
      metricWidth: 'Width',
      metricHeight: 'Height',
      metricTotalPixels: 'Total Pixels',
      metricMegapixels: 'Megapixels (MP)',
      metricAspectRatio: 'Aspect Ratio',
      metricFormat: 'File Format',
      metricFileSize: 'File Size',
      metricRawMemory: 'Uncompressed Memory',
      orientationLandscape: 'Landscape',
      orientationPortrait: 'Portrait',
      orientationSquare: 'Square',
    };

    try {
      if (appEl.dataset.i18n) {
        i18n = { ...i18n, ...JSON.parse(appEl.dataset.i18n) };
      }
    } catch (e) {
      console.warn('Failed to parse i18n dictionary', e);
    }

    const uploadView = document.getElementById('pcUploadView') as HTMLDivElement;
    const resultsView = document.getElementById('pcResultsView') as HTMLDivElement;
    const dropzone = document.getElementById('pcDropzone') as HTMLDivElement;
    const fileInput = document.getElementById('pcFileInput') as HTMLInputElement;
    const browseBtn = document.getElementById('pcBrowseBtn') as HTMLButtonElement;
    const sampleBtn = document.getElementById('pcSampleBtn') as HTMLButtonElement;
    const newBtn = document.getElementById('pcNewBtn') as HTMLButtonElement;

    // Result elements
    const heroDimensions = document.getElementById('pcHeroDimensions') as HTMLDivElement;
    const heroTotalPixels = document.getElementById('pcHeroTotalPixels') as HTMLSpanElement;
    const heroMegapixels = document.getElementById('pcHeroMegapixels') as HTMLSpanElement;
    const previewImg = document.getElementById('pcPreviewImg') as HTMLImageElement;
    const badgeOrientation = document.getElementById('pcBadgeOrientation') as HTMLSpanElement;
    const badgeFormat = document.getElementById('pcBadgeFormat') as HTMLSpanElement;
    const fileNameEl = document.getElementById('pcFileName') as HTMLSpanElement;
    const fileSizeEl = document.getElementById('pcFileSize') as HTMLSpanElement;

    const valWidth = document.getElementById('pcValWidth') as HTMLSpanElement;
    const valHeight = document.getElementById('pcValHeight') as HTMLSpanElement;
    const valMegapixels = document.getElementById('pcValMegapixels') as HTMLSpanElement;
    const valAspectRatio = document.getElementById('pcValAspectRatio') as HTMLSpanElement;
    const valFormat = document.getElementById('pcValFormat') as HTMLSpanElement;
    const valMemory = document.getElementById('pcValMemory') as HTMLSpanElement;

    // Copy buttons
    const btnCopyTotal = document.getElementById('pcBtnCopyTotal') as HTMLButtonElement;
    const btnCopyDim = document.getElementById('pcBtnCopyDim') as HTMLButtonElement;
    const btnCopySpecs = document.getElementById('pcBtnCopySpecs') as HTMLButtonElement;
    const textCopyTotal = document.getElementById('pcTextCopyTotal') as HTMLSpanElement;
    const textCopyDim = document.getElementById('pcTextCopyDim') as HTMLSpanElement;
    const textCopySpecs = document.getElementById('pcTextCopySpecs') as HTMLSpanElement;

    let currentMetrics: PixelMetrics | null = null;

    async function handleFile(file: File) {
      try {
        currentMetrics = await PixelCounterEngine.inspectFile(file);

        // Populate Hero Card
        heroDimensions.textContent = `${currentMetrics.width} × ${currentMetrics.height} px`;
        heroTotalPixels.textContent = currentMetrics.formattedTotalPixels;
        heroMegapixels.textContent = currentMetrics.formattedMegapixels;

        // Preview & Thumbnail
        previewImg.src = currentMetrics.previewUrl;
        
        let orientLabel = i18n.orientationSquare;
        if (currentMetrics.orientation === 'landscape') orientLabel = i18n.orientationLandscape;
        else if (currentMetrics.orientation === 'portrait') orientLabel = i18n.orientationPortrait;
        
        badgeOrientation.textContent = orientLabel;
        badgeFormat.textContent = currentMetrics.formatName;
        fileNameEl.textContent = currentMetrics.fileName;
        fileSizeEl.textContent = currentMetrics.formattedFileSize;

        // Metrics Grid
        valWidth.textContent = `${currentMetrics.width.toLocaleString()} px`;
        valHeight.textContent = `${currentMetrics.height.toLocaleString()} px`;
        valMegapixels.textContent = currentMetrics.formattedMegapixels;
        valAspectRatio.textContent = `${currentMetrics.aspectRatioStr} (${currentMetrics.aspectRatioDecimal})`;
        valFormat.textContent = currentMetrics.formatName;
        valMemory.textContent = currentMetrics.formattedRawMemory;

        // Transition views
        uploadView.hidden = true;
        resultsView.hidden = false;
      } catch (err) {
        console.error(err);
        alert(i18n.errorLoad);
      }
    }

    // Reset View
    function resetView() {
      if (currentMetrics?.previewUrl && currentMetrics.previewUrl.startsWith('blob:')) {
        URL.revokeObjectURL(currentMetrics.previewUrl);
      }
      currentMetrics = null;
      fileInput.value = '';
      resultsView.hidden = true;
      uploadView.hidden = false;
    }

    newBtn?.addEventListener('click', resetView);

    // File Input & Browse
    browseBtn?.addEventListener('click', () => fileInput?.click());
    fileInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) handleFile(file);
    });

    // Sample Image Button
    sampleBtn?.addEventListener('click', async () => {
      try {
        sampleBtn.setAttribute('disabled', 'true');
        const sampleFile = await PixelCounterEngine.generateSampleImage();
        await handleFile(sampleFile);
      } catch (err) {
        console.error(err);
      } finally {
        sampleBtn.removeAttribute('disabled');
      }
    });

    // Drag & Drop
    dropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('dragover');
    });

    dropzone?.addEventListener('dragleave', (e) => {
      e.preventDefault();
      dropzone.classList.remove('dragover');
    });

    dropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('dragover');
      const file = e.dataTransfer?.files?.[0];
      if (file) handleFile(file);
    });

    // Clipboard Paste (Ctrl+V)
    window.addEventListener('paste', (e: ClipboardEvent) => {
      if (uploadView.hidden) return;
      const items = e.clipboardData?.items;
      if (!items) return;
      for (const item of items) {
        if (item.type.startsWith('image/')) {
          const file = item.getAsFile();
          if (file) {
            handleFile(file);
            break;
          }
        }
      }
    });

    // Helper for Toast feedback
    function triggerCopyFeedback(textEl: HTMLSpanElement, originalText: string) {
      textEl.textContent = i18n.actionCopied;
      setTimeout(() => {
        textEl.textContent = originalText;
      }, 1800);
    }

    // Copy actions
    btnCopyTotal?.addEventListener('click', async () => {
      if (!currentMetrics) return;
      try {
        await navigator.clipboard.writeText(currentMetrics.totalPixels.toString());
        triggerCopyFeedback(textCopyTotal, i18n.actionCopyTotal);
      } catch (e) {
        console.error(e);
      }
    });

    btnCopyDim?.addEventListener('click', async () => {
      if (!currentMetrics) return;
      try {
        await navigator.clipboard.writeText(`${currentMetrics.width} × ${currentMetrics.height} px`);
        triggerCopyFeedback(textCopyDim, i18n.actionCopyDim);
      } catch (e) {
        console.error(e);
      }
    });

    btnCopySpecs?.addEventListener('click', async () => {
      if (!currentMetrics) return;
      const specs = [
        `Image: ${currentMetrics.fileName}`,
        `Dimensions: ${currentMetrics.width} × ${currentMetrics.height} px`,
        `Total Pixels: ${currentMetrics.formattedTotalPixels} (${currentMetrics.formattedMegapixels})`,
        `Aspect Ratio: ${currentMetrics.aspectRatioStr} (${currentMetrics.aspectRatioDecimal})`,
        `Format: ${currentMetrics.formatName}`,
        `File Size: ${currentMetrics.formattedFileSize}`,
      ].join('\n');

      try {
        await navigator.clipboard.writeText(specs);
        triggerCopyFeedback(textCopySpecs, i18n.actionCopySpecs);
      } catch (e) {
        console.error(e);
      }
    });
  }

  // Support Astro view transitions and initial DOM load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPixelCounter);
  } else {
    initPixelCounter();
  }
  document.addEventListener('astro:page-load', initPixelCounter);
</script>

<style>
  .pixel-counter-tool {
    width: 100%;
    max-width: 860px;
    margin-inline: auto;
  }

  /* Dropzone */
  .dropzone {
    background: var(--color-surface);
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8) var(--space-4);
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .dropzone:hover,
  .dropzone.dragover {
    border-color: var(--color-primary);
    background: var(--color-primary-light, rgba(99, 102, 241, 0.04));
  }

  .dropzone-icon-box {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    background: var(--color-primary-light, rgba(99, 102, 241, 0.1));
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-2);
  }

  .dropzone-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .dropzone-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    max-width: 480px;
    margin: 0;
    line-height: 1.5;
  }

  .dropzone-actions {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    justify-content: center;
    margin-top: var(--space-2);
    flex-wrap: wrap;
  }

  .dropzone-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .dropzone-formats {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary, #94a3b8);
    margin: 0;
  }

  .privacy-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-success, #10b981);
    background: var(--color-success-light, rgba(16, 185, 129, 0.08));
    padding: 4px 10px;
    border-radius: var(--radius-full);
  }

  /* Action Bar */
  .top-action-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .bar-left {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success, #10b981);
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
  }

  .status-text {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  /* Hero Result Card */
  .hero-result-card {

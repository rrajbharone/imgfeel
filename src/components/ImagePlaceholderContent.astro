---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": t(locale, 'placeholder.faq.q1'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'placeholder.faq.a1')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'placeholder.faq.q2'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'placeholder.faq.a2')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'placeholder.faq.q3'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'placeholder.faq.a3')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'placeholder.faq.q4'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'placeholder.faq.a4')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'placeholder.faq.q5'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'placeholder.faq.a5')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'placeholder.faq.q6'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'placeholder.faq.a6')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'placeholder.faq.q7'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'placeholder.faq.a7')
      }
    }
  ]
};
---

<section class="section content-section">
  <div class="container">
    <div class="content-body">
      <!-- Section 1 -->
      <h2>{t(locale, 'placeholder.content.h1')}</h2>
      <p>{t(locale, 'placeholder.content.p1a')}</p>
      <p>{t(locale, 'placeholder.content.p1b')}</p>

      <div class="feature-cards-grid">
        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" stroke-dasharray="3 3"></rect>
              <line x1="3" y1="3" x2="21" y2="21"></line>
              <line x1="21" y1="3" x2="3" y2="21"></line>
            </svg>
          </div>
          <h3>{t(locale, 'placeholder.content.feat1Title')}</h3>
          <p>{t(locale, 'placeholder.content.feat1Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          <h3>{t(locale, 'placeholder.content.feat2Title')}</h3>
          <p>{t(locale, 'placeholder.content.feat2Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3>{t(locale, 'placeholder.content.feat3Title')}</h3>
          <p>{t(locale, 'placeholder.content.feat3Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
          </div>
          <h3>{t(locale, 'placeholder.content.feat4Title')}</h3>
          <p>{t(locale, 'placeholder.content.feat4Desc')}</p>
        </div>
      </div>

      <!-- Section 2: CLS & Core Web Vitals -->
      <h2>{t(locale, 'placeholder.content.h2')}</h2>
      <p>{t(locale, 'placeholder.content.p2a')}</p>
      <p>{t(locale, 'placeholder.content.p2b')}</p>

      <!-- Section 3: Responsive Aspect Ratios -->
      <h2>{t(locale, 'placeholder.content.h3')}</h2>
      <p>{t(locale, 'placeholder.content.p3a')}</p>
      <p>{t(locale, 'placeholder.content.p3b')}</p>

      <!-- Section 4: Master Presets Table -->
      <h2>{t(locale, 'placeholder.content.h4')}</h2>
      <p>{t(locale, 'placeholder.content.p4a')}</p>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Target Asset</th>
              <th>Dimensions</th>
              <th>Aspect Ratio</th>
              <th>Primary Platform & Usage</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Hero / Banner</strong></td>
              <td>1920 × 1080 px</td>
              <td>16:9</td>
              <td>Homepage headers, desktop splash screens, presentation decks</td>
            </tr>
            <tr>
              <td><strong>Social Card (OG)</strong></td>
              <td>1200 × 630 px</td>
              <td>1.91:1</td>
              <td>Open Graph previews on Twitter/X, Facebook, LinkedIn, Discord</td>
            </tr>
            <tr>
              <td><strong>Square Post</strong></td>
              <td>1080 × 1080 px</td>
              <td>1:1</td>
              <td>Instagram feed, product cards, e-commerce listings, app icons</td>
            </tr>
            <tr>
              <td><strong>Story / Reel</strong></td>
              <td>1080 × 1920 px</td>
              <td>9:16</td>
              <td>TikTok, Instagram Stories, YouTube Shorts, mobile onboarding</td>
            </tr>
            <tr>
              <td><strong>Article Feature</strong></td>
              <td>800 × 450 px</td>
              <td>16:9</td>
              <td>Blog featured graphics, technical documentation, news thumbnails</td>
            </tr>
            <tr>
              <td><strong>UI Card / Grid</strong></td>
              <td>600 × 400 px</td>
              <td>3:2</td>
              <td>SaaS feature grids, dashboard modules, portfolio case studies</td>
            </tr>
            <tr>
              <td><strong>Avatar / Profile</strong></td>
              <td>400 × 400 px</td>
              <td>1:1</td>
              <td>User profile pictures, team headshots, customer testimonials</td>
            </tr>
            <tr>
              <td><strong>Ad Leaderboard</strong></td>
              <td>728 × 90 px</td>
              <td>8.08:1</td>
              <td>Header ad slots, forum banner ads, sponsor placements</td>
            </tr>
            <tr>
              <td><strong>Medium Rectangle</strong></td>
              <td>300 × 250 px</td>
              <td>1.2:1</td>
              <td>Sidebar display ads, in-feed sponsored promotion units</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 5: Vector SVG vs Raster Formats -->
      <h2>{t(locale, 'placeholder.content.h5')}</h2>
      <p>{t(locale, 'placeholder.content.p5a')}</p>
      <p>{t(locale, 'placeholder.content.p5b')}</p>

      <!-- Section 6: Wireframing Color Psychology -->
      <h2>{t(locale, 'placeholder.content.h6')}</h2>
      <p>{t(locale, 'placeholder.content.p6a')}</p>
      <p>{t(locale, 'placeholder.content.p6b')}</p>

      <!-- Section 7: How to Embed -->
      <h2>{t(locale, 'placeholder.content.h7')}</h2>
      <p>{t(locale, 'placeholder.content.p7Intro')}</p>
      <ul>
        <li><strong>Direct HTML Tag:</strong> Paste the generated image URL or Data URI directly into <code>&lt;img src="..." alt="Placeholder" width="800" height="600" /&gt;</code>.</li>
        <li><strong>CSS Background:</strong> Use in stylesheets for layout testing: <code>background-image: url('data:image/svg+xml;utf8,...');</code>.</li>
        <li><strong>Markdown Docs:</strong> Embed in GitHub READMEs or Notion pages using <code>![Placeholder](...)</code>.</li>
        <li><strong>Inline SVG:</strong> Copy raw SVG XML markup into React, Vue, Svelte, or Astro components for zero-dependency vector rendering.</li>
      </ul>

      <!-- Section 8: FAQ -->
      <div class="faq-container">
        <h2>{t(locale, 'placeholder.faq.heading')}</h2>
        
        <div class="faq-accordion">
          <details class="faq-item" open>
            <summary class="faq-question"><h3>{t(locale, 'placeholder.faq.q1')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'placeholder.faq.a1')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'placeholder.faq.q2')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'placeholder.faq.a2')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'placeholder.faq.q3')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'placeholder.faq.a3')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'placeholder.faq.q4')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'placeholder.faq.a4')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'placeholder.faq.q5')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'placeholder.faq.a5')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'placeholder.faq.q6')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'placeholder.faq.a6')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'placeholder.faq.q7')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'placeholder.faq.a7')}</p></div>
          </details>
        </div>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .content-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-10) 0;
  }

  @media (min-width: 640px) {
    .content-section {
      padding: var(--space-12) 0;
    }
  }

  .content-body {
    max-width: var(--container-narrow);
    margin-inline: auto;
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.75;
    box-sizing: border-box;
  }

  .content-body h2 {
    color: var(--color-text);
    font-size: var(--text-xl);
    font-weight: 800;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    letter-spacing: -0.02em;
    line-height: 1.3;
    word-break: break-word;
  }

  @media (min-width: 640px) {
    .content-body h2 {
      font-size: var(--text-2xl);
      margin-top: var(--space-10);
      margin-bottom: var(--space-4);
    }
  }

  .content-body h2:first-child {
    margin-top: 0;
  }

  .content-body p {
    margin-bottom: var(--space-4);
  }

  .content-body ul {
    margin-bottom: var(--space-6);
    padding-left: var(--space-5);
  }

  .content-body li {
    margin-bottom: var(--space-2-5);
  }

  .content-body strong {
    color: var(--color-text);
  }

  .content-body code {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    font-size: 0.88em;
    color: var(--color-accent);
    font-family: monospace;
  }

  .feature-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin: var(--space-6) 0 var(--space-8) 0;
  }

  @media (min-width: 640px) {
    .feature-cards-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .feature-card {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .feature-card-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-card h3 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .feature-card p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .table-responsive {
    overflow-x: auto;
    margin: var(--space-6) 0 var(--space-8) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .data-table th,
  .data-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  .data-table th {
    background: var(--color-surface-subtle);
    font-weight: 700;
    color: var(--color-text);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  /* FAQ */
  .faq-container {
    margin-top: var(--space-12);
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
    overflow: hidden;
  }

  .faq-question {
    padding: var(--space-4);
    cursor: pointer;
    font-weight: 600;
    user-select: none;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question h3 {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: 700;
  }

  .faq-answer {
    padding: 0 var(--space-4) var(--space-4) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .faq-answer p {
    margin: 0;
  }
</style>

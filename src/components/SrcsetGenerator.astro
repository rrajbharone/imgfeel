---
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';
import { SRCSET_PRESETS, SIZES_PRESETS } from '@/scripts/srcset-generator';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="srcset-generator-wrapper" data-locale={locale}>
  <!-- Upload Dropzone (Initial State) -->
  <div id="dropzoneContainer" class="dropzone-container">
    <div id="dropzone" class="dropzone" role="button" tabindex="0" aria-label={t(locale, 'srcset.dropzone.title')}>
      <input type="file" id="fileInput" accept="image/jpeg,image/jpg,image/png,image/webp,image/avif,image/svg+xml" class="file-input" />
      <div class="dropzone-content">
        <div class="dropzone-icon">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
            <line x1="12" y1="2" x2="12" y2="22"></line>
          </svg>
        </div>
        <h2 class="dropzone-title">{t(locale, 'srcset.dropzone.title')}</h2>
        <p class="dropzone-subtitle">{t(locale, 'srcset.dropzone.subtitle')}</p>
        <div class="dropzone-actions">
          <button type="button" id="browseBtn" class="btn btn-primary btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            {t(locale, 'srcset.dropzone.browse')}
          </button>
          <button type="button" id="sampleBtn" class="btn btn-secondary btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 16v-4"></path>
              <path d="M12 8h.01"></path>
            </svg>
            {t(locale, 'srcset.dropzone.sample')}
          </button>
        </div>
        <div class="privacy-badge">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>{t(locale, 'srcset.privacy.badge')}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Active Workspace -->
  <div id="workspace" class="workspace" style="display: none;">
    <!-- Workspace Header / File Info Bar -->
    <div class="workspace-header-bar">
      <div class="file-info-col">
        <div class="file-title-row">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          <span id="fileNameDisplay" class="file-name">hero.jpg</span>
        </div>
        <div class="file-meta-row">
          <span id="naturalDimBadge" class="badge">1920 × 1080 px</span>
          <span id="aspectRatioBadge" class="badge">16:9 Aspect Ratio</span>
          <span id="breakpointsCountBadge" class="badge badge-accent">4 Breakpoints</span>
        </div>
      </div>
      <button type="button" id="changeImageBtn" class="btn btn-secondary btn-sm">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
        {t(locale, 'srcset.action.changeImage')}
      </button>
    </div>

    <!-- Error Banner -->
    <div id="errorBanner" class="error-banner" style="display: none;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <span id="errorMessage">An error occurred</span>
    </div>

    <!-- Main Workspace Grid -->
    <div class="workspace-grid">
      <!-- Settings & Breakpoints Column -->
      <div class="settings-col">
        <!-- Descriptor Mode Card -->
        <div class="control-group">
          <label class="field-label">{t(locale, 'srcset.label.descriptorMode')}</label>
          <div class="mode-options-list">
            <label class="radio-card active" id="modeWidthCard">
              <input type="radio" name="descriptorMode" value="width" checked />
              <div class="radio-card-body">
                <strong>{t(locale, 'srcset.desc.width')}</strong>
              </div>
            </label>
            <label class="radio-card" id="modeDensityCard">
              <input type="radio" name="descriptorMode" value="density" />
              <div class="radio-card-body">
                <strong>{t(locale, 'srcset.desc.density')}</strong>
              </div>
            </label>
          </div>
        </div>

        <!-- Width Breakpoints Card -->
        <div class="control-group" id="widthConfigGroup">
          <label for="widthPresetSelect" class="field-label">{t(locale, 'srcset.label.preset')}</label>
          <select id="widthPresetSelect" class="form-select">
            {SRCSET_PRESETS.map((p) => (
              <option value={p.id}>{p.name}</option>
            ))}
          </select>

          <label class="field-label" style="margin-top: 4px;">{t(locale, 'srcset.label.widths')}</label>
          <div class="width-chips-container" id="widthChipsContainer">
            <!-- Dynamic Chips Injected Here -->
          </div>

          <!-- Add Custom Width Input -->
          <div class="add-width-row">
            <input type="number" id="customWidthInput" class="form-input" placeholder={t(locale, 'srcset.placeholder.addWidth')} min="100" max="7680" />
            <button type="button" id="addWidthBtn" class="btn btn-secondary btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              {t(locale, 'srcset.label.addWidth')}
            </button>
          </div>
        </div>

        <!-- sizes Attribute Card -->
        <div class="control-group" id="sizesConfigGroup">
          <label for="sizesPresetSelect" class="field-label">{t(locale, 'srcset.label.sizesPreset')}</label>
          <select id="sizesPresetSelect" class="form-select">
            {SIZES_PRESETS.map((s) => (
              <option value={s.id}>{s.name}</option>
            ))}
          </select>

          <div class="custom-sizes-field" style="margin-top: 4px;">
            <label for="sizesCustomInput" class="field-label-sm">{t(locale, 'srcset.label.customSizes')}</label>
            <input type="text" id="sizesCustomInput" class="form-input" value="100vw" />
          </div>
        </div>

        <!-- Filename Pattern & Attributes Card -->
        <div class="control-group">
          <div class="field-row">
            <label for="pathPatternInput" class="field-label">{t(locale, 'srcset.label.pathPattern')}</label>
            <span class="field-hint">{t(locale, 'srcset.hint.pathPattern')}</span>
            <input type="text" id="pathPatternInput" class="form-input" value="images/{name}-{w}.{ext}" />
          </div>

          <div class="field-row" style="margin-top: 4px;">
            <label for="altTextInput" class="field-label">{t(locale, 'srcset.label.altText')}</label>
            <input type="text" id="altTextInput" class="form-input" placeholder="Descriptive image text" />
          </div>

          <div class="attributes-toggle-row" style="margin-top: 6px;">
            <label class="checkbox-inline">
              <input type="checkbox" id="lazyToggle" checked />
              <span>{t(locale, 'srcset.toggle.lazy')}</span>
            </label>
            <label class="checkbox-inline">
              <input type="checkbox" id="asyncToggle" checked />
              <span>{t(locale, 'srcset.toggle.async')}</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Generated Markup & Export Column -->
      <div class="output-col">
        <!-- Markup Code Card -->
        <div class="output-card">
          <div class="output-card-header">
            <div class="code-format-pills">
              <button type="button" class="format-pill active" data-format="html-img">
                <span>HTML &lt;img&gt;</span>
              </button>
              <button type="button" class="format-pill" data-format="html-picture">
                <span>HTML5 &lt;picture&gt;</span>
              </button>
              <button type="button" class="format-pill" data-format="react-jsx">
                <span>React JSX</span>
              </button>
            </div>
            <button type="button" id="copyCodeBtn" class="btn btn-primary btn-sm">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span id="copyBtnText">{t(locale, 'srcset.action.copyCode')}</span>
            </button>
          </div>

          <!-- Code Display Box -->
          <div class="code-box-wrapper">
            <pre class="code-pre"><code id="codeOutput" class="code-content"></code></pre>
          </div>
        </div>

        <!-- In-Browser Asset Resizer & ZIP Exporter Card -->
        <div class="output-card">
          <div class="export-header">
            <div class="export-title-col">
              <span class="export-title">Batch Resizer & ZIP Download</span>
              <span class="export-subtitle">Resize your image to all generated srcset widths directly in your browser</span>
            </div>
          </div>

          <div class="export-controls-grid">
            <div class="export-control-field">
              <label for="exportFormatSelect" class="field-label-sm">{t(locale, 'srcset.label.exportFormat')}</label>
              <select id="exportFormatSelect" class="form-select">
                <option value="image/webp" selected>WebP (Modern & Compact)</option>
                <option value="image/jpeg">JPEG (Standard Photographic)</option>
                <option value="image/png">PNG (Lossless)</option>
              </select>
            </div>

            <div class="export-control-field">
              <label for="exportQualitySelect" class="field-label-sm">{t(locale, 'srcset.label.exportQuality')}</label>
              <select id="exportQualitySelect" class="form-select">
                <option value="0.90">90% High Quality</option>
                <option value="0.82" selected>82% Balanced (Recommended)</option>
                <option value="0.75">75% High Compression</option>
              </select>
            </div>
          </div>

          <button type="button" id="downloadZipBtn" class="btn btn-primary btn-xl">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span id="zipBtnText">{t(locale, 'srcset.action.downloadZip')}</span>
          </button>
          <div id="zipProgressBar" class="progress-bar-container" style="display: none;">
            <div id="zipProgressFill" class="progress-fill" style="width: 0%;"></div>
          </div>
        </div>

        <!-- Generated Breakpoints Table Card -->
        <div class="output-card">
          <span class="export-title" style="margin-bottom: 8px;">Calculated Breakpoint Dimensions</span>
          <div class="table-container">
            <table class="breakpoints-table">
              <thead>
                <tr>
                  <th>Width</th>
                  <th>Height</th>
                  <th>Aspect Ratio</th>
                  <th>Generated Asset Name</th>
                </tr>
              </thead>
              <tbody id="breakpointsTableBody">
                <!-- Injected Rows -->
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    SrcsetGeneratorEngine,
    SRCSET_PRESETS,
    SIZES_PRESETS,
    type SrcsetOptions,
  } from '@/scripts/srcset-generator';

  document.addEventListener('DOMContentLoaded', () => {
    // DOM Elements
    const dropzoneContainer = document.getElementById('dropzoneContainer')!;
    const dropzone = document.getElementById('dropzone')!;
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const browseBtn = document.getElementById('browseBtn')!;
    const sampleBtn = document.getElementById('sampleBtn')!;
    const workspace = document.getElementById('workspace')!;
    const changeImageBtn = document.getElementById('changeImageBtn')!;
    const fileNameDisplay = document.getElementById('fileNameDisplay')!;
    const naturalDimBadge = document.getElementById('naturalDimBadge')!;
    const aspectRatioBadge = document.getElementById('aspectRatioBadge')!;
    const breakpointsCountBadge = document.getElementById('breakpointsCountBadge')!;
    const errorBanner = document.getElementById('errorBanner')!;
    const errorMessage = document.getElementById('errorMessage')!;

    // Controls
    const modeWidthCard = document.getElementById('modeWidthCard')!;
    const modeDensityCard = document.getElementById('modeDensityCard')!;
    const widthPresetSelect = document.getElementById('widthPresetSelect') as HTMLSelectElement;
    const widthChipsContainer = document.getElementById('widthChipsContainer')!;
    const customWidthInput = document.getElementById('customWidthInput') as HTMLInputElement;
    const addWidthBtn = document.getElementById('addWidthBtn')!;
    const sizesPresetSelect = document.getElementById('sizesPresetSelect') as HTMLSelectElement;
    const sizesCustomInput = document.getElementById('sizesCustomInput') as HTMLInputElement;
    const pathPatternInput = document.getElementById('pathPatternInput') as HTMLInputElement;
    const altTextInput = document.getElementById('altTextInput') as HTMLInputElement;
    const lazyToggle = document.getElementById('lazyToggle') as HTMLInputElement;
    const asyncToggle = document.getElementById('asyncToggle') as HTMLInputElement;

    // Output & Copy
    const formatPills = document.querySelectorAll('.format-pill');
    const codeOutput = document.getElementById('codeOutput')!;
    const copyCodeBtn = document.getElementById('copyCodeBtn')!;
    const copyBtnText = document.getElementById('copyBtnText')!;
    const exportFormatSelect = document.getElementById('exportFormatSelect') as HTMLSelectElement;
    const exportQualitySelect = document.getElementById('exportQualitySelect') as HTMLSelectElement;
    const downloadZipBtn = document.getElementById('downloadZipBtn')!;
    const zipBtnText = document.getElementById('zipBtnText')!;
    const zipProgressBar = document.getElementById('zipProgressBar')!;
    const zipProgressFill = document.getElementById('zipProgressFill')!;
    const breakpointsTableBody = document.getElementById('breakpointsTableBody')!;

    // State
    let currentImage: HTMLImageElement | null = null;
    let currentFileName = 'hero.jpg';
    let baseFileName = 'hero';
    let fileExtension = 'jpg';

    const options: SrcsetOptions = {
      descriptorMode: 'width',
      widths: [480, 768, 1024, 1440],
      densities: [1, 2, 3],
      sizesAttribute: '100vw',
      fileNamePattern: 'images/{name}-{w}.{ext}',
      altText: '',
      lazyLoad: true,
      asyncDecoding: true,
      outputFormat: 'html-img',
      exportImageFormat: 'image/webp',
      exportQuality: 0.82,
    };

    function showError(msg: string) {
      errorMessage.textContent = msg;
      errorBanner.style.display = 'flex';
    }

    function hideError() {
      errorBanner.style.display = 'none';
    }

    function renderWidthChips() {
      widthChipsContainer.innerHTML = '';
      const sorted = [...options.widths].sort((a, b) => a - b);
      sorted.forEach((w) => {
        const chip = document.createElement('div');
        chip.className = 'width-chip';
        chip.innerHTML = `
          <span class="chip-text">${w}px</span>
          <button type="button" class="chip-remove-btn" data-width="${w}" aria-label="Remove ${w}px">&times;</button>
        `;
        widthChipsContainer.appendChild(chip);
      });

      // Bind remove handlers
      widthChipsContainer.querySelectorAll('.chip-remove-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const targetW = parseInt((e.currentTarget as HTMLElement).getAttribute('data-width') || '0', 10);
          options.widths = options.widths.filter((w) => w !== targetW);
          if (options.widths.length === 0) {
            options.widths = [currentImage?.naturalWidth || 800];
          }
          renderWidthChips();
          updateCodeOutput();
        });
      });

      breakpointsCountBadge.textContent = `${options.widths.length} Breakpoints`;
    }

    function updateCodeOutput() {
      if (!currentImage) return;

      // Generate Code
      const code = SrcsetGeneratorEngine.generateCode(
        currentImage.naturalWidth,
        currentImage.naturalHeight,
        baseFileName,
        fileExtension,
        options
      );

      codeOutput.textContent = code;

      // Update Breakpoints Table
      const aspectRatio = currentImage.naturalWidth / currentImage.naturalHeight;
      const sorted = [...options.widths].sort((a, b) => a - b);
      breakpointsTableBody.innerHTML = '';

      sorted.forEach((w) => {
        const h = Math.round(w / aspectRatio);
        const tr = document.createElement('tr');
        const filename = SrcsetGeneratorEngine.formatFilename(
          options.fileNamePattern,
          baseFileName,
          w,
          h,
          1,
          fileExtension
        );
        tr.innerHTML = `
          <td><strong>${w} px</strong></td>
          <td>${h} px</td>
          <td>${aspectRatio.toFixed(2)}:1</td>
          <td class="code-mono">${filename}</td>
        `;
        breakpointsTableBody.appendChild(tr);
      });
    }

    async function handleImageLoaded(file: File | Blob, name: string) {
      try {
        hideError();
        currentFileName = name;
        baseFileName = name.replace(/\.[^/.]+$/, '');
        fileExtension = name.split('.').pop()?.toLowerCase() || 'jpg';
        fileNameDisplay.textContent = name;

        const img = new Image();
        img.src = URL.createObjectURL(file);
        await new Promise((resolve, reject) => {
          img.onload = () => resolve(img);
          img.onerror = () => reject(new Error('Failed to decode image file.'));
        });

        currentImage = img;

        naturalDimBadge.textContent = `${img.naturalWidth} × ${img.naturalHeight} px`;
        const ar = (img.naturalWidth / img.naturalHeight).toFixed(2);
        aspectRatioBadge.textContent = `${ar}:1 Aspect Ratio`;

        // Smart width auto-suggestion
        options.widths = SrcsetGeneratorEngine.suggestWidths(img.naturalWidth);

        dropzoneContainer.style.display = 'none';
        workspace.style.display = 'block';

        renderWidthChips();
        updateCodeOutput();
      } catch (err: any) {
        showError(err.message || 'Failed to load image.');
      }
    }

    // Descriptor Mode Radio
    document.querySelectorAll('input[name="descriptorMode"]').forEach((radio) => {
      radio.addEventListener('change', (e) => {
        const val = (e.target as HTMLInputElement).value as 'width' | 'density';
        options.descriptorMode = val;
        if (val === 'width') {
          modeWidthCard.classList.add('active');
          modeDensityCard.classList.remove('active');
          document.getElementById('sizesConfigGroup')!.style.display = 'flex';
        } else {
          modeDensityCard.classList.add('active');
          modeWidthCard.classList.remove('active');
          document.getElementById('sizesConfigGroup')!.style.display = 'none';
        }
        updateCodeOutput();
      });
    });

    // Preset Selection
    widthPresetSelect.addEventListener('change', () => {
      const found = SRCSET_PRESETS.find((p) => p.id === widthPresetSelect.value);
      if (found) {
        options.widths = [...found.widths];
        renderWidthChips();
        updateCodeOutput();
      }
    });

    // Add Custom Width
    addWidthBtn.addEventListener('click', () => {
      const val = parseInt(customWidthInput.value, 10);
      if (val && val > 0 && !options.widths.includes(val)) {
        options.widths.push(val);
        customWidthInput.value = '';
        renderWidthChips();
        updateCodeOutput();
      }
    });

    customWidthInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        addWidthBtn.click();
      }
    });

    // sizes Preset
    sizesPresetSelect.addEventListener('change', () => {
      const found = SIZES_PRESETS.find((s) => s.id === sizesPresetSelect.value);
      if (found && found.value) {
        sizesCustomInput.value = found.value;
        options.sizesAttribute = found.value;
      }
      updateCodeOutput();
    });

    sizesCustomInput.addEventListener('input', () => {
      options.sizesAttribute = sizesCustomInput.value;
      updateCodeOutput();
    });

    pathPatternInput.addEventListener('input', () => {
      options.fileNamePattern = pathPatternInput.value || 'images/{name}-{w}.{ext}';
      updateCodeOutput();
    });

    altTextInput.addEventListener('input', () => {
      options.altText = altTextInput.value;
      updateCodeOutput();
    });

    lazyToggle.addEventListener('change', () => {
      options.lazyLoad = lazyToggle.checked;
      updateCodeOutput();
    });

    asyncToggle.addEventListener('change', () => {
      options.asyncDecoding = asyncToggle.checked;
      updateCodeOutput();
    });

    // Format Pills
    formatPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        formatPills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        options.outputFormat = pill.getAttribute('data-format') as any;
        updateCodeOutput();
      });
    });

    // Copy Code Button
    copyCodeBtn.addEventListener('click', async () => {
      const text = codeOutput.textContent || '';
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        copyBtnText.textContent = 'Code Copied!';
        copyCodeBtn.classList.add('btn-success');
        setTimeout(() => {
          copyBtnText.textContent = 'Copy Markup Code';
          copyCodeBtn.classList.remove('btn-success');
        }, 2000);
      } catch {
        // Fallback
        const textarea = document.createElement('textarea');
        textarea.value = text;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        copyBtnText.textContent = 'Code Copied!';
        setTimeout(() => {
          copyBtnText.textContent = 'Copy Markup Code';
        }, 2000);
      }
    });

    // Batch Resizer & ZIP Exporter
    exportFormatSelect.addEventListener('change', () => {
      options.exportImageFormat = exportFormatSelect.value as any;
    });

    exportQualitySelect.addEventListener('change', () => {
      options.exportQuality = parseFloat(exportQualitySelect.value);
    });

    downloadZipBtn.addEventListener('click', async () => {
      if (!currentImage) return;

      try {
        downloadZipBtn.setAttribute('disabled', 'true');
        zipBtnText.textContent = 'Resizing & Packaging...';
        zipProgressBar.style.display = 'block';
        zipProgressFill.style.width = '10%';

        const zipBlob = await SrcsetGeneratorEngine.generateResizedZip(
          currentImage,
          baseFileName,
          options.widths,
          options.exportImageFormat,
          options.exportQuality,
          (curr, total) => {
            const pct = Math.round((curr / total) * 100);
            zipProgressFill.style.width = `${pct}%`;
          }
        );

        const url = URL.createObjectURL(zipBlob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${baseFileName}-responsive-srcset.zip`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);

        zipBtnText.textContent = 'Download Complete!';
        setTimeout(() => {
          downloadZipBtn.removeAttribute('disabled');
          zipBtnText.textContent = 'Download Resized Images (.ZIP)';
          zipProgressBar.style.display = 'none';
        }, 2500);
      } catch (err: any) {
        showError('Failed to generate ZIP archive: ' + err.message);
        downloadZipBtn.removeAttribute('disabled');
        zipBtnText.textContent = 'Download Resized Images (.ZIP)';
        zipProgressBar.style.display = 'none';
      }
    });

    // Upload Handlers
    browseBtn.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('click', (e) => {
      if (e.target === sampleBtn || sampleBtn.contains(e.target as Node)) return;
      fileInput.click();
    });

    sampleBtn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const sample = await SrcsetGeneratorEngine.generateSampleImage();
      handleImageLoaded(sample.file, sample.file.name);
    });

    changeImageBtn.addEventListener('click', () => {
      fileInput.value = '';
      fileInput.click();
    });

    fileInput.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) handleImageLoaded(file, file.name);
    });

    // Drag & Drop
    ['dragenter', 'dragover'].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropzone.classList.add('drag-over');
      });
    });

    ['dragleave', 'drop'].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropzone.classList.remove('drag-over');
      });
    });

    dropzone.addEventListener('drop', (e) => {
      const file = e.dataTransfer?.files[0];
      if (file) handleImageLoaded(file, file.name);
    });
  });
</script>


---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';
import { getToolUrl } from '@/data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const webpUrl = getToolUrl('webp-compressor', locale);
const exactUrl = getToolUrl('exact-dimension-resizer', locale);
const dimCheckUrl = getToolUrl('image-dimensions-checker', locale);
---

<div
  class="file-size-checker"
  id="file-size-checker-app"
>
  <!-- Upload State -->
  <div class="checker-upload" id="size-upload">
    <div class="dropzone" id="size-dropzone">
      <div class="dropzone-icon-box">
        <svg class="dropzone-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="12" y1="18" x2="12" y2="12"></line>
          <line x1="9" y1="15" x2="15" y2="15"></line>
        </svg>
      </div>
      <p class="dropzone-title">{t(locale, 'sizecheck.dropzone.title')}</p>
      <p class="dropzone-subtitle">{t(locale, 'sizecheck.dropzone.subtitle')}</p>
      
      <div class="dropzone-actions">
        <button type="button" class="btn btn-primary btn-browse">{t(locale, 'sizecheck.dropzone.browse')}</button>
        <button type="button" class="btn btn-secondary btn-sm" id="size-btn-sample">{t(locale, 'sizecheck.dropzone.sample')}</button>
      </div>

      <div class="dropzone-footer">
        <p class="dropzone-formats">{t(locale, 'sizecheck.dropzone.formats')}</p>
        <span class="privacy-badge">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>{t(locale, 'sizecheck.privacy.badge')}</span>
        </span>
      </div>

      <input
        type="file"
        id="size-file-input"
        accept="image/*,.jpg,.jpeg,.png,.webp,.gif,.svg,.avif,.bmp,.ico,.tiff"
        class="sr-only"
      />
    </div>
  </div>

  <!-- Editor / Results State (Hidden initially) -->
  <div class="checker-editor" id="size-editor" hidden>
    <!-- Top Action Bar -->
    <div class="top-action-bar">
      <div class="bar-left">
        <span class="status-indicator"></span>
        <span class="status-text">{t(locale, 'sizecheck.status.analyzed')}</span>
      </div>
      <div class="bar-right">
        <button type="button" class="btn btn-secondary btn-sm action-btn" id="size-btn-copy-size">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span>{t(locale, 'sizecheck.action.copySize')}</span>
        </button>
        <button type="button" class="btn btn-secondary btn-sm action-btn" id="size-btn-copy-report">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
          </svg>
          <span>{t(locale, 'sizecheck.action.copyReport')}</span>
        </button>
        <button type="button" class="btn btn-primary btn-sm action-btn action-new" id="size-btn-new">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'sizecheck.action.newImage')}</span>
        </button>
      </div>
    </div>

    <!-- Main Grid: Preview & Metrics -->
    <div class="editor-grid">
      <!-- Left Column: Preview & Web Performance Health Card -->
      <div class="preview-column">
        <div class="preview-card">
          <div class="preview-viewport">
            <img id="size-preview" class="preview-img" alt="Uploaded image preview" />
            <!-- Live Overlay Badges -->
            <div class="preview-overlay">
              <span class="preview-tag tag-kb" id="size-badge-kb">—</span>
              <span class="preview-tag tag-bytes" id="size-badge-bytes">—</span>
              <span class="preview-tag tag-rating" id="size-badge-rating">—</span>
            </div>
          </div>
        </div>

        <!-- Web Health & SEO Scorecard -->
        <div class="health-card">
          <div class="card-header-compact">
            <span class="header-title">{t(locale, 'sizecheck.section.webHealth')}</span>
          </div>
          <div class="health-body">
            <span class="web-health-pill" id="size-rating-badge">—</span>
            <p class="health-desc" id="size-rating-desc">—</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Primary Key Metric Cards & Detail Sections -->
      <div class="metrics-column">
        <div class="summary-cards-grid">
          <!-- Card 1: Kilobytes -->
          <div class="metric-card highlight-card">
            <div class="metric-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
            </div>
            <div class="metric-info">
              <span class="metric-label">{t(locale, 'sizecheck.metric.kilobytes')}</span>
              <span class="metric-value-lg" id="size-val-kb">—</span>
            </div>
          </div>

          <!-- Card 2: Bytes & Bits -->
          <div class="metric-card">
            <div class="metric-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="4" y1="9" x2="20" y2="9"></line>
                <line x1="4" y1="15" x2="20" y2="15"></line>
                <line x1="10" y1="3" x2="8" y2="21"></line>
                <line x1="16" y1="3" x2="14" y2="21"></line>
              </svg>
            </div>
            <div class="metric-info">
              <span class="metric-label">{t(locale, 'sizecheck.metric.bytes')}</span>
              <span class="metric-value" id="size-val-bytes">—</span>
            </div>
          </div>

          <!-- Card 3: Megabytes -->
          <div class="metric-card">
            <div class="metric-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </div>
            <div class="metric-info">
              <span class="metric-label">{t(locale, 'sizecheck.metric.megabytes')}</span>
              <span class="metric-value" id="size-val-mb">—</span>
            </div>
          </div>

          <!-- Card 4: Bits Per Pixel (BPP) -->
          <div class="metric-card">
            <div class="metric-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
            </div>
            <div class="metric-info">
              <span class="metric-label">{t(locale, 'sizecheck.metric.bpp')}</span>
              <span class="metric-value" id="size-val-bpp">—</span>
            </div>
          </div>
        </div>

        <!-- Section 1: Estimated Network Download Times -->
        <div class="detail-card">
          <div class="header-with-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12.55a11 11 0 0 1 14.08 0"></path>
              <path d="M1.42 9a16 16 0 0 1 21.16 0"></path>
              <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
              <line x1="12" y1="20" x2="12.01" y2="20"></line>
            </svg>
            <h3 class="detail-title">{t(locale, 'sizecheck.section.loadTimes')}</h3>
          </div>

          <div class="network-grid">
            <div class="net-item">
              <span class="net-speed">5G / Fiber (100 Mbps)</span>
              <span class="net-time" id="size-lt-fiber">—</span>
            </div>
            <div class="net-item">
              <span class="net-speed">4G LTE (25 Mbps)</span>
              <span class="net-time" id="size-lt-4g">—</span>
            </div>
            <div class="net-item">
              <span class="net-speed">Fast 3G (1.6 Mbps)</span>
              <span class="net-time" id="size-lt-3g-fast">—</span>
            </div>
            <div class="net-item">
              <span class="net-speed">Slow 3G (400 Kbps)</span>
              <span class="net-time" id="size-lt-3g-slow">—</span>
            </div>
            <div class="net-item">
              <span class="net-speed">2G / Edge (50 Kbps)</span>
              <span class="net-time" id="size-lt-2g">—</span>
            </div>
          </div>
        </div>

        <!-- Section 2: Storage & Upload Limits Calculator -->
        <div class="detail-card">
          <div class="header-with-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
              <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
              <line x1="6" y1="6" x2="6.01" y2="6"></line>
              <line x1="6" y1="18" x2="6.01" y2="18"></line>
            </svg>
            <h3 class="detail-title">{t(locale, 'sizecheck.section.storage')}</h3>
          </div>

          <div class="specs-table">
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'sizecheck.storage.email')}</span>
              <span class="spec-value" id="size-cap-email">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'sizecheck.storage.fit1g')}</span>
              <span class="spec-value" id="size-cap-1g">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'sizecheck.storage.fit16g')}</span>
              <span class="spec-value" id="size-cap-16g">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'sizecheck.storage.fit64g')}</span>
              <span class="spec-value" id="size-cap-64g">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'sizecheck.storage.fit128g')}</span>
              <span class="spec-value" id="size-cap-128g">—</span>
            </div>
          </div>
        </div>

        <!-- Section 3: Technical & Compression Properties -->
        <div class="detail-card">
          <div class="header-with-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <h3 class="detail-title">{t(locale, 'sizecheck.section.technical')}</h3>
          </div>

          <div class="specs-table">
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'sizecheck.table.filename')}</span>
              <span class="spec-value" id="size-table-filename">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'sizecheck.table.mime')}</span>
              <span class="spec-value" id="size-table-mime">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'sizecheck.table.format')}</span>
              <span class="spec-value" id="size-table-format">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'sizecheck.table.dimensions')}</span>
              <span class="spec-value" id="size-table-dimensions">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'sizecheck.table.megapixels')}</span>
              <span class="spec-value" id="size-table-mp">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'sizecheck.table.aspectRatio')}</span>
              <span class="spec-value" id="size-table-aspect">—</span>
            </div>
          </div>
        </div>

        <!-- Next Actions / Tool Suggestions -->
        <div class="tool-links-box">
          <p class="tool-links-title">{t(locale, 'sizecheck.nextActions.title')}</p>
          <div class="tool-quick-links">
            <a href={webpUrl} class="btn btn-secondary btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
              <span>{t(locale, 'sizecheck.nextActions.compress')}</span>
            </a>
            <a href={exactUrl} class="btn btn-secondary btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 3 21 3 21 9"></polyline>
                <polyline points="9 21 3 21 3 15"></polyline>
                <line x1="21" y1="3" x2="14" y2="10"></line>
                <line x1="3" y1="21" x2="10" y2="14"></line>
              </svg>
              <span>{t(locale, 'sizecheck.nextActions.resize')}</span>
            </a>
            <a href={dimCheckUrl} class="btn btn-secondary btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 7V5a2 2 0 0 1 2-2h2"></path>
                <path d="M17 3h2a2 2 0 0 1 2 2v2"></path>
                <path d="M21 17v2a2 2 0 0 1-2 2h-2"></path>
                <path d="M7 21H5a2 2 0 0 1-2-2v-2"></path>
                <rect x="7" y="7" width="10" height="10" rx="1"></rect>
              </svg>
              <span>{t(locale, 'sizecheck.nextActions.dimCheck')}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Error State -->
  <div class="checker-error" id="size-error" hidden>
    <p id="size-error-msg"></p>
  </div>
</div>

<script src="@/scripts/file-size-checker.ts"></script>

<style>
  .file-size-checker {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    box-sizing: border-box;
  }

  /* --- Dropzone --- */
  .dropzone {
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8) var(--space-4);
    text-align: center;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    max-width: 680px;
    margin-inline: auto;
    box-shadow: var(--shadow-sm);
    box-sizing: border-box;
    width: 100%;
  }

  @media (min-width: 640px) {
    .dropzone {
      padding: var(--space-12) var(--space-6);
    }
  }

  .dropzone:hover,
  .dropzone-active {
    border-color: var(--color-accent);
    background: var(--color-accent-light);
    transform: translateY(-2px);
  }

  .dropzone-icon-box {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-lg);
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-1);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .dropzone-icon-box {
      width: 60px;
      height: 60px;
    }
  }

  .dropzone:hover .dropzone-icon-box {
    transform: scale(1.05);
  }

  .dropzone-title {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--color-text);
    margin: 0;
    letter-spacing: -0.01em;
  }

  @media (min-width: 640px) {
    .dropzone-title {
      font-size: var(--text-xl);
    }
  }

  .dropzone-subtitle {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    max-width: 440px;
    line-height: 1.5;
    margin: 0;
  }

  @media (min-width: 640px) {
    .dropzone-subtitle {
      font-size: var(--text-sm);
    }
  }

  .dropzone-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-block: var(--space-1);
    width: 100%;
  }

  .btn-browse {
    pointer-events: none;
  }

  .dropzone-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
    width: 100%;
  }

  .dropzone-formats {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.4;
    max-width: 100%;
    word-break: break-word;
  }

  .privacy-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    color: #065f46;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    max-width: 100%;
    text-align: center;
  }

  /* --- Editor Layout --- */
  .checker-editor {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .checker-editor {
      gap: var(--space-6);
    }
  }

  /* Top Action Bar */
  .top-action-bar {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 640px) {
    .top-action-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: var(--space-3) var(--space-4);
    }
  }

  .bar-left {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  @media (min-width: 640px) {
    .bar-left {
      justify-content: flex-start;
    }
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 0 3px var(--color-success-light);
    flex-shrink: 0;
  }

  .status-text {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .bar-right {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    width: 100%;
  }

  @media (min-width: 640px) {
    .bar-right {
      display: flex;
      align-items: center;
      width: auto;
      gap: var(--space-2);
    }
  }

  .action-btn {
    width: 100%;
    padding: 8px 10px;
    font-size: var(--text-xs);
    min-height: 38px;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    white-space: nowrap;
  }

  @media (max-width: 639px) {
    .action-new {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 640px) {
    .action-btn {
      width: auto;
    }
  }

  /* Main 2-Column Editor Grid */
  .editor-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: start;
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 900px) {
    .editor-grid {
      grid-template-columns: 360px 1fr;
      gap: var(--space-6);
    }
  }

  /* Left Preview Column */
  .preview-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 900px) {
    .preview-column {
      position: sticky;
      top: calc(var(--header-height) + 16px);
      gap: var(--space-4);
    }

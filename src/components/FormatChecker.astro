---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';
import { getToolUrl } from '@/data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const webpUrl = getToolUrl('webp-compressor', locale);
const exactUrl = getToolUrl('exact-dimension-resizer', locale);
const base64Url = getToolUrl('image-to-base64-converter', locale);
const dpiUrl = getToolUrl('image-dpi-checker', locale);

const i18nDict = {
  statusAnalyzed: t(locale, 'fmtcheck.status.analyzed'),
  errorLoad: t(locale, 'fmtcheck.error.load'),
  errorFormat: t(locale, 'fmtcheck.error.format'),
  matchedExt: t(locale, 'fmtcheck.verdict.matched'),
  mismatchedExt: t(locale, 'fmtcheck.verdict.mismatched'),
  mismatchedDesc: t(locale, 'fmtcheck.verdict.mismatchedDesc'),
  alphaYes: t(locale, 'fmtcheck.feat.alphaYes'),
  alphaNo: t(locale, 'fmtcheck.feat.alphaNo'),
  animYes: t(locale, 'fmtcheck.feat.animYes'),
  animNo: t(locale, 'fmtcheck.feat.animNo'),
  lossy: t(locale, 'fmtcheck.feat.lossy'),
  lossless: t(locale, 'fmtcheck.feat.lossless'),
  vector: t(locale, 'fmtcheck.feat.vector'),
  uncompressed: t(locale, 'fmtcheck.feat.uncompressed'),
};
---

<div class="fmt-tool-wrapper" id="formatCheckerApp" data-i18n={JSON.stringify(i18nDict)}>
  <!-- Dropzone / Upload State -->
  <div class="fmt-dropzone-card" id="fmtDropzone">
    <div class="fmt-dropzone-content">
      <div class="fmt-icon-circle">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <polyline points="9 15 11 17 15 13"></polyline>
        </svg>
      </div>

      <h2 class="fmt-drop-title">{t(locale, 'fmtcheck.dropzone.title')}</h2>
      <p class="fmt-drop-subtitle">{t(locale, 'fmtcheck.dropzone.subtitle')}</p>

      <div class="fmt-btn-row">
        <label class="btn btn-primary fmt-btn-primary" for="fmtFileInput">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'fmtcheck.dropzone.browse')}</span>
        </label>
        <input type="file" id="fmtFileInput" accept="image/*,.jpg,.jpeg,.png,.webp,.gif,.svg,.avif,.heic,.heif,.bmp,.tiff,.tif,.ico,.psd" class="sr-only" />

        <button type="button" class="btn btn-secondary fmt-sample-btn" id="fmtSampleWebpBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          <span>{t(locale, 'fmtcheck.dropzone.sampleWebp')}</span>
        </button>

        <button type="button" class="btn btn-secondary fmt-sample-btn" id="fmtSampleMismatchBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          <span>{t(locale, 'fmtcheck.dropzone.sampleMismatch')}</span>
        </button>
      </div>

      <p class="fmt-formats-hint">{t(locale, 'fmtcheck.dropzone.formats')}</p>

      <div class="fmt-privacy-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span>{t(locale, 'fmtcheck.privacy.badge')}</span>
      </div>
    </div>
  </div>

  <!-- Loading State -->
  <div class="fmt-loading-card" id="fmtLoadingCard" style="display: none;">
    <div class="fmt-spinner"></div>
    <p class="fmt-loading-text">{t(locale, 'fmtcheck.status.analyzing')}</p>
  </div>

  <!-- Results Workspace -->
  <div class="fmt-results-view" id="fmtResultsView" style="display: none;">
    <!-- Top Meta & Action Bar -->
    <div class="fmt-results-header">
      <div class="fmt-meta-badge">
        <span class="fmt-status-dot"></span>
        <span id="fmtMetaFileName" class="fmt-filename-label">image.webp</span>
        <span class="fmt-meta-tag" id="fmtMetaResolution">1200 × 800 px</span>
        <span class="fmt-meta-tag" id="fmtMetaFileSize">450 KB</span>
      </div>

      <div class="fmt-header-actions">
        <button type="button" class="btn btn-secondary btn-sm" id="fmtNewImageBtn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'fmtcheck.action.newImage')}</span>
        </button>
      </div>
    </div>

    <!-- Mismatch Warning Banner (Shown only when extension is spoofed/mismatched) -->
    <div class="fmt-mismatch-banner" id="fmtMismatchBanner" style="display: none;">
      <div class="mismatch-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
          <line x1="12" y1="9" x2="12" y2="13"></line>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
      </div>
      <div class="mismatch-text">
        <strong id="fmtMismatchHeading">{t(locale, 'fmtcheck.verdict.mismatched')}</strong>
        <p id="fmtMismatchText">This file has a .jpg extension, but its internal binary signature confirms it is actually a WebP image.</p>
      </div>
    </div>

    <!-- Format Hero Verdict Card -->
    <div class="fmt-verdict-card" id="fmtVerdictCard">
      <div class="fmt-verdict-left">
        <span class="verdict-label">{t(locale, 'fmtcheck.card.detectedFormat')}</span>
        <div class="verdict-format-row">
          <strong id="fmtHeroFormat">WebP (Extended VP8X)</strong>
          <span class="verdict-tag tag-success" id="fmtHeroTag">MIME: image/webp</span>
        </div>
        <p class="verdict-desc" id="fmtHeroDesc">Modern high-efficiency format offering superior compression for web graphics.</p>
      </div>

      <div class="fmt-verdict-right">
        <div class="preview-thumb-wrap">
          <img id="fmtPreviewImg" src="" alt="Analyzed format preview" class="preview-thumb" />
        </div>
      </div>
    </div>

    <!-- 4 Key Stat Metric Boxes -->
    <div class="fmt-metrics-grid">
      <!-- Box 1: MIME & Container -->
      <div class="metric-box highlight-box">
        <div class="metric-icon-wrap">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
          </svg>
        </div>
        <span class="metric-title">{t(locale, 'fmtcheck.box.mimeTitle')}</span>
        <strong class="metric-val" id="boxMimeVal">image/webp</strong>
        <span class="metric-sub" id="boxMimeSub">Google WebP Container</span>
      </div>

      <!-- Box 2: Extension Analysis -->
      <div class="metric-box">
        <div class="metric-icon-wrap">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
        </div>
        <span class="metric-title">{t(locale, 'fmtcheck.box.extTitle')}</span>
        <strong class="metric-val" id="boxExtVal">.webp (Matched)</strong>
        <span class="metric-sub" id="boxExtSub">Declared matches binary magic bytes</span>
      </div>

      <!-- Box 3: Compression & Alpha -->
      <div class="metric-box">
        <div class="metric-icon-wrap">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
            <path d="M2 12h20"></path>
          </svg>
        </div>
        <span class="metric-title">{t(locale, 'fmtcheck.box.compressionTitle')}</span>
        <strong class="metric-val" id="boxCompressionVal">Lossless (With Alpha)</strong>
        <span class="metric-sub" id="boxCompressionSub">Static Graphic • 32-bit RGBA</span>
      </div>

      <!-- Box 4: Dimensions & Weight -->
      <div class="metric-box">
        <div class="metric-icon-wrap">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </div>
        <span class="metric-title">{t(locale, 'fmtcheck.box.dimensionsTitle')}</span>
        <strong class="metric-val" id="boxDimensionsVal">1200 × 800 px</strong>
        <span class="metric-sub" id="boxDimensionsSub">450 KB (3:2 Landscape)</span>
      </div>
    </div>

    <!-- Browser & Platform Compatibility Matrix -->
    <div class="fmt-table-card">
      <div class="table-card-header">
        <h3>{t(locale, 'fmtcheck.compat.title')}</h3>
        <p>{t(locale, 'fmtcheck.compat.subtitle')}</p>
      </div>

      <div class="table-responsive-wrap">
        <table class="fmt-compat-table">
          <thead>
            <tr>
              <th>{t(locale, 'fmtcheck.th.browser')}</th>
              <th>{t(locale, 'fmtcheck.th.compatibility')}</th>
              <th>{t(locale, 'fmtcheck.th.notes')}</th>
            </tr>
          </thead>
          <tbody id="fmtCompatBody">
            <!-- Rendered dynamically -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Technical Specs & Magic Byte Accordion -->
    <details class="fmt-specs-accordion">
      <summary class="specs-summary">
        <span>{t(locale, 'fmtcheck.specs.heading')}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="accordion-arrow" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </summary>

      <div class="specs-grid">
        <div class="spec-item">
          <span class="spec-k">{t(locale, 'fmtcheck.spec.magicHex')}:</span>
          <strong class="spec-v" id="specMagicHex">52 49 46 46 57 45 42 50</strong>
        </div>
        <div class="spec-item">
          <span class="spec-k">{t(locale, 'fmtcheck.spec.container')}:</span>
          <strong class="spec-v" id="specContainer">Google WebP Extended</strong>
        </div>
        <div class="spec-item">
          <span class="spec-k">{t(locale, 'fmtcheck.spec.colorDepth')}:</span>
          <strong class="spec-v" id="specColorDepth">32-bit RGBA</strong>
        </div>
        <div class="spec-item">
          <span class="spec-k">{t(locale, 'fmtcheck.spec.alphaSupport')}:</span>
          <strong class="spec-v" id="specAlphaSupport">Yes (Transparent)</strong>
        </div>
        <div class="spec-item">
          <span class="spec-k">{t(locale, 'fmtcheck.spec.animation')}:</span>
          <strong class="spec-v" id="specAnimation">No (Static)</strong>
        </div>
        <div class="spec-item">
          <span class="spec-k">{t(locale, 'fmtcheck.spec.declaredExt')}:</span>
          <strong class="spec-v" id="specDeclaredExt">.webp</strong>
        </div>
      </div>
    </details>

    <!-- Quick Action Tool Recommendations -->
    <div class="fmt-actions-row">
      <a href={webpUrl} class="btn btn-secondary action-link-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <span>{t(locale, 'fmtcheck.action.compressWebp')}</span>
      </a>

      <a href={exactUrl} class="btn btn-secondary action-link-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 3 21 3 21 9"></polyline>
          <polyline points="9 21 3 21 3 15"></polyline>
          <line x1="21" y1="3" x2="14" y2="10"></line>
          <line x1="3" y1="21" x2="10" y2="14"></line>
        </svg>
        <span>{t(locale, 'fmtcheck.action.resize')}</span>
      </a>

      <a href={base64Url} class="btn btn-secondary action-link-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
        <span>{t(locale, 'fmtcheck.action.toBase64')}</span>
      </a>

      <button type="button" class="btn btn-primary action-link-btn" id="fmtCheckAnotherBtn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
        <span>{t(locale, 'fmtcheck.action.checkAnother')}</span>
      </button>
    </div>
  </div>
</div>

<script>
  import {
    analyzeImageFormat,
    generateSampleWebp,
    generateSamplePng,
    generateSampleSvg,
    generateSampleMismatched,
    type FormatAnalysis,
  } from '@/scripts/format-checker';

  function initFormatChecker() {
    const container = document.getElementById('formatCheckerApp');
    if (!container) return;

    let i18n = {
      statusAnalyzed: 'Format Analyzed',
      errorLoad: 'Failed to analyze image format',
      errorFormat: 'Unsupported or unreadable file format',
      matchedExt: 'File extension matches actual binary format',
      mismatchedExt: 'Extension Mismatch Detected!',
      mismatchedDesc: 'This file is disguised or renamed with an incorrect extension.',
      alphaYes: 'Yes (Alpha Transparency)',
      alphaNo: 'No (Opaque)',
      animYes: 'Yes (Animated)',
      animNo: 'No (Static)',
      lossy: 'Lossy',
      lossless: 'Lossless',
      vector: 'Vector',
      uncompressed: 'Uncompressed',
    };

    try {
      const dataAttr = container.getAttribute('data-i18n');
      if (dataAttr) i18n = JSON.parse(dataAttr);
    } catch {
      // fallback
    }

    // Elements
    const dropzone = document.getElementById('fmtDropzone');
    const fileInput = document.getElementById('fmtFileInput') as HTMLInputElement | null;
    const sampleWebpBtn = document.getElementById('fmtSampleWebpBtn');
    const sampleMismatchBtn = document.getElementById('fmtSampleMismatchBtn');
    const loadingCard = document.getElementById('fmtLoadingCard');
    const resultsView = document.getElementById('fmtResultsView');

    // Header info
    const metaFileName = document.getElementById('fmtMetaFileName');
    const metaResolution = document.getElementById('fmtMetaResolution');
    const metaFileSize = document.getElementById('fmtMetaFileSize');
    const newImageBtn = document.getElementById('fmtNewImageBtn');
    const checkAnotherBtn = document.getElementById('fmtCheckAnotherBtn');

    // Mismatch Banner
    const mismatchBanner = document.getElementById('fmtMismatchBanner');
    const mismatchHeading = document.getElementById('fmtMismatchHeading');
    const mismatchText = document.getElementById('fmtMismatchText');

    // Hero Verdict
    const heroFormat = document.getElementById('fmtHeroFormat');
    const heroTag = document.getElementById('fmtHeroTag');
    const heroDesc = document.getElementById('fmtHeroDesc');
    const previewImg = document.getElementById('fmtPreviewImg') as HTMLImageElement | null;

    // 4 Key Stat Boxes
    const boxMimeVal = document.getElementById('boxMimeVal');
    const boxMimeSub = document.getElementById('boxMimeSub');
    const boxExtVal = document.getElementById('boxExtVal');
    const boxExtSub = document.getElementById('boxExtSub');
    const boxCompressionVal = document.getElementById('boxCompressionVal');
    const boxCompressionSub = document.getElementById('boxCompressionSub');
    const boxDimensionsVal = document.getElementById('boxDimensionsVal');
    const boxDimensionsSub = document.getElementById('boxDimensionsSub');

    // Compatibility Table
    const compatBody = document.getElementById('fmtCompatBody');

    // Specs
    const specMagicHex = document.getElementById('specMagicHex');
    const specContainer = document.getElementById('specContainer');
    const specColorDepth = document.getElementById('specColorDepth');
    const specAlphaSupport = document.getElementById('specAlphaSupport');
    const specAnimation = document.getElementById('specAnimation');
    const specDeclaredExt = document.getElementById('specDeclaredExt');

    let currentAnalysis: FormatAnalysis | null = null;

    async function handleFile(file: File) {
      if (!dropzone || !loadingCard || !resultsView) return;

      dropzone.style.display = 'none';
      resultsView.style.display = 'none';
      loadingCard.style.display = 'flex';

      try {
        currentAnalysis = await analyzeImageFormat(file);

        // Header info
        if (metaFileName) metaFileName.textContent = currentAnalysis.name;
        if (metaResolution) metaResolution.textContent = currentAnalysis.width ? `${currentAnalysis.width} × ${currentAnalysis.height} px` : 'Vector / N/A';
        if (metaFileSize) metaFileSize.textContent = currentAnalysis.fileSizeFormatted;

        // Preview image
        if (previewImg) previewImg.src = currentAnalysis.previewUrl;

        // Mismatch banner
        if (mismatchBanner) {
          if (currentAnalysis.isExtensionMismatch) {
            mismatchBanner.style.display = 'flex';
            if (mismatchHeading) mismatchHeading.textContent = i18n.mismatchedExt;
            if (mismatchText) {
              mismatchText.textContent = `This file has a ${currentAnalysis.declaredExtension} extension, but binary magic bytes confirm it is actually ${currentAnalysis.detectedFormat} (${currentAnalysis.actualExtension}).`;
            }
          } else {
            mismatchBanner.style.display = 'none';
          }
        }

        // Hero Verdict
        if (heroFormat) heroFormat.textContent = currentAnalysis.detectedFormat;
        if (heroTag) {
          heroTag.textContent = `MIME: ${currentAnalysis.mimeType}`;
          heroTag.className = currentAnalysis.isExtensionMismatch ? 'verdict-tag tag-warning' : 'verdict-tag tag-success';
        }
        if (heroDesc) heroDesc.textContent = currentAnalysis.recommendation;

        // Box 1: MIME & Container
        if (boxMimeVal) boxMimeVal.textContent = currentAnalysis.mimeType;
        if (boxMimeSub) boxMimeSub.textContent = currentAnalysis.containerInfo;

        // Box 2: Extension Analysis
        if (boxExtVal) {
          boxExtVal.textContent = currentAnalysis.isExtensionMismatch
            ? `${currentAnalysis.declaredExtension} ➔ ${currentAnalysis.actualExtension}`
            : `${currentAnalysis.actualExtension} (Verified)`;
        }
        if (boxExtSub) {
          boxExtSub.textContent = currentAnalysis.isExtensionMismatch
            ? 'Mismatched / Spoofed extension'
            : i18n.matchedExt;
        }

        // Box 3: Compression & Alpha
        if (boxCompressionVal) {
          boxCompressionVal.textContent = `${currentAnalysis.compressionType}${currentAnalysis.hasAlpha ? ' • Alpha' : ''}`;
        }
        if (boxCompressionSub) {
          boxCompressionSub.textContent = `${currentAnalysis.isAnimated ? i18n.animYes : i18n.animNo} • ${currentAnalysis.colorDepth}`;
        }

        // Box 4: Dimensions & Size
        if (boxDimensionsVal) {
          boxDimensionsVal.textContent = currentAnalysis.width ? `${currentAnalysis.width} × ${currentAnalysis.height} px` : 'Vector Scalable';
        }
        if (boxDimensionsSub) {
          boxDimensionsSub.textContent = `${currentAnalysis.fileSizeFormatted} (${currentAnalysis.aspectRatio})`;
        }

        // Compatibility Table
        renderCompatTable(currentAnalysis);

        // Technical Specs
        if (specMagicHex) specMagicHex.textContent = currentAnalysis.hexSignature;
        if (specContainer) specContainer.textContent = currentAnalysis.containerInfo;
        if (specColorDepth) specColorDepth.textContent = currentAnalysis.colorDepth;
        if (specAlphaSupport) specAlphaSupport.textContent = currentAnalysis.hasAlpha ? i18n.alphaYes : i18n.alphaNo;
        if (specAnimation) specAnimation.textContent = currentAnalysis.isAnimated ? i18n.animYes : i18n.animNo;
        if (specDeclaredExt) specDeclaredExt.textContent = currentAnalysis.declaredExtension;

        loadingCard.style.display = 'none';
        resultsView.style.display = 'flex';
      } catch (err) {
        alert(err instanceof Error ? err.message : i18n.errorLoad);
        resetToDropzone();
      }
    }

    function resetToDropzone() {
      currentAnalysis = null;
      if (fileInput) fileInput.value = '';
      if (loadingCard) loadingCard.style.display = 'none';
      if (resultsView) resultsView.style.display = 'none';
      if (dropzone) dropzone.style.display = 'block';
    }

    function renderCompatTable(data: FormatAnalysis) {
      if (!compatBody) return;
      const b = data.browserSupport;

      const list = [
        { browser: 'Google Chrome', support: b.chrome, icon: 'chrome' },
        { browser: 'Apple Safari (macOS)', support: b.safari, icon: 'safari' },
        { browser: 'Mozilla Firefox', support: b.firefox, icon: 'firefox' },
        { browser: 'Microsoft Edge', support: b.edge, icon: 'edge' },
        { browser: 'iOS Safari (iPhone / iPad)', support: b.iosSafari, icon: 'apple' },
        { browser: 'Android Chrome & Mobile', support: b.androidChrome, icon: 'android' },
      ];

      compatBody.innerHTML = list.map((item) => {
        const isFull = item.support.toLowerCase().includes('universal') || item.support.toLowerCase().includes('supported') || item.support.includes('+');
        const badgeClass = isFull ? 'badge-excellent' : 'badge-poor';

        return `
          <tr>
            <td><strong>${item.browser}</strong></td>
            <td><span class="status-badge ${badgeClass}">${item.support}</span></td>
            <td>${data.shortName} native rendering</td>
          </tr>
        `;
      }).join('');
    }

    if (newImageBtn) newImageBtn.addEventListener('click', resetToDropzone);
    if (checkAnotherBtn) checkAnotherBtn.addEventListener('click', resetToDropzone);

    // Sample buttons
    if (sampleWebpBtn) {
      sampleWebpBtn.addEventListener('click', async () => {
        const file = await generateSampleWebp();
        handleFile(file);
      });
    }

    if (sampleMismatchBtn) {
      sampleMismatchBtn.addEventListener('click', async () => {
        const file = await generateSampleMismatched();
        handleFile(file);
      });
    }

    // Drag and Drop
    if (dropzone) {
      ['dragenter', 'dragover'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('fmt-drag-active');
        });
      });

      ['dragleave', 'drop'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('fmt-drag-active');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        if (dt && dt.files && dt.files[0]) {
          handleFile(dt.files[0]);
        }
      });
    }

    if (fileInput) {
      fileInput.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        if (target.files && target.files[0]) {
          handleFile(target.files[0]);
        }
      });
    }

    // Paste listener (Ctrl+V)
    window.addEventListener('paste', (e: ClipboardEvent) => {
      const items = e.clipboardData?.items;
      if (!items) return;
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.indexOf('image') !== -1) {
          const file = items[i].getAsFile();
          if (file) {
            handleFile(file);
            break;
          }
        }
      }
    });
  }

  initFormatChecker();
  document.addEventListener('astro:page-load', initFormatChecker);
</script>


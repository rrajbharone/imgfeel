            <tr>
              <td><strong>{t(locale, 'pixelcounter.table.r1Name')}</strong></td>
              <td><code>{t(locale, 'pixelcounter.table.r1Dimensions')}</code></td>
              <td><strong>{t(locale, 'pixelcounter.table.r1TotalPixels')}</strong></td>
              <td><span class="badge-mp">{t(locale, 'pixelcounter.table.r1Megapixels')}</span></td>
              <td>{t(locale, 'pixelcounter.table.r1Aspect')}</td>

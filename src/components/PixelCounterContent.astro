              <td><span class="badge-mp">{t(locale, 'pixelcounter.table.r2Megapixels')}</span></td>
              <td>{t(locale, 'pixelcounter.table.r2Aspect')}</td>
              <td>{t(locale, 'pixelcounter.table.r2UseCase')}</td>
            </tr>
            <tr>
              <td><strong>{t(locale, 'pixelcounter.table.r3Name')}</strong></td>

          <p>{t(locale, 'pixelcounter.content.p5c')}</p>
        </div>
      </div>
    </div>

    <!-- Section 6: Aspect Ratio Relationship -->
    <div class="content-block">
      <h2>{t(locale, 'pixelcounter.content.h6')}</h2>
      <p>{t(locale, 'pixelcounter.content.p6a')}</p>
      <p>{t(locale, 'pixelcounter.content.p6b')}</p>
    </div>

    <!-- Section 7: Step-by-Step Instructions -->
    <div class="content-block">
      <h2>{t(locale, 'pixelcounter.content.h7')}</h2>
      <p>{t(locale, 'pixelcounter.content.p7Intro')}</p>

      <div class="steps-timeline">
        <div class="step-card">

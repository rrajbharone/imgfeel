            </tr>
            <tr>
              <td><strong>{t(locale, 'pixelcounter.table.r7Name')}</strong></td>
              <td><code>{t(locale, 'pixelcounter.table.r7Dimensions')}</code></td>
              <td><strong>{t(locale, 'pixelcounter.table.r7TotalPixels')}</strong></td>
              <td><span class="badge-mp">{t(locale, 'pixelcounter.table.r7Megapixels')}</span></td>
              <td>{t(locale, 'pixelcounter.table.r7Aspect')}</td>

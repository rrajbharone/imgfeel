---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';
import { getToolUrl } from '@/data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const resizerUrl = getToolUrl('exact-dimension-resizer', locale);
const dimcheckUrl = getToolUrl('image-dimensions-checker', locale);
const aspectUrl = getToolUrl('image-aspect-ratio-checker', locale);
const filesizeUrl = getToolUrl('image-file-size-checker', locale);
const compressorUrl = getToolUrl('webp-compressor', locale);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": t(locale, 'pixelcounter.faq.q1'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'pixelcounter.faq.a1')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'pixelcounter.faq.q2'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'pixelcounter.faq.a2')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'pixelcounter.faq.q3'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'pixelcounter.faq.a3')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'pixelcounter.faq.q4'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'pixelcounter.faq.a4')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'pixelcounter.faq.q5'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'pixelcounter.faq.a5')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'pixelcounter.faq.q6'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'pixelcounter.faq.a6')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'pixelcounter.faq.q7'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'pixelcounter.faq.a7')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'pixelcounter.faq.q8'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'pixelcounter.faq.a8')
      }
    }
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="pixel-counter-article section">
  <div class="container narrow-container">
    <!-- Section 1: Intro & What is a Pixel Counter -->
    <div class="content-block">
      <h2>{t(locale, 'pixelcounter.content.h1')}</h2>
      <p>{t(locale, 'pixelcounter.content.p1a')}</p>
      <p>{t(locale, 'pixelcounter.content.p1b')}</p>

      <div class="feature-cards-grid">
        <div class="feat-card">
          <div class="feat-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="4" y1="9" x2="20" y2="9"></line>
              <line x1="4" y1="15" x2="20" y2="15"></line>
              <line x1="10" y1="3" x2="8" y2="21"></line>
              <line x1="16" y1="3" x2="14" y2="21"></line>
            </svg>
          </div>
          <h3>{t(locale, 'pixelcounter.content.feat1Title')}</h3>
          <p>{t(locale, 'pixelcounter.content.feat1Desc')}</p>
        </div>

        <div class="feat-card">
          <div class="feat-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <h3>{t(locale, 'pixelcounter.content.feat2Title')}</h3>
          <p>{t(locale, 'pixelcounter.content.feat2Desc')}</p>
        </div>

        <div class="feat-card">
          <div class="feat-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
          </div>
          <h3>{t(locale, 'pixelcounter.content.feat3Title')}</h3>
          <p>{t(locale, 'pixelcounter.content.feat3Desc')}</p>
        </div>

        <div class="feat-card">
          <div class="feat-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3>{t(locale, 'pixelcounter.content.feat4Title')}</h3>
          <p>{t(locale, 'pixelcounter.content.feat4Desc')}</p>
        </div>
      </div>
    </div>

    <!-- Section 2: Mathematical Formula -->
    <div class="content-block">
      <h2>{t(locale, 'pixelcounter.content.h2')}</h2>
      <p>{t(locale, 'pixelcounter.content.p2a')}</p>
      
      <div class="formula-box">
        <span class="formula-label">Pixel Calculation Formula:</span>
        <code class="formula-code">Total Pixels = Width (px) × Height (px)</code>
        <code class="formula-code">Megapixels (MP) = Total Pixels ÷ 1,000,000</code>
      </div>

      <p>{t(locale, 'pixelcounter.content.p2b')}</p>
    </div>

    <!-- Section 3: Differences breakdown -->
    <div class="content-block">
      <h2>{t(locale, 'pixelcounter.content.h3')}</h2>
      <div class="differences-list">
        <div class="diff-item">
          <span class="diff-bullet">1</span>
          <p>{t(locale, 'pixelcounter.content.p3a')}</p>
        </div>
        <div class="diff-item">
          <span class="diff-bullet">2</span>
          <p>{t(locale, 'pixelcounter.content.p3b')}</p>
        </div>
        <div class="diff-item">
          <span class="diff-bullet">3</span>
          <p>{t(locale, 'pixelcounter.content.p3c')}</p>
        </div>
        <div class="diff-item">
          <span class="diff-bullet">4</span>
          <p>{t(locale, 'pixelcounter.content.p3d')}</p>
        </div>

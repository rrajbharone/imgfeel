---
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';
import { getToolUrl } from '@/data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const blurUrl = getToolUrl('image-blur-tool', locale);
const beautifyUrl = getToolUrl('screenshot-beautifier', locale);
const exactUrl = getToolUrl('exact-dimension-resizer', locale);
const grayscaleUrl = getToolUrl('image-grayscale-converter', locale);
const cropUrl = getToolUrl('freeform-image-cropper', locale);
---

<div class="denoise-app-container" id="denoiseApp" data-locale={locale} data-i18n={JSON.stringify({
  copiedSuccess: t(locale, 'noiseReducer.action.copied'),
})}>
  <!-- State 1: Upload-First Initial Dropzone Card -->
  <div class="denoise-dropzone-card" id="denoiseDropzone">
    <div class="dropzone-inner">
      <div class="dropzone-icon-ring">
        <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </div>

      <h2 class="dropzone-headline">{t(locale, 'noiseReducer.dropzone.title')}</h2>
      <p class="dropzone-subheadline">{t(locale, 'noiseReducer.dropzone.subtitle')}</p>

      <div class="dropzone-action-group">
        <label for="denoiseFileInput" class="btn btn-primary dropzone-browse-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'noiseReducer.dropzone.browse')}</span>
        </label>
        <input type="file" id="denoiseFileInput" accept="image/jpeg,image/png,image/webp,image/avif,image/bmp" class="visually-hidden" />

        <button type="button" class="btn btn-secondary sample-demo-btn" id="denoiseSampleBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span>{t(locale, 'noiseReducer.dropzone.sample')}</span>
        </button>
      </div>

      <div class="dropzone-badges-row">
        <span class="badge-pill">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          JPG, PNG, WebP, AVIF, BMP
        </span>
        <span class="badge-pill badge-pill-green">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          {t(locale, 'noiseReducer.privacy.badge')}
        </span>
      </div>
    </div>
  </div>

  <!-- Loading State Card -->
  <div class="denoise-loading-card" id="denoiseLoadingCard" style="display: none;">
    <div class="loading-spinner"></div>
    <p class="loading-text">{t(locale, 'noiseReducer.status.processing')}</p>
  </div>

  <!-- State 2: Active Workspace (Hidden until image upload) -->
  <div class="denoise-workspace-card" id="denoiseWorkspace" style="display: none;">
    <!-- Workspace Top Header Bar -->
    <div class="workspace-header-bar">
      <div class="image-meta-info">
        <span class="file-name-tag" id="denoiseFileName">image.jpg</span>
        <span class="file-dim-pill" id="denoiseOriginalDimsTag">-- × -- px</span>
        <span class="file-size-pill" id="denoiseOriginalSizeTag">-- KB</span>
      </div>

      <div class="workspace-header-actions">
        <button type="button" class="btn btn-secondary btn-sm change-image-btn" id="denoiseChangeImageBtn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'noiseReducer.action.changeImage')}</span>
        </button>
      </div>
    </div>

    <!-- 2-Column Responsive Layout -->
    <div class="denoise-main-grid">
      <!-- Left Column: Interactive Comparison Preview -->
      <div class="denoise-preview-card">
        <!-- View Mode Navigation Tabs -->
        <div class="preview-mode-tabs">
          <button type="button" class="preview-tab active" data-view="split" id="viewModeSplitBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="3" x2="12" y2="21"></line>
              <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            </svg>
            <span>{t(locale, 'noiseReducer.view.split')}</span>
          </button>
          <button type="button" class="preview-tab" data-view="side" id="viewModeSideBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="9" height="18" rx="2"></rect>
              <rect x="13" y="3" width="9" height="18" rx="2"></rect>
            </svg>
            <span>{t(locale, 'noiseReducer.view.side')}</span>
          </button>
          <button type="button" class="preview-tab" data-view="result" id="viewModeResultBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
            </svg>
            <span>{t(locale, 'noiseReducer.view.denoised')}</span>
          </button>
        </div>

        <!-- Split Slider Container (Same architecture as GrayscaleConverter and ImageBlur) -->
        <div class="split-viewport-wrapper" id="splitViewportWrapper">
          <div class="split-comparison-box" id="splitComparisonBox">
            <canvas id="noiseCanvasUnder" class="split-canvas"></canvas>
            <canvas id="noiseCanvasOver" class="split-canvas over-canvas"></canvas>
            
            <div class="split-divider-line" id="splitDividerLine" style="left: 50%;">
              <div class="split-drag-handle" title="Drag to compare">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </div>
            </div>

            <span class="split-tag tag-left">{t(locale, 'noiseReducer.split.original')}</span>
            <span class="split-tag tag-right">{t(locale, 'noiseReducer.split.denoised')}</span>
          </div>
          <p class="split-hint-text">{t(locale, 'noiseReducer.split.hint')}</p>
        </div>

        <!-- Side-by-Side Container (Hidden by default) -->
        <div class="side-viewport-wrapper" id="sideViewportWrapper" style="display: none;">
          <div class="side-box">
            <span class="side-badge">{t(locale, 'noiseReducer.split.original')}</span>
            <img id="sideOriginalImg" src="" alt="Original" class="side-img" />
          </div>
          <div class="side-box">
            <span class="side-badge">{t(locale, 'noiseReducer.split.denoised')}</span>
            <img id="sideDenoisedImg" src="" alt="Denoised" class="side-img" />
          </div>
        </div>

        <!-- Denoised Result Only Viewport (Hidden by default) -->
        <div class="single-viewport-wrapper" id="singleViewportWrapper" style="display: none;">
          <img id="singleDenoisedImg" src="" alt="Denoised preview" class="single-img" />
        </div>

        <!-- Live Metrics Bar -->
        <div class="preview-metrics-strip">
          <div class="metric-item">
            <span class="metric-lbl">{t(locale, 'noiseReducer.metrics.original')}:</span>
            <strong id="liveMetricOrigDims">-- × -- px</strong>
          </div>
          <div class="metric-item">
            <span class="metric-lbl">{t(locale, 'noiseReducer.metrics.profile')}:</span>
            <span class="profile-chip" id="liveMetricProfile">Balanced Auto</span>
          </div>
          <div class="metric-item">
            <span class="metric-lbl">{t(locale, 'noiseReducer.privacy.badge')}:</span>
            <strong class="privacy-green">100% In-Browser</strong>
          </div>
        </div>

        <!-- Primary Action Buttons Row -->
        <div class="denoise-action-buttons-grid">
          <button type="button" class="btn btn-primary denoise-download-btn" id="denoiseDownloadBtn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>{t(locale, 'noiseReducer.action.download')}</span>
          </button>

          <button type="button" class="btn btn-secondary denoise-copy-btn" id="denoiseCopyBtn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="denoiseCopyBtnText">{t(locale, 'noiseReducer.action.copyImage')}</span>
          </button>

          <button type="button" class="btn btn-secondary denoise-reset-btn" id="denoiseResetBtn" title={t(locale, 'noiseReducer.action.reset')}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
              <path d="M3 3v5h5"></path>
            </svg>
            <span>{t(locale, 'noiseReducer.action.reset')}</span>
          </button>
        </div>
      </div>

      <!-- Right Column: Denoise Controls Panel -->
      <div class="denoise-controls-panel">
        <!-- Section 1: Presets -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'noiseReducer.section.presets')}</label>
          <div class="preset-chips-grid">
            <button type="button" class="tone-preset-btn active" data-preset="balanced">
              <strong>{t(locale, 'noiseReducer.preset.balanced')}</strong>
              <span>{t(locale, 'noiseReducer.preset.balancedDesc')}</span>
            </button>

            <button type="button" class="tone-preset-btn" data-preset="lowlight">
              <strong>{t(locale, 'noiseReducer.preset.lowlight')}</strong>
              <span>{t(locale, 'noiseReducer.preset.lowlightDesc')}</span>
            </button>

            <button type="button" class="tone-preset-btn" data-preset="portrait">
              <strong>{t(locale, 'noiseReducer.preset.portrait')}</strong>
              <span>{t(locale, 'noiseReducer.preset.portraitDesc')}</span>
            </button>

            <button type="button" class="tone-preset-btn" data-preset="grain">
              <strong>{t(locale, 'noiseReducer.preset.grain')}</strong>
              <span>{t(locale, 'noiseReducer.preset.grainDesc')}</span>
            </button>
          </div>
        </div>

        <!-- Section 2: Fine-Tuning Sliders -->
        <div class="control-group">
          <div class="slider-header-row">
            <label for="strengthSlider" class="control-label">{t(locale, 'noiseReducer.control.strength')}</label>
            <span class="val-pill" id="strengthValPill">45%</span>
          </div>
          <input type="range" id="strengthSlider" min="0" max="100" value="45" step="1" class="denoise-range" />
          <p class="slider-help">{t(locale, 'noiseReducer.control.strengthHelp')}</p>
        </div>

        <div class="control-group">
          <div class="slider-header-row">
            <label for="colorNoiseSlider" class="control-label">{t(locale, 'noiseReducer.control.colorNoise')}</label>
            <span class="val-pill" id="colorNoiseValPill">60%</span>
          </div>
          <input type="range" id="colorNoiseSlider" min="0" max="100" value="60" step="1" class="denoise-range" />
          <p class="slider-help">{t(locale, 'noiseReducer.control.colorNoiseHelp')}</p>
        </div>

        <div class="control-group">
          <div class="slider-header-row">
            <label for="sharpnessSlider" class="control-label">{t(locale, 'noiseReducer.control.sharpness')}</label>
            <span class="val-pill" id="sharpnessValPill">30%</span>
          </div>
          <input type="range" id="sharpnessSlider" min="0" max="100" value="30" step="1" class="denoise-range" />
          <p class="slider-help">{t(locale, 'noiseReducer.control.sharpnessHelp')}</p>
        </div>

        <!-- Radius Selector Box -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'noiseReducer.control.radius')}</label>
          <div class="radius-chips-row">
            <button type="button" class="radius-chip active" data-radius="1">{t(locale, 'noiseReducer.radius.fine')}</button>
            <button type="button" class="radius-chip" data-radius="2">{t(locale, 'noiseReducer.radius.medium')}</button>
            <button type="button" class="radius-chip" data-radius="3">{t(locale, 'noiseReducer.radius.heavy')}</button>
          </div>
        </div>

        <!-- Section 3: Export Format & Quality -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'noiseReducer.section.export')}</label>
          <div class="select-field">
            <label for="exportFormatSelect" class="sub-label">{t(locale, 'noiseReducer.export.format')}</label>
            <select id="exportFormatSelect" class="denoise-select">
              <option value="original" selected>Same as Original</option>
              <option value="image/png">PNG (Lossless & Sharp)</option>
              <option value="image/webp">WebP (Optimized & Modern)</option>
              <option value="image/jpeg">JPG / JPEG (Standard Photo)</option>
            </select>
          </div>

          <div class="quality-field" id="qualityFieldBox" style="display: none;">
            <div class="slider-header-row">
              <label for="exportQualitySlider" class="sub-label">{t(locale, 'noiseReducer.export.quality')}</label>
              <span class="val-pill" id="qualityValPill">92%</span>
            </div>
            <input type="range" id="exportQualitySlider" min="10" max="100" value="92" step="1" class="denoise-range" />
          </div>
        </div>
      </div>
    </div>

    <!-- Related Cross Navigation Links -->
    <div class="denoise-cross-links-row">
      <a href={blurUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="9" stroke-dasharray="2 3"></circle>
          <circle cx="12" cy="12" r="5" stroke-dasharray="1 2"></circle>
        </svg>
        <span>{t(locale, 'noiseReducer.cross.blur')}</span>
      </a>

      <a href={beautifyUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2"></rect>
          <path d="M3 9h18"></path>
          <circle cx="7" cy="6" r="1"></circle>
        </svg>
        <span>{t(locale, 'noiseReducer.cross.beautify')}</span>
      </a>

      <a href={exactUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="4" y1="21" x2="4" y2="14"></line>
          <line x1="4" y1="10" x2="4" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12" y2="3"></line>
          <line x1="20" y1="21" x2="20" y2="16"></line>
          <line x1="20" y1="12" x2="20" y2="3"></line>
        </svg>
        <span>{t(locale, 'noiseReducer.cross.exact')}</span>
      </a>

      <a href={grayscaleUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 2a10 10 0 0 1 0 20z" fill="currentColor"></path>
        </svg>
        <span>{t(locale, 'noiseReducer.cross.grayscale')}</span>
      </a>

      <a href={cropUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 2v14a2 2 0 0 0 2 2h14"></path>
          <path d="M18 22V8a2 2 0 0 0-2-2H2"></path>
        </svg>
        <span>{t(locale, 'noiseReducer.cross.cropper')}</span>
      </a>
    </div>
  </div>
</div>

<script>
  import {
    loadImageFromFile,
    applyDenoiseToImageData,
    generateSampleNoisyImage,
    exportDenoisedImage,
    copyDenoisedImageToClipboard,
    PRESET_CONFIGS,
    type DenoiseOptions,
    type DenoisePreset,
    type LoadedImageInfo,
  } from '@/scripts/denoise-engine';

  const appEl = document.getElementById('denoiseApp');
  const i18n = appEl?.dataset.i18n ? JSON.parse(appEl.dataset.i18n) : {};

  // State
  let currentFile: File | null = null;
  let loadedImageObj: LoadedImageInfo | null = null;
  let originalWidth = 0;
  let originalHeight = 0;
  let splitPosPercent = 50;
  let isDraggingSplit = false;

  let activePreset: DenoisePreset = 'balanced';
  let denoiseOptions: DenoiseOptions = { ...PRESET_CONFIGS.balanced };
  let exportFormat: string = 'original';
  let exportQuality: number = 0.92;

  let renderDebounceTimer: number | null = null;
  let fullExportBlob: Blob | null = null;
  let fullExportDataUrl: string = '';

  // DOM Elements
  const dropzone = document.getElementById('denoiseDropzone') as HTMLElement;
  const fileInput = document.getElementById('denoiseFileInput') as HTMLInputElement;
  const sampleBtn = document.getElementById('denoiseSampleBtn') as HTMLButtonElement;
  const loadingCard = document.getElementById('denoiseLoadingCard') as HTMLElement;
  const workspace = document.getElementById('denoiseWorkspace') as HTMLElement;

  const fileNameEl = document.getElementById('denoiseFileName') as HTMLElement;
  const origDimsTag = document.getElementById('denoiseOriginalDimsTag') as HTMLElement;
  const origSizeTag = document.getElementById('denoiseOriginalSizeTag') as HTMLElement;
  const changeImageBtn = document.getElementById('denoiseChangeImageBtn') as HTMLButtonElement;

  const viewTabs = document.querySelectorAll('.preview-tab') as NodeListOf<HTMLButtonElement>;
  const splitWrapper = document.getElementById('splitViewportWrapper') as HTMLElement;
  const sideWrapper = document.getElementById('sideViewportWrapper') as HTMLElement;
  const singleWrapper = document.getElementById('singleViewportWrapper') as HTMLElement;

  const splitBox = document.getElementById('splitComparisonBox') as HTMLElement;
  const canvasUnder = document.getElementById('noiseCanvasUnder') as HTMLCanvasElement;
  const canvasOver = document.getElementById('noiseCanvasOver') as HTMLCanvasElement;
  const splitDivider = document.getElementById('splitDividerLine') as HTMLElement;

  const sideOrigImg = document.getElementById('sideOriginalImg') as HTMLImageElement;
  const sideDenoisedImg = document.getElementById('sideDenoisedImg') as HTMLImageElement;
  const singleDenoisedImg = document.getElementById('singleDenoisedImg') as HTMLImageElement;

  const liveMetricOrigDims = document.getElementById('liveMetricOrigDims') as HTMLElement;
  const liveMetricProfile = document.getElementById('liveMetricProfile') as HTMLElement;

  const presetBtns = document.querySelectorAll('.tone-preset-btn') as NodeListOf<HTMLButtonElement>;
  const strengthSlider = document.getElementById('strengthSlider') as HTMLInputElement;
  const strengthValPill = document.getElementById('strengthValPill') as HTMLElement;
  const colorNoiseSlider = document.getElementById('colorNoiseSlider') as HTMLInputElement;
  const colorNoiseValPill = document.getElementById('colorNoiseValPill') as HTMLElement;
  const sharpnessSlider = document.getElementById('sharpnessSlider') as HTMLInputElement;
  const sharpnessValPill = document.getElementById('sharpnessValPill') as HTMLElement;
  const radiusChips = document.querySelectorAll('.radius-chip') as NodeListOf<HTMLButtonElement>;

  const exportFormatSelect = document.getElementById('exportFormatSelect') as HTMLSelectElement;
  const qualityFieldBox = document.getElementById('qualityFieldBox') as HTMLElement;
  const exportQualitySlider = document.getElementById('exportQualitySlider') as HTMLInputElement;
  const qualityValPill = document.getElementById('qualityValPill') as HTMLElement;

  const downloadBtn = document.getElementById('denoiseDownloadBtn') as HTMLButtonElement;
  const copyBtn = document.getElementById('denoiseCopyBtn') as HTMLButtonElement;
  const copyBtnText = document.getElementById('denoiseCopyBtnText') as HTMLElement;
  const resetBtn = document.getElementById('denoiseResetBtn') as HTMLButtonElement;

  function renderSplitCanvases() {
    if (!loadedImageObj || !canvasUnder || !canvasOver) return;

    const maxW = 900;
    const maxH = 560;
    let targetW = originalWidth;
    let targetH = originalHeight;

    if (targetW > maxW || targetH > maxH) {
      const ratio = Math.min(maxW / targetW, maxH / targetH);
      targetW = Math.round(targetW * ratio);
      targetH = Math.round(targetH * ratio);
    }

    canvasUnder.width = targetW;
    canvasUnder.height = targetH;
    canvasOver.width = targetW;
    canvasOver.height = targetH;

    const ctxUnder = canvasUnder.getContext('2d');
    const ctxOver = canvasOver.getContext('2d');
    if (!ctxUnder || !ctxOver) return;

    // Original on under canvas
    ctxUnder.drawImage(loadedImageObj.img, 0, 0, targetW, targetH);

    // Denoised on over canvas
    ctxOver.drawImage(loadedImageObj.img, 0, 0, targetW, targetH);
    const imgData = ctxOver.getImageData(0, 0, targetW, targetH);
    applyDenoiseToImageData(imgData, targetW, targetH, denoiseOptions);
    ctxOver.putImageData(imgData, 0, 0);

    if (canvasOver) {
      canvasOver.style.clipPath = `inset(0 0 0 ${splitPosPercent}%)`;
    }
  }

  async function processFullExport() {
    if (!loadedImageObj) return;

    try {
      // Determine format
      let targetMime: 'image/png' | 'image/webp' | 'image/jpeg' = 'image/png';
      if (exportFormat === 'original') {
        if (loadedImageObj.type === 'image/jpeg' || loadedImageObj.type === 'image/jpg') targetMime = 'image/jpeg';
        else if (loadedImageObj.type === 'image/webp') targetMime = 'image/webp';
        else targetMime = 'image/png';
      } else {
        targetMime = exportFormat as any;
      }

      const res = await exportDenoisedImage(loadedImageObj, denoiseOptions, targetMime, exportQuality);
      fullExportBlob = res.blob;
      fullExportDataUrl = res.dataUrl;

      if (sideDenoisedImg) sideDenoisedImg.src = res.dataUrl;
      if (singleDenoisedImg) singleDenoisedImg.src = res.dataUrl;
    } catch (err) {
      console.error('Denoise export error:', err);
    }
  }

  function triggerUpdate() {
    renderSplitCanvases();
    if (renderDebounceTimer) clearTimeout(renderDebounceTimer);
    renderDebounceTimer = window.setTimeout(processFullExport, 80);
  }

  async function loadFile(file: File) {
    if (!dropzone || !loadingCard || !workspace) return;

    dropzone.style.display = 'none';
    workspace.style.display = 'none';
    loadingCard.style.display = 'flex';

    try {
      currentFile = file;
      loadedImageObj = await loadImageFromFile(file);
      originalWidth = loadedImageObj.originalWidth;
      originalHeight = loadedImageObj.originalHeight;

      // Reset options to balanced preset
      activePreset = 'balanced';
      denoiseOptions = { ...PRESET_CONFIGS.balanced };
      splitPosPercent = 50;

      presetBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-preset') === 'balanced'));
      if (strengthSlider) strengthSlider.value = String(denoiseOptions.strength);
      if (strengthValPill) strengthValPill.textContent = `${denoiseOptions.strength}%`;
      if (colorNoiseSlider) colorNoiseSlider.value = String(denoiseOptions.colorNoise);
      if (colorNoiseValPill) colorNoiseValPill.textContent = `${denoiseOptions.colorNoise}%`;
      if (sharpnessSlider) sharpnessSlider.value = String(denoiseOptions.sharpness);
      if (sharpnessValPill) sharpnessValPill.textContent = `${denoiseOptions.sharpness}%`;
      radiusChips.forEach((rc) => rc.classList.toggle('active', Number(rc.dataset.radius) === denoiseOptions.radius));

      // Header meta tags
      if (fileNameEl) fileNameEl.textContent = file.name;
      if (origDimsTag) origDimsTag.textContent = `${originalWidth} × ${originalHeight} px`;
      if (origSizeTag) origSizeTag.textContent = `${(file.size / 1024).toFixed(1)} KB`;
      if (liveMetricOrigDims) liveMetricOrigDims.textContent = `${originalWidth} × ${originalHeight} px`;
      if (liveMetricProfile) liveMetricProfile.textContent = 'Balanced Auto';

      if (splitDivider) splitDivider.style.left = '50%';
      if (sideOrigImg) sideOrigImg.src = loadedImageObj.img.src;

      renderSplitCanvases();
      await processFullExport();

      loadingCard.style.display = 'none';
      workspace.style.display = 'block';
    } catch (err) {
      alert(err instanceof Error ? err.message : (i18n.errorLoad || 'Failed to load image'));
      resetToDropzone();
    }
  }

  function resetToDropzone() {
    currentFile = null;
    loadedImageObj = null;
    if (fileInput) fileInput.value = '';
    if (loadingCard) loadingCard.style.display = 'none';
    if (workspace) workspace.style.display = 'none';
    if (dropzone) dropzone.style.display = 'block';
  }

  if (changeImageBtn) changeImageBtn.addEventListener('click', resetToDropzone);

  // View mode tab switching
  viewTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      viewTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');

      const mode = tab.getAttribute('data-view');
      if (splitWrapper) splitWrapper.style.display = mode === 'split' ? 'flex' : 'none';
      if (sideWrapper) sideWrapper.style.display = mode === 'side' ? 'grid' : 'none';
      if (singleWrapper) singleWrapper.style.display = mode === 'result' ? 'block' : 'none';
    });
  });

  // Split dragging logic (Matching other tools)
  function handleSplitMove(clientX: number) {
    if (!splitBox) return;
    const rect = splitBox.getBoundingClientRect();
    const x = Math.max(0, Math.min(rect.width, clientX - rect.left));
    splitPosPercent = Math.round((x / rect.width) * 100);

    if (splitDivider) splitDivider.style.left = `${splitPosPercent}%`;
    if (canvasOver) canvasOver.style.clipPath = `inset(0 0 0 ${splitPosPercent}%)`;
  }

  if (splitBox) {
    splitBox.addEventListener('mousedown', (e) => {
      isDraggingSplit = true;
      handleSplitMove(e.clientX);
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDraggingSplit) return;
      handleSplitMove(e.clientX);
    });

    window.addEventListener('mouseup', () => {
      isDraggingSplit = false;
    });

    // Touch events for mobile
    splitBox.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        isDraggingSplit = true;
        handleSplitMove(e.touches[0].clientX);
      }
    }, { passive: true });

    splitBox.addEventListener('touchmove', (e) => {
      if (!isDraggingSplit || e.touches.length !== 1) return;
      handleSplitMove(e.touches[0].clientX);
    }, { passive: true });

    splitBox.addEventListener('touchend', () => {
      isDraggingSplit = false;
    });
  }

  // Presets
  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      presetBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const presetKey = (btn.getAttribute('data-preset') as DenoisePreset) || 'balanced';
      activePreset = presetKey;
      const config = PRESET_CONFIGS[presetKey];
      if (config) {
        denoiseOptions = { ...config };
        if (strengthSlider) strengthSlider.value = String(config.strength);
        if (strengthValPill) strengthValPill.textContent = `${config.strength}%`;
        if (colorNoiseSlider) colorNoiseSlider.value = String(config.colorNoise);
        if (colorNoiseValPill) colorNoiseValPill.textContent = `${config.colorNoise}%`;
        if (sharpnessSlider) sharpnessSlider.value = String(config.sharpness);
        if (sharpnessValPill) sharpnessValPill.textContent = `${config.sharpness}%`;
        radiusChips.forEach((rc) => rc.classList.toggle('active', Number(rc.dataset.radius) === config.radius));

        if (liveMetricProfile) liveMetricProfile.textContent = btn.querySelector('strong')?.textContent || presetKey;
      }
      triggerUpdate();
    });
  });

  // Range Sliders
  if (strengthSlider) {
    strengthSlider.addEventListener('input', () => {
      denoiseOptions.strength = parseInt(strengthSlider.value, 10);
      if (strengthValPill) strengthValPill.textContent = `${denoiseOptions.strength}%`;
      triggerUpdate();
    });
  }

  if (colorNoiseSlider) {
    colorNoiseSlider.addEventListener('input', () => {
      denoiseOptions.colorNoise = parseInt(colorNoiseSlider.value, 10);
      if (colorNoiseValPill) colorNoiseValPill.textContent = `${denoiseOptions.colorNoise}%`;
      triggerUpdate();
    });
  }

  if (sharpnessSlider) {
    sharpnessSlider.addEventListener('input', () => {
      denoiseOptions.sharpness = parseInt(sharpnessSlider.value, 10);
      if (sharpnessValPill) sharpnessValPill.textContent = `${denoiseOptions.sharpness}%`;
      triggerUpdate();
    });
  }

  radiusChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      radiusChips.forEach((c) => c.classList.remove('active'));
      chip.classList.add('active');
      denoiseOptions.radius = Number(chip.dataset.radius) || 1;
      triggerUpdate();
    });
  });

  // Export Settings
  if (exportFormatSelect) {
    exportFormatSelect.addEventListener('change', () => {
      exportFormat = exportFormatSelect.value;
      if (qualityFieldBox) {
        qualityFieldBox.style.display = exportFormat === 'image/jpeg' || exportFormat === 'image/webp' ? 'block' : 'none';
      }
      triggerUpdate();
    });
  }

  if (exportQualitySlider) {
    exportQualitySlider.addEventListener('input', () => {
      const q = parseInt(exportQualitySlider.value, 10);
      exportQuality = q / 100;
      if (qualityValPill) qualityValPill.textContent = `${q}%`;
      triggerUpdate();
    });
  }

  // Reset Button
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      activePreset = 'balanced';
      denoiseOptions = { ...PRESET_CONFIGS.balanced };
      presetBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-preset') === 'balanced'));
      if (strengthSlider) strengthSlider.value = String(denoiseOptions.strength);
      if (strengthValPill) strengthValPill.textContent = `${denoiseOptions.strength}%`;
      if (colorNoiseSlider) colorNoiseSlider.value = String(denoiseOptions.colorNoise);
      if (colorNoiseValPill) colorNoiseValPill.textContent = `${denoiseOptions.colorNoise}%`;
      if (sharpnessSlider) sharpnessSlider.value = String(denoiseOptions.sharpness);
      if (sharpnessValPill) sharpnessValPill.textContent = `${denoiseOptions.sharpness}%`;
      radiusChips.forEach((rc) => rc.classList.toggle('active', Number(rc.dataset.radius) === denoiseOptions.radius));
      if (liveMetricProfile) liveMetricProfile.textContent = 'Balanced Auto';
      triggerUpdate();
    });
  }

  // Download Action
  if (downloadBtn) {
    downloadBtn.addEventListener('click', () => {
      if (!fullExportBlob || !loadedImageObj) return;

      const baseName = loadedImageObj.name.replace(/\.[^/.]+$/, '');
      let ext = 'png';
      if (exportFormat === 'image/jpeg') ext = 'jpg';
      else if (exportFormat === 'image/webp') ext = 'webp';
      else if (exportFormat === 'original') {
        const origExt = loadedImageObj.name.split('.').pop()?.toLowerCase();
        ext = origExt || 'png';
      }

      const link = document.createElement('a');
      link.href = URL.createObjectURL(fullExportBlob);
      link.download = `${baseName}-denoised.${ext}`;
      link.click();
      URL.revokeObjectURL(link.href);
    });
  }

  // Copy to Clipboard Action
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      if (!loadedImageObj) return;
      try {
        await copyDenoisedImageToClipboard(loadedImageObj, denoiseOptions);
        if (copyBtnText) copyBtnText.textContent = i18n.copiedSuccess || 'Copied!';
        copyBtn.classList.add('btn-success');
        setTimeout(() => {
          if (copyBtnText) copyBtnText.textContent = 'Copy Image';
          copyBtn.classList.remove('btn-success');
        }, 2000);
      } catch (err) {
        alert('Could not copy image to clipboard.');
      }
    });
  }

  // File Upload Handlers
  if (fileInput) {
    fileInput.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files && files[0]) loadFile(files[0]);
    });
  }

  if (sampleBtn) {
    sampleBtn.addEventListener('click', async () => {
      showLoading(true);
      try {
        const sampleFile = await generateSampleNoisyImage();
        await loadFile(sampleFile);
      } catch (err) {
        showLoading(false);
      }
    });
  }

  function showLoading(show: boolean) {
    if (show) {
      loadingCard.style.display = 'flex';
      workspace.style.display = 'none';
      dropzone.style.display = 'none';
    } else {
      loadingCard.style.display = 'none';
    }
  }

  // Drag & Drop onto Dropzone
  if (dropzone) {
    ['dragenter', 'dragover'].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropzone.classList.add('dragover');
      });
    });
    ['dragleave', 'drop'].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropzone.classList.remove('dragover');
      });
    });
    dropzone.addEventListener('drop', (e) => {
      const dt = e.dataTransfer;
      if (dt?.files?.[0]) loadFile(dt.files[0]);
    });
  }

  // Global Clipboard Paste
  window.addEventListener('paste', (e) => {
    const items = e.clipboardData?.items;
    if (!items) return;
    for (let i = 0; i < items.length; i++) {
      if (items[i].type.startsWith('image/')) {
        const file = items[i].getAsFile();
        if (file) loadFile(file);
        break;
      }
    }
  });
</script>


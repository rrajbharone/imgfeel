---
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';
import { getToolUrl } from '@/data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Localized tool URLs for related tools grid
const exactUrl = getToolUrl('exact-dimension-resizer', locale);
const webpUrl = getToolUrl('webp-compressor', locale);
const dpiUrl = getToolUrl('image-dpi-converter', locale);
const ocrUrl = getToolUrl('image-to-text-converter', locale);
const gifUrl = getToolUrl('gif-frame-extractor', locale);
const pixelCounterUrl = getToolUrl('pixel-counter', locale);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": t(locale, 'pptresize.content.faq1Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'pptresize.content.faq1A')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'pptresize.content.faq2Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'pptresize.content.faq2A')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'pptresize.content.faq3Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'pptresize.content.faq3A')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'pptresize.content.faq4Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'pptresize.content.faq4A')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'pptresize.content.faq5Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'pptresize.content.faq5A')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'pptresize.content.faq6Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'pptresize.content.faq6A')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'pptresize.content.faq7Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'pptresize.content.faq7A')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'pptresize.content.faq8Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'pptresize.content.faq8A')
      }
    }
  ]
};
---

<section class="section content-section">
  <div class="container">
    <div class="content-body">
      <!-- Section 1: Overview & Value -->
      <div class="content-block">
        <h2>{t(locale, 'pptresize.content.h1')}</h2>
        <p>{t(locale, 'pptresize.content.p1a')}</p>
        <p>{t(locale, 'pptresize.content.p1b')}</p>

        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <h3>{t(locale, 'pptresize.content.feat1Title')}</h3>
            <p>{t(locale, 'pptresize.content.feat1Desc')}</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            </div>
            <h3>{t(locale, 'pptresize.content.feat2Title')}</h3>
            <p>{t(locale, 'pptresize.content.feat2Desc')}</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </div>
            <h3>{t(locale, 'pptresize.content.feat3Title')}</h3>
            <p>{t(locale, 'pptresize.content.feat3Desc')}</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </div>
            <h3>{t(locale, 'pptresize.content.feat4Title')}</h3>
            <p>{t(locale, 'pptresize.content.feat4Desc')}</p>
          </div>
        </div>
      </div>

      <!-- Section 2: Reference Table -->
      <div class="content-block">
        <h2>{t(locale, 'pptresize.content.h2Table')}</h2>
        <p>{t(locale, 'pptresize.content.p2Table')}</p>

        <div class="table-responsive">
          <table class="specs-table">
            <thead>
              <tr>
                <th>{t(locale, 'pptresize.content.thPreset')}</th>
                <th>{t(locale, 'pptresize.content.thRatio')}</th>
                <th>{t(locale, 'pptresize.content.thInches')}</th>
                <th>{t(locale, 'pptresize.content.thCm')}</th>
                <th>{t(locale, 'pptresize.content.thPixels')}</th>
                <th>{t(locale, 'pptresize.content.thPrint')}</th>
                <th>{t(locale, 'pptresize.content.thUse')}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>{t(locale, 'pptresize.content.row1Preset')}</strong></td>
                <td><span class="code-badge">16:9</span></td>
                <td>13.333 × 7.5 in</td>
                <td>33.87 × 19.05 cm</td>
                <td>1280 × 720 / 1920 × 1080</td>
                <td>4000 × 2250</td>
                <td>{t(locale, 'pptresize.content.row1Use')}</td>
              </tr>
              <tr>
                <td><strong>{t(locale, 'pptresize.content.row2Preset')}</strong></td>
                <td><span class="code-badge">4:3</span></td>
                <td>10.0 × 7.5 in</td>
                <td>25.40 × 19.05 cm</td>
                <td>960 × 720 / 1024 × 768</td>
                <td>3000 × 2250</td>
                <td>{t(locale, 'pptresize.content.row2Use')}</td>
              </tr>
              <tr>
                <td><strong>{t(locale, 'pptresize.content.row3Preset')}</strong></td>
                <td><span class="code-badge">16:10</span></td>
                <td>10.0 × 6.25 in</td>
                <td>25.40 × 15.88 cm</td>
                <td>960 × 600 / 1920 × 1200</td>
                <td>3000 × 1875</td>
                <td>{t(locale, 'pptresize.content.row3Use')}</td>
              </tr>
              <tr>
                <td><strong>{t(locale, 'pptresize.content.row4Preset')}</strong></td>
                <td><span class="code-badge">1.41:1</span></td>
                <td>11.693 × 8.268 in</td>
                <td>29.70 × 21.00 cm</td>
                <td>1123 × 794</td>
                <td>3508 × 2480</td>
                <td>{t(locale, 'pptresize.content.row4Use')}</td>
              </tr>
              <tr>
                <td><strong>{t(locale, 'pptresize.content.row5Preset')}</strong></td>
                <td><span class="code-badge">1:1.41</span></td>
                <td>8.268 × 11.693 in</td>
                <td>21.00 × 29.70 cm</td>
                <td>794 × 1123</td>
                <td>2480 × 3508</td>
                <td>{t(locale, 'pptresize.content.row5Use')}</td>
              </tr>
              <tr>
                <td><strong>{t(locale, 'pptresize.content.row6Preset')}</strong></td>
                <td><span class="code-badge">1.29:1</span></td>
                <td>11.0 × 8.5 in</td>
                <td>27.94 × 21.59 cm</td>
                <td>1056 × 816</td>
                <td>3300 × 2550</td>
                <td>{t(locale, 'pptresize.content.row6Use')}</td>
              </tr>
              <tr>
                <td><strong>{t(locale, 'pptresize.content.row7Preset')}</strong></td>
                <td><span class="code-badge">1:1.29</span></td>
                <td>8.5 × 11.0 in</td>
                <td>21.59 × 27.94 cm</td>
                <td>816 × 1056</td>
                <td>2550 × 3300</td>
                <td>{t(locale, 'pptresize.content.row7Use')}</td>
              </tr>
              <tr>
                <td><strong>{t(locale, 'pptresize.content.row8Preset')}</strong></td>
                <td><span class="code-badge">1.41:1</span></td>
                <td>16.535 × 11.693 in</td>
                <td>42.00 × 29.70 cm</td>
                <td>1587 × 1123</td>
                <td>4960 × 3508</td>
                <td>{t(locale, 'pptresize.content.row8Use')}</td>
              </tr>
              <tr>
                <td><strong>{t(locale, 'pptresize.content.row9Preset')}</strong></td>

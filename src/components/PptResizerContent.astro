          <div class="type-card">
            <h3>{t(locale, 'pptresize.content.layout3Title')}</h3>
            <p>{t(locale, 'pptresize.content.layout3Desc')}</p>
          </div>

          <div class="type-card">
            <h3>{t(locale, 'pptresize.content.layout4Title')}</h3>
            <p>{t(locale, 'pptresize.content.layout4Desc')}</p>
          </div>
        </div>
      </div>

      <!-- Section 8: Common Mistakes to Avoid -->
      <div class="content-block">
        <h2>{t(locale, 'pptresize.content.h6')}</h2>
        <p>{t(locale, 'pptresize.content.p6a')}</p>

        <div class="types-grid">
          <div class="type-card">
            <h3>{t(locale, 'pptresize.content.mistake1Title')}</h3>
            <p>{t(locale, 'pptresize.content.mistake1Desc')}</p>
          </div>

          <div class="type-card">
            <h3>{t(locale, 'pptresize.content.mistake2Title')}</h3>
            <p>{t(locale, 'pptresize.content.mistake2Desc')}</p>

          <details class="faq-item">
            <summary class="faq-question">
              <span>{t(locale, 'pptresize.content.faq2Q')}</span>
              <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="faq-answer">
              <p>{t(locale, 'pptresize.content.faq2A')}</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>{t(locale, 'pptresize.content.faq3Q')}</span>
              <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="faq-answer">
              <p>{t(locale, 'pptresize.content.faq3A')}</p>

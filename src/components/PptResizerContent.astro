      <!-- Section 10: FAQ Accordion -->
      <div class="content-block faq-container">
        <h2>{t(locale, 'pptresize.content.faqTitle')}</h2>
        <div class="faq-accordion">
          <details class="faq-item">
            <summary class="faq-question">
              <span>{t(locale, 'pptresize.content.faq1Q')}</span>

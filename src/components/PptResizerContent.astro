            <p>{t(locale, 'pptresize.content.use3Desc')}</p>
          </div>

          <div class="type-card">
            <h3>{t(locale, 'pptresize.content.use4Title')}</h3>
            <p>{t(locale, 'pptresize.content.use4Desc')}</p>
          </div>
        </div>
      </div>

      <!-- Section 7: Content Layout Considerations -->
      <div class="content-block">
        <h2>{t(locale, 'pptresize.content.h5')}</h2>
        <p>{t(locale, 'pptresize.content.p5a')}</p>

        <div class="types-grid">
          <div class="type-card">
            <h3>{t(locale, 'pptresize.content.layout1Title')}</h3>
            <p>{t(locale, 'pptresize.content.layout1Desc')}</p>

        </div>
      </div>

      <!-- Section 3: Technical OpenXML & EMUs -->
      <div class="content-block">
        <h2>{t(locale, 'pptresize.content.h3Tech')}</h2>
        <p>{t(locale, 'pptresize.content.p3Tech1')}</p>
        <p>{t(locale, 'pptresize.content.p3Tech2')}</p>
        <p>{t(locale, 'pptresize.content.p3Tech3')}</p>
      </div>

      <!-- Section 4: Step-by-Step Guide -->
      <div class="content-block">
        <h2>{t(locale, 'pptresize.content.h2')}</h2>
        <p>{t(locale, 'pptresize.content.p2a')}</p>

        <div class="steps-grid">
          <div class="step-card">
            <div class="step-number">1</div>
            <div class="step-content">
              <h3>{t(locale, 'pptresize.content.step1Title')}</h3>
              <p>{t(locale, 'pptresize.content.step1Desc')}</p>
            </div>
          </div>

          <div class="step-card">
            <div class="step-number">2</div>
            <div class="step-content">
              <h3>{t(locale, 'pptresize.content.step2Title')}</h3>
              <p>{t(locale, 'pptresize.content.step2Desc')}</p>
            </div>
          </div>

          <div class="step-card">
            <div class="step-number">3</div>
            <div class="step-content">
              <h3>{t(locale, 'pptresize.content.step3Title')}</h3>
              <p>{t(locale, 'pptresize.content.step3Desc')}</p>
            </div>
          </div>

          <div class="step-card">
            <div class="step-number">4</div>
            <div class="step-content">
              <h3>{t(locale, 'pptresize.content.step4Title')}</h3>
              <p>{t(locale, 'pptresize.content.step4Desc')}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 5: Dimension Breakdown -->
      <div class="content-block">
        <h2>{t(locale, 'pptresize.content.h3')}</h2>
        <p>{t(locale, 'pptresize.content.p3a')}</p>

        <div class="types-grid">
          <div class="type-card">
            <h3>{t(locale, 'pptresize.content.dim1Title')}</h3>
            <p>{t(locale, 'pptresize.content.dim1Desc')}</p>
          </div>

          <div class="type-card">
            <h3>{t(locale, 'pptresize.content.dim2Title')}</h3>
            <p>{t(locale, 'pptresize.content.dim2Desc')}</p>
          </div>

          <div class="type-card">
            <h3>{t(locale, 'pptresize.content.dim3Title')}</h3>
            <p>{t(locale, 'pptresize.content.dim3Desc')}</p>
          </div>

          <div class="type-card">
            <h3>{t(locale, 'pptresize.content.dim4Title')}</h3>
            <p>{t(locale, 'pptresize.content.dim4Desc')}</p>
          </div>
        </div>
      </div>

      <!-- Section 6: Real-World Scenarios -->
      <div class="content-block">
        <h2>{t(locale, 'pptresize.content.h4')}</h2>
        <p>{t(locale, 'pptresize.content.p4a')}</p>

        <div class="types-grid">
          <div class="type-card">
            <h3>{t(locale, 'pptresize.content.use1Title')}</h3>
            <p>{t(locale, 'pptresize.content.use1Desc')}</p>

          <div class="type-card">
            <h3>{t(locale, 'pptresize.content.mistake4Title')}</h3>
            <p>{t(locale, 'pptresize.content.mistake4Desc')}</p>
          </div>
        </div>
      </div>

      <!-- Section 9: Related Tools 6-Card Grid -->
      <div class="content-block related-tools-section">
        <h2>{t(locale, 'pptresize.cross.title')}</h2>
        <div class="cross-tools-grid">
          <a href={exactUrl} class="cross-card">
            <div class="cross-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
            </div>
            <div class="cross-info">
              <span class="cross-title">{t(locale, 'pptresize.cross.exact')}</span>
              <p class="cross-desc">{t(locale, 'pptresize.cross.exactDesc')}</p>
            </div>
          </a>

          <a href={webpUrl} class="cross-card">
            <div class="cross-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </div>
            <div class="cross-info">
              <span class="cross-title">{t(locale, 'pptresize.cross.webp')}</span>
              <p class="cross-desc">{t(locale, 'pptresize.cross.webpDesc')}</p>
            </div>
          </a>

          <a href={dpiUrl} class="cross-card">
            <div class="cross-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            </div>
            <div class="cross-info">
              <span class="cross-title">{t(locale, 'pptresize.cross.dpiConv')}</span>
              <p class="cross-desc">{t(locale, 'pptresize.cross.dpiConvDesc')}</p>
            </div>
          </a>

          <a href={ocrUrl} class="cross-card">
            <div class="cross-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 7V4h16v3"></path>
                <path d="M9 20h6"></path>
                <path d="M12 4v16"></path>
              </svg>
            </div>
            <div class="cross-info">
              <span class="cross-title">{t(locale, 'pptresize.cross.imgToText')}</span>
              <p class="cross-desc">{t(locale, 'pptresize.cross.imgToTextDesc')}</p>
            </div>
          </a>

          <a href={gifUrl} class="cross-card">
            <div class="cross-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
                <line x1="7" y1="2" x2="7" y2="22"></line>

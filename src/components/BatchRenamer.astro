---
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="batch-renamer-wrapper" data-locale={locale}>
  <!-- Upload Dropzone (Initial State) -->
  <div id="dropzoneContainer" class="dropzone-container">
    <div id="dropzone" class="dropzone" role="button" tabindex="0" aria-label={t(locale, 'renamer.dropzone.title')}>
      <input type="file" id="fileInput" accept="image/jpeg,image/jpg,image/png,image/webp,image/avif,image/gif,image/svg+xml" multiple class="file-input" />
      <div class="dropzone-content">
        <div class="dropzone-icon">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
          </svg>
        </div>
        <h2 class="dropzone-title">{t(locale, 'renamer.dropzone.title')}</h2>
        <p class="dropzone-subtitle">{t(locale, 'renamer.dropzone.subtitle')}</p>
        <div class="dropzone-actions">
          <button type="button" id="browseBtn" class="btn btn-primary btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            {t(locale, 'renamer.dropzone.browse')}
          </button>
          <button type="button" id="sampleBtn" class="btn btn-secondary btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 16v-4"></path>
              <path d="M12 8h.01"></path>
            </svg>
            {t(locale, 'renamer.dropzone.sample')}
          </button>
        </div>
        <div class="privacy-badge">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>{t(locale, 'renamer.privacy.badge')}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Active Workspace -->
  <div id="workspace" class="workspace" style="display: none;">
    <!-- Workspace Header Bar -->
    <div class="workspace-header-bar">
      <div class="workspace-stats-col">
        <span id="statImagesCount" class="badge badge-accent">0 Images</span>
        <span id="statTotalSize" class="badge">Total Size: 0 MB</span>
      </div>
      <div class="workspace-actions-col">
        <button type="button" id="addMoreBtn" class="btn btn-secondary btn-sm">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          {t(locale, 'renamer.action.addMore')}
        </button>
        <button type="button" id="clearAllBtn" class="btn btn-secondary btn-sm">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
          {t(locale, 'renamer.action.clearAll')}
        </button>
      </div>
    </div>

    <!-- Error Banner -->
    <div id="errorBanner" class="error-banner" style="display: none;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <span id="errorMessage">An error occurred</span>
    </div>

    <!-- Workspace Grid -->
    <div class="workspace-grid">
      <!-- Left Column: Settings & Renaming Modes -->
      <div class="settings-col">
        <!-- Mode Tabs -->
        <div class="mode-tabs-container">
          <button type="button" class="mode-tab active" data-mode="pattern">
            {t(locale, 'renamer.tab.pattern')}
          </button>
          <button type="button" class="mode-tab" data-mode="find-replace">
            {t(locale, 'renamer.tab.findReplace')}
          </button>
          <button type="button" class="mode-tab" data-mode="prefix-suffix">
            {t(locale, 'renamer.tab.prefixSuffix')}
          </button>
          <button type="button" class="mode-tab" data-mode="casing">
            {t(locale, 'renamer.tab.casing')}
          </button>
        </div>

        <!-- Mode 1: Pattern Controls -->
        <div id="panelPattern" class="mode-panel active control-group">
          <div class="field-row">
            <label for="patternInput" class="field-label">{t(locale, 'renamer.label.pattern')}</label>
            <span class="field-hint">{t(locale, 'renamer.hint.pattern')}</span>
            <input type="text" id="patternInput" class="form-input" value="photo-{00n}" />
          </div>

          <div class="presets-row">
            <button type="button" class="preset-pill" data-pattern="photo-{00n}">{t(locale, 'renamer.preset.photoSeq')}</button>
            <button type="button" class="preset-pill" data-pattern="vacation-2026-{n}">{t(locale, 'renamer.preset.vacation')}</button>
            <button type="button" class="preset-pill" data-pattern="{orig}-edited">{t(locale, 'renamer.preset.origEdit')}</button>
            <button type="button" class="preset-pill" data-pattern="product-{w}x{h}-{n}">{t(locale, 'renamer.preset.productDim')}</button>
          </div>

          <div class="two-cols-grid">
            <div class="field-row">
              <label for="startNumInput" class="field-label-sm">{t(locale, 'renamer.label.startNum')}</label>
              <input type="number" id="startNumInput" class="form-input" value="1" min="0" max="99999" />
            </div>
            <div class="field-row">
              <label for="paddingSelect" class="field-label-sm">{t(locale, 'renamer.label.padding')}</label>
              <select id="paddingSelect" class="form-select">
                <option value="1">{t(locale, 'renamer.pad.none')}</option>
                <option value="2">{t(locale, 'renamer.pad.two')}</option>
                <option value="3" selected>{t(locale, 'renamer.pad.three')}</option>
                <option value="4">{t(locale, 'renamer.pad.four')}</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Mode 2: Find & Replace Controls -->
        <div id="panelFindReplace" class="mode-panel control-group" style="display: none;">
          <div class="field-row">
            <label for="findTextInput" class="field-label">{t(locale, 'renamer.label.findText')}</label>
            <input type="text" id="findTextInput" class="form-input" placeholder={t(locale, 'renamer.placeholder.find')} />
          </div>

          <div class="field-row">
            <label for="replaceTextInput" class="field-label">{t(locale, 'renamer.label.replaceText')}</label>
            <input type="text" id="replaceTextInput" class="form-input" placeholder={t(locale, 'renamer.placeholder.replace')} />
          </div>

          <div class="checkbox-list">
            <label class="checkbox-inline">
              <input type="checkbox" id="matchCaseToggle" />
              <span>{t(locale, 'renamer.toggle.matchCase')}</span>
            </label>
            <label class="checkbox-inline">
              <input type="checkbox" id="regexToggle" />
              <span>{t(locale, 'renamer.toggle.regex')}</span>
            </label>
          </div>
        </div>

        <!-- Mode 3: Prefix / Suffix Controls -->
        <div id="panelPrefixSuffix" class="mode-panel control-group" style="display: none;">
          <div class="field-row">
            <label for="prefixInput" class="field-label">{t(locale, 'renamer.label.prefix')}</label>
            <input type="text" id="prefixInput" class="form-input" placeholder={t(locale, 'renamer.placeholder.prefix')} />
          </div>

          <div class="field-row">
            <label for="suffixInput" class="field-label">{t(locale, 'renamer.label.suffix')}</label>
            <input type="text" id="suffixInput" class="form-input" placeholder={t(locale, 'renamer.placeholder.suffix')} />
          </div>
        </div>

        <!-- Mode 4: Case & Cleanup Controls -->
        <div id="panelCasing" class="mode-panel control-group" style="display: none;">
          <div class="field-row">
            <label for="caseTransformSelect" class="field-label">{t(locale, 'renamer.label.caseTransform')}</label>
            <select id="caseTransformSelect" class="form-select">
              <option value="none" selected>{t(locale, 'renamer.case.none')}</option>
              <option value="lowercase">{t(locale, 'renamer.case.lower')}</option>
              <option value="uppercase">{t(locale, 'renamer.case.upper')}</option>
              <option value="titlecase">{t(locale, 'renamer.case.title')}</option>
            </select>
          </div>

          <div class="field-row">
            <label for="spaceReplacementSelect" class="field-label">{t(locale, 'renamer.label.spaces')}</label>
            <select id="spaceReplacementSelect" class="form-select">
              <option value="none">{t(locale, 'renamer.space.none')}</option>
              <option value="hyphen" selected>{t(locale, 'renamer.space.hyphen')}</option>
              <option value="underscore">{t(locale, 'renamer.space.underscore')}</option>
              <option value="remove">{t(locale, 'renamer.space.remove')}</option>
            </select>
          </div>
        </div>

        <!-- Universal Global Sanitizers Card -->
        <div class="control-group">
          <div class="checkbox-list">
            <label class="checkbox-inline">
              <input type="checkbox" id="cleanCharsToggle" checked />
              <div class="checkbox-text-col">
                <strong>{t(locale, 'renamer.toggle.cleanChars')}</strong>
                <span class="field-hint">{t(locale, 'renamer.toggle.cleanCharsDesc')}</span>
              </div>
            </label>
            <label class="checkbox-inline">
              <input type="checkbox" id="lowerExtToggle" checked />
              <div class="checkbox-text-col">
                <strong>{t(locale, 'renamer.toggle.lowerExt')}</strong>
              </div>
            </label>
          </div>
        </div>
      </div>

      <!-- Right Column: Live Table & Actions -->
      <div class="table-col">
        <div class="output-card">
          <!-- Top Action Bar -->
          <div class="table-header-row">
            <div class="table-title-col">
              <span class="table-title">{t(locale, 'renamer.table.previewTitle')}</span>
              <span class="table-subtitle">Live real-time preview of your renamed files</span>
            </div>
            <button type="button" id="downloadZipBtn" class="btn btn-primary btn-lg download-zip-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span id="zipBtnText">{t(locale, 'renamer.action.downloadZip')}</span>
            </button>
          </div>

          <!-- Progress Bar -->
          <div id="zipProgressBar" class="progress-bar-container" style="display: none;">
            <div id="zipProgressFill" class="progress-fill" style="width: 0%;"></div>
          </div>

          <!-- Interactive Responsive Before & After List -->
          <div class="items-list-container" id="itemsListContainer">
            <!-- Cards Injected Here -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    BatchRenamerEngine,
    type ImageItem,
    type RenameOptions,
    type RenameMode,
  } from '@/scripts/batch-renamer';

  document.addEventListener('DOMContentLoaded', () => {
    // DOM Elements
    const dropzoneContainer = document.getElementById('dropzoneContainer')!;
    const dropzone = document.getElementById('dropzone')!;
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const browseBtn = document.getElementById('browseBtn')!;
    const sampleBtn = document.getElementById('sampleBtn')!;
    const workspace = document.getElementById('workspace')!;
    const addMoreBtn = document.getElementById('addMoreBtn')!;
    const clearAllBtn = document.getElementById('clearAllBtn')!;
    const statImagesCount = document.getElementById('statImagesCount')!;
    const statTotalSize = document.getElementById('statTotalSize')!;
    const errorBanner = document.getElementById('errorBanner')!;
    const errorMessage = document.getElementById('errorMessage')!;

    // Mode Tabs & Panels
    const modeTabs = document.querySelectorAll('.mode-tab');
    const panelPattern = document.getElementById('panelPattern')!;
    const panelFindReplace = document.getElementById('panelFindReplace')!;
    const panelPrefixSuffix = document.getElementById('panelPrefixSuffix')!;
    const panelCasing = document.getElementById('panelCasing')!;

    // Inputs
    const patternInput = document.getElementById('patternInput') as HTMLInputElement;
    const startNumInput = document.getElementById('startNumInput') as HTMLInputElement;
    const paddingSelect = document.getElementById('paddingSelect') as HTMLSelectElement;
    const findTextInput = document.getElementById('findTextInput') as HTMLInputElement;
    const replaceTextInput = document.getElementById('replaceTextInput') as HTMLInputElement;
    const matchCaseToggle = document.getElementById('matchCaseToggle') as HTMLInputElement;
    const regexToggle = document.getElementById('regexToggle') as HTMLInputElement;
    const prefixInput = document.getElementById('prefixInput') as HTMLInputElement;
    const suffixInput = document.getElementById('suffixInput') as HTMLInputElement;
    const caseTransformSelect = document.getElementById('caseTransformSelect') as HTMLSelectElement;
    const spaceReplacementSelect = document.getElementById('spaceReplacementSelect') as HTMLSelectElement;
    const cleanCharsToggle = document.getElementById('cleanCharsToggle') as HTMLInputElement;
    const lowerExtToggle = document.getElementById('lowerExtToggle') as HTMLInputElement;
    const presetPills = document.querySelectorAll('.preset-pill');

    // List & Download
    const itemsListContainer = document.getElementById('itemsListContainer')!;
    const downloadZipBtn = document.getElementById('downloadZipBtn')!;
    const zipBtnText = document.getElementById('zipBtnText')!;
    const zipProgressBar = document.getElementById('zipProgressBar')!;
    const zipProgressFill = document.getElementById('zipProgressFill')!;

    // State
    let items: ImageItem[] = [];
    const options: RenameOptions = {
      mode: 'pattern',
      pattern: 'photo-{00n}',
      startNumber: 1,
      numberPadding: 3,
      findText: '',
      replaceText: '',
      isRegex: false,
      matchCase: false,
      prefix: '',
      suffix: '',
      caseTransformation: 'none',
      spaceReplacement: 'hyphen',
      cleanSpecialChars: true,
      lowercaseExtension: true,
    };

    function showError(msg: string) {
      errorMessage.textContent = msg;
      errorBanner.style.display = 'flex';
    }

    function hideError() {
      errorBanner.style.display = 'none';
    }

    function updateStats() {
      const totalBytes = items.reduce((acc, item) => acc + item.sizeBytes, 0);
      statImagesCount.textContent = `${items.length} Images`;
      statTotalSize.textContent = `Total: ${BatchRenamerEngine.formatBytes(totalBytes)}`;
    }

    function refreshTable() {
      items = BatchRenamerEngine.computeNewNames(items, options);
      itemsListContainer.innerHTML = '';

      items.forEach((item, index) => {
        const card = document.createElement('div');
        card.className = 'renamer-item-card';

        card.innerHTML = `
          <div class="card-left-col">
            <span class="index-badge">#${index + 1}</span>
            <img src="${item.thumbnailUrl}" class="item-thumb" alt="" loading="lazy" />
            <div class="old-file-meta">
              <span class="old-name-text" title="${item.originalName}">${item.originalName}</span>
              <span class="size-text">${BatchRenamerEngine.formatBytes(item.sizeBytes)}</span>
            </div>
          </div>

          <div class="card-center-col">
            <div class="new-name-wrapper">
              <span class="new-name-label">New Name</span>
              <input type="text" class="rename-inline-input" data-id="${item.id}" value="${item.newName}" spellcheck="false" />
            </div>
          </div>

          <div class="card-right-col">
            <button type="button" class="action-btn download-single-btn" data-id="${item.id}" title="Download ${item.newName}" aria-label="Download ${item.newName}">
              <svg class="action-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </button>
            <button type="button" class="action-btn action-btn-delete remove-item-btn" data-id="${item.id}" title="Delete ${item.originalName}" aria-label="Delete ${item.originalName}">
              <svg class="action-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                <line x1="10" y1="11" x2="10" y2="17"></line>
                <line x1="14" y1="11" x2="14" y2="17"></line>
              </svg>
            </button>
          </div>
        `;

        itemsListContainer.appendChild(card);
      });

      // Bind inline rename override
      itemsListContainer.querySelectorAll('.rename-inline-input').forEach((input) => {
        input.addEventListener('change', (e) => {
          const targetId = (e.currentTarget as HTMLInputElement).getAttribute('data-id');
          const item = items.find((i) => i.id === targetId);
          if (item) {
            item.customOverride = (e.currentTarget as HTMLInputElement).value;
            refreshTable();
          }
        });
      });

      // Bind single download
      itemsListContainer.querySelectorAll('.download-single-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const targetId = (e.currentTarget as HTMLElement).getAttribute('data-id');
          const item = items.find((i) => i.id === targetId);
          if (item) {
            const url = URL.createObjectURL(item.file);
            const a = document.createElement('a');
            a.href = url;
            a.download = item.newName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
          }
        });
      });

      // Bind remove single item
      itemsListContainer.querySelectorAll('.remove-item-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const targetId = (e.currentTarget as HTMLElement).getAttribute('data-id');
          items = items.filter((i) => i.id !== targetId);
          if (items.length === 0) {
            workspace.style.display = 'none';
            dropzoneContainer.style.display = 'block';
          } else {
            updateStats();
            refreshTable();
          }
        });
      });
    }

    async function addFiles(files: FileList | File[]) {
      try {
        hideError();
        const fileArr = Array.from(files);
        if (fileArr.length === 0) return;

        for (const file of fileArr) {
          const id = Math.random().toString(36).substring(2, 9);
          const originalName = file.name;
          const lastDot = originalName.lastIndexOf('.');
          const baseName = lastDot > 0 ? originalName.substring(0, lastDot) : originalName;
          const extension = lastDot > 0 ? originalName.substring(lastDot + 1) : '';
          const thumbnailUrl = URL.createObjectURL(file);

          const { width, height } = await BatchRenamerEngine.getImageDimensions(file);

          items.push({
            id,
            file,
            originalName,
            baseName,
            extension,
            sizeBytes: file.size,
            width,
            height,
            thumbnailUrl,
            newName: originalName,
          });
        }

        dropzoneContainer.style.display = 'none';
        workspace.style.display = 'block';

        updateStats();
        refreshTable();
      } catch (err: any) {
        showError(err.message || 'Failed to add image files.');
      }
    }

    // Mode Tabs Switcher
    modeTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        modeTabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');

        const mode = tab.getAttribute('data-mode') as RenameMode;
        options.mode = mode;

        panelPattern.style.display = mode === 'pattern' ? 'flex' : 'none';
        panelFindReplace.style.display = mode === 'find-replace' ? 'flex' : 'none';
        panelPrefixSuffix.style.display = mode === 'prefix-suffix' ? 'flex' : 'none';
        panelCasing.style.display = mode === 'casing' ? 'flex' : 'none';

        refreshTable();
      });
    });

    // Preset Pills
    presetPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const pat = pill.getAttribute('data-pattern') || 'photo-{00n}';
        patternInput.value = pat;
        options.pattern = pat;
        refreshTable();
      });
    });

    // Inputs Listeners
    patternInput.addEventListener('input', () => {
      options.pattern = patternInput.value;
      refreshTable();
    });

    startNumInput.addEventListener('input', () => {
      options.startNumber = parseInt(startNumInput.value, 10) || 1;
      refreshTable();
    });

    paddingSelect.addEventListener('change', () => {
      options.numberPadding = parseInt(paddingSelect.value, 10) || 3;
      refreshTable();
    });

    findTextInput.addEventListener('input', () => {
      options.findText = findTextInput.value;
      refreshTable();
    });

    replaceTextInput.addEventListener('input', () => {
      options.replaceText = replaceTextInput.value;
      refreshTable();
    });

    matchCaseToggle.addEventListener('change', () => {
      options.matchCase = matchCaseToggle.checked;
      refreshTable();
    });

    regexToggle.addEventListener('change', () => {
      options.isRegex = regexToggle.checked;
      refreshTable();
    });

    prefixInput.addEventListener('input', () => {
      options.prefix = prefixInput.value;
      refreshTable();
    });

    suffixInput.addEventListener('input', () => {
      options.suffix = suffixInput.value;
      refreshTable();
    });

    caseTransformSelect.addEventListener('change', () => {
      options.caseTransformation = caseTransformSelect.value as any;
      refreshTable();
    });

    spaceReplacementSelect.addEventListener('change', () => {
      options.spaceReplacement = spaceReplacementSelect.value as any;
      refreshTable();
    });

    cleanCharsToggle.addEventListener('change', () => {
      options.cleanSpecialChars = cleanCharsToggle.checked;
      refreshTable();
    });

    lowerExtToggle.addEventListener('change', () => {
      options.lowercaseExtension = lowerExtToggle.checked;
      refreshTable();
    });

    // Batch ZIP Download
    downloadZipBtn.addEventListener('click', async () => {
      if (items.length === 0) return;

      try {
        downloadZipBtn.setAttribute('disabled', 'true');
        zipBtnText.textContent = 'Packaging ZIP Archive...';
        zipProgressBar.style.display = 'block';
        zipProgressFill.style.width = '10%';

        const zipBlob = await BatchRenamerEngine.createRenamedZip(items, (curr, total) => {
          const pct = Math.round((curr / total) * 100);
          zipProgressFill.style.width = `${pct}%`;
        });

        const url = URL.createObjectURL(zipBlob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'renamed-images.zip';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);

        zipBtnText.textContent = 'Download Complete!';
        setTimeout(() => {
          downloadZipBtn.removeAttribute('disabled');
          zipBtnText.textContent = 'Download All Renamed Images (.ZIP)';
          zipProgressBar.style.display = 'none';
        }, 2000);
      } catch (err: any) {
        showError('Failed to create ZIP: ' + err.message);
        downloadZipBtn.removeAttribute('disabled');
        zipBtnText.textContent = 'Download All Renamed Images (.ZIP)';
        zipProgressBar.style.display = 'none';
      }
    });

    // Upload & Sample Handlers
    browseBtn.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('click', (e) => {
      if (e.target === sampleBtn || sampleBtn.contains(e.target as Node)) return;
      fileInput.click();
    });

    sampleBtn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const samples = await BatchRenamerEngine.generateSampleBatch();
      addFiles(samples);
    });

    addMoreBtn.addEventListener('click', () => fileInput.click());

    clearAllBtn.addEventListener('click', () => {
      items = [];
      fileInput.value = '';
      workspace.style.display = 'none';
      dropzoneContainer.style.display = 'block';
    });

    fileInput.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files) addFiles(files);
    });

    // Drag & Drop
    ['dragenter', 'dragover'].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropzone.classList.add('drag-over');
      });
    });

    ['dragleave', 'drop'].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropzone.classList.remove('drag-over');
      });
    });

    dropzone.addEventListener('drop', (e) => {
      const files = e.dataTransfer?.files;
      if (files) addFiles(files);
    });
  });
</script>


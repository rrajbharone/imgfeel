---
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div id="batch-renamer-container" class="batch-renamer-container" data-locale={locale} data-download-text={t(locale, 'renamer.action.downloadSingle')} data-remove-text={t(locale, 'renamer.action.remove')}>
  <!-- Hidden File Input -->
  <input type="file" id="fileInput" accept="image/jpeg,image/jpg,image/png,image/webp,image/avif,image/gif,image/svg+xml" multiple class="sr-only" />

  <!-- 1. Initial Upload Dropzone View (Shown when 0 images) -->
  <div id="uploadSection" class="upload-section">
    <div id="dropzone" class="upload-dropzone" role="button" tabindex="0" aria-label={t(locale, 'renamer.dropzone.title')}>
      <div class="upload-icon">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
      </div>
      <h2 class="upload-title">{t(locale, 'renamer.upload.title')}</h2>
      <p class="upload-subtitle">{t(locale, 'renamer.dropzone.subtitle')}</p>
      
      <div class="upload-actions">
        <button type="button" id="chooseImagesBtn" class="btn btn-primary btn-lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'renamer.dropzone.browse')}</span>
        </button>
        <button type="button" id="sampleDemoBtn" class="btn btn-secondary btn-lg">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span>{t(locale, 'renamer.dropzone.sample')}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 2. Two-Panel Workspace View (Shown after upload - Exact Screenshot Match) -->
  <div id="workspaceSection" class="workspace-section" style="display: none;">
    <!-- Error Banner -->
    <div id="errorBanner" class="error-banner" style="display: none;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <span id="errorMessage">An error occurred</span>
    </div>

    <div class="two-panel-layout">
      <!-- LEFT PANEL: Large Image Preview Card with < 1 / 10 > Controls -->
      <div class="left-preview-panel">
        <div class="large-preview-card">
          <div class="preview-image-container">
            <img id="largePreviewImg" src="" alt="Active Image Preview" class="large-preview-image" />
          </div>
        </div>

        <!-- Navigation Controls: < 1 / 10 > -->
        <div class="preview-navigation-bar">
          <button type="button" id="prevBtn" class="nav-btn" aria-label={t(locale, 'renamer.nav.prev')}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <span id="navCounter" class="nav-counter">1 / 1</span>
          <button type="button" id="nextBtn" class="nav-btn" aria-label={t(locale, 'renamer.nav.next')}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>

      <!-- RIGHT PANEL: Custom Names Dropdown, Scrollable List & Download Controls -->
      <div class="right-sidebar-panel">
        <!-- Top: Batch Mode Dropdown / Custom Names -->
        <div class="batch-dropdown-container">
          <div class="custom-select-wrapper">
            <select id="batchModeSelect" class="batch-select" aria-label="Batch renaming mode">
              <option value="custom">{t(locale, 'renamer.batch.customNames')}</option>
              <option value="sequential">{t(locale, 'renamer.batch.sequential')}</option>
              <option value="prefix-suffix">{t(locale, 'renamer.batch.prefixSuffix')}</option>
              <option value="find-replace">{t(locale, 'renamer.batch.findReplace')}</option>
              <option value="datestamp">{t(locale, 'renamer.batch.dateStamp')}</option>
            </select>
            <svg class="dropdown-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </div>

          <!-- Drawer for batch patterns when selected -->
          <div id="batchDrawer" class="batch-drawer" style="display: none;">
            <div id="drawerSequential" class="drawer-group" style="display: none;">
              <div class="drawer-row">
                <input type="text" id="seqBaseInput" class="drawer-input" placeholder={t(locale, 'renamer.batch.baseName')} value="photo" />
                <input type="number" id="seqStartInput" class="drawer-input drawer-input-sm" placeholder={t(locale, 'renamer.batch.startNumber')} value="1" min="0" />
              </div>
            </div>

            <div id="drawerPrefixSuffix" class="drawer-group" style="display: none;">
              <div class="drawer-row">
                <input type="text" id="prefixInput" class="drawer-input" placeholder={t(locale, 'renamer.batch.prefix')} />
                <input type="text" id="suffixInput" class="drawer-input" placeholder={t(locale, 'renamer.batch.suffix')} />
              </div>
            </div>

            <div id="drawerFindReplace" class="drawer-group" style="display: none;">
              <div class="drawer-row">
                <input type="text" id="findInput" class="drawer-input" placeholder={t(locale, 'renamer.batch.find')} />
                <input type="text" id="replaceInput" class="drawer-input" placeholder={t(locale, 'renamer.batch.replace')} />
              </div>
            </div>

            <button type="button" id="applyBatchBtn" class="btn btn-secondary btn-sm apply-btn">
              {t(locale, 'renamer.batch.apply')}
            </button>
          </div>
        </div>

        <!-- Middle: Scrollable Image Rows List -->
        <div id="imageList" class="image-rows-list">
          <!-- Dynamically inserted image rows matching screenshot -->
        </div>

        <!-- Bottom Actions: Download All Split Button + Auxiliary Buttons -->
        <div class="sidebar-bottom-actions">
          <div class="download-split-group">
            <button type="button" id="downloadAllMainBtn" class="split-btn-main">
              <span id="downloadAllText">{t(locale, 'renamer.action.downloadZip')} (0)</span>
            </button>
            <button type="button" id="downloadDropdownTrigger" class="split-btn-dropdown" aria-label="More download options">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>

            <!-- Dropdown Menu for single vs zip download -->
            <div id="downloadDropdownMenu" class="download-dropdown-menu" style="display: none;">
              <button type="button" id="downloadZipOption" class="dropdown-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>Download All (.ZIP)</span>
              </button>
              <button type="button" id="downloadSingleOption" class="dropdown-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span id="downloadSingleText">Download Selected Image</span>
              </button>
            </div>
          </div>

          <!-- Add More Button -->
          <button type="button" id="addMoreBtn" class="action-icon-btn" title={t(locale, 'renamer.action.addMore')}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="3"></rect>
              <line x1="12" y1="8" x2="12" y2="16"></line>
              <line x1="8" y1="12" x2="16" y2="12"></line>
            </svg>
          </button>

          <!-- Clear / Reset Button -->
          <button type="button" id="clearAllBtn" class="action-icon-btn" title={t(locale, 'renamer.action.clearAll')}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
          </button>
        </div>

        <!-- Packaging Progress Bar -->
        <div id="zipProgressBar" class="progress-bar-container" style="display: none;">
          <div id="zipProgressFill" class="progress-fill" style="width: 0%;"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    BatchRenamerEngine,
    type ImageItem,
  } from '@/scripts/batch-renamer';

  document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.getElementById('batch-renamer-container') as HTMLElement;
    const downloadLabel = wrapper?.getAttribute('data-download-text') || 'Download';
    const removeLabel = wrapper?.getAttribute('data-remove-text') || 'Delete';

    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const dropzone = document.getElementById('dropzone')!;
    const chooseImagesBtn = document.getElementById('chooseImagesBtn')!;
    const sampleDemoBtn = document.getElementById('sampleDemoBtn')!;

    const uploadSection = document.getElementById('uploadSection')!;
    const workspaceSection = document.getElementById('workspaceSection')!;
    const imageList = document.getElementById('imageList')!;

    const largePreviewImg = document.getElementById('largePreviewImg') as HTMLImageElement;
    const prevBtn = document.getElementById('prevBtn')!;
    const nextBtn = document.getElementById('nextBtn')!;
    const navCounter = document.getElementById('navCounter')!;

    const batchModeSelect = document.getElementById('batchModeSelect') as HTMLSelectElement;
    const batchDrawer = document.getElementById('batchDrawer')!;
    const drawerSequential = document.getElementById('drawerSequential')!;
    const drawerPrefixSuffix = document.getElementById('drawerPrefixSuffix')!;
    const drawerFindReplace = document.getElementById('drawerFindReplace')!;
    const applyBatchBtn = document.getElementById('applyBatchBtn')!;

    const seqBaseInput = document.getElementById('seqBaseInput') as HTMLInputElement;
    const seqStartInput = document.getElementById('seqStartInput') as HTMLInputElement;
    const prefixInput = document.getElementById('prefixInput') as HTMLInputElement;
    const suffixInput = document.getElementById('suffixInput') as HTMLInputElement;
    const findInput = document.getElementById('findInput') as HTMLInputElement;
    const replaceInput = document.getElementById('replaceInput') as HTMLInputElement;

    const downloadAllMainBtn = document.getElementById('downloadAllMainBtn')!;
    const downloadAllText = document.getElementById('downloadAllText')!;
    const downloadDropdownTrigger = document.getElementById('downloadDropdownTrigger')!;
    const downloadDropdownMenu = document.getElementById('downloadDropdownMenu')!;
    const downloadZipOption = document.getElementById('downloadZipOption')!;
    const downloadSingleOption = document.getElementById('downloadSingleOption')!;
    const downloadSingleText = document.getElementById('downloadSingleText')!;

    const addMoreBtn = document.getElementById('addMoreBtn')!;
    const clearAllBtn = document.getElementById('clearAllBtn')!;
    const zipProgressBar = document.getElementById('zipProgressBar')!;
    const zipProgressFill = document.getElementById('zipProgressFill')!;

    const errorBanner = document.getElementById('errorBanner')!;
    const errorMessage = document.getElementById('errorMessage')!;

    let items: ImageItem[] = [];
    let selectedIndex = 0;

    function showError(msg: string) {
      errorMessage.textContent = msg;
      errorBanner.style.display = 'flex';
    }

    function hideError() {
      errorBanner.style.display = 'none';
    }

    function updatePreview() {
      if (items.length === 0) return;
      if (selectedIndex < 0) selectedIndex = 0;
      if (selectedIndex >= items.length) selectedIndex = items.length - 1;

      const current = items[selectedIndex];
      if (current) {
        largePreviewImg.src = current.thumbnailUrl;
        largePreviewImg.alt = current.newName;
        navCounter.textContent = `${selectedIndex + 1} / ${items.length}`;
        downloadSingleText.textContent = `Download "${current.newName}"`;
      }

      // Update active highlight in the right list
      const rows = imageList.querySelectorAll('.image-item-row');
      rows.forEach((row, idx) => {
        if (idx === selectedIndex) {
          row.classList.add('active-row');
          row.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        } else {
          row.classList.remove('active-row');
        }
      });
    }

    function updateSummary() {
      downloadAllText.textContent = `Download All (${items.length})`;
      navCounter.textContent = `${items.length > 0 ? selectedIndex + 1 : 0} / ${items.length}`;
    }

    function computeSanitizedBase(inputVal: string, extension: string): string {
      let val = inputVal.trim();
      if (!val) return 'image';
      if (extension && val.toLowerCase().endsWith('.' + extension.toLowerCase())) {
        val = val.substring(0, val.length - (extension.length + 1));
      }
      return val;
    }

    function renderList() {
      imageList.innerHTML = '';

      items.forEach((item, idx) => {
        const row = document.createElement('div');
        row.className = `image-item-row ${idx === selectedIndex ? 'active-row' : ''}`;
        row.setAttribute('data-id', item.id);
        row.setAttribute('data-index', idx.toString());

        row.innerHTML = `
          <!-- Left: Small compact thumbnail -->
          <div class="row-thumbnail">
            <img src="${item.thumbnailUrl}" alt="${item.originalName}" class="thumb-img" loading="lazy" />
          </div>

          <!-- Right: Meta header (#5 and .png) + Editable Filename Field -->
          <div class="row-content">
            <div class="row-meta">
              <span class="meta-number">#${idx + 1}</span>
              <span class="meta-extension">.${item.extension || 'png'}</span>
            </div>
            <input
              type="text"
              class="row-input"
              value="${item.baseName}"
              data-id="${item.id}"
              data-index="${idx}"
              placeholder="Filename..."
              aria-label="Edit filename"
              spellcheck="false"
            />
          </div>

          <!-- Quick delete button on hover -->
          <button type="button" class="row-delete-btn" data-id="${item.id}" title="${removeLabel}">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        `;

        // Click row to select
        row.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('.row-delete-btn')) return;
          selectedIndex = idx;
          updatePreview();
        });

        imageList.appendChild(row);
      });

      // Bind input changes
      imageList.querySelectorAll('.row-input').forEach((input) => {
        const handleInputChange = (e: Event) => {
          const target = e.target as HTMLInputElement;
          const id = target.getAttribute('data-id');
          const item = items.find((it) => it.id === id);
          if (item) {
            item.baseName = computeSanitizedBase(target.value, item.extension);
            item.newName = item.extension ? `${item.baseName}.${item.extension}` : item.baseName;
          }
        };
        input.addEventListener('input', handleInputChange);
        input.addEventListener('focus', () => {
          const idx = parseInt(input.getAttribute('data-index') || '0', 10);
          selectedIndex = idx;
          updatePreview();
        });
      });

      // Bind delete buttons
      imageList.querySelectorAll('.row-delete-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const id = btn.getAttribute('data-id');
          const target = items.find((it) => it.id === id);
          if (target && target.thumbnailUrl) {
            URL.revokeObjectURL(target.thumbnailUrl);
          }
          items = items.filter((it) => it.id !== id);

          if (items.length === 0) {
            workspaceSection.style.display = 'none';
            uploadSection.style.display = 'block';
            fileInput.value = '';
          } else {
            if (selectedIndex >= items.length) {
              selectedIndex = items.length - 1;
            }
            renderList();
            updatePreview();
            updateSummary();
          }
        });
      });
    }

    async function handleAddFiles(fileList: FileList | File[]) {
      hideError();
      const filesArray = Array.from(fileList);
      if (filesArray.length === 0) return;

      try {
        const inspected = await Promise.all(
          filesArray.map((f) => BatchRenamerEngine.inspectImageFile(f))
        );
        items.push(...inspected);

        if (items.length > 0) {
          uploadSection.style.display = 'none';
          workspaceSection.style.display = 'block';
          renderList();
          updatePreview();
          updateSummary();
        }
      } catch (err: any) {
        showError(err.message || 'Failed to process images.');
      }
    }

    // Navigation Controls
    prevBtn.addEventListener('click', () => {
      if (items.length <= 1) return;
      selectedIndex = selectedIndex > 0 ? selectedIndex - 1 : items.length - 1;
      updatePreview();
    });

    nextBtn.addEventListener('click', () => {
      if (items.length <= 1) return;
      selectedIndex = selectedIndex < items.length - 1 ? selectedIndex + 1 : 0;
      updatePreview();
    });

    // Keyboard Arrow Navigation
    document.addEventListener('keydown', (e) => {
      if (['INPUT', 'SELECT', 'TEXTAREA'].includes((document.activeElement?.tagName || ''))) return;
      if (items.length <= 1) return;
      if (e.key === 'ArrowLeft') {
        selectedIndex = selectedIndex > 0 ? selectedIndex - 1 : items.length - 1;
        updatePreview();
      } else if (e.key === 'ArrowRight') {
        selectedIndex = selectedIndex < items.length - 1 ? selectedIndex + 1 : 0;
        updatePreview();
      }
    });

    // Batch Renaming Drawer
    function updateBatchDrawer() {
      const mode = batchModeSelect.value;
      if (mode === 'custom') {
        batchDrawer.style.display = 'none';
      } else {
        batchDrawer.style.display = 'flex';
        drawerSequential.style.display = mode === 'sequential' ? 'block' : 'none';
        drawerPrefixSuffix.style.display = mode === 'prefix-suffix' ? 'block' : 'none';
        drawerFindReplace.style.display = mode === 'find-replace' ? 'block' : 'none';
      }
    }

    batchModeSelect.addEventListener('change', () => {
      updateBatchDrawer();
      if (batchModeSelect.value === 'datestamp') {
        applyDatestamp();
      }
    });

    function applySequential() {
      const base = seqBaseInput.value.trim() || 'image';
      const start = parseInt(seqStartInput.value, 10) || 1;
      items.forEach((it, idx) => {
        const num = start + idx;
        it.baseName = `${base}-${num}`;
        it.newName = it.extension ? `${it.baseName}.${it.extension}` : it.baseName;
      });
      renderList();
      updatePreview();
    }

    function applyPrefixSuffix() {
      const p = prefixInput.value;
      const s = suffixInput.value;
      items.forEach((it) => {
        it.baseName = `${p}${it.baseName}${s}`;
        it.newName = it.extension ? `${it.baseName}.${it.extension}` : it.baseName;
      });
      renderList();
      updatePreview();
    }

    function applyFindReplace() {
      const f = findInput.value;
      const r = replaceInput.value;
      if (!f) return;
      items.forEach((it) => {
        it.baseName = it.baseName.split(f).join(r);
        it.newName = it.extension ? `${it.baseName}.${it.extension}` : it.baseName;
      });
      renderList();
      updatePreview();
    }

    function applyDatestamp() {
      const date = new Date().toISOString().slice(0, 10);
      items.forEach((it, idx) => {
        it.baseName = `${date}_${idx + 1}`;
        it.newName = it.extension ? `${it.baseName}.${it.extension}` : it.baseName;
      });
      renderList();
      updatePreview();
    }

    applyBatchBtn.addEventListener('click', () => {
      const mode = batchModeSelect.value;
      if (mode === 'sequential') applySequential();
      else if (mode === 'prefix-suffix') applyPrefixSuffix();
      else if (mode === 'find-replace') applyFindReplace();
      else if (mode === 'datestamp') applyDatestamp();
    });

    // ZIP Package Download
    async function triggerZipDownload() {
      if (items.length === 0) return;
      try {
        downloadAllMainBtn.setAttribute('disabled', 'true');
        downloadAllText.textContent = 'Packaging ZIP...';
        zipProgressBar.style.display = 'block';
        zipProgressFill.style.width = '15%';

        const zipBlob = await BatchRenamerEngine.createRenamedZip(items, (curr, total) => {
          const pct = Math.round((curr / total) * 100);
          zipProgressFill.style.width = `${pct}%`;
        });

        const url = URL.createObjectURL(zipBlob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'renamed-images.zip';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(() => URL.revokeObjectURL(url), 1000);

        downloadAllText.textContent = 'Download Complete!';
        setTimeout(() => {
          downloadAllMainBtn.removeAttribute('disabled');
          updateSummary();
          zipProgressBar.style.display = 'none';
          zipProgressFill.style.width = '0%';
        }, 2000);
      } catch (err: any) {
        showError('Failed to create ZIP: ' + err.message);
        downloadAllMainBtn.removeAttribute('disabled');
        updateSummary();
        zipProgressBar.style.display = 'none';
      }
    }

    downloadAllMainBtn.addEventListener('click', () => {
      downloadDropdownMenu.style.display = 'none';
      triggerZipDownload();
    });

    downloadDropdownTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      downloadDropdownMenu.style.display = downloadDropdownMenu.style.display === 'none' ? 'flex' : 'none';
    });

    document.addEventListener('click', (e) => {
      if (!downloadDropdownMenu.contains(e.target as Node) && e.target !== downloadDropdownTrigger) {
        downloadDropdownMenu.style.display = 'none';
      }
    });

    downloadZipOption.addEventListener('click', () => {
      downloadDropdownMenu.style.display = 'none';
      triggerZipDownload();
    });

    downloadSingleOption.addEventListener('click', () => {
      downloadDropdownMenu.style.display = 'none';
      const current = items[selectedIndex];
      if (current) {
        const url = URL.createObjectURL(current.file);
        const a = document.createElement('a');
        a.href = url;
        a.download = current.newName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      }
    });

    // Upload Triggers
    chooseImagesBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput.click();
    });

    dropzone.addEventListener('click', (e) => {
      if (e.target === sampleDemoBtn || sampleDemoBtn.contains(e.target as Node)) return;
      fileInput.click();
    });

    sampleDemoBtn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const samples = await BatchRenamerEngine.generateSampleBatch();
      handleAddFiles(samples);
    });

    addMoreBtn.addEventListener('click', () => fileInput.click());

    clearAllBtn.addEventListener('click', () => {
      items.forEach((it) => {
        if (it.thumbnailUrl) URL.revokeObjectURL(it.thumbnailUrl);
      });
      items = [];
      selectedIndex = 0;
      fileInput.value = '';
      workspaceSection.style.display = 'none';
      uploadSection.style.display = 'block';
    });

    fileInput.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files) handleAddFiles(files);
    });

    ['dragenter', 'dragover'].forEach((ev) => {
      dropzone.addEventListener(ev, (e) => {
        e.preventDefault();
        dropzone.classList.add('drag-over');
      });
    });

    ['dragleave', 'drop'].forEach((ev) => {
      dropzone.addEventListener(ev, (e) => {
        e.preventDefault();
        dropzone.classList.remove('drag-over');
      });
    });

    dropzone.addEventListener('drop', (e) => {
      const files = e.dataTransfer?.files;
      if (files) handleAddFiles(files);
    });
  });
</script>


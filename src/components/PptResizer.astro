---
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div
  id="pptResizerWrapper"
  class="ppt-resizer-wrapper"
  data-locale={locale}
  data-str-download={t(locale, 'pptresize.action.download')}
  data-str-processing={t(locale, 'pptresize.action.processing')}
  data-str-complete={t(locale, 'pptresize.action.complete')}
  data-str-error-inspect={t(locale, 'pptresize.error.inspect')}
  data-str-error-resize={t(locale, 'pptresize.error.resize')}
  data-str-slides-single={t(locale, 'pptresize.stat.slidesSingle')}
  data-str-slides-plural={t(locale, 'pptresize.stat.slidesPlural')}
  data-str-custom={t(locale, 'pptresize.preset.custom')}
>
  <!-- Upload Dropzone (Initial State) -->
  <div id="dropzoneContainer" class="dropzone-container">
    <div id="dropzone" class="dropzone" role="button" tabindex="0" aria-label={t(locale, 'pptresize.dropzone.title')}>
      <input
        type="file"
        id="fileInput"
        accept=".pptx,.ppt,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.ms-powerpoint"
        class="file-input"
      />
      <div class="dropzone-content">
        <div class="dropzone-icon">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
            <path d="M7 8h4a2 2 0 0 1 0 4H7z"></path>
            <line x1="7" y1="8" x2="7" y2="14"></line>
          </svg>
        </div>
        <h2 class="dropzone-title">{t(locale, 'pptresize.dropzone.title')}</h2>
        <p class="dropzone-subtitle">{t(locale, 'pptresize.dropzone.subtitle')}</p>
        <div class="dropzone-actions">
          <button type="button" id="browseBtn" class="btn btn-primary btn-action">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            <span>{t(locale, 'pptresize.dropzone.browse')}</span>
          </button>
          <button type="button" id="sampleBtn" class="btn btn-secondary btn-action">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 16v-4"></path>
              <path d="M12 8h.01"></path>
            </svg>
            <span>{t(locale, 'pptresize.dropzone.sample')}</span>
          </button>
        </div>
        <div class="privacy-badge">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>{t(locale, 'pptresize.privacy.badge')}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Active Workspace -->
  <div id="workspace" class="workspace" style="display: none;">
    <!-- Workspace Header Bar -->
    <div class="workspace-header-bar">
      <div class="file-info-col">
        <div class="file-title-row">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
          <span id="fileNameDisplay" class="file-name">presentation.pptx</span>
        </div>
        <div class="file-meta-row">
          <span id="statSlidesCount" class="badge badge-accent">1 Slide</span>
          <span id="statOriginalSize" class="badge">4:3 Standard (10.0 × 7.5 in)</span>
          <span id="statFileSize" class="badge">Size: 0 KB</span>
        </div>
      </div>
      <button type="button" id="changeFileBtn" class="btn btn-secondary btn-sm">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
        <span>{t(locale, 'pptresize.action.changeFile')}</span>
      </button>
    </div>

    <!-- Error Banner -->
    <div id="errorBanner" class="error-banner" style="display: none;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <span id="errorMessage">An error occurred</span>
    </div>

    <!-- Main Workspace Grid -->
    <div class="workspace-grid">
      <!-- Settings Column -->
      <div class="settings-col">
        <!-- Preset Selector Card -->
        <div class="control-group">
          <label for="presetSelect" class="field-label">{t(locale, 'pptresize.label.preset')}</label>
          <select id="presetSelect" class="form-select">
            <option value="16-9">{t(locale, 'pptresize.preset.169')}</option>
            <option value="4-3">{t(locale, 'pptresize.preset.43')}</option>
            <option value="16-10">{t(locale, 'pptresize.preset.1610')}</option>
            <option value="a4-landscape">{t(locale, 'pptresize.preset.a4Landscape')}</option>
            <option value="a4-portrait">{t(locale, 'pptresize.preset.a4Portrait')}</option>
            <option value="letter-landscape">{t(locale, 'pptresize.preset.letterLandscape')}</option>
            <option value="letter-portrait">{t(locale, 'pptresize.preset.letterPortrait')}</option>
            <option value="a3-poster">{t(locale, 'pptresize.preset.a3')}</option>
            <option value="square">{t(locale, 'pptresize.preset.square')}</option>
            <option value="custom">{t(locale, 'pptresize.preset.custom')}</option>
          </select>

          <!-- Orientation Toggle -->
          <div class="field-row">
            <label class="field-label-sm">{t(locale, 'pptresize.label.orientation')}</label>
            <div class="orientation-buttons">
              <button type="button" id="orientLandscapeBtn" class="orient-btn active">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                </svg>
                <span>{t(locale, 'pptresize.orient.landscape')}</span>
              </button>
              <button type="button" id="orientPortraitBtn" class="orient-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="5" y="2" width="14" height="20" rx="2"></rect>
                </svg>
                <span>{t(locale, 'pptresize.orient.portrait')}</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Custom Dimensions Card -->
        <div class="control-group">
          <div class="field-row">
            <label for="unitSelect" class="field-label-sm">{t(locale, 'pptresize.label.unit')}</label>
            <select id="unitSelect" class="form-select">
              <option value="in" selected>{t(locale, 'pptresize.unit.inches')}</option>
              <option value="cm">{t(locale, 'pptresize.unit.cm')}</option>
              <option value="mm">{t(locale, 'pptresize.unit.mm')}</option>
              <option value="pt">{t(locale, 'pptresize.unit.pt')}</option>
              <option value="px">{t(locale, 'pptresize.unit.px')}</option>
            </select>
          </div>

          <div class="two-cols-grid">
            <div class="field-row">
              <label for="widthInput" class="field-label-sm">{t(locale, 'pptresize.label.width')}</label>
              <input type="number" id="widthInput" class="form-input" value="13.33" step="0.01" min="0.1" max="500" />
            </div>
            <div class="field-row">
              <label for="heightInput" class="field-label-sm">{t(locale, 'pptresize.label.height')}</label>
              <input type="number" id="heightInput" class="form-input" value="7.50" step="0.01" min="0.1" max="500" />
            </div>
          </div>

          <div class="checkbox-wrapper">
            <label class="checkbox-inline">
              <input type="checkbox" id="scaleContentToggle" checked />
              <div class="checkbox-text-col">
                <strong>{t(locale, 'pptresize.label.scaleContent')}</strong>
                <span class="field-hint">{t(locale, 'pptresize.label.scaleContentDesc')}</span>
              </div>
            </label>
          </div>
        </div>
      </div>

      <!-- Preview & Download Column -->
      <div class="preview-col">
        <!-- Visual Aspect Ratio Comparison Card -->
        <div class="output-card">
          <div class="preview-header">
            <span class="output-title">{t(locale, 'pptresize.preview.title')}</span>
          </div>

          <div class="aspect-ratio-comparison-stage">
            <!-- Original Slide Frame -->
            <div class="slide-visual-box original-box">
              <div class="slide-box-header">
                <span class="box-badge">{t(locale, 'pptresize.preview.original')}</span>
                <span id="originalRatioLabel" class="box-ratio">4:3</span>
              </div>
              <div class="slide-frame-canvas-wrap">
                <div id="originalSlideFrame" class="slide-frame original-frame">
                  <div class="slide-inner-mockup">
                    <div class="mock-line title-line"></div>
                    <div class="mock-line body-line"></div>
                    <div class="mock-line body-line short"></div>
                  </div>
                </div>
              </div>
              <span id="originalDimsLabel" class="box-dims-text">10.0 × 7.5 in</span>
            </div>

            <!-- Arrow Indicator -->
            <div class="comparison-arrow">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4F46E5" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>

            <!-- Target Slide Frame -->
            <div class="slide-visual-box target-box">
              <div class="slide-box-header">
                <span class="box-badge box-badge-target">{t(locale, 'pptresize.preview.target')}</span>
                <span id="targetRatioLabel" class="box-ratio">16:9</span>
              </div>
              <div class="slide-frame-canvas-wrap">
                <div id="targetSlideFrame" class="slide-frame target-frame">
                  <div class="slide-inner-mockup">
                    <div class="mock-line title-line"></div>
                    <div class="mock-line body-line"></div>
                    <div class="mock-line body-line short"></div>
                  </div>
                </div>
              </div>
              <span id="targetDimsLabel" class="box-dims-text">13.33 × 7.5 in</span>
            </div>
          </div>

          <!-- Action Buttons Area -->
          <div class="action-buttons-box">
            <div class="action-buttons-row">
              <button type="button" id="downloadBtn" class="btn btn-primary btn-action-main">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span id="downloadBtnText">{t(locale, 'pptresize.action.download')}</span>
              </button>
              <button type="button" id="resetBtn" class="btn btn-secondary btn-action-secondary">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                  <path d="M3 3v5h5"></path>
                </svg>
                <span>{t(locale, 'pptresize.action.reset')}</span>
              </button>
            </div>
            <div id="progressBar" class="progress-bar-container" style="display: none;">
              <div id="progressFill" class="progress-fill" style="width: 0%;"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    PptResizerEngine,
    SLIDE_PRESETS,
    type PresentationInfo,
    type PptResizeOptions,
    type PptxZipEntry,
  } from '@/scripts/ppt-resizer';

  document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.getElementById('pptResizerWrapper');
    if (!wrapper) return;

    // Localized Strings from data attributes
    const STR_DOWNLOAD = wrapper.dataset.strDownload || 'Download Resized Presentation (.PPTX)';
    const STR_PROCESSING = wrapper.dataset.strProcessing || 'Resizing & Packaging PPTX...';
    const STR_COMPLETE = wrapper.dataset.strComplete || 'Download Complete!';
    const STR_ERROR_INSPECT = wrapper.dataset.strErrorInspect || 'Failed to inspect PowerPoint file. Please ensure it is a valid .pptx presentation.';
    const STR_ERROR_RESIZE = wrapper.dataset.strErrorResize || 'Failed to resize PowerPoint presentation: ';
    const STR_SLIDES_SINGLE = wrapper.dataset.strSlidesSingle || '1 Slide';
    const STR_SLIDES_PLURAL = wrapper.dataset.strSlidesPlural || '{n} Slides';
    const STR_CUSTOM = wrapper.dataset.strCustom || 'Custom';

    // Elements
    const dropzoneContainer = document.getElementById('dropzoneContainer')!;
    const dropzone = document.getElementById('dropzone')!;
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const browseBtn = document.getElementById('browseBtn')!;
    const sampleBtn = document.getElementById('sampleBtn')!;
    const workspace = document.getElementById('workspace')!;
    const changeFileBtn = document.getElementById('changeFileBtn')!;
    const resetBtn = document.getElementById('resetBtn')!;
    const fileNameDisplay = document.getElementById('fileNameDisplay')!;
    const statSlidesCount = document.getElementById('statSlidesCount')!;
    const statOriginalSize = document.getElementById('statOriginalSize')!;
    const statFileSize = document.getElementById('statFileSize')!;
    const errorBanner = document.getElementById('errorBanner')!;
    const errorMessage = document.getElementById('errorMessage')!;

    // Controls
    const presetSelect = document.getElementById('presetSelect') as HTMLSelectElement;
    const orientLandscapeBtn = document.getElementById('orientLandscapeBtn')!;
    const orientPortraitBtn = document.getElementById('orientPortraitBtn')!;
    const unitSelect = document.getElementById('unitSelect') as HTMLSelectElement;
    const widthInput = document.getElementById('widthInput') as HTMLInputElement;
    const heightInput = document.getElementById('heightInput') as HTMLInputElement;
    const scaleContentToggle = document.getElementById('scaleContentToggle') as HTMLInputElement;

    // Visual Preview & Download
    const originalRatioLabel = document.getElementById('originalRatioLabel')!;
    const originalDimsLabel = document.getElementById('originalDimsLabel')!;
    const originalSlideFrame = document.getElementById('originalSlideFrame')!;
    const targetRatioLabel = document.getElementById('targetRatioLabel')!;
    const targetDimsLabel = document.getElementById('targetDimsLabel')!;
    const targetSlideFrame = document.getElementById('targetSlideFrame')!;
    const downloadBtn = document.getElementById('downloadBtn')!;
    const downloadBtnText = document.getElementById('downloadBtnText')!;
    const progressBar = document.getElementById('progressBar')!;
    const progressFill = document.getElementById('progressFill')!;

    // State
    let currentZipEntries: PptxZipEntry[] = [];
    let presentationInfo: PresentationInfo | null = null;
    let selectedOrientation: 'landscape' | 'portrait' = 'landscape';
    let currentUnit: 'in' | 'cm' | 'mm' | 'pt' | 'px' = 'in';

    const resizeOptions: PptResizeOptions = {
      presetId: '16-9',
      targetWidthEmus: 12192000,
      targetHeightEmus: 6858000,
      orientation: 'landscape',
      scaleContent: true,
      typeAttr: 'screen16x9',
    };

    function showError(msg: string) {
      errorMessage.textContent = msg;
      errorBanner.style.display = 'flex';
    }

    function hideError() {
      errorBanner.style.display = 'none';
    }

    function formatBytes(bytes: number): string {
      if (bytes === 0) return '0 B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    }

    function updateVisualFrames() {
      if (!presentationInfo) return;

      // 1. Update Original Frame Aspect Ratio
      const origAspect = presentationInfo.originalWidthEmus / presentationInfo.originalHeightEmus;
      originalRatioLabel.textContent = presentationInfo.aspectRatioName;
      originalDimsLabel.textContent = `${presentationInfo.originalWidthInches} × ${presentationInfo.originalHeightInches} in`;
      originalSlideFrame.style.aspectRatio = `${origAspect}`;

      // 2. Update Target Frame Aspect Ratio
      const targetAspect = resizeOptions.targetWidthEmus / resizeOptions.targetHeightEmus;
      let targetRatioName = STR_CUSTOM;
      if (Math.abs(targetAspect - 16 / 9) < 0.05) targetRatioName = '16:9';
      else if (Math.abs(targetAspect - 4 / 3) < 0.05) targetRatioName = '4:3';
      else if (Math.abs(targetAspect - 16 / 10) < 0.05) targetRatioName = '16:10';
      else if (Math.abs(targetAspect - 1.414) < 0.05) targetRatioName = 'A4 Landscape';
      else if (Math.abs(targetAspect - 1 / 1.414) < 0.05) targetRatioName = 'A4 Portrait';
      else if (Math.abs(targetAspect - 1.294) < 0.05) targetRatioName = 'Letter Landscape';
      else if (Math.abs(targetAspect - 1 / 1.294) < 0.05) targetRatioName = 'Letter Portrait';
      else if (Math.abs(targetAspect - 1.0) < 0.05) targetRatioName = '1:1 Square';

      targetRatioLabel.textContent = targetRatioName;
      targetSlideFrame.style.aspectRatio = `${targetAspect}`;

      // Convert target to current display unit
      let wVal = 0;
      let hVal = 0;
      if (currentUnit === 'in') {
        wVal = parseFloat((resizeOptions.targetWidthEmus / PptResizerEngine.EMUS_PER_INCH).toFixed(2));
        hVal = parseFloat((resizeOptions.targetHeightEmus / PptResizerEngine.EMUS_PER_INCH).toFixed(2));
        targetDimsLabel.textContent = `${wVal} × ${hVal} in`;
      } else if (currentUnit === 'cm') {
        wVal = parseFloat((resizeOptions.targetWidthEmus / PptResizerEngine.EMUS_PER_CM).toFixed(2));
        hVal = parseFloat((resizeOptions.targetHeightEmus / PptResizerEngine.EMUS_PER_CM).toFixed(2));
        targetDimsLabel.textContent = `${wVal} × ${hVal} cm`;
      } else if (currentUnit === 'mm') {
        wVal = parseFloat((resizeOptions.targetWidthEmus / PptResizerEngine.EMUS_PER_MM).toFixed(1));
        hVal = parseFloat((resizeOptions.targetHeightEmus / PptResizerEngine.EMUS_PER_MM).toFixed(1));
        targetDimsLabel.textContent = `${wVal} × ${hVal} mm`;
      } else if (currentUnit === 'pt') {
        wVal = Math.round(resizeOptions.targetWidthEmus / PptResizerEngine.EMUS_PER_PT);
        hVal = Math.round(resizeOptions.targetHeightEmus / PptResizerEngine.EMUS_PER_PT);
        targetDimsLabel.textContent = `${wVal} × ${hVal} pt`;
      } else {
        wVal = Math.round(resizeOptions.targetWidthEmus / PptResizerEngine.EMUS_PER_PX);
        hVal = Math.round(resizeOptions.targetHeightEmus / PptResizerEngine.EMUS_PER_PX);
        targetDimsLabel.textContent = `${wVal} × ${hVal} px`;
      }

      widthInput.value = wVal.toString();
      heightInput.value = hVal.toString();
    }

    function applyPreset(presetId: string) {
      resizeOptions.presetId = presetId;
      const found = SLIDE_PRESETS.find((p) => p.id === presetId);
      if (!found) return;

      let cx = found.widthEmus;
      let cy = found.heightEmus;

      // Handle orientation swapping
      if (selectedOrientation === 'portrait' && cx > cy) {
        const tmp = cx;
        cx = cy;
        cy = tmp;
      } else if (selectedOrientation === 'landscape' && cy > cx) {
        const tmp = cx;
        cx = cy;
        cy = tmp;
      }

      resizeOptions.targetWidthEmus = cx;
      resizeOptions.targetHeightEmus = cy;
      resizeOptions.typeAttr = found.typeAttr;

      updateVisualFrames();
    }

    async function handleFileSelected(file: File) {
      try {
        hideError();
        const { info, zipEntries } = await PptResizerEngine.inspectPptx(file);
        presentationInfo = info;
        currentZipEntries = zipEntries;

        fileNameDisplay.textContent = info.fileName;
        statSlidesCount.textContent =
          info.totalSlides === 1 ? STR_SLIDES_SINGLE : STR_SLIDES_PLURAL.replace('{n}', info.totalSlides.toString());
        statOriginalSize.textContent = `${info.aspectRatioName} (${info.originalWidthInches} × ${info.originalHeightInches} in)`;
        statFileSize.textContent = `Size: ${formatBytes(info.fileSizeBytes)}`;

        // Smart preset recommendation
        if (Math.abs(info.aspectRatioDecimal - 4 / 3) < 0.05) {
          presetSelect.value = '16-9';
          applyPreset('16-9');
        } else {
          presetSelect.value = '16-9';
          applyPreset('16-9');
        }

        dropzoneContainer.style.display = 'none';
        workspace.style.display = 'block';
      } catch (err: any) {
        showError(err.message || STR_ERROR_INSPECT);
      }
    }

    // Preset Select Change
    presetSelect.addEventListener('change', () => {
      applyPreset(presetSelect.value);
    });

    // Orientation Buttons
    orientLandscapeBtn.addEventListener('click', () => {
      orientLandscapeBtn.classList.add('active');
      orientPortraitBtn.classList.remove('active');
      selectedOrientation = 'landscape';
      resizeOptions.orientation = 'landscape';
      applyPreset(presetSelect.value);
    });

    orientPortraitBtn.addEventListener('click', () => {
      orientPortraitBtn.classList.add('active');
      orientLandscapeBtn.classList.remove('active');
      selectedOrientation = 'portrait';
      resizeOptions.orientation = 'portrait';
      applyPreset(presetSelect.value);
    });

    // Unit Select Change
    unitSelect.addEventListener('change', () => {
      currentUnit = unitSelect.value as any;
      updateVisualFrames();
    });

    // Custom Width / Height Inputs
    function onCustomDimensionInput() {
      presetSelect.value = 'custom';
      resizeOptions.presetId = 'custom';
      resizeOptions.typeAttr = 'custom';

      const w = parseFloat(widthInput.value) || 1;
      const h = parseFloat(heightInput.value) || 1;

      if (currentUnit === 'in') {
        resizeOptions.targetWidthEmus = Math.round(w * PptResizerEngine.EMUS_PER_INCH);
        resizeOptions.targetHeightEmus = Math.round(h * PptResizerEngine.EMUS_PER_INCH);
      } else if (currentUnit === 'cm') {
        resizeOptions.targetWidthEmus = Math.round(w * PptResizerEngine.EMUS_PER_CM);
        resizeOptions.targetHeightEmus = Math.round(h * PptResizerEngine.EMUS_PER_CM);
      } else if (currentUnit === 'mm') {
        resizeOptions.targetWidthEmus = Math.round(w * PptResizerEngine.EMUS_PER_MM);
        resizeOptions.targetHeightEmus = Math.round(h * PptResizerEngine.EMUS_PER_MM);
      } else if (currentUnit === 'pt') {
        resizeOptions.targetWidthEmus = Math.round(w * PptResizerEngine.EMUS_PER_PT);
        resizeOptions.targetHeightEmus = Math.round(h * PptResizerEngine.EMUS_PER_PT);
      } else {
        resizeOptions.targetWidthEmus = Math.round(w * PptResizerEngine.EMUS_PER_PX);
        resizeOptions.targetHeightEmus = Math.round(h * PptResizerEngine.EMUS_PER_PX);
      }

      const aspect = resizeOptions.targetWidthEmus / resizeOptions.targetHeightEmus;
      targetRatioLabel.textContent = aspect >= 1 ? `${aspect.toFixed(2)}:1` : `1:${(1 / aspect).toFixed(2)}`;
      targetSlideFrame.style.aspectRatio = `${aspect}`;
      targetDimsLabel.textContent = `${w} × ${h} ${currentUnit}`;
    }

    widthInput.addEventListener('input', onCustomDimensionInput);
    heightInput.addEventListener('input', onCustomDimensionInput);

    scaleContentToggle.addEventListener('change', () => {
      resizeOptions.scaleContent = scaleContentToggle.checked;
    });

    // Download Handler
    downloadBtn.addEventListener('click', async () => {
      if (!presentationInfo || currentZipEntries.length === 0) return;

      try {
        downloadBtn.setAttribute('disabled', 'true');
        downloadBtnText.textContent = STR_PROCESSING;
        progressBar.style.display = 'block';
        progressFill.style.width = '10%';

        const blob = await PptResizerEngine.resizePptx(
          currentZipEntries,
          resizeOptions,
          presentationInfo.originalWidthEmus,
          presentationInfo.originalHeightEmus,
          (pct) => {
            progressFill.style.width = `${pct}%`;
          }
        );

        const baseName = presentationInfo.fileName.replace(/\.[^/.]+$/, '');
        const outName = `${baseName}-resized.pptx`;

        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = outName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);

        downloadBtnText.textContent = STR_COMPLETE;
        setTimeout(() => {
          downloadBtn.removeAttribute('disabled');
          downloadBtnText.textContent = STR_DOWNLOAD;
          progressBar.style.display = 'none';
        }, 2200);
      } catch (err: any) {
        showError(STR_ERROR_RESIZE + (err.message || ''));
        downloadBtn.removeAttribute('disabled');
        downloadBtnText.textContent = STR_DOWNLOAD;
        progressBar.style.display = 'none';
      }
    });

    // Reset / Change Handlers
    function resetTool() {
      fileInput.value = '';
      currentZipEntries = [];
      presentationInfo = null;
      hideError();
      workspace.style.display = 'none';
      dropzoneContainer.style.display = 'block';
    }

    browseBtn.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('click', (e) => {
      if (e.target === sampleBtn || sampleBtn.contains(e.target as Node)) return;
      fileInput.click();
    });

    sampleBtn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const sample = await PptResizerEngine.generateSamplePptx();
      handleFileSelected(sample);
    });

    changeFileBtn.addEventListener('click', () => {
      fileInput.value = '';
      fileInput.click();
    });

    resetBtn.addEventListener('click', resetTool);

    fileInput.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) handleFileSelected(file);
    });

    // Drag & Drop
    ['dragenter', 'dragover'].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropzone.classList.add('drag-over');
      });
    });

    ['dragleave', 'drop'].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropzone.classList.remove('drag-over');
      });
    });

    dropzone.addEventListener('drop', (e) => {
      const file = e.dataTransfer?.files[0];
      if (file) handleFileSelected(file);
    });
  });
</script>


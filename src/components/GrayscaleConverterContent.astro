---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": t(locale, 'grayconv.faq.q1'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'grayconv.faq.a1')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'grayconv.faq.q2'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'grayconv.faq.a2')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'grayconv.faq.q3'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'grayconv.faq.a3')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'grayconv.faq.q4'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'grayconv.faq.a4')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'grayconv.faq.q5'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'grayconv.faq.a5')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'grayconv.faq.q6'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'grayconv.faq.a6')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'grayconv.faq.q7'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'grayconv.faq.a7')
      }
    }
  ]
};
---

<section class="section content-section">
  <div class="container">
    <div class="content-body">
      <!-- Section 1 -->
      <h2>{t(locale, 'grayconv.content.h1')}</h2>
      <p>{t(locale, 'grayconv.content.p1a')}</p>
      <p>{t(locale, 'grayconv.content.p1b')}</p>

      <div class="feature-cards-grid">
        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 2a10 10 0 0 1 0 20z" fill="currentColor"></path>
            </svg>
          </div>
          <h3>{t(locale, 'grayconv.content.feat1Title')}</h3>
          <p>{t(locale, 'grayconv.content.feat1Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="3" x2="12" y2="21"></line>
              <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            </svg>
          </div>
          <h3>{t(locale, 'grayconv.content.feat2Title')}</h3>
          <p>{t(locale, 'grayconv.content.feat2Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </div>
          <h3>{t(locale, 'grayconv.content.feat3Title')}</h3>
          <p>{t(locale, 'grayconv.content.feat3Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3>{t(locale, 'grayconv.content.feat4Title')}</h3>
          <p>{t(locale, 'grayconv.content.feat4Desc')}</p>
        </div>
      </div>

      <!-- Section 2 -->
      <h2>{t(locale, 'grayconv.content.h2')}</h2>
      <p>{t(locale, 'grayconv.content.p2a')}</p>
      <p>{t(locale, 'grayconv.content.p2b')}</p>

      <!-- Section 3 -->
      <h2>{t(locale, 'grayconv.content.h3')}</h2>
      <p>{t(locale, 'grayconv.content.p3a')}</p>
      <p>{t(locale, 'grayconv.content.p3b')}</p>

      <!-- Section 4: Table -->
      <h2>{t(locale, 'grayconv.content.h4')}</h2>
      <p>{t(locale, 'grayconv.content.p4a')}</p>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Conversion Mode</th>
              <th>Mathematical Weighting</th>
              <th>Contrast Profile</th>
              <th>Ideal Application</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>ITU-R BT.709 Luminance</strong></td>
              <td>0.2126 R + 0.7152 G + 0.0722 B</td>
              <td>Balanced, photometrically natural</td>
              <td>Portraits, landscapes, general web media</td>
            </tr>
            <tr>
              <td><strong>High-Contrast Dramatic</strong></td>
              <td>Luminance + S-Curve contrast boost</td>
              <td>Deep shadows &amp; crisp highlights</td>
              <td>Architecture, street &amp; moody photography</td>
            </tr>
            <tr>
              <td><strong>Vintage Sepia</strong></td>
              <td>Warm brown &amp; amber tone matrix</td>
              <td>Warm nostalgic monochrome</td>
              <td>Retro photos, memory albums, vintage art</td>
            </tr>
            <tr>
              <td><strong>Cool Silver / Platinum</strong></td>
              <td>Luminance + cyan/blue highlight tint</td>
              <td>Modern metallic monochrome</td>
              <td>Fashion, tech branding, modern portraits</td>
            </tr>
            <tr>
              <td><strong>Simple Arithmetic Average</strong></td>
              <td>(R + G + B) / 3</td>
              <td>Flat, mathematically uniform</td>
              <td>Scientific image analysis, raw sensors</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 5 -->
      <h2>{t(locale, 'grayconv.content.h5')}</h2>
      <p>{t(locale, 'grayconv.content.p5a')}</p>
      <p>{t(locale, 'grayconv.content.p5b')}</p>

      <!-- Section 6 -->
      <h2>{t(locale, 'grayconv.content.h6')}</h2>
      <p>{t(locale, 'grayconv.content.p6a')}</p>
      <p>{t(locale, 'grayconv.content.p6b')}</p>

      <!-- Section 7: Native OS Guides -->
      <h2>{t(locale, 'grayconv.content.h7')}</h2>
      <p>{t(locale, 'grayconv.content.p7Intro')}</p>
      <ul>
        <li><strong>iPhone / iPad (iOS Photos):</strong> Open the image in the Photos app &rarr; tap <em>Edit</em> &rarr; tap the <em>Filters</em> icon &rarr; select <strong>Mono</strong>, <strong>Silvertone</strong>, or <strong>Noir</strong>. Alternatively, tap the <em>Adjust</em> dial and slide <strong>Saturation</strong> to <code>-100</code>.</li>
        <li><strong>Android (Google Photos / Gallery):</strong> Open the image &rarr; tap <em>Edit</em> &rarr; navigate to <em>Adjust</em> &rarr; lower <strong>Saturation</strong> completely to <code>-100</code>, or choose the <em>Vista</em> / <em>Onyx</em> black and white filter under the <em>Filters</em> tab.</li>
        <li><strong>Mac (macOS Preview / Photos):</strong> Open the image in Preview &rarr; click <strong>Tools &rarr; Adjust Color</strong> &rarr; drag the <strong>Saturation</strong> slider all the way to the left to produce an instant grayscale image.</li>
        <li><strong>Windows (Photos app):</strong> Open the image in the Windows Photos app &rarr; press <code>Ctrl + E</code> to open the editor &rarr; select <strong>Adjustments &rarr; Color &rarr; Saturation</strong> &rarr; drag to <code>0</code>, or select the <em>Slate</em> or <em>Steel</em> monochrome preset.</li>
      </ul>

      <!-- Section 8: FAQ -->
      <div class="faq-container">
        <h2>{t(locale, 'grayconv.faq.heading')}</h2>
        
        <div class="faq-accordion">
          <details class="faq-item" open>
            <summary class="faq-question"><h3>{t(locale, 'grayconv.faq.q1')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'grayconv.faq.a1')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'grayconv.faq.q2')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'grayconv.faq.a2')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'grayconv.faq.q3')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'grayconv.faq.a3')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'grayconv.faq.q4')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'grayconv.faq.a4')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'grayconv.faq.q5')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'grayconv.faq.a5')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'grayconv.faq.q6')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'grayconv.faq.a6')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'grayconv.faq.q7')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'grayconv.faq.a7')}</p></div>
          </details>
        </div>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .content-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-12) 0;
  }

  .content-body {
    max-width: var(--container-narrow);
    margin-inline: auto;
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.75;
  }

  .content-body h2 {
    color: var(--color-text);
    font-size: var(--text-2xl);
    font-weight: 800;
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .content-body h2:first-child {
    margin-top: 0;
  }

  .content-body p {
    margin-bottom: var(--space-4);
  }

  .content-body ul {
    margin-bottom: var(--space-6);
    padding-left: var(--space-5);
  }

  .content-body li {
    margin-bottom: var(--space-2-5);
  }

  .content-body strong {
    color: var(--color-text);
  }

  .feature-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin: var(--space-6) 0 var(--space-8) 0;
  }

  @media (min-width: 640px) {
    .feature-cards-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .feature-card {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .feature-card-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-card h3 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .feature-card p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .table-responsive {
    overflow-x: auto;
    margin: var(--space-6) 0 var(--space-8) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .data-table th,
  .data-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  .data-table th {
    background: var(--color-surface-subtle);
    font-weight: 700;
    color: var(--color-text);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  /* FAQ */
  .faq-container {
    margin-top: var(--space-12);
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
    overflow: hidden;
  }

  .faq-question {
    padding: var(--space-4);
    cursor: pointer;
    font-weight: 600;
    user-select: none;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question h3 {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: 700;
  }

  .faq-answer {
    padding: 0 var(--space-4) var(--space-4) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .faq-answer p {
    margin: 0;
  }
</style>

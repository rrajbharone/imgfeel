---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div id="yt-resizer-container" class="yt-resizer-card">
  <!-- Hidden File Input -->
  <input type="file" id="yt-file-input" accept="image/jpeg,image/png,image/webp" class="sr-only" />

  <!-- Upload Dropzone -->
  <div id="yt-dropzone" class="yt-dropzone">
    <div class="dropzone-icon">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
        <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
      </svg>
    </div>
    <h3 class="dropzone-title">{t(locale, 'ytresizer.dropzone.title')}</h3>
    <p class="dropzone-subtitle">{t(locale, 'ytresizer.dropzone.subtitle')}</p>
  </div>

  <!-- Main Editor Area (Hidden until image is uploaded) -->
  <div id="yt-editor-area" class="yt-editor-area" hidden>
    <!-- Safe Area Guidance Callout Tip -->
    <div class="yt-tip-box">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
      <span>{t(locale, 'ytresizer.safeAreaTip')}</span>
    </div>

    <!-- Device View Mode Tabs -->
    <div class="view-mode-bar">
      <button type="button" class="yt-view-btn active" data-view="all">{t(locale, 'ytresizer.view.all')}</button>
      <button type="button" class="yt-view-btn" data-view="desktop">{t(locale, 'ytresizer.view.desktop')}</button>
      <button type="button" class="yt-view-btn" data-view="mobile">{t(locale, 'ytresizer.view.mobile')}</button>
      <button type="button" class="yt-view-btn" data-view="tv">{t(locale, 'ytresizer.view.tv')}</button>
    </div>

    <!-- 16:9 Interactive Canvas Wrapper with YouTube Safe Area Overlay -->
    <div class="canvas-stage">
      <div class="canvas-wrapper">
        <canvas id="yt-main-canvas" width="2560" height="1440" class="yt-canvas"></canvas>
        
        <!-- Safe Area Overlay Guide -->
        <div id="yt-safe-overlay" class="safe-overlay mode-all" aria-hidden="true">
          <!-- Desktop Horizontal Band -->
          <div class="overlay-desktop-band">
            <!-- Central Mobile Safe Area Box -->
            <div class="overlay-mobile-box">
              <span class="safe-box-tag">Safe Area (1235 × 338 px)</span>
            </div>
          </div>
        </div>

        <span class="drag-badge">Drag image to position banner</span>
      </div>
    </div>

    <!-- Controls Column -->
    <div class="controls-grid">
      <!-- Background Mode -->
      <div class="control-group">
        <label class="control-label">{t(locale, 'ytresizer.bg.label')}</label>
        <div class="bg-tabs">
          <button type="button" class="yt-bg-btn active" data-bg="blur">{t(locale, 'ytresizer.bg.blur')}</button>
          <button type="button" class="yt-bg-btn" data-bg="solid">{t(locale, 'ytresizer.bg.solid')}</button>
        </div>

        <div id="yt-color-group" class="color-picker-row" hidden>
          <button type="button" class="yt-color-pill" data-color="#1f2937" style="background:#1f2937" title="Dark Slate"></button>
          <button type="button" class="yt-color-pill" data-color="#ffffff" style="background:#ffffff" title="White"></button>
          <button type="button" class="yt-color-pill" data-color="#000000" style="background:#000000" title="Black"></button>
          <button type="button" class="yt-color-pill" data-color="#FF0000" style="background:#FF0000" title="YouTube Red"></button>
          <input type="color" id="yt-custom-color" value="#1f2937" class="yt-color-picker" title="Custom color" />
        </div>
      </div>

      <!-- Zoom / Scale Slider -->
      <div class="control-group">
        <label for="yt-zoom-input" class="control-label">{t(locale, 'ytresizer.label.zoom')}</label>
        <input type="range" id="yt-zoom-input" min="0.8" max="3.0" step="0.05" value="1.0" class="yt-range" />
      </div>

      <!-- Output Format -->
      <div class="control-group">
        <label for="yt-format-select" class="control-label">{t(locale, 'ytresizer.label.format')}</label>
        <select id="yt-format-select" class="yt-select">
          <option value="image/jpeg">JPG (Recommended)</option>
          <option value="image/png">PNG</option>
          <option value="image/webp">WebP</option>
        </select>
      </div>

      <!-- Action Buttons -->
      <div class="actions-row">
        <button type="button" id="yt-download-btn" class="btn btn-primary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>{t(locale, 'ytresizer.action.download')}</span>
        </button>
        <button type="button" id="yt-change-img-btn" class="btn btn-secondary">
          {t(locale, 'ytresizer.action.newImage')}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import '@/scripts/youtube-resizer';
</script>

<style>
  .yt-resizer-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-md);
    max-width: var(--container-narrow);
    margin-inline: auto;
  }

  .yt-dropzone {
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-12) var(--space-6);
    text-align: center;
    cursor: pointer;
    background: var(--color-surface);
    transition: all .15s;
  }
  .yt-dropzone:hover,
  .yt-dropzone.drag-over {
    border-color: var(--color-accent);
    background: var(--color-accent-light);
  }
  .dropzone-icon {
    color: #FF0000;
    margin-bottom: var(--space-3);
    display: flex;
    justify-content: center;
  }
  .dropzone-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }
  .dropzone-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .yt-tip-box {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-accent-light);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    color: var(--color-text);
    margin-bottom: var(--space-5);
  }
  .yt-tip-box svg {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .view-mode-bar {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  @media (min-width: 600px) {
    .view-mode-bar {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .yt-view-btn {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    transition: all .15s;
  }
  .yt-view-btn.active {
    background: var(--color-accent-light);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .canvas-stage {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-6);
  }

  .canvas-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 2px solid var(--color-border);
    box-shadow: var(--shadow-md);
    background: #000;
    touch-action: none;
    cursor: grab;
  }
  .canvas-wrapper:active {
    cursor: grabbing;
  }

  .yt-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* YouTube Safe Area Overlay */
  .safe-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all .2s;
  }

  .overlay-desktop-band {
    position: absolute;
    width: 100%;
    height: 23.47%; /* 338px / 1440px */
    border-top: 1.5px dashed rgba(59, 130, 246, 0.8);
    border-bottom: 1.5px dashed rgba(59, 130, 246, 0.8);
    background: rgba(59, 130, 246, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .overlay-mobile-box {
    position: absolute;
    width: 48.24%; /* 1235px / 2560px */
    height: 100%;
    border: 2px solid #eab308;
    background: rgba(234, 179, 8, 0.15);
    box-shadow: 0 0 10px rgba(234, 179, 8, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .safe-box-tag {
    font-size: 10px;
    font-weight: 700;
    color: #eab308;
    background: rgba(0, 0, 0, 0.85);
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  /* View Mode Filtering for Overlay */
  .safe-overlay.mode-mobile .overlay-desktop-band {
    background: rgba(0, 0, 0, 0.7);
  }
  .safe-overlay.mode-mobile .overlay-mobile-box {
    background: transparent;
    border: 2px solid #eab308;
  }

  .safe-overlay.mode-desktop .overlay-desktop-band {
    background: transparent;
    border: 2px dashed #3b82f6;
  }
  .safe-overlay.mode-desktop .overlay-mobile-box {
    border-color: rgba(234, 179, 8, 0.4);
    background: transparent;
  }

  .safe-overlay.mode-tv {
    background: transparent;
  }
  .safe-overlay.mode-tv .overlay-desktop-band {
    border: none;
    background: transparent;
  }
  .safe-overlay.mode-tv .overlay-mobile-box {
    border: none;
    background: transparent;
  }
  .safe-overlay.mode-tv .safe-box-tag {
    display: none;
  }

  .drag-badge {
    position: absolute;
    bottom: var(--space-2);
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.75);
    color: #fff;
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 12px;
    pointer-events: none;
  }

  .controls-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 600px) {
    .controls-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .control-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text);
  }

  .bg-tabs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
  }

  .yt-bg-btn {
    padding: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-secondary);
  }
  .yt-bg-btn.active {
    background: var(--color-accent-light);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .color-picker-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .yt-color-pill {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    cursor: pointer;
  }

  .yt-color-picker {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    cursor: pointer;
    padding: 0;
    background: none;
  }

  .yt-range {
    width: 100%;
    accent-color: var(--color-accent);
  }

  .yt-select {
    width: 100%;
    padding: var(--space-2);
    font-size: var(--text-xs);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  .actions-row {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  @media (min-width: 500px) {
    .actions-row {
      flex-direction: row;
    }
  }
</style>

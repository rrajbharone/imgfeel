---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';
import { getToolUrl } from '@/data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const cropperUrl = getToolUrl('freeform-image-cropper', locale);
const circleUrl = getToolUrl('circle-image-cropper', locale);
const stitcherUrl = getToolUrl('image-stitcher', locale);
const resizerUrl = getToolUrl('image-resizer', locale);
const mosaicUrl = getToolUrl('image-mosaic-generator', locale);
const webpUrl = getToolUrl('webp-compressor', locale);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": t(locale, 'splitter.faq.q1'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'splitter.faq.a1')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'splitter.faq.q2'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'splitter.faq.a2')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'splitter.faq.q3'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'splitter.faq.a3')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'splitter.faq.q4'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'splitter.faq.a4')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'splitter.faq.q5'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'splitter.faq.a5')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'splitter.faq.q6'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'splitter.faq.a6')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'splitter.faq.q7'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'splitter.faq.a7')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'splitter.faq.q8'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'splitter.faq.a8')
      }
    }
  ]
};
---

<section class="section content-section">
  <div class="container">
    <div class="content-body">
      <!-- Section 1: Overview & What is Image Splitter -->
      <h2>{t(locale, 'splitter.content.h1')}</h2>
      <p>{t(locale, 'splitter.content.p1a')}</p>
      <p>{t(locale, 'splitter.content.p1b')}</p>

      <!-- 4 Core Feature Cards -->
      <div class="feature-cards-grid">
        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
          </div>
          <h3>{t(locale, 'splitter.content.feat1Title')}</h3>
          <p>{t(locale, 'splitter.content.feat1Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
          </div>
          <h3>{t(locale, 'splitter.content.feat2Title')}</h3>
          <p>{t(locale, 'splitter.content.feat2Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
          </div>
          <h3>{t(locale, 'splitter.content.feat3Title')}</h3>
          <p>{t(locale, 'splitter.content.feat3Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3>{t(locale, 'splitter.content.feat4Title')}</h3>
          <p>{t(locale, 'splitter.content.feat4Desc')}</p>
        </div>
      </div>

      <!-- Section 2: How It Works & Split Methods -->
      <h2>{t(locale, 'splitter.content.h2')}</h2>
      <p>{t(locale, 'splitter.content.p2a')}</p>
      <p>{t(locale, 'splitter.content.p2b')}</p>

      <!-- Section 3: Social Media Use Cases -->
      <h2>{t(locale, 'splitter.content.h3')}</h2>
      <p>{t(locale, 'splitter.content.p3a')}</p>
      <p>{t(locale, 'splitter.content.p3b')}</p>

      <!-- Section 4: Master Reference Table -->
      <h2>{t(locale, 'splitter.content.h4')}</h2>
      <p>{t(locale, 'splitter.content.p4a')}</p>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>{t(locale, 'splitter.table.thPlatform')}</th>
              <th>{t(locale, 'splitter.table.thUseCase')}</th>
              <th>{t(locale, 'splitter.table.thConfig')}</th>
              <th>{t(locale, 'splitter.table.thSource')}</th>
              <th>{t(locale, 'splitter.table.thPiece')}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>{t(locale, 'splitter.table.r1Target')}</strong></td>
              <td>{t(locale, 'splitter.table.r1UseCase')}</td>
              <td>{t(locale, 'splitter.table.r1Config')}</td>
              <td>{t(locale, 'splitter.table.r1Source')}</td>
              <td>{t(locale, 'splitter.table.r1Piece')}</td>
            </tr>
            <tr>
              <td><strong>{t(locale, 'splitter.table.r2Target')}</strong></td>
              <td>{t(locale, 'splitter.table.r2UseCase')}</td>
              <td>{t(locale, 'splitter.table.r2Config')}</td>
              <td>{t(locale, 'splitter.table.r2Source')}</td>
              <td>{t(locale, 'splitter.table.r2Piece')}</td>
            </tr>
            <tr>
              <td><strong>{t(locale, 'splitter.table.r3Target')}</strong></td>
              <td>{t(locale, 'splitter.table.r3UseCase')}</td>
              <td>{t(locale, 'splitter.table.r3Config')}</td>
              <td>{t(locale, 'splitter.table.r3Source')}</td>
              <td>{t(locale, 'splitter.table.r3Piece')}</td>
            </tr>
            <tr>
              <td><strong>{t(locale, 'splitter.table.r4Target')}</strong></td>
              <td>{t(locale, 'splitter.table.r4UseCase')}</td>
              <td>{t(locale, 'splitter.table.r4Config')}</td>
              <td>{t(locale, 'splitter.table.r4Source')}</td>
              <td>{t(locale, 'splitter.table.r4Piece')}</td>
            </tr>
            <tr>
              <td><strong>{t(locale, 'splitter.table.r5Target')}</strong></td>
              <td>{t(locale, 'splitter.table.r5UseCase')}</td>
              <td>{t(locale, 'splitter.table.r5Config')}</td>
              <td>{t(locale, 'splitter.table.r5Source')}</td>
              <td>{t(locale, 'splitter.table.r5Piece')}</td>
            </tr>
            <tr>
              <td><strong>{t(locale, 'splitter.table.r6Target')}</strong></td>
              <td>{t(locale, 'splitter.table.r6UseCase')}</td>
              <td>{t(locale, 'splitter.table.r6Config')}</td>
              <td>{t(locale, 'splitter.table.r6Source')}</td>
              <td>{t(locale, 'splitter.table.r6Piece')}</td>
            </tr>
            <tr>
              <td><strong>{t(locale, 'splitter.table.r7Target')}</strong></td>
              <td>{t(locale, 'splitter.table.r7UseCase')}</td>
              <td>{t(locale, 'splitter.table.r7Config')}</td>
              <td>{t(locale, 'splitter.table.r7Source')}</td>
              <td>{t(locale, 'splitter.table.r7Piece')}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 5: Format Selection -->
      <h2>{t(locale, 'splitter.content.h5')}</h2>
      <p>{t(locale, 'splitter.content.p5a')}</p>
      <p>{t(locale, 'splitter.content.p5b')}</p>

      <!-- Section 6: Pro Tips -->
      <h2>{t(locale, 'splitter.content.h6')}</h2>
      <p>{t(locale, 'splitter.content.p6a')}</p>
      <p>{t(locale, 'splitter.content.p6b')}</p>

      <!-- Section 7: Step-by-Step Instructions -->
      <h2>{t(locale, 'splitter.content.h7')}</h2>
      <p>{t(locale, 'splitter.content.p7Intro')}</p>

      <ol class="steps-ordered-list">
        <li>
          <strong>{t(locale, 'splitter.steps.step1Title')}</strong> — {t(locale, 'splitter.steps.step1Desc')} <kbd>Ctrl+V</kbd> / <kbd>Cmd+V</kbd>.
        </li>
        <li>
          <strong>{t(locale, 'splitter.steps.step2Title')}</strong> — {t(locale, 'splitter.steps.step2Desc')}
        </li>
        <li>
          <strong>{t(locale, 'splitter.steps.step3Title')}</strong> — {t(locale, 'splitter.steps.step3Desc')}
        </li>
        <li>
          <strong>{t(locale, 'splitter.steps.step4Title')}</strong> — {t(locale, 'splitter.steps.step4Desc')}
        </li>
        <li>
          <strong>{t(locale, 'splitter.steps.step5Title')}</strong> — {t(locale, 'splitter.steps.step5Desc')}
        </li>
        <li>
          <strong>{t(locale, 'splitter.steps.step6Title')}</strong> — {t(locale, 'splitter.steps.step6Desc')}
        </li>
      </ol>

      <!-- Related Tools Cross Links -->
      <div class="cross-tools-container">
        <h3>{t(locale, 'splitter.cross.heading')}</h3>
        <div class="cross-tools-grid">
          <a href={cropperUrl} class="cross-tool-card">
            <span class="cross-tool-title">{t(locale, 'splitter.cross.cropper')}</span>
            <span class="cross-tool-desc">{t(locale, 'splitter.cross.cropperDesc')}</span>
          </a>
          <a href={circleUrl} class="cross-tool-card">
            <span class="cross-tool-title">{t(locale, 'splitter.cross.circle')}</span>
            <span class="cross-tool-desc">{t(locale, 'splitter.cross.circleDesc')}</span>
          </a>
          <a href={stitcherUrl} class="cross-tool-card">
            <span class="cross-tool-title">{t(locale, 'splitter.cross.stitcher')}</span>
            <span class="cross-tool-desc">{t(locale, 'splitter.cross.stitcherDesc')}</span>
          </a>
          <a href={mosaicUrl} class="cross-tool-card">
            <span class="cross-tool-title">{t(locale, 'splitter.cross.mosaic')}</span>
            <span class="cross-tool-desc">{t(locale, 'splitter.cross.mosaicDesc')}</span>
          </a>
          <a href={resizerUrl} class="cross-tool-card">
            <span class="cross-tool-title">{t(locale, 'splitter.cross.resizer')}</span>
            <span class="cross-tool-desc">{t(locale, 'splitter.cross.resizerDesc')}</span>
          </a>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="faq-container">
        <h2>{t(locale, 'splitter.faq.heading')}</h2>
        
        <div class="faq-accordion">
          <details class="faq-item" open>
            <summary class="faq-question"><h3>{t(locale, 'splitter.faq.q1')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'splitter.faq.a1')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'splitter.faq.q2')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'splitter.faq.a2')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'splitter.faq.q3')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'splitter.faq.a3')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'splitter.faq.q4')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'splitter.faq.a4')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'splitter.faq.q5')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'splitter.faq.a5')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'splitter.faq.q6')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'splitter.faq.a6')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'splitter.faq.q7')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'splitter.faq.a7')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'splitter.faq.q8')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'splitter.faq.a8')}</p></div>
          </details>
        </div>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .content-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-12) 0;
    width: 100%;
    box-sizing: border-box;
  }

  .content-body {
    max-width: var(--container-narrow);
    margin-inline: auto;
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.75;
    width: 100%;
    box-sizing: border-box;
    min-width: 0;
  }

  .content-body h2 {
    color: var(--color-text);
    font-size: var(--text-2xl);
    font-weight: 800;
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.3;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .content-body h2:first-child {
    margin-top: 0;
  }

  .content-body p {
    margin-bottom: var(--space-4);
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .content-body ul,
  .content-body ol {
    margin-bottom: var(--space-6);
    padding-left: var(--space-5);
  }

  .steps-ordered-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: var(--space-4) 0 var(--space-8) 0;
    padding-left: var(--space-5);
    width: 100%;
    box-sizing: border-box;
  }

  .steps-ordered-list li {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .steps-ordered-list strong {
    color: var(--color-text);
  }

  kbd {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 2px 5px;
    font-size: 11px;
    font-family: inherit;
    color: var(--color-text);
  }

  /* 4-Feature Cards Grid */
  .feature-cards-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin: var(--space-6) 0 var(--space-8) 0;
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 640px) {
    .feature-cards-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .feature-card {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    box-sizing: border-box;
    min-width: 0;
  }

  .feature-card-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-card h3 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
    word-break: break-word;
  }

  .feature-card p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
    word-break: break-word;
  }

  /* Reference Data Table */
  .table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: var(--space-6) 0 var(--space-8) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .data-table {
    width: 100%;
    min-width: 580px;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .data-table th,
  .data-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  .data-table th {
    background: var(--color-surface-subtle);
    font-weight: 700;
    color: var(--color-text);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  /* Cross Tools Links */
  .cross-tools-container {
    margin: var(--space-10) 0;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    width: 100%;
    box-sizing: border-box;
  }

  .cross-tools-container h3 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
    word-break: break-word;
  }

  .cross-tools-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 640px) {
    .cross-tools-grid {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
  }

  .cross-tool-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 3px;
    text-decoration: none;
    transition: all var(--transition-fast);
    min-width: 0;
    box-sizing: border-box;
  }

  .cross-tool-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .cross-tool-title {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent);
    word-break: break-word;
  }

  .cross-tool-desc {
    font-size: 11px;
    color: var(--color-text-secondary);
    line-height: 1.4;
    word-break: break-word;
  }

  /* FAQ Accordion */
  .faq-container {
    margin-top: var(--space-10);
    width: 100%;
    box-sizing: border-box;
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
    width: 100%;
    box-sizing: border-box;
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
    overflow: hidden;
    width: 100%;
    box-sizing: border-box;
  }

  .faq-question {
    padding: var(--space-4);
    cursor: pointer;
    font-weight: 600;
    user-select: none;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    word-break: break-word;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question h3 {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: 700;
    word-break: break-word;
  }

  .faq-answer {
    padding: 0 var(--space-4) var(--space-4) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    word-break: break-word;
  }

  .faq-answer p {
    margin: 0;
    word-break: break-word;
  }
</style>

---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": t(locale, 'stitch.faq.q1'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'stitch.faq.a1')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'stitch.faq.q2'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'stitch.faq.a2')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'stitch.faq.q3'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'stitch.faq.a3')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'stitch.faq.q4'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'stitch.faq.a4')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'stitch.faq.q5'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'stitch.faq.a5')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'stitch.faq.q6'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'stitch.faq.a6')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'stitch.faq.q7'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'stitch.faq.a7')
      }
    }
  ]
};
---

<section class="section content-section">
  <div class="container">
    <div class="content-body">
      <!-- Section 1 -->
      <h2>{t(locale, 'stitch.content.h1')}</h2>
      <p>{t(locale, 'stitch.content.p1a')}</p>
      <p>{t(locale, 'stitch.content.p1b')}</p>

      <div class="feature-cards-grid">
        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="5" width="9" height="14" rx="1"></rect>
              <rect x="13" y="5" width="9" height="14" rx="1"></rect>
            </svg>
          </div>
          <h3>{t(locale, 'stitch.content.feat1Title')}</h3>
          <p>{t(locale, 'stitch.content.feat1Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="5" y="2" width="14" height="9" rx="1"></rect>
              <rect x="5" y="13" width="14" height="9" rx="1"></rect>
            </svg>
          </div>
          <h3>{t(locale, 'stitch.content.feat2Title')}</h3>
          <p>{t(locale, 'stitch.content.feat2Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3>{t(locale, 'stitch.content.feat3Title')}</h3>
          <p>{t(locale, 'stitch.content.feat3Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <h3>{t(locale, 'stitch.content.feat4Title')}</h3>
          <p>{t(locale, 'stitch.content.feat4Desc')}</p>
        </div>
      </div>

      <!-- Section 2 -->
      <h2>{t(locale, 'stitch.content.h2')}</h2>
      <p>{t(locale, 'stitch.content.p2a')}</p>
      <p>{t(locale, 'stitch.content.p2b')}</p>

      <!-- Section 3 -->
      <h2>{t(locale, 'stitch.content.h3')}</h2>
      <p>{t(locale, 'stitch.content.p3a')}</p>
      <p>{t(locale, 'stitch.content.p3b')}</p>

      <!-- Section 4: Comparison Table -->
      <h2>{t(locale, 'stitch.content.h4')}</h2>
      <p>{t(locale, 'stitch.content.p4a')}</p>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Stitching Layout</th>
              <th>Dimension Scaling Strategy</th>
              <th>Visual Structure</th>
              <th>Best Practical Applications</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Horizontal (Side-by-Side)</strong></td>
              <td>Match Height or Original</td>
              <td>Continuous horizontal ribbon</td>
              <td>Before/after comparisons, panoramic landscape sets, website hero banners</td>
            </tr>
            <tr>
              <td><strong>Vertical (Stacked)</strong></td>
              <td>Match Width or Original</td>
              <td>Continuous vertical scroll strip</td>
              <td>Long chat screenshots, step-by-step recipe guides, infographics, comic strips</td>
            </tr>
            <tr>
              <td><strong>Grid (2 Columns)</strong></td>
              <td>Equal Column Width Matching</td>
              <td>2x2 balanced collage matrix</td>
              <td>Before/after makeover sets, e-commerce dual-angle product showcases</td>
            </tr>
            <tr>
              <td><strong>Grid (3 Columns)</strong></td>
              <td>Equal Column Width Matching</td>
              <td>3x3 editorial moodboard</td>
              <td>Photography portfolios, Instagram story collages, team rosters</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 5 -->
      <h2>{t(locale, 'stitch.content.h5')}</h2>
      <p>{t(locale, 'stitch.content.p5a')}</p>
      <p>{t(locale, 'stitch.content.p5b')}</p>

      <!-- Section 6 -->
      <h2>{t(locale, 'stitch.content.h6')}</h2>
      <p>{t(locale, 'stitch.content.p6a')}</p>
      <p>{t(locale, 'stitch.content.p6b')}</p>

      <!-- Section 7: Native OS Guides -->
      <h2>{t(locale, 'stitch.content.h7')}</h2>
      <p>{t(locale, 'stitch.content.p7Intro')}</p>
      <ul>
        <li><strong>iPhone / iPad (iOS):</strong> Open the <strong>Shortcuts</strong> app &rarr; create a new shortcut with the <strong>Combine Images</strong> action &rarr; set direction to <em>Horizontally</em> or <em>Vertically</em> and save the combined photo to Camera Roll.</li>
        <li><strong>Android:</strong> Open <strong>Google Photos</strong> &rarr; select multiple images &rarr; tap the <strong>+ (Add to)</strong> button &rarr; select <strong>Collage</strong> to combine pictures into a grid layout.</li>
        <li><strong>Mac (macOS):</strong> Open the <strong>Shortcuts</strong> app on macOS &rarr; add the <strong>Combine Images</strong> action, or open multiple images in <strong>Preview</strong> and copy/paste them onto an expanded canvas.</li>
        <li><strong>Windows 10 / 11:</strong> Open <strong>Paint</strong> or <strong>Paint 3D</strong> &rarr; expand the canvas area &rarr; paste each picture side-by-side or stacked vertically, then save as PNG or JPG.</li>
      </ul>

      <!-- Section 8: FAQ -->
      <div class="faq-container">
        <h2>{t(locale, 'stitch.faq.heading')}</h2>
        
        <div class="faq-accordion">
          <details class="faq-item" open>
            <summary class="faq-question"><h3>{t(locale, 'stitch.faq.q1')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'stitch.faq.a1')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'stitch.faq.q2')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'stitch.faq.a2')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'stitch.faq.q3')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'stitch.faq.a3')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'stitch.faq.q4')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'stitch.faq.a4')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'stitch.faq.q5')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'stitch.faq.a5')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'stitch.faq.q6')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'stitch.faq.a6')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'stitch.faq.q7')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'stitch.faq.a7')}</p></div>
          </details>
        </div>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .content-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-12) 0;
  }

  .content-body {
    max-width: var(--container-narrow);
    margin-inline: auto;
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.75;
  }

  .content-body h2 {
    color: var(--color-text);
    font-size: var(--text-2xl);
    font-weight: 800;
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .content-body h2:first-child {
    margin-top: 0;
  }

  .content-body p {
    margin-bottom: var(--space-4);
  }

  .content-body ul {
    margin-bottom: var(--space-6);
    padding-left: var(--space-5);
  }

  .content-body li {
    margin-bottom: var(--space-2-5);
  }

  .content-body strong {
    color: var(--color-text);
  }

  .feature-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin: var(--space-6) 0 var(--space-8) 0;
  }

  @media (min-width: 640px) {
    .feature-cards-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .feature-card {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .feature-card-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-card h3 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .feature-card p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .table-responsive {
    overflow-x: auto;
    margin: var(--space-6) 0 var(--space-8) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .data-table th,
  .data-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  .data-table th {
    background: var(--color-surface-subtle);
    font-weight: 700;
    color: var(--color-text);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  /* FAQ */
  .faq-container {
    margin-top: var(--space-12);
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
    overflow: hidden;
  }

  .faq-question {
    padding: var(--space-4);
    cursor: pointer;
    font-weight: 600;
    user-select: none;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question h3 {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: 700;
  }

  .faq-answer {
    padding: 0 var(--space-4) var(--space-4) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .faq-answer p {
    margin: 0;
  }
</style>

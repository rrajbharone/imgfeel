const faqItems = [
  {
    q: 'What are the official Railway RRB photo and signature dimensions for 2026 recruitments?',
    a: 'For Railway Recruitment Board (RRB) and Railway Recruitment Cell (RRC) examinations, standard passport photographs require dimensions of 35 mm × 45 mm (roughly 350 × 450 pixels or 320 × 400 pixels). Digital signatures must measure a minimum of 140 × 60 pixels (or preferred 240 × 80 pixels) centered within a 35 mm × 20 mm box.',
  },
  {
    q: 'What is the required file size limit for RRB photograph and signature uploads?',
    a: 'For most major recruitments on rrbapply.gov.in (including RRB ALP CEN 01/2024, Technician CEN 02/2024, JE CEN 03/2024, NTPC CEN 05/2024, and RPF Constable/SI), both photographs and signatures strictly require file sizes between 30 KB and 70 KB in JPG/JPEG format. For Railway Apprentice (RRC) portals, photos are typically 20 KB – 70 KB and signatures are 10 KB – 50 KB.',
  },
  {
    q: 'Does this tool replace the Live Photo capture requirement on rrbapply.gov.in?',
    a: 'No. Recent CEN recruitments on the unified rrbapply.gov.in portal mandate capturing a real-time Live Photograph through your smartphone or webcam during initial online registration. However, candidates must still prepare and carry identical 35 × 45 mm (30–70 KB) printed photos for affixing to the e-Call Letter / Admit Card counterfoil on examination day, and upload them during Document Verification (DV). For Railway Apprentice applications, direct photo upload is required.',
  },
  {
    q: 'Can I sign using capital letters for RRB NTPC, Group D, or ALP exams?',
    a: 'No. Railway Recruitment Boards strictly disqualify applications where signatures are written in CAPITAL or BLOCK letters or merely use initials. Your signature must be in your natural, continuous running handwriting using a black or dark blue ink ballpoint pen.',
  },
  {
    q: 'What ink color is permitted for Railway signatures?',
    a: 'Official Railway notifications permit dark black or dark blue ink pen. You must sign cleanly on an unruled, plain white sheet of paper. Pencils, sketch pens, or smudged gel pens are not accepted by RRB document verification examiners.',
  },
  {
    q: 'Why does the RRB portal reject signatures under 30 KB?',
    a: 'The rrbapply.gov.in upload module enforces a strict byte-level validator that checks both the minimum threshold (30.0 KB) and the maximum threshold (70.0 KB). Scanned black-and-white signatures often compress to 10–18 KB, triggering an automatic portal rejection. Our intelligent client-side resizer injects safe JPEG padding metadata to ensure your file stays perfectly within the 35–60 KB safe zone.',
  },
  {
    q: 'What background color is mandatory for RRB candidate photos?',
    a: 'Indian Railways strictly mandates a plain, light-colored or pure white background (#FFFFFF) with even lighting across the face. Photographs with dark backgrounds, patterned wallpapers, door frames, or outdoor scenery are rejected.',
  },
  {
    q: 'Are requirements different for Railway Apprentice compared to RRB NTPC or Group D?',
    a: 'Yes. Zonal Railway Recruitment Cells (RRC Eastern Railway, Western Railway, Northern Railway, etc.) for Act Apprentice training require direct file uploads (photographs between 20–70 KB and signatures between 10–50 KB) without a live webcam check. Selecting "Railway Apprentice" in our dropdown automatically applies these zonal parameters.',
  },
  {
    q: 'How many copies of the formatted photograph should I keep for RRB recruitment?',
    a: 'Official RRB notifications explicitly advise candidates to keep at least 12 identical copies of the passport photograph uploaded/formatted for their application. You will need the exact same photo for CBT Stage 1, CBT Stage 2, CBAT Aptitude test, Document Verification (DV), and Medical Fitness examinations.',
  },
  {
    q: 'Are my railway documents or signatures uploaded to your server?',
    a: 'Never. ImgFeel processes 100% of your images locally in your web browser using HTML5 Canvas APIs. Your confidential photographs, signatures, and personal credentials never leave your smartphone or computer, guaranteeing absolute privacy.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'RRB Photo & Signature Resizer',
  operatingSystem: 'Any',
  applicationCategory: 'MultimediaApplication',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

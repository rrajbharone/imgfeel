    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 var(--space-3);
  }

  .related-chips-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .related-chip {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 6px 12px;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .related-chip:hover {
    border-color: #4F46E5;
    color: #4F46E5;
  }
</style>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .content-section {
    padding: var(--space-8) 0 var(--space-16);
    background: var(--color-background);
    border-top: 1px solid var(--color-border);
  }

  .content-body {
    max-width: 900px;
    margin-inline: auto;
    color: var(--color-text);
    font-size: var(--text-base);
    line-height: 1.7;
  }

  .content-body h2 {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .content-body h2:first-of-type {
    margin-top: 0;
  }

  .content-body p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    line-height: 1.7;
  }

  /* Features Grid */
  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin: var(--space-6) 0 var(--space-8);
  }

  @media (min-width: 600px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .feature-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .feature-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: rgba(79, 70, 229, 0.08);
    color: #4F46E5;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2px;
  }

  .feature-card h3 {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .feature-card p {
    font-size: 12.5px;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  /* Steps Grid */
  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin: var(--space-6) 0 var(--space-8);
  }

  @media (min-width: 600px) {
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .step-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 16px 18px;
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .step-number {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #4F46E5;
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .step-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .step-content h3 {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .step-content p {
    font-size: 12.5px;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  /* Types Grid */
  .types-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin: var(--space-5) 0 var(--space-8);
  }

  @media (min-width: 600px) {
    .types-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .type-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .type-card h3 {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
    line-height: 1.35;
  }

  .type-card p {
    font-size: 12.5px;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  /* FAQ Accordion */
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: var(--space-5) 0 var(--space-10);
  }

  .faq-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 18px;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text);
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    color: var(--color-text-secondary);
    transition: transform 0.2s ease;
    flex-shrink: 0;
    margin-left: 10px;
  }

  details[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 18px 16px;
  }

  .faq-answer p {
    font-size: 13px;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  /* Related Tools Box */
  .related-tools-box {
    margin-top: var(--space-10);
    padding: 20px 22px;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .related-tools-box h3 {

---
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';
import { getToolUrl } from '@/data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Localized tool URLs for related tools 6-card grid
const canvaUrl = getToolUrl('canva-watermark-remover', locale);
const exactUrl = getToolUrl('exact-dimension-resizer', locale);
const webpUrl = getToolUrl('webp-compressor', locale);
const denoiseUrl = getToolUrl('image-noise-reducer', locale);
const pixelCounterUrl = getToolUrl('pixel-counter', locale);
const videoTrimUrl = getToolUrl('video-trimmer', locale);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": t(locale, 'geminiwatermark.content.faq1Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'geminiwatermark.content.faq1A')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'geminiwatermark.content.faq2Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'geminiwatermark.content.faq2A')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'geminiwatermark.content.faq3Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'geminiwatermark.content.faq3A')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'geminiwatermark.content.faq4Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'geminiwatermark.content.faq4A')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'geminiwatermark.content.faq5Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'geminiwatermark.content.faq5A')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'geminiwatermark.content.faq6Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'geminiwatermark.content.faq6A')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'geminiwatermark.content.faq7Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'geminiwatermark.content.faq7A')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'geminiwatermark.content.faq8Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'geminiwatermark.content.faq8A')
      }
    }
  ]
};
---

<section class="section content-section">
  <div class="container">
    <div class="content-body">
      <!-- Section 1: Introduction & High-Level Overview -->
      <div class="content-block">
        <h2>{t(locale, 'geminiwatermark.content.h1')}</h2>
        <p>{t(locale, 'geminiwatermark.content.p1a')}</p>
        <p>{t(locale, 'geminiwatermark.content.p1b')}</p>

        <!-- Feature Highlights Grid -->
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2l2.4 5.6L20 10l-5.6 2.4L12 18l-2.4-5.6L4 10l5.6-2.4z"></path>
                <path d="M19 16l1.2 2.8L23 20l-2.8 1.2L19 24l-1.2-2.8L15 20l2.8-1.2z"></path>
              </svg>
            </div>
            <h3>{t(locale, 'geminiwatermark.content.feat1Title')}</h3>
            <p>{t(locale, 'geminiwatermark.content.feat1Desc')}</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
              </svg>
            </div>
            <h3>{t(locale, 'geminiwatermark.content.feat2Title')}</h3>
            <p>{t(locale, 'geminiwatermark.content.feat2Desc')}</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                <line x1="12" y1="19" x2="12" y2="23"></line>
                <line x1="8" y1="23" x2="16" y2="23"></line>
              </svg>
            </div>
            <h3>{t(locale, 'geminiwatermark.content.feat3Title')}</h3>
            <p>{t(locale, 'geminiwatermark.content.feat3Desc')}</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <h3>{t(locale, 'geminiwatermark.content.feat4Title')}</h3>
            <p>{t(locale, 'geminiwatermark.content.feat4Desc')}</p>
          </div>
        </div>
      </div>

      <!-- Section 2: Why Gemini Adds Watermarks -->
      <div class="content-block">
        <h2>{t(locale, 'geminiwatermark.content.h2Why')}</h2>
        <p>{t(locale, 'geminiwatermark.content.p2Why1')}</p>
        <p>{t(locale, 'geminiwatermark.content.p2Why2')}</p>
      </div>

      <!-- Section 3: Technical Alpha Unblending Mechanics -->
      <div class="content-block">
        <h2>{t(locale, 'geminiwatermark.content.h3Tech')}</h2>
        <p>{t(locale, 'geminiwatermark.content.p3Tech1')}</p>
        <p>{t(locale, 'geminiwatermark.content.p3Tech2')}</p>
        <p>{t(locale, 'geminiwatermark.content.p3Tech3')}</p>
      </div>

      <!-- Section 4: Comparison Table -->
      <div class="content-block">
        <h2>{t(locale, 'geminiwatermark.content.h2Table')}</h2>
        <p>{t(locale, 'geminiwatermark.content.p2Table')}</p>

        <div class="table-responsive">
          <table class="specs-table">
            <thead>
              <tr>
                <th>{t(locale, 'geminiwatermark.content.thMethod')}</th>
                <th>{t(locale, 'geminiwatermark.content.thSpeed')}</th>
                <th>{t(locale, 'geminiwatermark.content.thPrivacy')}</th>
                <th>{t(locale, 'geminiwatermark.content.thQuality')}</th>
                <th>{t(locale, 'geminiwatermark.content.thVideo')}</th>
                <th>{t(locale, 'geminiwatermark.content.thBestFor')}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>{t(locale, 'geminiwatermark.content.row1Method')}</strong></td>
                <td><span class="code-badge">&lt; 150 ms (Image)</span></td>
                <td>100% Local Browser Sandbox</td>
                <td>Pixel-Perfect (Exact Reverse Math)</td>
                <td>Yes (Frame-by-Frame + Audio)</td>
                <td>{t(locale, 'geminiwatermark.content.row1Use')}</td>
              </tr>
              <tr>
                <td><strong>{t(locale, 'geminiwatermark.content.row2Method')}</strong></td>
                <td><span class="code-badge">15 - 60 sec</span></td>
                <td>Uploaded to Cloud Servers</td>
                <td>Hallucinated / Soft Blurring</td>
                <td>Limited (Flickering Artifacts)</td>
                <td>{t(locale, 'geminiwatermark.content.row2Use')}</td>
              </tr>
              <tr>
                <td><strong>{t(locale, 'geminiwatermark.content.row3Method')}</strong></td>
                <td><span class="code-badge">Instant</span></td>
                <td>Local Canvas Crop</td>
                <td>Destructive Aspect Ratio Loss</td>
                <td>Yes (Destructive Crop)</td>
                <td>{t(locale, 'geminiwatermark.content.row3Use')}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Section 5: Step-by-Step Workflow Guide -->
      <div class="content-block">
        <h2>{t(locale, 'geminiwatermark.content.h2Steps')}</h2>
        <p>{t(locale, 'geminiwatermark.content.p2Steps')}</p>

        <div class="steps-grid">
          <div class="step-card">
            <div class="step-number">1</div>
            <h3>{t(locale, 'geminiwatermark.content.step1Title')}</h3>
            <p>{t(locale, 'geminiwatermark.content.step1Desc')}</p>
          </div>

          <div class="step-card">
            <div class="step-number">2</div>
            <h3>{t(locale, 'geminiwatermark.content.step2Title')}</h3>
            <p>{t(locale, 'geminiwatermark.content.step2Desc')}</p>
          </div>

          <div class="step-card">
            <div class="step-number">3</div>
            <h3>{t(locale, 'geminiwatermark.content.step3Title')}</h3>
            <p>{t(locale, 'geminiwatermark.content.step3Desc')}</p>
          </div>

          <div class="step-card">
            <div class="step-number">4</div>
            <h3>{t(locale, 'geminiwatermark.content.step4Title')}</h3>
            <p>{t(locale, 'geminiwatermark.content.step4Desc')}</p>

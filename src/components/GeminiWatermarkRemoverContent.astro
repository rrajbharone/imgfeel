              <p class="cross-desc">{t(locale, 'geminiwatermark.cross.videoTrimDesc')}</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Section 10: Frequently Asked Questions (FAQ) Accordion -->
      <div class="content-block faq-container">
        <h2>{t(locale, 'geminiwatermark.content.faqTitle')}</h2>
        <div class="faq-accordion">
          <details class="faq-item">
            <summary class="faq-question">
              <span>{t(locale, 'geminiwatermark.content.faq1Q')}</span>

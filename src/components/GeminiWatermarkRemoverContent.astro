          </div>

          <div class="type-card">
            <h3>{t(locale, 'geminiwatermark.content.use3Title')}</h3>
            <p>{t(locale, 'geminiwatermark.content.use3Desc')}</p>
          </div>

          <div class="type-card">
            <h3>{t(locale, 'geminiwatermark.content.use4Title')}</h3>
            <p>{t(locale, 'geminiwatermark.content.use4Desc')}</p>
          </div>
        </div>
      </div>

      <!-- Section 7: Ethics & Provenance -->
      <div class="content-block">
        <h2>{t(locale, 'geminiwatermark.content.h2Ethics')}</h2>
        <p>{t(locale, 'geminiwatermark.content.p2Ethics1')}</p>
        <p>{t(locale, 'geminiwatermark.content.p2Ethics2')}</p>
      </div>

      <!-- Section 8: Technical Limitations -->
      <div class="content-block">
        <h2>{t(locale, 'geminiwatermark.content.h2Limits')}</h2>
        <p>{t(locale, 'geminiwatermark.content.p2Limits')}</p>

        <div class="types-grid">
          <div class="type-card">
            <h3>{t(locale, 'geminiwatermark.content.limit1Title')}</h3>
            <p>{t(locale, 'geminiwatermark.content.limit1Desc')}</p>
          </div>

          <div class="type-card">
            <h3>{t(locale, 'geminiwatermark.content.limit2Title')}</h3>
            <p>{t(locale, 'geminiwatermark.content.limit2Desc')}</p>

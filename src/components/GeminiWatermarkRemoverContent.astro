          <div class="type-card">
            <h3>{t(locale, 'geminiwatermark.content.limit4Title')}</h3>
            <p>{t(locale, 'geminiwatermark.content.limit4Desc')}</p>
          </div>
        </div>
      </div>

      <!-- Section 9: Related Tools 6-Card Grid -->
      <div class="content-block related-tools-section">
        <h2>{t(locale, 'geminiwatermark.cross.title')}</h2>
        <div class="cross-tools-grid">
          <a href={canvaUrl} class="cross-card">
            <div class="cross-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 21-4.3-4.3c-1-1-1-2.5 0-3.4l9.6-9.6c1-1 2.5-1 3.4 0l5.6 5.6c1 1 1 2.5 0 3.4L13 21"></path>
                <path d="M22 21H7"></path>
              </svg>
            </div>
            <div class="cross-info">
              <span class="cross-title">{t(locale, 'geminiwatermark.cross.canva')}</span>
              <p class="cross-desc">{t(locale, 'geminiwatermark.cross.canvaDesc')}</p>
            </div>
          </a>

          <a href={exactUrl} class="cross-card">
            <div class="cross-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
            </div>
            <div class="cross-info">
              <span class="cross-title">{t(locale, 'geminiwatermark.cross.exact')}</span>
              <p class="cross-desc">{t(locale, 'geminiwatermark.cross.exactDesc')}</p>
            </div>
          </a>

          <a href={webpUrl} class="cross-card">
            <div class="cross-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </div>
            <div class="cross-info">
              <span class="cross-title">{t(locale, 'geminiwatermark.cross.webp')}</span>
              <p class="cross-desc">{t(locale, 'geminiwatermark.cross.webpDesc')}</p>
            </div>
          </a>

          <a href={denoiseUrl} class="cross-card">
            <div class="cross-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 4V2"></path>
                <path d="M15 16v-2"></path>
                <path d="M8 9h2"></path>
                <path d="M20 9h2"></path>
                <path d="M17.8 11.8 19 13"></path>
                <path d="M15 9h0"></path>
                <path d="m3 21 9-9"></path>
              </svg>
            </div>
            <div class="cross-info">
              <span class="cross-title">{t(locale, 'geminiwatermark.cross.denoise')}</span>
              <p class="cross-desc">{t(locale, 'geminiwatermark.cross.denoiseDesc')}</p>
            </div>
          </a>

          <a href={pixelCounterUrl} class="cross-card">
            <div class="cross-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>

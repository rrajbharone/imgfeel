<!-- Structured Data FAQ Schema -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  *, *::before, *::after {
    box-sizing: border-box;
  }
  .content-section {
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
    box-sizing: border-box;
  }
  .content-body {
    width: 100%;
    max-width: 900px;
    margin-inline: auto;
    word-break: break-word;
    overflow-wrap: break-word;
    box-sizing: border-box;
  }
  .feature-card, .type-card, .step-card, .faq-item {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    word-break: break-word;
    overflow-wrap: break-word;
    box-sizing: border-box;
  }
  .content-section {
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
  }

  .content-body {
    max-width: 900px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .content-body h2 {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .content-body p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* Features Grid */
  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .feature-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    box-shadow: var(--shadow-sm);
  }

  .feature-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    background: rgba(255, 0, 0, 0.08);
    color: #FF0000;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-1);
  }

  .feature-card h3 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .feature-card p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Types Grid */
  .types-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3-5);
  }

  @media (min-width: 640px) {
    .types-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .type-card {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
  }

  .type-card h4 {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .type-card p {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Steps Grid */
  .steps-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .step-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }

  .step-number {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: #FF0000;
    color: #ffffff;
    font-weight: 800;
    font-size: var(--text-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .step-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .step-content h4 {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .step-content p {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* FAQ Accordion */
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-2-5);
  }

  .faq-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .faq-item[open] {
    border-color: var(--color-accent-border);
    background: var(--color-surface);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    transition: transform 0.2s ease;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--color-accent);
  }

  .faq-answer {
    padding: 0 var(--space-4) var(--space-4);
  }

  .faq-answer p {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }
</style>

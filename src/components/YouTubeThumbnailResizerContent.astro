---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": t(locale, 'ytthumb.content.faq1Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'ytthumb.content.faq1A')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'ytthumb.content.faq2Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'ytthumb.content.faq2A')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'ytthumb.content.faq3Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'ytthumb.content.faq3A')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'ytthumb.content.faq4Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'ytthumb.content.faq4A')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'ytthumb.content.faq5Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'ytthumb.content.faq5A')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'ytthumb.content.faq6Q'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'ytthumb.content.faq6A')
      }
    }
  ]
};
---

<section class="section content-section">
  <div class="container">
    <div class="content-body">
      <!-- Section 1: Overview & Importance -->
      <h2>{t(locale, 'ytthumb.content.h1')}</h2>
      <p>{t(locale, 'ytthumb.content.p1a')}</p>
      <p>{t(locale, 'ytthumb.content.p1b')}</p>

      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>

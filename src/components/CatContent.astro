---
/**
 * CAT Photo & Signature Resizer SEO Content & FAQ Component
 * Strict compliance with ImgFeel UI/UX Design System Standards
 */

const faqItems = [
  {
    q: 'What are the official photo and signature dimensions for CAT 2026 registration?',
    a: 'According to the official IIM CAT Registration Guide, the candidate photograph must have dimensions of 30 mm × 45 mm (or 35 mm × 45 mm, roughly 350 × 450 pixels) with a resolution of at least 150 DPI. The digital signature must measure 80 mm × 35 mm (roughly 400 × 175 pixels) with at least 150 DPI.',
  },
  {
    q: 'What is the maximum allowed file size for CAT photograph and signature uploads?',
    a: 'Both the candidate photograph and the scanned signature must strictly have a maximum file size of 80 KB in JPG or JPEG format on iimcat.ac.in. Files exceeding 80 KB are rejected by the registration portal.',
  },
  {
    q: 'What background color is mandatory for the IIM CAT photograph?',
    a: 'A plain white background (#FFFFFF) is strictly mandatory for the CAT photograph. Photographs with colored, patterned, outdoor, or dark backgrounds are rejected by automated validation checks and testing center authorities.',
  },
  {
    q: 'How recent should my photograph be for CAT application submission?',
    a: 'The photograph must be recent and not older than 6 months from the date of online registration. It must feature a clear frontal view with a neutral expression, open eyes, and visible ears.',
  },
  {
    q: 'Can I sign using CAPITAL / BLOCK letters for the CAT registration?',
    a: 'No. The Indian Institutes of Management (IIMs) strictly disqualify applications where signatures are written in CAPITAL or BLOCK letters or merely use initials. Your signature must be executed in your natural, continuous running handwriting using a black or blue ink pen on clean white unruled paper.',
  },
  {
    q: 'How many printed copies of the photograph should I retain for CAT exam day?',
    a: 'Candidates must retain at least 4 to 8 identical physical copies of the photograph uploaded online. You are required to affix this identical physical photograph to the CAT Admit Card in the presence of the invigilator at the test center.',
  },
  {
    q: 'Are spectacles allowed in the CAT passport photograph?',
    a: 'Clear, regular prescription spectacles are allowed provided there is no flash reflection or glare on the lenses and the eyes remain completely visible. Sunglasses, dark goggles, or tinted lenses are strictly prohibited.',
  },
  {
    q: 'Can I upload a smartphone selfie or cropped social media picture for CAT?',
    a: 'No. Casual selfies, cropped photos, mobile snapshots with uneven lighting or shadows, and photos with caps or headwear (except mandatory religious headgear like turbans) are strictly disallowed.',
  },
  {
    q: 'Is there a correction window for photo or signature errors in CAT?',
    a: 'Yes. IIMs typically provide a limited CAT Application Correction Window shortly after registration closes, allowing candidates to re-upload their photograph and signature if initial uploads were blurry or flagged.',
  },
  {
    q: 'Are my confidential application files uploaded to your web server for processing?',
    a: 'Never. ImgFeel processes 100% of your images locally inside your web browser using HTML5 Canvas APIs. Your private photographs, signatures, and biometric identity documents never leave your computer or smartphone.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'CAT Photo & Signature Resizer',
  operatingSystem: 'Any',
  applicationCategory: 'MultimediaApplication',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<!-- JSON-LD Structured Data Schemas -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(appSchema)} />

<section class="section content-section">
  <div class="container">
    <div class="content-body">
      <!-- Section 1: Introduction to Official IIM CAT Standards -->
      <h2>Official IIM CAT Photo &amp; Signature Guidelines (2026 Examination Standards)</h2>
      <p>
        The Common Admission Test (CAT) is India's premier national entrance examination conducted by the Indian Institutes of Management (IIMs) for admission to postgraduate management programmes (MBA/PGP) across 21 IIMs and hundreds of top associate business schools (such as FMS Delhi, SPJIMR, MDI Gurgaon, and IIT DMS). Candidates registering on the official portal, <strong>iimcat.ac.in</strong>, must strictly satisfy exact biometric upload requirements for their scanned passport photograph and digital signature.
      </p>
      <p>
        This free, client-side <strong>CAT Photo &amp; Signature Resizer</strong> automatically formats candidate photographs to <strong>30 × 45 mm (350 × 450 px, strictly ≤ 80 KB JPG)</strong> and signatures to <strong>80 × 35 mm (400 × 175 px, strictly ≤ 80 KB JPG)</strong> with minimum 150 DPI resolution. It cleans grayish paper backgrounds, ensures pure white backdrop contrast, and guarantees 100% compliance with IIM portal upload limits.
      </p>

      <!-- Section 2: Important Guidelines Breakdown -->
      <h2>Key Image Specifications Established by the IIM CAT Registration Guide</h2>
      <p>
        To avoid rejection during online submission or verification hurdles on examination day, adhere strictly to these official standards:
      </p>
      <div class="benefits-grid">

---
/**
 * NEET & JEE Entrance Exam Photo & Signature Resizer SEO Content & FAQ Component
 * Strict compliance with ImgFeel UI/UX Design System Standards
 */

const faqItems = [
  {
    q: 'What are the official photo and signature dimensions for NEET UG 2026?',
    a: 'For NEET UG (conducted by NTA), passport-size photographs must measure 3.5 cm × 4.5 cm (roughly 350 × 450 pixels) with a file size between 10 KB and 200 KB in JPG/JPEG format. Scanned signatures must be between 10 KB and 100 KB in JPG format, signed with black or blue ink on white paper in running handwriting.',
  },
  {
    q: 'Does NEET UG require a live photo or an uploaded passport photograph?',
    a: 'NTA mandates both. During online application registration on exams.nta.ac.in/NEET, candidates must capture a real-time Live Photograph through their webcam or smartphone camera. In addition, candidates must upload a scanned recent passport photograph (10–200 KB JPG) and keep identical printed copies (along with 4"×6" postcard-size photos) to affix to the Admit Card counterfoil and attendance sheet on exam day.',
  },
  {
    q: 'What is the required file size limit for NEET PG photograph and signature uploads?',
    a: 'According to the NBEMS (National Board of Examinations in Medical Sciences) guidelines, photographs and signatures for NEET PG must strictly be less than 80 KB (between 10 KB and 80 KB) in JPG/JPEG format. The photograph must be recent (taken within 3 months) on a plain white background with 75%–80% face coverage.',
  },
  {
    q: 'What are the photo and signature requirements for JEE Main 2026?',
    a: 'For JEE Main (NTA), candidate photographs must be in JPG/JPEG format with a file size strictly between 10 KB and 200 KB, featuring a plain white background with 80% face coverage (ears visible). Signatures must be between 10 KB and 100 KB in JPG/JPEG format, executed in running handwriting with blue or black ink on unruled white paper.',
  },
  {
    q: 'Do I need to upload a fresh photo and signature for JEE Advanced 2026?',
    a: 'For Indian nationals who qualified through JEE Main, photograph and signature records are automatically transferred from the JEE Main registration database to the JEE Advanced portal. Direct photograph and signature uploads (10–200 KB photo, 10–100 KB signature) are required for foreign nationals, specific special categories, or during designated portal correction windows.',
  },
  {
    q: 'Can I sign using CAPITAL / BLOCK letters for NEET or JEE examinations?',
    a: 'No. Both the National Testing Agency (NTA) and NBEMS explicitly disqualify applications containing signatures executed in CAPITAL / BLOCK letters or consisting solely of initials. Signatures must be in your natural, continuous running handwriting.',
  },
  {
    q: 'What background color is mandatory for NEET and JEE candidate photographs?',
    a: 'A plain white background (#FFFFFF) is mandatory for NEET UG, NEET PG, JEE Main, and JEE Advanced. Photographs with colored, patterned, outdoor, or dark backgrounds are rejected by automated validation systems and verification officers.',
  },
  {
    q: 'Are spectacles allowed in NEET and JEE application photos?',
    a: 'Spectacles are permitted only if worn regularly for vision correction. Tinted glasses, sunglasses, polaroids, or colored lenses are strictly prohibited. The eyes and ears must remain completely unobstructed without reflection or flash glare on the lenses.',
  },
  {
    q: 'What is the difference between NEET UG passport photo and postcard photo?',
    a: 'For NEET UG, candidates need two formats: (1) Standard passport photograph (3.5 × 4.5 cm / 10–200 KB JPG) for application upload, and (2) Postcard photograph (4" × 6" / 10 × 15 cm, also 10–200 KB JPG) with white background, which must be printed and pasted on the Proforma accompanying the Admit Card on the examination day.',
  },
  {
    q: 'Are candidate photos or signatures uploaded to your servers for processing?',
    a: 'Never. ImgFeel processes 100% of your images locally inside your web browser using HTML5 Canvas APIs. Your private photographs, signatures, and biometric identity files never leave your device, ensuring complete security and privacy.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'NEET & JEE Photo & Signature Resizer',
  operatingSystem: 'Any',
  applicationCategory: 'MultimediaApplication',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<!-- JSON-LD Structured Data Schemas -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(appSchema)} />

<section class="section content-section">
  <div class="container">
    <div class="content-body">
      <!-- Section 1: Introduction to Official NEET & JEE Standards -->
      <h2>Official NEET &amp; JEE Entrance Exam Photo &amp; Signature Specifications (2026 Standards)</h2>
      <p>
        National entrance examinations in India—including <strong>NEET UG (Undergraduate)</strong>, <strong>NEET PG (Postgraduate)</strong>, <strong>JEE Main</strong>, and <strong>JEE Advanced</strong>—enforce stringent biometric image validation rules. The National Testing Agency (NTA), the National Board of Examinations in Medical Sciences (NBEMS), and the Joint Admission Board (JAB) utilize automated portal validators that immediately reject uploaded photographs or signatures with non-compliant dimensions, incorrect file sizes, or improper backgrounds.
      </p>
      <p>
        This free, client-side <strong>NEET Photo &amp; Signature Resizer</strong> automatically formats your passport photo and digital signature to exact 2026 entrance exam requirements. It crops your image to standard <strong>3.5 × 4.5 cm (350 × 450 px)</strong> dimensions, whitens dark backgrounds, optimizes resolution, and compresses files strictly within official byte limits (<strong>10–200 KB</strong> for NTA, <strong>10–80 KB</strong> for NBEMS) without losing facial clarity.
      </p>


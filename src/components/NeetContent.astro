    padding: 16px 20px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    vertical-align: top;
    line-height: 1.5;
  }

  .specs-table tr:last-child td {
    border-bottom: none;
  }

  /* --- Steps List --- */
  .steps-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-block: var(--space-6);
  }

  .step-card {

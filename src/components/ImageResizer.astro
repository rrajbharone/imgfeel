---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div
  class="resizer"
  id="image-resizer-app"
  data-i18n-dropzone-title={t(locale, 'resizer.dropzone.title')}
  data-i18n-dropzone-subtitle={t(locale, 'resizer.dropzone.subtitle')}
  data-i18n-dropzone-formats={t(locale, 'resizer.dropzone.formats')}
  data-i18n-dropzone-dragging={t(locale, 'resizer.dropzone.dragging')}
  data-i18n-dropzone-browse={t(locale, 'resizer.dropzone.browse')}
  data-i18n-info-title={t(locale, 'resizer.info.title')}
  data-i18n-info-filename={t(locale, 'resizer.info.filename')}
  data-i18n-info-format={t(locale, 'resizer.info.format')}
  data-i18n-info-original-size={t(locale, 'resizer.info.originalSize')}
  data-i18n-info-dimensions={t(locale, 'resizer.info.dimensions')}
  data-i18n-mode-dimensions={t(locale, 'resizer.mode.dimensions')}
  data-i18n-mode-percentage={t(locale, 'resizer.mode.percentage')}
  data-i18n-mode-target-size={t(locale, 'resizer.mode.targetSize')}
  data-i18n-label-width={t(locale, 'resizer.label.width')}
  data-i18n-label-height={t(locale, 'resizer.label.height')}
  data-i18n-label-percentage={t(locale, 'resizer.label.percentage')}
  data-i18n-label-target-file-size={t(locale, 'resizer.label.targetFileSize')}
  data-i18n-label-lock={t(locale, 'resizer.label.lockAspectRatio')}
  data-i18n-label-quality={t(locale, 'resizer.label.quality')}
  data-i18n-label-output-format={t(locale, 'resizer.label.outputFormat')}
  data-i18n-format-original={t(locale, 'resizer.format.original')}
  data-i18n-result-title={t(locale, 'resizer.result.title')}
  data-i18n-result-new-dimensions={t(locale, 'resizer.result.newDimensions')}
  data-i18n-result-new-size={t(locale, 'resizer.result.newSize')}
  data-i18n-action-resize={t(locale, 'resizer.action.resize')}
  data-i18n-action-download={t(locale, 'resizer.action.download')}
  data-i18n-action-new-image={t(locale, 'resizer.action.newImage')}
  data-i18n-error-invalid={t(locale, 'resizer.error.invalidFile')}
  data-i18n-error-load={t(locale, 'resizer.error.loadFailed')}
  data-i18n-error-resize={t(locale, 'resizer.error.resizeFailed')}
  data-i18n-status-processing={t(locale, 'resizer.status.processing')}
  data-i18n-status-complete={t(locale, 'resizer.status.complete')}
>
  <!-- Upload State -->
  <div class="resizer-upload" id="resizer-upload">
    <div class="dropzone" id="resizer-dropzone" tabindex="0" role="button" aria-label={t(locale, 'resizer.dropzone.title')}>
      <div class="dropzone-icon-wrapper">
        <svg class="dropzone-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
      </div>
      <p class="dropzone-title">{t(locale, 'resizer.dropzone.title')}</p>
      <p class="dropzone-subtitle">{t(locale, 'resizer.dropzone.subtitle')}</p>
      <button type="button" class="btn btn-primary dropzone-browse-btn" id="resizer-browse-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 8 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2z"></path>
        </svg>
        <span>{t(locale, 'resizer.dropzone.browse')}</span>
      </button>
      <p class="dropzone-formats">{t(locale, 'resizer.dropzone.formats')}</p>
      <input
        type="file"
        id="resizer-file-input"
        accept="image/jpeg,image/png,image/webp,image/avif"
        class="sr-only"
      />
    </div>
  </div>

  <!-- Editor State (hidden initially) -->
  <div class="resizer-editor" id="resizer-editor" hidden>
    <div class="editor-layout">
      <!-- Preview -->
      <div class="preview-area">
        <img id="resizer-preview" class="preview-image" alt="" />
        <div class="image-info" id="resizer-info"></div>
      </div>

      <!-- Controls -->
      <div class="controls-area">
        <!-- Mode Tabs -->
        <div class="mode-tabs" role="tablist">
          <button class="mode-tab active" data-mode="dimensions" id="mode-dimensions" role="tab" aria-selected="true" aria-controls="controls-dimensions">{t(locale, 'resizer.mode.dimensions')}</button>
          <button class="mode-tab" data-mode="percentage" id="mode-percentage" role="tab" aria-selected="false" aria-controls="controls-percentage">{t(locale, 'resizer.mode.percentage')}</button>
          <button class="mode-tab" data-mode="targetSize" id="mode-target-size" role="tab" aria-selected="false" aria-controls="controls-target-size">{t(locale, 'resizer.mode.targetSize')}</button>
        </div>

        <!-- Dimensions Controls -->
        <div class="control-group" id="controls-dimensions" role="tabpanel" aria-labelledby="mode-dimensions">
          <div class="input-row">
            <div class="input-field">
              <label for="resize-width">{t(locale, 'resizer.label.width')}</label>
              <input type="number" id="resize-width" min="1" max="10000" />
            </div>
            <div class="input-field">
              <label for="resize-height">{t(locale, 'resizer.label.height')}</label>
              <input type="number" id="resize-height" min="1" max="10000" />
            </div>
          </div>
          <label class="checkbox-label">
            <input type="checkbox" id="lock-aspect" checked />
            <span>{t(locale, 'resizer.label.lockAspectRatio')}</span>
          </label>
        </div>

        <!-- Percentage Controls -->
        <div class="control-group" id="controls-percentage" hidden role="tabpanel" aria-labelledby="mode-percentage">
          <div class="input-field">
            <label for="resize-percentage">{t(locale, 'resizer.label.percentage')}</label>
            <div class="percentage-input">
              <input type="number" id="resize-percentage" min="1" max="500" value="50" />
              <span class="percentage-sign">%</span>
            </div>
          </div>
          <div class="percentage-presets">
            <button type="button" class="preset-btn" data-pct="25">25%</button>
            <button type="button" class="preset-btn" data-pct="50">50%</button>
            <button type="button" class="preset-btn" data-pct="75">75%</button>
            <button type="button" class="preset-btn" data-pct="100">100%</button>
          </div>
          <div class="pct-preview" id="pct-preview-info"></div>
        </div>

        <!-- Target File Size Controls -->
        <div class="control-group" id="controls-target-size" hidden role="tabpanel" aria-labelledby="mode-target-size">
          <div class="input-field">
            <label for="resize-target-size">{t(locale, 'resizer.label.targetFileSize')}</label>
            <div class="target-size-input">
              <input type="number" id="resize-target-size" min="1" max="100000" value="100" />
              <span class="unit-sign">KB</span>
            </div>
          </div>
          <div class="target-size-presets">
            <button type="button" class="target-preset-btn" data-kb="15">15 KB</button>
            <button type="button" class="target-preset-btn" data-kb="20">20 KB</button>
            <button type="button" class="target-preset-btn" data-kb="25">25 KB</button>
            <button type="button" class="target-preset-btn" data-kb="50">50 KB</button>
            <button type="button" class="target-preset-btn active" data-kb="100">100 KB</button>
            <button type="button" class="target-preset-btn" data-kb="200">200 KB</button>
            <button type="button" class="target-preset-btn" data-kb="500">500 KB</button>
            <button type="button" class="target-preset-btn" data-kb="1024">1 MB</button>
          </div>
        </div>

        <!-- Output Format -->
        <div class="control-group" id="format-group">
          <label for="resize-format">{t(locale, 'resizer.label.outputFormat')}</label>
          <select id="resize-format" class="format-select">
            <option value="original" selected>{t(locale, 'resizer.format.original')}</option>
            <option value="image/jpeg">JPG / JPEG</option>
            <option value="image/png">PNG (Lossless)</option>
            <option value="image/webp">WebP</option>
            <option value="image/avif" id="opt-avif" hidden>AVIF</option>
          </select>
        </div>

        <!-- Quality -->
        <div class="control-group" id="quality-group">
          <label for="resize-quality">{t(locale, 'resizer.label.quality')}: <span id="quality-value">90</span>%</label>
          <input type="range" id="resize-quality" min="10" max="100" value="90" />
        </div>

        <!-- Actions -->
        <div class="actions">
          <button class="btn btn-primary btn-lg action-resize" id="btn-resize">{t(locale, 'resizer.action.resize')}</button>
        </div>
      </div>
    </div>

    <!-- Result (hidden initially) -->
    <div class="result-area" id="resizer-result" hidden>
      <h3 class="result-title">{t(locale, 'resizer.result.title')}</h3>
      <div class="result-info" id="result-info"></div>
      <div class="result-actions">
        <button class="btn btn-primary" id="btn-download">{t(locale, 'resizer.action.download')}</button>
        <button class="btn btn-secondary" id="btn-new-image">{t(locale, 'resizer.action.newImage')}</button>
      </div>
    </div>
  </div>

  <!-- Error State -->
  <div class="resizer-error" id="resizer-error" hidden>
    <p id="error-message"></p>
  </div>
</div>

<script src="@/scripts/image-resizer.ts"></script>

<style>
  .resizer {
    max-width: var(--container-narrow);
    margin-inline: auto;
  }

  /* Dropzone */
  .dropzone {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-10) var(--space-4);
    border: 2px dashed var(--color-accent);
    border-radius: var(--radius-lg);
    cursor: pointer;
    background: var(--color-surface);
    transition: border-color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
    text-align: center;
    outline: none;
  }
  .dropzone:hover,
  .dropzone:focus-visible,
  .dropzone.dragging {
    border-color: var(--color-accent);
    background: var(--color-accent-light);
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
  }
  .dropzone-icon-wrapper {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-1);
    transition: transform 0.15s ease;
  }
  .dropzone:hover .dropzone-icon-wrapper,
  .dropzone.dragging .dropzone-icon-wrapper {
    transform: translateY(-2px);
  }
  .dropzone-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
  }
  .dropzone-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    max-width: 360px;
  }
  .dropzone-browse-btn {
    margin-top: var(--space-2);
    margin-bottom: var(--space-1);
    min-height: 44px;
    padding-inline: var(--space-6);
  }
  .dropzone-formats {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Editor */
  .editor-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Preview */
  .preview-area {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .preview-image {
    width: 100%;
    max-height: 400px;
    object-fit: contain;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .image-info {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }
  .image-info :global(.info-label) {
    font-weight: 600;
    color: var(--color-text);
  }

  /* Controls */
  .controls-area {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .mode-tabs {
    display: flex;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .mode-tab {
    flex: 1;
    padding: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    background: var(--color-bg);
    border: none;
    cursor: pointer;
    min-height: 44px;
    transition: background 0.15s, color 0.15s;
  }
  .mode-tab.active {
    background: var(--color-accent);
    color: #fff;
  }
  .mode-tab:not(.active):hover {
    background: var(--color-surface);
  }
  .control-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .control-group label {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
  }
  .input-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }
  .input-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .input-field input[type="number"] {
    width: 100%;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    min-height: 44px;
    background: var(--color-bg);
  }
  .input-field input[type="number"]:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: -1px;
    border-color: transparent;
  }
  .format-select {
    width: 100%;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    min-height: 44px;
    background: var(--color-bg);
    color: var(--color-text);
  }
  .format-select:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: -1px;
    border-color: transparent;
  }
  .percentage-input {
    position: relative;
  }
  .percentage-input input {
    padding-right: var(--space-8) !important;
  }
  .percentage-sign {
    position: absolute;
    right: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .checkbox-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 400 !important;
    cursor: pointer;
    min-height: 44px;
  }
  [hidden] {
    display: none !important;
  }

  .percentage-presets {
    display: flex;
    gap: var(--space-2);
  }
  .preset-btn {
    flex: 1;
    padding: var(--space-2) var(--space-1);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
    min-height: 36px;
  }
  .preset-btn:hover,
  .preset-btn.active {
    background: var(--color-accent-light);
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .target-size-presets {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-2);
  }
  .target-preset-btn {
    padding: var(--space-2) var(--space-1);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
    min-height: 36px;
    text-align: center;
  }
  .target-preset-btn:hover,
  .target-preset-btn.active {
    background: var(--color-accent-light);
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .unit-sign {
    position: absolute;
    right: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .target-size-input {
    position: relative;
  }
  .target-size-input input {
    padding-right: var(--space-10) !important;
  }
  .pct-preview {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* Actions */
  .actions {
    display: flex;
    gap: var(--space-3);
  }
  .action-resize {
    width: 100%;
  }

  /* Result */
  .result-area {
    margin-top: var(--space-6);
    padding: var(--space-5);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }
  .result-title {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }
  .result-info {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }
  .result-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  /* Error */
  .resizer-error {
    padding: var(--space-4);
    background: var(--color-error-bg);
    border-radius: var(--radius-md);
    color: var(--color-error);
    font-size: var(--text-sm);
    margin-top: var(--space-4);
  }

  @media (min-width: 768px) {
    .editor-layout {
      flex-direction: row;
    }
    .preview-area {
      flex: 1;
      min-width: 0;
    }
    .controls-area {
      width: 280px;
      flex-shrink: 0;
    }
  }
</style>

---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';
import { getToolUrl } from '@/data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const stitchUrl = getToolUrl('image-stitcher', locale);
const blurUrl = getToolUrl('image-blur-tool', locale);
const squareUrl = getToolUrl('resize-image-to-1-1', locale);
const circleUrl = getToolUrl('circle-image-cropper', locale);
const grayscaleUrl = getToolUrl('image-grayscale-converter', locale);

const i18nDict = {
  statusReady: t(locale, 'beautify.status.ready'),
  statusProcessing: t(locale, 'beautify.status.processing'),
  errorLoad: t(locale, 'beautify.error.load'),
  copySuccess: t(locale, 'beautify.action.copied'),
  downloadName: t(locale, 'beautify.download.filename'),
};
---

<div class="beautify-tool-wrapper" id="beautifyApp" data-i18n={JSON.stringify(i18nDict)}>
  <!-- Dropzone / Empty State -->
  <div class="beautify-dropzone-card" id="beautifyDropzone">
    <div class="beautify-dropzone-content">
      <div class="beautify-icon-circle">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2l2.4 5.6L20 10l-5.6 2.4L12 18l-2.4-5.6L4 10l5.6-2.4z"></path>
          <path d="M19 16l1.2 2.8L23 20l-2.8 1.2L19 24l-1.2-2.8L15 20l2.8-1.2z"></path>
        </svg>
      </div>

      <h2 class="beautify-drop-title">{t(locale, 'beautify.dropzone.title')}</h2>
      <p class="beautify-drop-subtitle">{t(locale, 'beautify.dropzone.subtitle')}</p>

      <div class="beautify-btn-row">
        <label class="btn btn-primary beautify-btn-primary" for="beautifyFileInput">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'beautify.dropzone.browse')}</span>
        </label>
        <input type="file" id="beautifyFileInput" accept="image/*,.jpg,.jpeg,.png,.webp,.avif,.bmp" class="sr-only" />

        <button type="button" class="btn btn-secondary beautify-sample-btn" id="beautifySampleBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
          <span>{t(locale, 'beautify.dropzone.sample')}</span>
        </button>
      </div>

      <p class="beautify-formats-hint">{t(locale, 'beautify.dropzone.formats')}</p>

      <div class="beautify-privacy-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span>{t(locale, 'beautify.privacy.badge')}</span>
      </div>
    </div>
  </div>

  <!-- Loading State -->
  <div class="beautify-loading-card" id="beautifyLoadingCard" style="display: none;">
    <div class="beautify-spinner"></div>
    <p class="beautify-loading-text">{t(locale, 'beautify.status.processing')}</p>
  </div>

  <!-- Main Beautifier Workspace -->
  <div class="beautify-workspace" id="beautifyWorkspace" style="display: none;">
    <!-- Top Action Bar -->
    <div class="beautify-top-bar">
      <div class="top-bar-info">
        <span class="beautify-status-dot"></span>
        <span class="top-bar-name" id="currentFileName">screenshot.png</span>
        <span class="top-bar-dims" id="currentFileDims">0 × 0 px</span>
      </div>
      <div class="top-bar-actions">
        <label class="btn btn-secondary btn-sm" for="beautifyChangeInput">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'beautify.action.changeImage')}</span>
        </label>
        <input type="file" id="beautifyChangeInput" accept="image/*,.jpg,.jpeg,.png,.webp,.avif,.bmp" class="sr-only" />

        <button type="button" class="btn btn-secondary btn-sm" id="beautifyResetBtn">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
            <path d="M3 3v5h5"></path>
          </svg>
          <span>{t(locale, 'beautify.action.reset')}</span>
        </button>
      </div>
    </div>

    <!-- 2-Column Grid: Preview on Left, Settings on Right -->
    <div class="beautify-main-grid">
      <!-- Left Column: Live Canvas Viewport -->
      <div class="beautify-preview-card">
        <div class="viewport-header">
          <span class="viewport-label">{t(locale, 'beautify.preview.title')}</span>
          <span class="viewport-tag" id="beautifyDimsBadge">0 × 0 px</span>
        </div>

        <div class="beautify-canvas-viewport">
          <div class="canvas-checkerboard-wrap" id="canvasWrap">
            <canvas id="mainBeautifyCanvas" class="main-canvas"></canvas>
          </div>
        </div>
      </div>

      <!-- Right Column: Beautification Controls -->
      <div class="beautify-controls-panel">
        <!-- Section 1: Background Style -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'beautify.bg.label')}</label>
          <div class="bg-mode-chips">
            <button type="button" class="bg-mode-btn active" data-bg="gradient">{t(locale, 'beautify.bg.gradient')}</button>
            <button type="button" class="bg-mode-btn" data-bg="solid">{t(locale, 'beautify.bg.solid')}</button>
            <button type="button" class="bg-mode-btn" data-bg="transparent">{t(locale, 'beautify.bg.transparent')}</button>
          </div>

          <!-- Gradient Palette Picker -->
          <div class="gradient-palette-grid" id="gradientGrid">
            <!-- Rendered dynamically from GRADIENT_PRESETS -->
          </div>

          <!-- Solid Color Palette Picker (hidden by default) -->
          <div class="solid-palette-row" id="solidGrid" style="display: none;">
            <button type="button" class="solid-chip active" data-color="#0f172a" style="background: #0f172a;" title="Dark Slate"></button>
            <button type="button" class="solid-chip" data-color="#ffffff" style="background: #ffffff; border-color: #cbd5e1;" title="Pure White"></button>
            <button type="button" class="solid-chip" data-color="#000000" style="background: #000000;" title="Pure Black"></button>
            <button type="button" class="solid-chip" data-color="#f8fafc" style="background: #f8fafc; border-color: #cbd5e1;" title="Soft Cream"></button>
            <label class="solid-custom-label" title="Custom Hex Color">
              <input type="color" id="beautifyCustomColorInput" value="#3b82f6" class="sr-only" />
              <span class="solid-custom-dot" id="customColorDot"></span>
            </label>
          </div>
        </div>

        <!-- Section 2: Mockup Window Frame -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'beautify.frame.label')}</label>
          <div class="frame-chips-grid">
            <button type="button" class="frame-btn active" data-frame="macos-dark">
              <span class="mockup-dots-preview">
                <span style="background: #ef4444;"></span>
                <span style="background: #f59e0b;"></span>
                <span style="background: #10b981;"></span>
              </span>
              <span>macOS Dark</span>
            </button>

            <button type="button" class="frame-btn" data-frame="macos-light">
              <span class="mockup-dots-preview">
                <span style="background: #ef4444;"></span>
                <span style="background: #f59e0b;"></span>
                <span style="background: #10b981;"></span>
              </span>
              <span>macOS Light</span>
            </button>

            <button type="button" class="frame-btn" data-frame="browser">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
              <span>Browser Bar</span>
            </button>

            <button type="button" class="frame-btn" data-frame="none">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
              </svg>
              <span>None (Clean)</span>
            </button>
          </div>
        </div>

        <!-- Section 3: Canvas Aspect Ratio -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'beautify.ratio.label')}</label>
          <div class="ratio-chips-grid">
            <button type="button" class="ratio-btn active" data-ratio="auto">Auto (Fit)</button>
            <button type="button" class="ratio-btn" data-ratio="16:9">16:9 (Social / X)</button>
            <button type="button" class="ratio-btn" data-ratio="1:1">1:1 (Square)</button>
            <button type="button" class="ratio-btn" data-ratio="4:3">4:3 (Deck)</button>
            <button type="button" class="ratio-btn" data-ratio="9:16">9:16 (Story)</button>
          </div>
        </div>

        <!-- Section 4: Sliders (Padding, Radius, Shadow, Scale) -->
        <div class="control-group">
          <div class="slider-header-row">
            <label for="paddingSlider" class="control-label">{t(locale, 'beautify.sliders.padding')}</label>
            <span id="paddingVal" class="val-pill">48 px</span>
          </div>
          <input type="range" id="paddingSlider" min="16" max="120" value="48" step="4" class="beautify-range" />
        </div>

        <div class="control-group">
          <div class="slider-header-row">
            <label for="radiusSlider" class="control-label">{t(locale, 'beautify.sliders.radius')}</label>
            <span id="radiusVal" class="val-pill">16 px</span>
          </div>
          <input type="range" id="radiusSlider" min="0" max="36" value="16" step="2" class="beautify-range" />
        </div>

        <div class="control-group">
          <label class="control-label">{t(locale, 'beautify.shadow.label')}</label>
          <div class="shadow-chips-row">
            <button type="button" class="shadow-btn" data-shadow="none">{t(locale, 'beautify.shadow.none')}</button>
            <button type="button" class="shadow-btn" data-shadow="soft">{t(locale, 'beautify.shadow.soft')}</button>
            <button type="button" class="shadow-btn active" data-shadow="medium">{t(locale, 'beautify.shadow.medium')}</button>
            <button type="button" class="shadow-btn" data-shadow="dramatic">{t(locale, 'beautify.shadow.dramatic')}</button>
            <button type="button" class="shadow-btn" data-shadow="glow">{t(locale, 'beautify.shadow.glow')}</button>
          </div>
        </div>

        <div class="control-group">
          <div class="slider-header-row">
            <label for="scaleSlider" class="control-label">{t(locale, 'beautify.sliders.scale')}</label>
            <span id="scaleVal" class="val-pill">100 %</span>
          </div>
          <input type="range" id="scaleSlider" min="50" max="100" value="100" step="5" class="beautify-range" />
        </div>

        <!-- Section 5: Format & Quality Selection -->
        <div class="control-group">
          <label for="beautifyFormatSelect" class="control-label">{t(locale, 'beautify.format.label')}</label>
          <select id="beautifyFormatSelect" class="beautify-select">
            <option value="image/png" selected>PNG (Lossless / Best Quality)</option>
            <option value="image/jpeg">JPG / JPEG (Compact File)</option>
            <option value="image/webp">WebP (Modern Web Format)</option>
          </select>
        </div>

        <!-- Section 6: Live Metrics Card -->
        <div class="beautify-metrics-card">
          <div class="metric-row">
            <span class="metric-label">{t(locale, 'beautify.metrics.dimensions')}:</span>
            <strong id="metricDims">0 × 0 px</strong>
          </div>
          <div class="metric-row">
            <span class="metric-label">{t(locale, 'beautify.metrics.fileWeight')}:</span>
            <strong id="metricWeight">-- KB</strong>
          </div>
          <div class="metric-row">
            <span class="metric-label">{t(locale, 'beautify.metrics.privacyStatus')}:</span>
            <strong>{t(locale, 'beautify.metrics.clientSafe')}</strong>
          </div>
        </div>

        <!-- Action Buttons: Copy & Download -->
        <div class="action-buttons-row">
          <button type="button" class="btn btn-secondary beautify-copy-btn" id="beautifyCopyBtn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copyBtnText">{t(locale, 'beautify.action.copy')}</span>
          </button>

          <button type="button" class="btn btn-primary beautify-download-btn" id="beautifyDownloadBtn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>{t(locale, 'beautify.action.download')}</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Quick Navigation to Related Tools -->
    <div class="beautify-cross-links-row">
      <a href={stitchUrl} class="btn btn-secondary beautify-cross-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="8" height="18" rx="1"></rect>
          <rect x="13" y="3" width="8" height="18" rx="1"></rect>
          <path d="M11 8h2M11 12h2M11 16h2"></path>
        </svg>
        <span>{t(locale, 'beautify.cross.stitch')}</span>
      </a>

      <a href={blurUrl} class="btn btn-secondary beautify-cross-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="9" stroke-dasharray="2 3"></circle>
          <circle cx="12" cy="12" r="5" stroke-dasharray="1 2"></circle>
          <circle cx="12" cy="12" r="1.5" fill="currentColor"></circle>
        </svg>
        <span>{t(locale, 'beautify.cross.blur')}</span>
      </a>

      <a href={squareUrl} class="btn btn-secondary beautify-cross-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        </svg>
        <span>{t(locale, 'beautify.cross.square')}</span>
      </a>

      <a href={circleUrl} class="btn btn-secondary beautify-cross-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="9"></circle>
        </svg>
        <span>{t(locale, 'beautify.cross.circle')}</span>
      </a>

      <a href={grayscaleUrl} class="btn btn-secondary beautify-cross-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 3a9 9 0 0 1 0 18v-18z" fill="currentColor"></path>
        </svg>
        <span>{t(locale, 'beautify.cross.grayscale')}</span>
      </a>
    </div>
  </div>
</div>

<script>
  import {
    GRADIENT_PRESETS,
    type BgType,
    type FrameType,
    type AspectRatioType,
    type ShadowPreset,
    type AlignmentType,
    type BeautifyResult,
    loadImageFromFile,
    renderBeautifiedCanvas,
    exportBeautifiedScreenshot,
    copyBeautifiedToClipboard,
    generateSampleScreenshot,
  } from '@/scripts/screenshot-beautifier';

  function initBeautifyApp() {
    const container = document.getElementById('beautifyApp');
    if (!container) return;

    let i18n = {
      statusReady: 'Ready',
      statusProcessing: 'Beautifying Screenshot...',
      errorLoad: 'Failed to process screenshot.',
      copySuccess: 'Copied to Clipboard!',
      downloadName: 'imgfeel-beautified',
    };

    try {
      const dataAttr = container.getAttribute('data-i18n');
      if (dataAttr) i18n = JSON.parse(dataAttr);
    } catch {}

    // Elements
    const dropzone = document.getElementById('beautifyDropzone');
    const fileInput = document.getElementById('beautifyFileInput') as HTMLInputElement | null;
    const changeInput = document.getElementById('beautifyChangeInput') as HTMLInputElement | null;
    const sampleBtn = document.getElementById('beautifySampleBtn');
    const loadingCard = document.getElementById('beautifyLoadingCard');
    const workspace = document.getElementById('beautifyWorkspace');
    const resetBtn = document.getElementById('beautifyResetBtn');

    // Header info
    const fileNameEl = document.getElementById('currentFileName');
    const fileDimsEl = document.getElementById('currentFileDims');

    // Canvas
    const mainCanvas = document.getElementById('mainBeautifyCanvas') as HTMLCanvasElement | null;
    const dimsBadge = document.getElementById('beautifyDimsBadge');

    // Controls
    const bgModeBtns = document.querySelectorAll('.bg-mode-btn');
    const gradientGrid = document.getElementById('gradientGrid');
    const solidGrid = document.getElementById('solidGrid');
    const solidChips = document.querySelectorAll('.solid-chip');
    const customColorInput = document.getElementById('beautifyCustomColorInput') as HTMLInputElement | null;
    const customColorDot = document.getElementById('customColorDot');

    const frameBtns = document.querySelectorAll('.frame-btn');
    const ratioBtns = document.querySelectorAll('.ratio-btn');
    const shadowBtns = document.querySelectorAll('.shadow-btn');

    const paddingSlider = document.getElementById('paddingSlider') as HTMLInputElement | null;
    const paddingVal = document.getElementById('paddingVal');
    const radiusSlider = document.getElementById('radiusSlider') as HTMLInputElement | null;
    const radiusVal = document.getElementById('radiusVal');
    const scaleSlider = document.getElementById('scaleSlider') as HTMLInputElement | null;
    const scaleVal = document.getElementById('scaleVal');
    const formatSelect = document.getElementById('beautifyFormatSelect') as HTMLSelectElement | null;

    // Metrics & Buttons
    const metricDims = document.getElementById('metricDims');
    const metricWeight = document.getElementById('metricWeight');
    const copyBtn = document.getElementById('beautifyCopyBtn');
    const copyBtnText = document.getElementById('copyBtnText');
    const downloadBtn = document.getElementById('beautifyDownloadBtn');

    // State
    let loadedImage: HTMLImageElement | null = null;
    let currentFileName = 'screenshot.png';
    let bgType: BgType = 'gradient';
    let gradientId = 'sunset';
    let solidColor = '#0f172a';
    let frameType: FrameType = 'macos-dark';
    let aspectRatio: AspectRatioType = 'auto';
    let shadow: ShadowPreset = 'medium';
    let padding = 48;
    let radius = 16;
    let scale = 100;
    const alignment: AlignmentType = 'center';
    let lastResult: BeautifyResult | null = null;
    let debounceTimer: number | null = null;

    // Render Gradient Chips dynamically
    if (gradientGrid) {
      gradientGrid.innerHTML = '';
      GRADIENT_PRESETS.forEach((preset) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `grad-chip ${preset.id === gradientId ? 'active' : ''}`;
        btn.setAttribute('data-grad-id', preset.id);
        btn.title = preset.name;

        const gradCss = `linear-gradient(${preset.angle}deg, ${preset.colors.join(', ')})`;
        btn.style.background = gradCss;

        btn.addEventListener('click', () => {
          document.querySelectorAll('.grad-chip').forEach((c) => c.classList.remove('active'));
          btn.classList.add('active');
          gradientId = preset.id;
          triggerUpdate();
        });

        gradientGrid.appendChild(btn);
      });
    }

    function renderCanvas() {
      if (!mainCanvas || !loadedImage) return;

      renderBeautifiedCanvas(loadedImage, mainCanvas, {
        bgType,
        gradientId,
        solidColor,
        frameType,
        aspectRatio,
        padding,
        radius,
        shadow,
        scale,
        alignment,
        format: 'image/png',
        quality: 0.95,
      });

      if (dimsBadge) dimsBadge.textContent = `${mainCanvas.width} × ${mainCanvas.height} px`;
    }

    async function processFullExport() {
      if (!loadedImage) return;

      const format = (formatSelect?.value as 'image/jpeg' | 'image/png' | 'image/webp' | 'original') || 'image/png';

      try {
        const result = await exportBeautifiedScreenshot(loadedImage, {
          bgType,
          gradientId,
          solidColor,
          frameType,
          aspectRatio,
          padding,
          radius,
          shadow,
          scale,
          alignment,
          format,
          quality: 0.95,
        });

        lastResult = result;

        if (metricDims) metricDims.textContent = `${result.width} × ${result.height} px`;
        if (metricWeight) metricWeight.textContent = result.fileSizeFormatted;
      } catch (err) {
        console.error('Beautifier export error:', err);
      }
    }

    function triggerUpdate() {
      renderCanvas();
      if (debounceTimer) clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(processFullExport, 80);
    }

    async function handleFile(file: File) {
      if (!dropzone || !loadingCard || !workspace) return;

      dropzone.style.display = 'none';
      workspace.style.display = 'none';
      loadingCard.style.display = 'flex';

      try {
        const img = await loadImageFromFile(file);
        loadedImage = img;
        currentFileName = file.name;

        if (fileNameEl) fileNameEl.textContent = file.name;
        if (fileDimsEl) fileDimsEl.textContent = `${img.naturalWidth} × ${img.naturalHeight} px`;

        renderCanvas();
        await processFullExport();

        loadingCard.style.display = 'none';
        workspace.style.display = 'flex';
      } catch (err) {
        alert(err instanceof Error ? err.message : i18n.errorLoad);
        resetToDropzone();
      }
    }

    function resetToDropzone() {
      loadedImage = null;
      if (fileInput) fileInput.value = '';
      if (changeInput) changeInput.value = '';
      if (loadingCard) loadingCard.style.display = 'none';
      if (workspace) workspace.style.display = 'none';
      if (dropzone) dropzone.style.display = 'block';
    }

    if (resetBtn) resetBtn.addEventListener('click', resetToDropzone);

    // Background Mode Switcher (Gradient, Solid, Transparent)
    bgModeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        bgModeBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        bgType = (btn.getAttribute('data-bg') as BgType) || 'gradient';

        if (gradientGrid) gradientGrid.style.display = bgType === 'gradient' ? 'grid' : 'none';
        if (solidGrid) solidGrid.style.display = bgType === 'solid' ? 'flex' : 'none';

        triggerUpdate();
      });
    });

    // Solid Color Chips
    solidChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        solidChips.forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        solidColor = chip.getAttribute('data-color') || '#0f172a';
        triggerUpdate();
      });
    });

    if (customColorInput) {
      customColorInput.addEventListener('input', () => {
        solidChips.forEach((c) => c.classList.remove('active'));
        solidColor = customColorInput.value;
        if (customColorDot) customColorDot.style.background = solidColor;
        triggerUpdate();
      });
    }

    // Frame Switcher
    frameBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        frameBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        frameType = (btn.getAttribute('data-frame') as FrameType) || 'macos-dark';
        triggerUpdate();
      });
    });

    // Aspect Ratio Switcher
    ratioBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        ratioBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        aspectRatio = (btn.getAttribute('data-ratio') as AspectRatioType) || 'auto';
        triggerUpdate();
      });
    });

    // Shadow Switcher
    shadowBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        shadowBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        shadow = (btn.getAttribute('data-shadow') as ShadowPreset) || 'medium';
        triggerUpdate();
      });
    });

    // Sliders
    if (paddingSlider) {
      paddingSlider.addEventListener('input', () => {
        padding = parseInt(paddingSlider.value, 10);
        if (paddingVal) paddingVal.textContent = `${padding} px`;
        triggerUpdate();
      });
    }

    if (radiusSlider) {
      radiusSlider.addEventListener('input', () => {
        radius = parseInt(radiusSlider.value, 10);
        if (radiusVal) radiusVal.textContent = `${radius} px`;
        triggerUpdate();
      });
    }

    if (scaleSlider) {
      scaleSlider.addEventListener('input', () => {
        scale = parseInt(scaleSlider.value, 10);
        if (scaleVal) scaleVal.textContent = `${scale} %`;
        triggerUpdate();
      });
    }

    // Format select
    if (formatSelect) {
      formatSelect.addEventListener('change', triggerUpdate);
    }

    // Copy to Clipboard
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        if (!loadedImage) return;
        try {
          await copyBeautifiedToClipboard(loadedImage, {
            bgType,
            gradientId,
            solidColor,
            frameType,
            aspectRatio,
            padding,
            radius,
            shadow,
            scale,
            alignment,
            format: 'image/png',
            quality: 0.95,
          });

          if (copyBtnText) copyBtnText.textContent = i18n.copySuccess;
          copyBtn.classList.add('copy-success');
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = t('en', 'beautify.action.copy');
            copyBtn.classList.remove('copy-success');
          }, 2000);
        } catch (err) {
          alert('Could not copy image to clipboard automatically. Please use download instead.');
        }
      });
    }

    // Download Button
    if (downloadBtn) {
      downloadBtn.addEventListener('click', () => {
        if (!lastResult) return;

        let ext = '.png';
        const selFormat = formatSelect?.value || 'image/png';
        if (selFormat === 'image/webp') ext = '.webp';
        else if (selFormat === 'image/jpeg') ext = '.jpg';

        const rawBase = currentFileName.replace(/\.[^/.]+$/, '');
        const filename = `${rawBase}-beautified${ext}`;

        const a = document.createElement('a');
        a.href = lastResult.dataUrl;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      });
    }

    // Sample button
    if (sampleBtn) {
      sampleBtn.addEventListener('click', async () => {
        const sampleFile = await generateSampleScreenshot();
        handleFile(sampleFile);
      });
    }

    // File input changes
    if (fileInput) {
      fileInput.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        if (target.files && target.files[0]) {
          handleFile(target.files[0]);
        }
      });
    }

    if (changeInput) {
      changeInput.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        if (target.files && target.files[0]) {
          handleFile(target.files[0]);
        }
      });
    }

    // Drag and drop on dropzone
    if (dropzone) {
      ['dragenter', 'dragover'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('beautify-drag-active');
        });
      });

      ['dragleave', 'drop'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('beautify-drag-active');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        if (dt && dt.files && dt.files[0]) {
          handleFile(dt.files[0]);
        }
      });
    }

    // Global Paste (Ctrl+V) listener
    window.addEventListener('paste', (e: ClipboardEvent) => {
      const items = e.clipboardData?.items;
      if (!items) return;
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.indexOf('image') !== -1) {
          const file = items[i].getAsFile();
          if (file) {
            handleFile(file);
            break;
          }
        }
      }
    });
  }

  initBeautifyApp();
  document.addEventListener('astro:page-load', initBeautifyApp);
</script>


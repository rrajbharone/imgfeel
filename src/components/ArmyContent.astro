---
/**
 * Indian Army & Agniveer Photo & Signature Resizer SEO Content & FAQ Component
 * Strict compliance with ImgFeel UI/UX Design System Standards
 */

const faqItems = [
  {
    q: 'What are the official photo and signature size limits for Indian Army Agniveer applications?',
    a: 'For online registration on joinindianarmy.nic.in, candidate passport photographs must strictly be between 10 KB and 50 KB in JPG/JPEG format (recommended 350 × 450 pixels). Digital signatures must strictly be between 5 KB and 20 KB in JPG/JPEG format (recommended 350 × 150 pixels), signed with a black or dark blue ink pen on clean white unruled paper.',
  },
  {
    q: 'What background color is required for Indian Army candidate photographs?',
    a: 'The Indian Army strictly requires a plain white or very light-colored background. Photographs taken against colored walls, outdoor landscapes, curtains, or dark backgrounds are rejected by recruitment officers and document scanning software.',
  },
  {
    q: 'How many physical copies of the photograph must I bring to the Army Recruitment Rally?',
    a: 'Official Indian Army notifications mandate that candidates must bring at least 20 copies of identical, un-attested passport-size photographs to the recruitment rally ground. These must be printed on high-quality photographic paper and must match the digital photograph uploaded to joinindianarmy.nic.in.',
  },
  {
    q: 'Can I wear a cap or sunglasses in my Indian Army recruitment photo?',
    a: 'No. Photographs with caps, hats, dark goggles, or tinted spectacles are strictly rejected. Both ears, forehead, and the complete facial contour must be clearly visible. Only Sikh candidates are permitted to wear a turban, provided their face is unobstructed.',
  },
  {
    q: 'Are the photo and signature specifications different for Army GD, Technical, and Clerk?',
    a: 'No. The unified online application module on joinindianarmy.nic.in enforces identical digital upload standards across all Agniveer categories: 10 KB to 50 KB for photographs and 5 KB to 20 KB for signatures in JPG/JPEG format. Selecting your specific category in our tool applies verified parameters tailored to your application category.',
  },
  {
    q: 'Can I sign using CAPITAL / BLOCK letters for Indian Army recruitment?',
    a: 'No. Join Indian Army strictly invalidates signatures written in CAPITAL / BLOCK letters or consisting solely of initials. Your signature must be in your natural running handwriting using black or dark blue ink.',
  },
  {
    q: 'Why does the Join Indian Army portal reject my signature file?',
    a: 'The joinindianarmy.nic.in portal enforces a rigid byte validator with an upper ceiling of 20.0 KB and a lower limit of 5.0 KB. Scanned signatures that compress under 5 KB or exceed 20 KB will trigger an immediate upload error. Our smart resizer automatically calibrates file size so your signature lands safely within 8–15 KB.',
  },
  {
    q: 'Do I need to hold a slate with name and date for the Indian Army photo?',
    a: 'Certain rally notifications advise or mandate holding a black slate in front of the chest with the candidate’s name and date of photograph written clearly in white chalk. Check your specific Zone Recruitment Office (ZRO/ARO) notification PDF to confirm whether a slate photo is required for your rally.',
  },
  {
    q: 'How recent should my Indian Army application photograph be?',
    a: 'The photograph must be recent, taken within the last 3 months prior to the date of online registration. Using outdated photographs or appearing at the rally with a noticeably altered hairstyle, beard, or facial appearance can result in disqualification.',
  },
  {
    q: 'Are my confidential Army application images uploaded to your web server?',
    a: 'Never. ImgFeel performs 100% of image resizing, cropping, contrast adjustments, and compression locally in your browser using HTML5 Canvas APIs. Your personal photographs and signatures are never transmitted over the internet or saved to any server.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Indian Army Photo & Signature Resizer',
  operatingSystem: 'Any',
  applicationCategory: 'MultimediaApplication',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<!-- JSON-LD Structured Data Schemas -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(appSchema)} />


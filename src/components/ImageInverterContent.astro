---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": t(locale, 'inverter.faq.q1'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'inverter.faq.a1')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'inverter.faq.q2'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'inverter.faq.a2')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'inverter.faq.q3'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'inverter.faq.a3')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'inverter.faq.q4'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'inverter.faq.a4')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'inverter.faq.q5'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'inverter.faq.a5')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'inverter.faq.q6'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'inverter.faq.a6')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'inverter.faq.q7'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'inverter.faq.a7')
      }
    }
  ]
};
---

<section class="section content-section">
  <div class="container">
    <div class="content-body">
      <!-- Section 1 -->
      <h2>{t(locale, 'inverter.content.h1')}</h2>
      <p>{t(locale, 'inverter.content.p1a')}</p>
      <p>{t(locale, 'inverter.content.p1b')}</p>

      <div class="feature-cards-grid">
        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3v18"></path>
              <path d="M12 3a9 9 0 0 1 9 9 9 9 0 0 1-9 9"></path>
              <path d="M12 3a9 9 0 0 0-9 9 9 9 0 0 0 9 9" fill="currentColor"></path>
            </svg>
          </div>
          <h3>{t(locale, 'inverter.content.feat1Title')}</h3>
          <p>{t(locale, 'inverter.content.feat1Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="3" x2="12" y2="21"></line>
              <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            </svg>
          </div>
          <h3>{t(locale, 'inverter.content.feat2Title')}</h3>
          <p>{t(locale, 'inverter.content.feat2Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <h3>{t(locale, 'inverter.content.feat3Title')}</h3>
          <p>{t(locale, 'inverter.content.feat3Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3>{t(locale, 'inverter.content.feat4Title')}</h3>
          <p>{t(locale, 'inverter.content.feat4Desc')}</p>
        </div>
      </div>

      <!-- Section 2 -->
      <h2>{t(locale, 'inverter.content.h2')}</h2>
      <p>{t(locale, 'inverter.content.p2a')}</p>
      <p>{t(locale, 'inverter.content.p2b')}</p>

      <!-- Section 3 -->
      <h2>{t(locale, 'inverter.content.h3')}</h2>
      <p>{t(locale, 'inverter.content.p3a')}</p>
      <p>{t(locale, 'inverter.content.p3b')}</p>

      <!-- Section 4: Table -->
      <h2>{t(locale, 'inverter.content.h4')}</h2>
      <p>{t(locale, 'inverter.content.p4a')}</p>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Inversion Mode</th>
              <th>Pixel Calculation</th>
              <th>Color Shift Effect</th>
              <th>Best Use Cases</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Full RGB Negative</strong></td>
              <td>R' = 255-R, G' = 255-G, B' = 255-B</td>
              <td>Full chromatic complement (Red &rarr; Cyan)</td>
              <td>Film negative digitization, surreal art, pop-art</td>
            </tr>
            <tr>
              <td><strong>Luminosity Inversion</strong></td>
              <td>HSL Lightness L' = 1.0 - L (Hue preserved)</td>
              <td>Inverts light/dark without changing color tones</td>
              <td>Dark-mode UI conversion, blueprints, textbook scans</td>
            </tr>
            <tr>
              <td><strong>Grayscale Negative</strong></td>
              <td>Y = ITU-R BT.709, Y' = 255 - Y</td>
              <td>Monochrome negative (Black &rarr; White)</td>
              <td>Medical radiography, X-rays, line art contrast</td>
            </tr>
            <tr>
              <td><strong>Invert Red Channel</strong></td>
              <td>R' = 255 - R, G' = G, B' = B</td>
              <td>Cyan-tinted duotone shift</td>
              <td>Cyberpunk aesthetics, artistic photo filters</td>
            </tr>
            <tr>
              <td><strong>Invert Green Channel</strong></td>
              <td>R' = R, G' = 255 - G, B' = B</td>
              <td>Magenta-tinted duotone shift</td>
              <td>Abstract landscape art, creative grading</td>
            </tr>
            <tr>
              <td><strong>Invert Blue Channel</strong></td>
              <td>R' = R, G' = G, B' = 255 - B</td>
              <td>Yellow/amber-tinted warm shift</td>
              <td>Golden hour simulation, vintage stylized visuals</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 5 -->
      <h2>{t(locale, 'inverter.content.h5')}</h2>
      <p>{t(locale, 'inverter.content.p5a')}</p>
      <p>{t(locale, 'inverter.content.p5b')}</p>

      <!-- Section 6 -->
      <h2>{t(locale, 'inverter.content.h6')}</h2>
      <p>{t(locale, 'inverter.content.p6a')}</p>
      <p>{t(locale, 'inverter.content.p6b')}</p>

      <!-- Section 7: Native OS Guides -->
      <h2>{t(locale, 'inverter.content.h7')}</h2>
      <p>{t(locale, 'inverter.content.p7Intro')}</p>
      <ul>
        <li><strong>iPhone / iPad (iOS):</strong> Go to <strong>Settings &rarr; Accessibility &rarr; Display &amp; Text Size</strong> &rarr; enable <strong>Smart Invert</strong> (inverts interface colors while preserving media) or <strong>Classic Invert</strong> (inverts every pixel). You can also set a triple-click side button shortcut.</li>
        <li><strong>Android:</strong> Swipe down the notification shade &rarr; tap the <strong>Color Inversion</strong> quick settings tile. Alternatively, go to <strong>Settings &rarr; Accessibility &rarr; Text and display &rarr; Color inversion</strong>.</li>
        <li><strong>Mac (macOS):</strong> Press <code>Option + Command + F5</code> to bring up Accessibility Shortcuts &rarr; check <strong>Invert Colors</strong>. Or navigate to <strong>System Settings &rarr; Accessibility &rarr; Display &rarr; Invert colors</strong>.</li>
        <li><strong>Windows 10 / 11:</strong> Press <code>Win + Ctrl + I</code> to toggle Color Inversion filters immediately. Alternatively, open <strong>Settings &rarr; Accessibility &rarr; Color filters</strong> &rarr; toggle on and select <strong>Inverted</strong>, or open the image in MS Paint and press <code>Ctrl + Shift + I</code>.</li>
      </ul>

      <!-- Section 8: FAQ -->
      <div class="faq-container">
        <h2>{t(locale, 'inverter.faq.heading')}</h2>
        
        <div class="faq-accordion">
          <details class="faq-item" open>
            <summary class="faq-question"><h3>{t(locale, 'inverter.faq.q1')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'inverter.faq.a1')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'inverter.faq.q2')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'inverter.faq.a2')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'inverter.faq.q3')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'inverter.faq.a3')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'inverter.faq.q4')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'inverter.faq.a4')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'inverter.faq.q5')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'inverter.faq.a5')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'inverter.faq.q6')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'inverter.faq.a6')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'inverter.faq.q7')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'inverter.faq.a7')}</p></div>
          </details>
        </div>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .content-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-12) 0;
  }

  .content-body {
    max-width: var(--container-narrow);
    margin-inline: auto;
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.75;
  }

  .content-body h2 {
    color: var(--color-text);
    font-size: var(--text-2xl);
    font-weight: 800;
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .content-body h2:first-child {
    margin-top: 0;
  }

  .content-body p {
    margin-bottom: var(--space-4);
  }

  .content-body ul {
    margin-bottom: var(--space-6);
    padding-left: var(--space-5);
  }

  .content-body li {
    margin-bottom: var(--space-2-5);
  }

  .content-body strong {
    color: var(--color-text);
  }

  .feature-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin: var(--space-6) 0 var(--space-8) 0;
  }

  @media (min-width: 640px) {
    .feature-cards-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .feature-card {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .feature-card-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-card h3 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .feature-card p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .table-responsive {
    overflow-x: auto;
    margin: var(--space-6) 0 var(--space-8) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .data-table th,
  .data-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  .data-table th {
    background: var(--color-surface-subtle);
    font-weight: 700;
    color: var(--color-text);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  /* FAQ */
  .faq-container {
    margin-top: var(--space-12);
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
    overflow: hidden;
  }

  .faq-question {
    padding: var(--space-4);
    cursor: pointer;
    font-weight: 600;
    user-select: none;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question h3 {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: 700;
  }

  .faq-answer {
    padding: 0 var(--space-4) var(--space-4) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .faq-answer p {
    margin: 0;
  }
</style>

---
import { t } from '@/i18n/utils';
import SEOHead from './SEOHead.astro';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const faqs = [
  { qKey: 'datauri.faq.q1', aKey: 'datauri.faq.a1' },
  { qKey: 'datauri.faq.q2', aKey: 'datauri.faq.a2' },
  { qKey: 'datauri.faq.q3', aKey: 'datauri.faq.a3' },
  { qKey: 'datauri.faq.q4', aKey: 'datauri.faq.a4' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: t(locale, faq.qKey),
    acceptedAnswer: {
      '@type': 'Answer',
      text: t(locale, faq.aKey),
    },
  })),
};
---

<article class="tool-content">
  <div class="container content-inner">
    <h2>{t(locale, 'datauri.content.heading1')}</h2>
    <p>{t(locale, 'datauri.content.p1')}</p>

    <h2>{t(locale, 'datauri.content.heading2')}</h2>
    <p>{t(locale, 'datauri.content.p2')}</p>
    <div class="code-example">
      <code>{t(locale, 'datauri.content.syntax1')}</code>
    </div>
    <p>{t(locale, 'datauri.content.p3')}</p>

    <h2>{t(locale, 'datauri.content.heading3')}</h2>
    <p>{t(locale, 'datauri.content.p4')}</p>

    <h2>{t(locale, 'datauri.content.heading4')}</h2>
    <p>{t(locale, 'datauri.content.p5')}</p>
    <ul class="req-list">
      <li>{t(locale, 'datauri.content.advantage1')}</li>
      <li>{t(locale, 'datauri.content.advantage2')}</li>
      <li>{t(locale, 'datauri.content.advantage3')}</li>
      <li>{t(locale, 'datauri.content.advantage4')}</li>
    </ul>

    <h2>{t(locale, 'datauri.content.heading5')}</h2>
    <p>{t(locale, 'datauri.content.p6')}</p>
    <ul class="code-snippets">
      <li><code>{t(locale, 'datauri.content.codeHtml')}</code></li>
      <li><code>{t(locale, 'datauri.content.codeCss')}</code></li>
    </ul>

    <h2>{t(locale, 'datauri.content.heading6')}</h2>
    <p>{t(locale, 'datauri.content.p7')}</p>
    <ol class="step-list">
      <li>{t(locale, 'datauri.content.step1')}</li>
      <li>{t(locale, 'datauri.content.step2')}</li>
      <li>{t(locale, 'datauri.content.step3')}</li>
      <li>{t(locale, 'datauri.content.step4')}</li>
      <li>{t(locale, 'datauri.content.step5')}</li>
    </ol>

    <h2>{t(locale, 'datauri.content.heading7')}</h2>
    <p>{t(locale, 'datauri.content.p8')}</p>

    <!-- FAQ Section -->
    <section class="content-faq">
      <h2>{t(locale, 'home.faq.title')}</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{t(locale, faq.qKey)}</summary>
            <p class="faq-answer">{t(locale, faq.aKey)}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
  <SEOHead schema={faqSchema} />
</article>

<style>
  .tool-content {
    padding-block: var(--space-12);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-12);
  }
  .content-inner {
    width: 100%;
    max-width: var(--container-narrow);
    margin-inline: auto;
    box-sizing: border-box;
  }
  .tool-content h2 {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    word-break: break-word;
    overflow-wrap: break-word;
  }
  .tool-content p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-4);
    word-break: break-word;
    overflow-wrap: break-word;
  }
  .code-example {
    background: #1e1e1e;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-4);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }
  .code-example code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: var(--text-xs);
    color: #ce9178;
    word-break: break-all;
    overflow-wrap: break-word;
    white-space: pre-wrap;
    display: block;
    max-width: 100%;
  }
  .code-snippets {
    list-style: none;
    padding-left: 0;
    margin-bottom: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }
  .code-snippets li {
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }
  .code-snippets code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: var(--text-xs);
    background: var(--color-surface);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: block;
    word-break: break-all;
    overflow-wrap: break-word;
    white-space: pre-wrap;
    max-width: 100%;
    box-sizing: border-box;
  }
  .req-list,
  .step-list {
    padding-left: var(--space-5);
    margin-bottom: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }
  .req-list li,
  .step-list li {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .content-faq {
    margin-top: var(--space-10);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    max-width: 100%;
  }
  .faq-item {
    border-bottom: 1px solid var(--color-border);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }
  .faq-question {
    padding: var(--space-4) 0;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    word-break: break-word;
  }
  .faq-answer {
    padding-bottom: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    word-break: break-word;
  }
</style>

---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';
import type { SearchableTool } from '@/data/tools';

interface Props {
  locale: Locale;
  searchableTools: SearchableTool[];
}

const { locale, searchableTools } = Astro.props;
---

<div class="tool-search-wrapper">
  <div class="search-field">
    <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input
      type="search"
      id="tool-search-input"
      class="search-input"
      placeholder={t(locale, 'search.placeholder')}
      autocomplete="off"
      aria-label={t(locale, 'search.placeholder')}
    />
    <button type="button" id="tool-search-clear" class="clear-btn" aria-label={t(locale, 'search.clear')} hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Empty State when no tools match query -->
  <div id="no-search-results" class="no-results-card" hidden>
    <div class="no-results-icon">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        <line x1="8" y1="11" x2="14" y2="11"></line>
      </svg>
    </div>
    <p class="no-results-text">{t(locale, 'search.noResults')}</p>
  </div>
</div>

<!-- Embedded JSON dataset directly from single source of truth registry -->
<script id="searchable-tools-data" type="application/json" is:raw set:html={JSON.stringify(searchableTools)} />

<script>
  function initToolSearch() {
    const input = document.getElementById('tool-search-input') as HTMLInputElement;
    const clearBtn = document.getElementById('tool-search-clear') as HTMLButtonElement;
    const noResults = document.getElementById('no-search-results') as HTMLElement;
    const dataScript = document.getElementById('searchable-tools-data');

    if (!input || !dataScript) return;

    let toolsData: Array<{
      id: string;
      title: string;
      description: string;
      href: string;
      keywords: string[];
    }> = [];

    try {
      toolsData = JSON.parse(dataScript.textContent || '[]');
    } catch (e) {
      toolsData = [];
    }

    function filterTools() {
      const query = input.value.trim().toLowerCase();
      if (clearBtn) clearBtn.hidden = query.length === 0;

      const toolCards = document.querySelectorAll<HTMLElement>('.tools-grid [data-tool-id]');
      let matchCount = 0;

      if (!query) {
        toolCards.forEach((card) => (card.style.display = ''));
        if (noResults) noResults.hidden = true;
        return;
      }

      // Filter against single source of truth tool data
      const matchingIds = new Set<string>();

      toolsData.forEach((tool) => {
        const titleMatch = tool.title.toLowerCase().includes(query);
        const descMatch = tool.description.toLowerCase().includes(query);
        const kwMatch = tool.keywords.some((kw) => kw.toLowerCase().includes(query));

        if (titleMatch || descMatch || kwMatch) {
          matchingIds.add(tool.id);
        }
      });

      toolCards.forEach((card) => {
        const id = card.dataset.toolId;
        if (id && matchingIds.has(id)) {
          card.style.display = '';
          matchCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.hidden = matchCount > 0;
      }
    }

    input.addEventListener('input', filterTools);

    clearBtn?.addEventListener('click', () => {
      input.value = '';
      filterTools();
      input.focus();
    });

    // Keyboard ESC shortcut
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        input.value = '';
        filterTools();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initToolSearch);
  } else {
    initToolSearch();
  }
</script>

<style>
  .tool-search-wrapper {
    width: 100%;
    max-width: 580px;
    margin-bottom: var(--space-8);
  }

  .search-field {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-secondary);
    pointer-events: none;
    z-index: 2;
    transition: color .15s;
  }

  .search-input {
    width: 100%;
    height: 50px;
    padding: 0 46px 0 48px;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    transition: border-color .15s, box-shadow .15s, background-color .15s;
  }

  .search-input::placeholder {
    color: var(--color-text-secondary);
    opacity: 0.8;
  }

  .search-input:hover {
    border-color: var(--color-text-muted);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-light);
    background: var(--color-bg);
  }

  .search-field:focus-within .search-icon {
    color: var(--color-accent);
  }

  /* Hide default webkit clear button */
  .search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .clear-btn {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 28px;
    height: 28px;
    border: none;
    background: transparent;
    color: var(--color-text-secondary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: background-color .15s, color .15s;
  }

  .clear-btn:hover {
    background: var(--color-border);
    color: var(--color-text);
  }

  .no-results-card {
    text-align: center;
    padding: var(--space-8) var(--space-4);
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    margin-top: var(--space-4);
  }

  .no-results-icon {
    display: flex;
    justify-content: center;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .no-results-text {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
  }
</style>

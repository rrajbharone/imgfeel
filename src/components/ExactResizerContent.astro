---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const faqItems = [
  { q: t(locale, 'exactresizer.faq.q1'), a: t(locale, 'exactresizer.faq.a1') },
  { q: t(locale, 'exactresizer.faq.q2'), a: t(locale, 'exactresizer.faq.a2') },
  { q: t(locale, 'exactresizer.faq.q3'), a: t(locale, 'exactresizer.faq.a3') },
  { q: t(locale, 'exactresizer.faq.q4'), a: t(locale, 'exactresizer.faq.a4') },
  { q: t(locale, 'exactresizer.faq.q5'), a: t(locale, 'exactresizer.faq.a5') },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="section content-section">
  <div class="container">
    <div class="content-body">
      <!-- Section 1 -->
      <h2>{t(locale, 'exactresizer.content.heading1')}</h2>
      <p>{t(locale, 'exactresizer.content.p1')}</p>
      <p>{t(locale, 'exactresizer.content.p1b')}</p>

      <!-- Section 2 -->
      <h2>{t(locale, 'exactresizer.content.heading2')}</h2>
      <p>{t(locale, 'exactresizer.content.p2')}</p>
      <div class="benefits-grid">
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <p>{t(locale, 'exactresizer.content.benefit1')}</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <p>{t(locale, 'exactresizer.content.benefit2')}</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <p>{t(locale, 'exactresizer.content.benefit3')}</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
              <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
              <line x1="6" y1="6" x2="6.01" y2="6"></line>
              <line x1="6" y1="18" x2="6.01" y2="18"></line>
            </svg>
          </div>
          <p>{t(locale, 'exactresizer.content.benefit4')}</p>
        </div>
      </div>

      <!-- Section 3 -->
      <h2>{t(locale, 'exactresizer.content.heading3')}</h2>
      <p>{t(locale, 'exactresizer.content.p3')}</p>
      
      <div class="modes-explanation">
        <div class="mode-item">
          <h3>{t(locale, 'exactresizer.content.mode1Title')}</h3>
          <p>{t(locale, 'exactresizer.content.mode1Desc')}</p>
        </div>
        <div class="mode-item">
          <h3>{t(locale, 'exactresizer.content.mode2Title')}</h3>
          <p>{t(locale, 'exactresizer.content.mode2Desc')}</p>
        </div>
        <div class="mode-item">
          <h3>{t(locale, 'exactresizer.content.mode3Title')}</h3>
          <p>{t(locale, 'exactresizer.content.mode3Desc')}</p>
        </div>
      </div>

      <!-- Section 4 -->
      <h2>{t(locale, 'exactresizer.content.heading4')}</h2>
      <p>{t(locale, 'exactresizer.content.p4')}</p>
      <ul class="dimension-list">
        <li><strong>{t(locale, 'exactresizer.content.dim1')}</strong></li>
        <li><strong>{t(locale, 'exactresizer.content.dim2')}</strong></li>
        <li><strong>{t(locale, 'exactresizer.content.dim3')}</strong></li>
        <li><strong>{t(locale, 'exactresizer.content.dim4')}</strong></li>
        <li><strong>{t(locale, 'exactresizer.content.dim5')}</strong></li>
        <li><strong>{t(locale, 'exactresizer.content.dim6')}</strong></li>
        <li><strong>{t(locale, 'exactresizer.content.dim7')}</strong></li>
      </ul>

      <!-- Section 5 -->
      <h2>{t(locale, 'exactresizer.content.heading5')}</h2>
      <p>{t(locale, 'exactresizer.content.p5')}</p>
      <div class="steps-container">
        <div class="step-card">
          <span class="step-num">1</span>
          <p>{t(locale, 'exactresizer.content.step1')}</p>
        </div>
        <div class="step-card">
          <span class="step-num">2</span>
          <p>{t(locale, 'exactresizer.content.step2')}</p>
        </div>
        <div class="step-card">
          <span class="step-num">3</span>
          <p>{t(locale, 'exactresizer.content.step3')}</p>
        </div>
        <div class="step-card">
          <span class="step-num">4</span>
          <p>{t(locale, 'exactresizer.content.step4')}</p>
        </div>
      </div>

      <!-- Section 6 -->
      <h2>{t(locale, 'exactresizer.content.heading6')}</h2>
      <p>{t(locale, 'exactresizer.content.p6')}</p>

      <!-- Section 7 -->
      <h2>{t(locale, 'exactresizer.content.heading7')}</h2>
      <p>{t(locale, 'exactresizer.content.p7')}</p>

      <!-- FAQ Section -->
      <h2 class="faq-heading">Frequently Asked Questions</h2>
      <div class="faq-list">
        {faqItems.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">
              <span>{faq.q}</span>
              <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .content-section {
    padding-block: var(--space-12);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .content-body {
    max-width: var(--container-narrow);
    margin-inline: auto;
  }

  .content-body h2 {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    letter-spacing: -0.01em;
  }

  .content-body h2:first-child {
    margin-top: 0;
  }

  .content-body p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-block: var(--space-6);
  }

  @media (min-width: 640px) {
    .benefits-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .benefit-card {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .benefit-card p {
    font-size: var(--text-sm);
    color: var(--color-text);
    margin: 0;
    line-height: 1.55;
  }

  .benefit-icon {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .modes-explanation {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-block: var(--space-5);
  }

  .mode-item {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
  }

  .mode-item h3 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 var(--space-1-5) 0;
  }

  .mode-item p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  .dimension-list {
    list-style: none;
    padding: 0;
    margin-block: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .dimension-list li {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .steps-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-block: var(--space-6);
  }

  .step-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
  }

  .step-num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #ffffff;
    font-size: var(--text-xs);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .step-card p {
    font-size: var(--text-sm);
    color: var(--color-text);
    margin: 0;
    line-height: 1.55;
  }

  .faq-heading {
    margin-top: var(--space-10) !important;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    color: var(--color-text-muted);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 var(--space-5) var(--space-4);
  }

  .faq-answer p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
  }
</style>

---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';
import { getToolUrl } from '@/data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const squareUrl = getToolUrl('resize-image-to-1-1', locale);
const ratioUrl = getToolUrl('image-aspect-ratio-checker', locale);
const webpUrl = getToolUrl('webp-compressor', locale);
const exactUrl = getToolUrl('exact-dimension-resizer', locale);

const i18nDict = {
  statusReady: t(locale, 'circlecrop.status.ready'),
  statusProcessing: t(locale, 'circlecrop.status.processing'),
  errorLoad: t(locale, 'circlecrop.error.load'),
  matchLargerSide: t(locale, 'circlecrop.preset.matchLarger'),
  downloadName: t(locale, 'circlecrop.download.filename'),
};
---

<div class="circle-tool-wrapper" id="circleCropperApp" data-i18n={JSON.stringify(i18nDict)}>
  <!-- Dropzone / Upload State -->
  <div class="circle-dropzone-card" id="circleDropzone">
    <div class="circle-dropzone-content">
      <div class="circle-icon-circle">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 3v18"></path>
          <path d="M3 12h18"></path>
        </svg>
      </div>

      <h2 class="circle-drop-title">{t(locale, 'circlecrop.dropzone.title')}</h2>
      <p class="circle-drop-subtitle">{t(locale, 'circlecrop.dropzone.subtitle')}</p>

      <div class="circle-btn-row">
        <label class="btn btn-primary circle-btn-primary" for="circleFileInput">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'circlecrop.dropzone.browse')}</span>
        </label>
        <input type="file" id="circleFileInput" accept="image/*,.jpg,.jpeg,.png,.webp,.avif,.bmp" class="sr-only" />

        <button type="button" class="btn btn-secondary circle-sample-btn" id="circleSampleBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="7" r="4"></circle>
            <path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"></path>
          </svg>
          <span>{t(locale, 'circlecrop.dropzone.sample')}</span>
        </button>
      </div>

      <p class="circle-formats-hint">{t(locale, 'circlecrop.dropzone.formats')}</p>

      <div class="circle-privacy-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span>{t(locale, 'circlecrop.privacy.badge')}</span>
      </div>
    </div>
  </div>

  <!-- Loading State -->
  <div class="circle-loading-card" id="circleLoadingCard" style="display: none;">
    <div class="circle-spinner"></div>
    <p class="circle-loading-text">{t(locale, 'circlecrop.status.processing')}</p>
  </div>

  <!-- Main Interactive Cropper Workspace -->
  <div class="circle-workspace" id="circleWorkspace" style="display: none;">
    <!-- Top Meta & Action Bar -->
    <div class="circle-workspace-header">
      <div class="circle-meta-badge">
        <span class="circle-status-dot"></span>
        <span id="circleFileName" class="circle-filename-label">avatar.jpg</span>
        <span class="circle-meta-tag" id="circleOriginalDimsTag">800 × 1000 px</span>
        <span class="circle-meta-tag" id="circleOriginalSizeTag">450 KB</span>
      </div>

      <div class="circle-header-actions">
        <button type="button" class="btn btn-secondary btn-sm" id="circleChangeImageBtn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'circlecrop.action.changeImage')}</span>
        </button>
      </div>
    </div>

    <!-- 2-Column Grid: Visual Cropper Viewport on Left, Settings on Right -->
    <div class="circle-main-grid">
      <!-- Left Column: Interactive Visual Viewport -->
      <div class="circle-viewport-card">
        <div class="viewport-canvas-container" id="circleViewportContainer">
          <canvas id="circleViewportCanvas" width="400" height="400" class="viewport-canvas"></canvas>
          <div class="viewport-overlay-hint">{t(locale, 'circlecrop.viewport.dragHint')}</div>
        </div>

        <!-- Viewport Toolbar (Zoom, Rotate, Flip, Reset) -->
        <div class="circle-toolbar">
          <div class="toolbar-zoom-row">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
            <input type="range" id="circleZoomSlider" min="100" max="300" value="100" step="1" class="circle-slider" aria-label="Zoom" />
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
            <span id="circleZoomVal" class="zoom-val-text">1.0×</span>
          </div>

          <div class="toolbar-btns-row">
            <button type="button" class="btn btn-secondary toolbar-btn" id="circleRotateBtn" title="Rotate 90° Clockwise">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
              </svg>
              <span>{t(locale, 'circlecrop.toolbar.rotate')}</span>
            </button>

            <button type="button" class="btn btn-secondary toolbar-btn" id="circleFlipBtn" title="Flip Horizontal">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m3 7 5 5-5 5V7z"></path>
                <path d="m21 7-5 5 5 5V7z"></path>
                <line x1="12" y1="20" x2="12" y2="4"></line>
              </svg>
              <span>{t(locale, 'circlecrop.toolbar.flip')}</span>
            </button>

            <button type="button" class="btn btn-secondary toolbar-btn" id="circleResetBtn" title="Reset Positioning">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                <path d="M3 3v5h5"></path>
              </svg>
              <span>{t(locale, 'circlecrop.toolbar.reset')}</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Right Column: Settings, Preview & Download -->
      <div class="circle-settings-panel">
        <!-- Section 1: Target Resolution Presets -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'circlecrop.size.label')}</label>
          <div class="circle-presets-grid">
            <button type="button" class="circle-preset-btn active" data-size="500">
              <strong>500 × 500 px</strong>
              <span>{t(locale, 'circlecrop.preset.avatar')}</span>
            </button>
            <button type="button" class="circle-preset-btn" data-size="512">
              <strong>512 × 512 px</strong>
              <span>{t(locale, 'circlecrop.preset.discord')}</span>
            </button>
            <button type="button" class="circle-preset-btn" data-size="800">
              <strong>800 × 800 px</strong>
              <span>{t(locale, 'circlecrop.preset.youtube')}</span>
            </button>
            <button type="button" class="circle-preset-btn" data-size="1080">
              <strong>1080 × 1080 px</strong>
              <span>{t(locale, 'circlecrop.preset.instagram')}</span>
            </button>
            <button type="button" class="circle-preset-btn" id="circlePresetMatchMaxBtn" data-size="max">
              <strong id="circlePresetMatchMaxVal">Original Max</strong>
              <span>{t(locale, 'circlecrop.preset.matchLarger')}</span>
            </button>
            <button type="button" class="circle-preset-btn" data-size="custom" id="circlePresetCustomBtn">
              <strong>{t(locale, 'circlecrop.preset.custom')}</strong>
              <span>{t(locale, 'circlecrop.preset.customDesc')}</span>
            </button>
          </div>

          <!-- Custom px input row -->
          <div class="circle-custom-input-row" id="circleCustomInputRow" style="display: none;">
            <label for="circleCustomSizeInput" class="custom-label">{t(locale, 'circlecrop.size.customInput')}:</label>
            <div class="custom-input-wrap">
              <input type="number" id="circleCustomSizeInput" value="600" min="16" max="8000" step="1" class="custom-num-input" />
              <span class="custom-unit">px</span>
            </div>
          </div>
        </div>

        <!-- Section 2: Decorative Ring Border -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'circlecrop.border.label')}</label>
          <div class="border-toggle-row">
            <label class="border-radio-label">
              <input type="radio" name="circleBorderToggle" value="0" checked />
              <span>{t(locale, 'circlecrop.border.none')}</span>
            </label>
            <label class="border-radio-label">
              <input type="radio" name="circleBorderToggle" value="1" />
              <span>{t(locale, 'circlecrop.border.solid')}</span>
            </label>
          </div>

          <div class="border-options-box" id="circleBorderOptionsBox" style="display: none;">
            <div class="border-width-row">
              <span class="sub-label">{t(locale, 'circlecrop.border.thickness')}: <strong id="circleBorderWidthVal">4px</strong></span>
              <input type="range" id="circleBorderWidthSlider" min="1" max="20" value="4" step="1" class="circle-slider" />
            </div>

            <div class="border-color-row">
              <input type="color" id="circleBorderColorInput" value="#ffffff" class="color-input-square" title="Border color" />
              <div class="border-swatches">
                <button type="button" class="swatch-ring-btn active" data-color="#ffffff" style="background:#ffffff;" title="White"></button>
                <button type="button" class="swatch-ring-btn" data-color="#000000" style="background:#000000;" title="Black"></button>
                <button type="button" class="swatch-ring-btn" data-color="#3b82f6" style="background:#3b82f6;" title="Blue"></button>
                <button type="button" class="swatch-ring-btn" data-color="#10b981" style="background:#10b981;" title="Emerald"></button>
              </div>
            </div>
          </div>
        </div>

        <!-- Section 3: Format & Quality -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'circlecrop.format.label')}</label>
          <select id="circleFormatSelect" class="circle-select">
            <option value="image/png" selected>PNG (Transparent Alpha Cutout)</option>
            <option value="image/webp">WebP (Transparent &amp; Compressed)</option>
            <option value="image/jpeg">JPG (White Solid Background)</option>
          </select>
        </div>

        <!-- Section 4: Live Output Preview Card -->
        <div class="output-preview-card">
          <div class="output-thumb-wrap">
            <img id="circleOutputImg" src="" alt="Circle cropped preview" class="output-thumb-img" />
          </div>
          <div class="output-meta-text">
            <span class="meta-line"><strong>{t(locale, 'circlecrop.metrics.outputSize')}:</strong> <span id="circleMetricDims">500 × 500 px</span></span>
            <span class="meta-line"><strong>{t(locale, 'circlecrop.metrics.fileWeight')}:</strong> <span id="circleMetricWeight">-- KB</span></span>
            <span class="meta-line"><strong>{t(locale, 'circlecrop.metrics.transparency')}:</strong> <span id="circleMetricAlpha">{t(locale, 'circlecrop.metrics.alphaTransparent')}</span></span>
          </div>
        </div>

        <!-- Single-Click Download Action -->
        <button type="button" class="btn btn-primary circle-download-btn" id="circleDownloadBtn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>{t(locale, 'circlecrop.action.download')}</span>
        </button>
      </div>
    </div>

    <!-- Quick Action Tool Recommendations -->
    <div class="circle-cross-links-row">
      <a href={squareUrl} class="btn btn-secondary circle-cross-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        </svg>
        <span>{t(locale, 'circlecrop.cross.square')}</span>
      </a>

      <a href={ratioUrl} class="btn btn-secondary circle-cross-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2v14a2 2 0 0 0 2 2h14"></path>
          <path d="M18 22V8a2 2 0 0 0-2-2H2"></path>
        </svg>
        <span>{t(locale, 'circlecrop.cross.ratio')}</span>
      </a>

      <a href={webpUrl} class="btn btn-secondary circle-cross-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <span>{t(locale, 'circlecrop.cross.compress')}</span>
      </a>

      <a href={exactUrl} class="btn btn-secondary circle-cross-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 3 21 3 21 9"></polyline>
          <polyline points="9 21 3 21 3 15"></polyline>
          <line x1="21" y1="3" x2="14" y2="10"></line>
          <line x1="3" y1="21" x2="10" y2="14"></line>
        </svg>
        <span>{t(locale, 'circlecrop.cross.exact')}</span>
      </a>
    </div>
  </div>
</div>

<script>
  import {
    cropImageToCircle,
    generateSamplePortrait,
    loadImage,
    type CircleCropResult,
  } from '@/scripts/circle-cropper';

  function initCircleCropper() {
    const container = document.getElementById('circleCropperApp');
    if (!container) return;

    let i18n = {
      statusReady: 'Ready',
      statusProcessing: 'Processing Circular Cutout...',
      errorLoad: 'Failed to process image file',
      matchLargerSide: 'Match Larger Side',
      downloadName: 'image-circle-cropped',
    };

    try {
      const dataAttr = container.getAttribute('data-i18n');
      if (dataAttr) i18n = JSON.parse(dataAttr);
    } catch {}

    // Elements
    const dropzone = document.getElementById('circleDropzone');
    const fileInput = document.getElementById('circleFileInput') as HTMLInputElement | null;
    const sampleBtn = document.getElementById('circleSampleBtn');
    const loadingCard = document.getElementById('circleLoadingCard');
    const workspace = document.getElementById('circleWorkspace');

    // Header
    const fileNameEl = document.getElementById('circleFileName');
    const origDimsTag = document.getElementById('circleOriginalDimsTag');
    const origSizeTag = document.getElementById('circleOriginalSizeTag');
    const changeImageBtn = document.getElementById('circleChangeImageBtn');

    // Viewport
    const viewportContainer = document.getElementById('circleViewportContainer');
    const viewportCanvas = document.getElementById('circleViewportCanvas') as HTMLCanvasElement | null;
    const zoomSlider = document.getElementById('circleZoomSlider') as HTMLInputElement | null;
    const zoomValEl = document.getElementById('circleZoomVal');
    const rotateBtn = document.getElementById('circleRotateBtn');
    const flipBtn = document.getElementById('circleFlipBtn');
    const resetBtn = document.getElementById('circleResetBtn');

    // Presets
    const presetBtns = document.querySelectorAll('.circle-preset-btn');
    const presetMatchMaxVal = document.getElementById('circlePresetMatchMaxVal');
    const customInputRow = document.getElementById('circleCustomInputRow');
    const customSizeInput = document.getElementById('circleCustomSizeInput') as HTMLInputElement | null;

    // Border options
    const borderRadios = document.querySelectorAll('input[name="circleBorderToggle"]');
    const borderOptionsBox = document.getElementById('circleBorderOptionsBox');
    const borderWidthSlider = document.getElementById('circleBorderWidthSlider') as HTMLInputElement | null;
    const borderWidthVal = document.getElementById('circleBorderWidthVal');
    const borderColorInput = document.getElementById('circleBorderColorInput') as HTMLInputElement | null;
    const swatchRingBtns = document.querySelectorAll('.swatch-ring-btn');

    // Format & Preview
    const formatSelect = document.getElementById('circleFormatSelect') as HTMLSelectElement | null;
    const outputImg = document.getElementById('circleOutputImg') as HTMLImageElement | null;
    const metricDims = document.getElementById('circleMetricDims');
    const metricWeight = document.getElementById('circleMetricWeight');
    const downloadBtn = document.getElementById('circleDownloadBtn');

    // State
    let currentFile: File | null = null;
    let loadedImageObj: HTMLImageElement | null = null;
    let originalWidth = 0;
    let originalHeight = 0;

    let panX = 0;
    let panY = 0;
    let zoom = 1.0;
    let rotation = 0; // 0, 90, 180, 270
    let flipH = false;
    let activeSizeSetting: string | number = 500;
    let hasBorder = false;
    let borderWidth = 4;
    let borderColor = '#ffffff';

    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let initialPanX = 0;
    let initialPanY = 0;

    let lastResult: CircleCropResult | null = null;
    let renderDebounceTimer: number | null = null;

    function getTargetSize(): number {
      if (activeSizeSetting === 'max') {
        return Math.max(originalWidth, originalHeight) || 500;
      }
      if (activeSizeSetting === 'custom') {
        return customSizeInput ? parseInt(customSizeInput.value, 10) || 500 : 500;
      }
      return typeof activeSizeSetting === 'number' ? activeSizeSetting : 500;
    }

    /**
     * Draws the interactive viewport canvas (dimmed outer area, crosshairs, and live transformed image).
     */
    function drawViewport() {
      if (!viewportCanvas || !loadedImageObj) return;
      const ctx = viewportCanvas.getContext('2d');
      if (!ctx) return;

      const vW = viewportCanvas.width;
      const vH = viewportCanvas.height;
      const center = vW / 2;
      const radius = vW / 2 - 10; // 10px margin

      ctx.clearRect(0, 0, vW, vH);

      // Base cover scale
      const baseScale = Math.max((radius * 2) / originalWidth, (radius * 2) / originalHeight);
      const totalScale = baseScale * zoom;
      const drawW = originalWidth * totalScale;
      const drawH = originalHeight * totalScale;

      // 1. Draw base image with transformations
      ctx.save();
      ctx.translate(center + panX, center + panY);
      ctx.rotate((rotation * Math.PI) / 180);
      if (flipH) ctx.scale(-1, 1);
      ctx.drawImage(loadedImageObj, -drawW / 2, -drawH / 2, drawW, drawH);
      ctx.restore();

      // 2. Dim outer mask outside circle
      ctx.save();
      ctx.fillStyle = 'rgba(15, 23, 42, 0.65)';
      ctx.beginPath();
      ctx.rect(0, 0, vW, vH);
      ctx.arc(center, center, radius, 0, Math.PI * 2, true);
      ctx.fill();
      ctx.restore();

      // 3. Circular crop guide border
      ctx.save();
      ctx.strokeStyle = hasBorder ? borderColor : 'rgba(255, 255, 255, 0.9)';
      ctx.lineWidth = hasBorder ? Math.max(2, borderWidth) : 2;
      if (!hasBorder) ctx.setLineDash([6, 6]);
      ctx.beginPath();
      ctx.arc(center, center, radius, 0, Math.PI * 2);
      ctx.stroke();
      ctx.restore();

      // 4. Subtle center crosshair guide
      ctx.save();
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.35)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(center - 12, center);
      ctx.lineTo(center + 12, center);
      ctx.moveTo(center, center - 12);
      ctx.lineTo(center, center + 12);
      ctx.stroke();
      ctx.restore();
    }

    async function processCrop() {
      if (!currentFile) return;

      const targetSize = getTargetSize();
      const format = (formatSelect?.value as 'image/png' | 'image/webp' | 'image/jpeg') || 'image/png';

      try {
        const result = await cropImageToCircle(currentFile, {
          panX,
          panY,
          zoom,
          rotation,
          flipH,
          targetSize,
          borderWidth: hasBorder ? borderWidth : 0,
          borderColor,
          format,
          quality: 0.92,
        });

        lastResult = result;

        if (outputImg) outputImg.src = result.dataUrl;
        if (metricDims) metricDims.textContent = `${result.width} × ${result.height} px`;
        if (metricWeight) metricWeight.textContent = result.fileSizeFormatted;
      } catch (err) {
        console.error('Crop execution error:', err);
      }
    }

    function triggerUpdate() {
      drawViewport();
      if (renderDebounceTimer) clearTimeout(renderDebounceTimer);
      renderDebounceTimer = window.setTimeout(processCrop, 100);
    }

    async function loadFile(file: File) {
      if (!dropzone || !loadingCard || !workspace) return;

      dropzone.style.display = 'none';
      workspace.style.display = 'none';
      loadingCard.style.display = 'flex';

      try {
        currentFile = file;
        loadedImageObj = await loadImage(file);
        originalWidth = loadedImageObj.naturalWidth || loadedImageObj.width;
        originalHeight = loadedImageObj.naturalHeight || loadedImageObj.height;

        // Reset transform state
        panX = 0;
        panY = 0;
        zoom = 1.0;
        rotation = 0;
        flipH = false;
        if (zoomSlider) zoomSlider.value = '100';
        if (zoomValEl) zoomValEl.textContent = '1.0×';

        // Header info
        if (fileNameEl) fileNameEl.textContent = file.name;
        if (origDimsTag) origDimsTag.textContent = `${originalWidth} × ${originalHeight} px`;
        if (origSizeTag) origSizeTag.textContent = `${(file.size / 1024).toFixed(1)} KB`;

        const maxSide = Math.max(originalWidth, originalHeight);
        if (presetMatchMaxVal) presetMatchMaxVal.textContent = `${maxSide} × ${maxSide} px`;

        drawViewport();
        await processCrop();

        loadingCard.style.display = 'none';
        workspace.style.display = 'flex';
      } catch (err) {
        alert(err instanceof Error ? err.message : i18n.errorLoad);
        resetToDropzone();
      }
    }

    function resetToDropzone() {
      currentFile = null;
      loadedImageObj = null;
      if (fileInput) fileInput.value = '';
      if (loadingCard) loadingCard.style.display = 'none';
      if (workspace) workspace.style.display = 'none';
      if (dropzone) dropzone.style.display = 'block';
    }

    if (changeImageBtn) changeImageBtn.addEventListener('click', resetToDropzone);

    // Zoom slider
    if (zoomSlider) {
      zoomSlider.addEventListener('input', () => {
        zoom = parseInt(zoomSlider.value, 10) / 100;
        if (zoomValEl) zoomValEl.textContent = `${zoom.toFixed(1)}×`;
        triggerUpdate();
      });
    }

    // Rotate & Flip buttons
    if (rotateBtn) {
      rotateBtn.addEventListener('click', () => {
        rotation = (rotation + 90) % 360;
        triggerUpdate();
      });
    }

    if (flipBtn) {
      flipBtn.addEventListener('click', () => {
        flipH = !flipH;
        triggerUpdate();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        panX = 0;
        panY = 0;
        zoom = 1.0;
        rotation = 0;
        flipH = false;
        if (zoomSlider) zoomSlider.value = '100';
        if (zoomValEl) zoomValEl.textContent = '1.0×';
        triggerUpdate();
      });
    }

    // Pointer events for dragging inside Viewport
    if (viewportCanvas) {
      viewportCanvas.addEventListener('mousedown', (e) => {
        isDragging = true;
        dragStartX = e.clientX;
        dragStartY = e.clientY;
        initialPanX = panX;
        initialPanY = panY;
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const dx = e.clientX - dragStartX;
        const dy = e.clientY - dragStartY;
        panX = initialPanX + dx;
        panY = initialPanY + dy;
        triggerUpdate();
      });

      window.addEventListener('mouseup', () => {
        if (isDragging) {
          isDragging = false;
        }
      });

      // Touch events for mobile
      viewportCanvas.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          isDragging = true;
          dragStartX = e.touches[0].clientX;
          dragStartY = e.touches[0].clientY;
          initialPanX = panX;
          initialPanY = panY;
        }
      }, { passive: true });

      viewportCanvas.addEventListener('touchmove', (e) => {
        if (!isDragging || e.touches.length !== 1) return;
        const dx = e.touches[0].clientX - dragStartX;
        const dy = e.touches[0].clientY - dragStartY;
        panX = initialPanX + dx;
        panY = initialPanY + dy;
        triggerUpdate();
      }, { passive: true });

      viewportCanvas.addEventListener('touchend', () => {
        isDragging = false;
      });

      // Wheel zoom
      viewportCanvas.addEventListener('wheel', (e) => {
        e.preventDefault();
        const delta = e.deltaY < 0 ? 0.1 : -0.1;
        zoom = Math.max(1.0, Math.min(3.0, zoom + delta));
        if (zoomSlider) zoomSlider.value = Math.round(zoom * 100).toString();
        if (zoomValEl) zoomValEl.textContent = `${zoom.toFixed(1)}×`;
        triggerUpdate();
      }, { passive: false });
    }

    // Presets
    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        presetBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const raw = btn.getAttribute('data-size');
        if (raw === 'max' || raw === 'custom') {
          activeSizeSetting = raw;
        } else {
          activeSizeSetting = parseInt(raw || '500', 10);
        }

        if (customInputRow) {
          customInputRow.style.display = activeSizeSetting === 'custom' ? 'flex' : 'none';
        }

        triggerUpdate();
      });
    });

    if (customSizeInput) {
      customSizeInput.addEventListener('input', triggerUpdate);
    }

    // Border controls
    borderRadios.forEach((radio) => {
      radio.addEventListener('change', (e) => {
        const val = (e.target as HTMLInputElement).value;
        hasBorder = val === '1';
        if (borderOptionsBox) {
          borderOptionsBox.style.display = hasBorder ? 'flex' : 'none';
        }
        triggerUpdate();
      });
    });

    if (borderWidthSlider) {
      borderWidthSlider.addEventListener('input', () => {
        borderWidth = parseInt(borderWidthSlider.value, 10);
        if (borderWidthVal) borderWidthVal.textContent = `${borderWidth}px`;
        triggerUpdate();
      });
    }

    if (borderColorInput) {
      borderColorInput.addEventListener('input', (e) => {
        borderColor = (e.target as HTMLInputElement).value;
        swatchRingBtns.forEach((b) => b.classList.remove('active'));
        triggerUpdate();
      });
    }

    swatchRingBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const col = btn.getAttribute('data-color') || '#ffffff';
        borderColor = col;
        if (borderColorInput) borderColorInput.value = col;
        swatchRingBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        triggerUpdate();
      });
    });

    // Format select
    if (formatSelect) {
      formatSelect.addEventListener('change', triggerUpdate);
    }

    // Download Button
    if (downloadBtn) {
      downloadBtn.addEventListener('click', () => {
        if (!lastResult) return;

        const extMap: Record<string, string> = {
          'image/png': '.png',
          'image/webp': '.webp',
          'image/jpeg': '.jpg',
        };
        const ext = extMap[formatSelect?.value || 'image/png'] || '.png';
        const baseName = currentFile ? currentFile.name.replace(/\.[^/.]+$/, '') : 'avatar';
        const filename = `${baseName}-circle-cutout${ext}`;

        const a = document.createElement('a');
        a.href = lastResult.dataUrl;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      });
    }

    // Sample button
    if (sampleBtn) {
      sampleBtn.addEventListener('click', async () => {
        const file = await generateSamplePortrait();
        loadFile(file);
      });
    }

    // File input change
    if (fileInput) {
      fileInput.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        if (target.files && target.files[0]) {
          loadFile(target.files[0]);
        }
      });
    }

    // Drag and drop
    if (dropzone) {
      ['dragenter', 'dragover'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('circle-drag-active');
        });
      });

      ['dragleave', 'drop'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('circle-drag-active');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        if (dt && dt.files && dt.files[0]) {
          loadFile(dt.files[0]);
        }
      });
    }

    // Paste listener (Ctrl+V)
    window.addEventListener('paste', (e: ClipboardEvent) => {
      const items = e.clipboardData?.items;
      if (!items) return;
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.indexOf('image') !== -1) {
          const file = items[i].getAsFile();
          if (file) {
            loadFile(file);
            break;
          }
        }
      }
    });
  }

  initCircleCropper();
  document.addEventListener('astro:page-load', initCircleCropper);
</script>


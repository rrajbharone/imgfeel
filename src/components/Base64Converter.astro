---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div id="b64-converter-container" class="b64-card">
  <!-- Hidden File Input -->
  <input type="file" id="b64-file-input" accept="image/*,.svg" class="sr-only" />

  <!-- Upload Dropzone -->
  <div id="b64-dropzone" class="b64-dropzone">
    <div class="dropzone-icon">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="16 18 22 12 16 6"></polyline>
        <polyline points="8 6 2 12 8 18"></polyline>
        <line x1="14" y1="4" x2="10" y2="20"></line>
      </svg>
    </div>
    <h3 class="dropzone-title">{t(locale, 'b64.dropzone.title')}</h3>
    <p class="dropzone-subtitle">{t(locale, 'b64.dropzone.subtitle')}</p>
  </div>

  <!-- Editor / Conversion Results Area (Hidden until upload) -->
  <div id="b64-editor-area" class="b64-editor-area" hidden>
    <!-- Large File Warning Banner -->
    <div id="b64-warning-box" class="warning-banner" hidden>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
        <line x1="12" y1="9" x2="12" y2="13"></line>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg>
      <span>{t(locale, 'b64.warning.largeFile')}</span>
    </div>

    <div class="preview-info-grid">
      <!-- Image Thumbnail Preview -->
      <div class="preview-box">
        <img id="b64-img-preview" src="" alt="Uploaded Preview" class="b64-thumb" />
      </div>

      <!-- Image File Details Card -->
      <div class="info-card">
        <h4 class="info-title">{t(locale, 'b64.info.heading')}</h4>
        <dl class="info-list">
          <div class="info-row">
            <dt>{t(locale, 'b64.info.filename')}:</dt>
            <dd id="b64-info-filename">-</dd>
          </div>
          <div class="info-row">
            <dt>{t(locale, 'b64.info.mime')}:</dt>
            <dd id="b64-info-mime">-</dd>
          </div>
          <div class="info-row">
            <dt>{t(locale, 'b64.info.dimensions')}:</dt>
            <dd id="b64-info-dim">-</dd>
          </div>
          <div class="info-row">
            <dt>{t(locale, 'b64.info.fileSize')}:</dt>
            <dd id="b64-info-size">-</dd>
          </div>
          <div class="info-row">
            <dt>{t(locale, 'b64.info.stringLen')}:</dt>
            <dd id="b64-info-len">-</dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Format Output Toggle -->
    <div class="format-bar">
      <label for="b64-format-select" class="format-label">{t(locale, 'b64.label.outputType')}:</label>
      <select id="b64-format-select" class="format-select">
        <option value="dataUrl" selected>{t(locale, 'b64.opt.dataUrl')}</option>
        <option value="raw">{t(locale, 'b64.opt.raw')}</option>
      </select>
    </div>

    <!-- Code Output Textarea -->
    <div class="output-box-wrapper">
      <textarea id="b64-output-textarea" class="b64-textarea" readonly spellcheck="false" rows="6"></textarea>
    </div>

    <!-- Actions Row -->
    <div class="actions-grid">
      <button type="button" id="b64-copy-btn" class="btn btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span id="b64-copy-btn-text" data-copied={t(locale, 'b64.action.copied')}>{t(locale, 'b64.action.copy')}</span>
      </button>

      <button type="button" id="b64-download-txt-btn" class="btn btn-secondary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>{t(locale, 'b64.action.downloadTxt')}</span>
      </button>

      <button type="button" id="b64-copy-html-btn" class="btn btn-secondary btn-sm">
        <span>{t(locale, 'b64.action.copyHtml')}</span>
      </button>

      <button type="button" id="b64-copy-css-btn" class="btn btn-secondary btn-sm">
        <span>{t(locale, 'b64.action.copyCss')}</span>
      </button>

      <button type="button" id="b64-change-img-btn" class="btn btn-outline">
        <span>{t(locale, 'b64.action.newImage')}</span>
      </button>
    </div>
  </div>
</div>

<script>
  import '@/scripts/base64-converter';
</script>

<style>
  .b64-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-md);
    max-width: var(--container-narrow);
    margin-inline: auto;
  }

  .b64-dropzone {
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-12) var(--space-6);
    text-align: center;
    cursor: pointer;
    background: var(--color-surface);
    transition: all .15s;
  }
  .b64-dropzone:hover,
  .b64-dropzone.drag-over {
    border-color: var(--color-accent);
    background: var(--color-accent-light);
  }

  .dropzone-icon {
    color: var(--color-accent);
    margin-bottom: var(--space-3);
    display: flex;
    justify-content: center;
  }
  .dropzone-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }
  .dropzone-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .warning-banner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: #fef3c7;
    border: 1px solid #f59e0b;
    color: #92400e;
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    margin-bottom: var(--space-4);
  }

  .preview-info-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  @media (min-width: 550px) {
    .preview-info-grid {
      grid-template-columns: 180px 1fr;
    }
  }

  .preview-box {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    max-height: 180px;
  }

  .b64-thumb {
    max-width: 100%;
    max-height: 150px;
    object-fit: contain;
    border-radius: 4px;
  }

  .info-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .info-title {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-xs);
    border-bottom: 1px border-subtle var(--color-border);
    padding-bottom: 4px;
  }

  .info-row dt {
    color: var(--color-text-secondary);
  }

  .info-row dd {
    font-weight: 600;
    color: var(--color-text);
  }

  .format-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .format-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text);
  }

  .format-select {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 600;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  .output-box-wrapper {
    margin-bottom: var(--space-5);
  }

  .b64-textarea {
    width: 100%;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
    line-height: 1.5;
    padding: var(--space-3);
    background: #1e1e1e;
    color: #4ec9b0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    resize: vertical;
    word-break: break-all;
  }

  .actions-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .btn.copy-success {
    background: #10b981 !important;
    border-color: #10b981 !important;
    color: #fff !important;
  }
</style>

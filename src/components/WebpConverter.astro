---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div
  class="webp-converter-app"
  id="webp-converter-app"
  data-i18n-status-queued={t(locale, 'webp.status.queued')}
  data-i18n-status-converting={t(locale, 'webp.status.converting')}
  data-i18n-status-converted={t(locale, 'webp.status.converted')}
  data-i18n-status-error={t(locale, 'webp.status.error')}
  data-i18n-action-download={t(locale, 'webp.action.download')}
  data-i18n-action-download-jpg={t(locale, 'webp.action.downloadJpg')}
  data-i18n-action-download-png={t(locale, 'webp.action.downloadPng')}
  data-i18n-action-convert-single={t(locale, 'webp.action.convertSingle')}
  data-i18n-action-convert-all={t(locale, 'webp.action.convertAll')}
  data-i18n-action-download-all={t(locale, 'webp.action.downloadAll')}
  data-i18n-info-original={t(locale, 'webp.info.original')}
  data-i18n-info-output={t(locale, 'webp.info.output')}
  data-i18n-error-invalid-type={t(locale, 'webp.error.invalidType')}
  data-i18n-error-load-failed={t(locale, 'webp.error.loadFailed')}
>
  <!-- Format & Quality Settings Bar -->
  <div class="converter-settings-bar">
    <!-- Format Toggle -->
    <div class="setting-group">
      <span class="setting-label">{t(locale, 'webp.label.convertTo')}</span>
      <div class="format-toggle" role="radiogroup" aria-label={t(locale, 'webp.label.convertTo')}>
        <label class="toggle-option">
          <input type="radio" name="webp-target-format" value="jpg" checked />
          <span class="toggle-pill">JPG</span>
        </label>
        <label class="toggle-option">
          <input type="radio" name="webp-target-format" value="png" />
          <span class="toggle-pill">PNG</span>
        </label>
      </div>
    </div>

    <!-- JPG Quality Selector -->
    <div class="setting-group webp-quality-wrapper" id="webp-quality-box">
      <span class="setting-label">{t(locale, 'webp.label.quality')}</span>
      <div class="quality-options" role="radiogroup" aria-label={t(locale, 'webp.label.quality')}>
        <label class="quality-option">
          <input type="radio" name="webp-jpg-quality" value="0.9" />
          <span class="option-pill">{t(locale, 'webp.quality.90')}</span>
        </label>
        <label class="quality-option">
          <input type="radio" name="webp-jpg-quality" value="0.8" checked />
          <span class="option-pill">{t(locale, 'webp.quality.80')}</span>
        </label>
        <label class="quality-option">
          <input type="radio" name="webp-jpg-quality" value="0.7" />
          <span class="option-pill">{t(locale, 'webp.quality.70')}</span>
        </label>
      </div>
    </div>
  </div>

  <!-- Privacy Badge -->
  <div class="privacy-badge-container">
    <div class="privacy-badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>{t(locale, 'webp.privacy.badge')}</span>
    </div>
  </div>

  <!-- Upload Dropzone (shown initially when queue is empty) -->
  <div class="upload-zone" id="webp-upload-zone">
    <div class="dropzone" id="webp-dropzone" tabindex="0" role="button" aria-label={t(locale, 'webp.dropzone.title')}>
      <div class="dropzone-icon-wrapper">
        <svg class="dropzone-icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
      </div>
      <p class="dropzone-title">{t(locale, 'webp.dropzone.title')}</p>
      <p class="dropzone-subtitle">{t(locale, 'webp.dropzone.subtitle')}</p>
      <button type="button" class="btn btn-primary dropzone-browse-btn" id="webp-browse-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 8 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2z"></path>
        </svg>
        <span>{t(locale, 'webp.dropzone.browse')}</span>
      </button>
      <p class="dropzone-formats">{t(locale, 'webp.dropzone.formats')}</p>
      <input
        type="file"
        id="webp-file-input"
        accept=".webp,image/webp"
        multiple
        class="sr-only"
      />
    </div>
  </div>

  <!-- Single Image Editor (inspired by Image Resizer) -->
  <div class="single-editor" id="webp-single-editor" hidden>
    <div class="editor-layout">
      <!-- Left: Image Preview & Details -->
      <div class="preview-area">
        <div class="preview-box">
          <img id="webp-single-preview" class="preview-img" alt="WebP Preview" />
        </div>

        <div class="info-card">
          <div class="info-row">
            <span class="info-label">{t(locale, 'webp.info.filename')}:</span>
            <span class="info-value truncate" id="webp-single-filename"></span>
          </div>
          <div class="info-row">
            <span class="info-label">{t(locale, 'webp.info.dimensions')}:</span>
            <span class="info-value" id="webp-single-dimensions">Auto</span>
          </div>
          <div class="info-row">
            <span class="info-label">{t(locale, 'webp.info.original')}:</span>
            <span class="info-value" id="webp-single-original-size"></span>
          </div>
        </div>
      </div>

      <!-- Right: Conversion Results & Actions -->
      <div class="controls-area">
        <div class="result-box" id="webp-single-result-card" hidden>
          <div class="result-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-success"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <h4>{t(locale, 'webp.result.title')}</h4>
          </div>
          <div class="result-details">
            <div class="result-detail-item">
              <span class="result-label">Output Format:</span>
              <span class="result-val font-bold" id="webp-single-result-format"></span>
            </div>
            <div class="result-detail-item">
              <span class="result-label">{t(locale, 'webp.info.output')}:</span>
              <span class="result-val font-bold" id="webp-single-result-size"></span>
            </div>
          </div>
        </div>

        <div class="action-buttons">
          <button type="button" class="btn btn-primary btn-lg w-full" id="webp-single-btn-convert">
            {t(locale, 'webp.action.convertSingle')}
          </button>
          <button type="button" class="btn btn-primary btn-lg w-full" id="webp-single-btn-download" hidden>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>{t(locale, 'webp.action.download')}</span>
          </button>
          <button type="button" class="btn btn-secondary w-full" id="webp-single-btn-new">
            {t(locale, 'webp.action.newImage')}
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Batch Queue Section (2+ images) -->
  <div class="batch-section" id="webp-batch-section" hidden>
    <div class="batch-header">
      <div class="batch-header-left">
        <button type="button" class="btn btn-secondary btn-sm" id="btn-webp-add-more">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <span>{t(locale, 'webp.action.addMore')}</span>
        </button>
        <button type="button" class="btn btn-ghost btn-sm text-danger" id="btn-webp-clear-all">
          {t(locale, 'webp.action.clearAll')}
        </button>
      </div>

      <div class="batch-header-right">
        <button type="button" class="btn btn-secondary btn-sm" id="btn-webp-convert-all" hidden>
          {t(locale, 'webp.action.convertAll')}
        </button>
        <button type="button" class="btn btn-primary btn-sm" id="btn-webp-download-all" hidden>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span>{t(locale, 'webp.action.downloadAll')}</span>
        </button>
      </div>
    </div>

    <!-- Batch Cards Container -->
    <div class="batch-list" id="webp-batch-list"></div>
  </div>

  <!-- Error Toast -->
  <div class="error-box" id="webp-error-message" hidden role="alert">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10" />
      <line x1="12" y1="8" x2="12" y2="12" />
      <line x1="12" y1="16" x2="12.01" y2="16" />
    </svg>
    <span id="webp-error-text"></span>
  </div>
</div>

<script>
  import '@/scripts/webp-converter';
</script>

<style>
  .webp-converter-app {
    max-width: 860px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Settings Bar */
  .converter-settings-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .setting-group {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .setting-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  /* Format Toggle */
  .format-toggle {
    display: flex;
    background: var(--color-bg);
    padding: 3px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    gap: 2px;
  }
  .toggle-option {
    cursor: pointer;
  }
  .toggle-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .toggle-pill {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-secondary);
    border-radius: var(--radius-sm);
    transition: all 0.15s ease;
    user-select: none;
  }
  .toggle-option input:checked + .toggle-pill {
    background: var(--color-accent);
    color: #ffffff;
  }

  /* Quality Options */
  .quality-options {
    display: flex;
    gap: var(--space-1-5);
  }
  .quality-option {
    cursor: pointer;
  }
  .quality-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .option-pill {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: all 0.15s ease;
    user-select: none;
  }
  .quality-option input:checked + .option-pill {
    background: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
  }

  /* Privacy Badge */
  .privacy-badge-container {
    display: flex;
    justify-content: center;
  }
  .privacy-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-secondary);
    background: var(--color-surface);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
  }
  .privacy-badge svg {
    color: #16a34a;
  }

  /* Dropzone */
  .dropzone {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-10) var(--space-4);
    border: 2px dashed var(--color-accent);
    border-radius: var(--radius-lg);
    cursor: pointer;
    background: var(--color-surface);
    transition: border-color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
    text-align: center;
    outline: none;
  }
  .dropzone:hover,
  .dropzone:focus-visible,
  .dropzone.dragging {
    border-color: var(--color-accent);
    background: var(--color-accent-light);
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
  }
  .dropzone-icon-wrapper {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-1);
    transition: transform 0.15s ease;
  }
  .dropzone:hover .dropzone-icon-wrapper,
  .dropzone.dragging .dropzone-icon-wrapper {
    transform: translateY(-2px);
  }
  .dropzone-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
  }
  .dropzone-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    max-width: 440px;
  }
  .dropzone-browse-btn {
    margin-top: var(--space-2);
    margin-bottom: var(--space-1);
    min-height: 44px;
    padding-inline: var(--space-6);
  }
  .dropzone-formats {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Single-Image Editor */
  .editor-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
  }
  .preview-area {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .preview-box {
    width: 100%;
    height: 260px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .preview-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .info-card {
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
  }
  .info-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-xs);
  }
  .info-label {
    color: var(--color-text-muted);
  }
  .info-value {
    color: var(--color-text);
    font-weight: 600;
  }
  .truncate {
    max-width: 180px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .controls-area {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .result-box {
    padding: var(--space-4);
    background: var(--color-bg);
    border: 1px solid #bbf7d0;
    border-radius: var(--radius-lg);
  }
  :global(.dark) .result-box {
    border-color: rgba(34, 197, 94, 0.3);
  }
  .result-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .result-header h4 {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }
  .text-success {
    color: #16a34a;
  }
  .result-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-xs);
  }
  .result-detail-item {
    display: flex;
    justify-content: space-between;
  }
  .result-label {
    color: var(--color-text-secondary);
  }
  .result-val {
    color: var(--color-text);
  }
  .font-bold {
    font-weight: 700;
  }

  .action-buttons {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: auto;
  }
  .w-full {
    width: 100%;
  }

  /* Batch Section */
  .batch-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .batch-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }
  .batch-header-left,
  .batch-header-right {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .text-danger {
    color: #dc2626 !important;
  }

  /* Batch List & Cards */
  .batch-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  :global(.queue-card) {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  :global(.queue-item-thumb) {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    flex-shrink: 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  :global(.thumb-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(.thumb-placeholder) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    color: var(--color-text-muted);
    font-size: 9px;
    font-weight: 700;
  }
  :global(.queue-item-meta) {
    flex: 1;
    min-width: 0;
  }
  :global(.meta-name) {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  :global(.meta-sizes) {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-top: 2px;
  }
  :global(.meta-error) {
    font-size: var(--text-xs);
    color: #dc2626;
    margin-top: 2px;
  }
  :global(.queue-item-status) {
    flex-shrink: 0;
  }
  :global(.status-badge) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  :global(.badge-queued) {
    background: var(--color-bg);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }
  :global(.badge-converting) {
    background: var(--color-accent-light);
    color: var(--color-accent);
  }
  :global(.badge-converted) {
    background: #dcfce7;
    color: #166534;
  }
  :global(.badge-error) {
    background: #fee2e2;
    color: #991b1b;
  }
  :global(.dark .badge-converted) {
    background: rgba(34, 197, 94, 0.2);
    color: #86efac;
  }
  :global(.dark .badge-error) {
    background: rgba(239, 68, 68, 0.2);
    color: #fca5a5;
  }
  :global(.queue-item-actions) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }
  :global(.btn-item-remove) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  :global(.btn-item-remove:hover) {
    background: var(--color-bg);
    color: var(--color-text);
  }

  /* Error Box */
  .error-box {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #b91c1c;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
  }
  :global(.dark) .error-box {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.3);
    color: #fca5a5;
  }

  :global(.spinner) {
    width: 12px;
    height: 12px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    display: inline-block;
    animation: spin 0.75s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 640px) {
    .editor-layout {
      grid-template-columns: 1fr;
    }

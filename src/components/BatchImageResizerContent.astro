---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';
import { getToolUrl } from '@/data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const exactUrl = getToolUrl('exact-dimension-resizer', locale);
const splitterUrl = getToolUrl('image-splitter', locale);
const stitcherUrl = getToolUrl('image-stitcher', locale);
const compressUrl = getToolUrl('webp-compressor', locale);
const cropperUrl = getToolUrl('freeform-image-cropper', locale);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": t(locale, 'batchResizer.faq.q1'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'batchResizer.faq.a1')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'batchResizer.faq.q2'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'batchResizer.faq.a2')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'batchResizer.faq.q3'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'batchResizer.faq.a3')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'batchResizer.faq.q4'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'batchResizer.faq.a4')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'batchResizer.faq.q5'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'batchResizer.faq.a5')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'batchResizer.faq.q6'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'batchResizer.faq.a6')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'batchResizer.faq.q7'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'batchResizer.faq.a7')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'batchResizer.faq.q8'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'batchResizer.faq.a8')
      }
    }
  ]
};
---

<section class="section content-section">
  <div class="container">
    <div class="content-body">
      <!-- Section 1: What is Bulk Resizing -->
      <h2>{t(locale, 'batchResizer.content.h1')}</h2>
      <p>{t(locale, 'batchResizer.content.p1a')}</p>
      <p>{t(locale, 'batchResizer.content.p1b')}</p>

      <!-- 4 Core Feature Cards -->
      <div class="feature-cards-grid">
        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
          </div>
          <h3>{t(locale, 'batchResizer.content.feat1Title')}</h3>
          <p>{t(locale, 'batchResizer.content.feat1Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h3>{t(locale, 'batchResizer.content.feat2Title')}</h3>
          <p>{t(locale, 'batchResizer.content.feat2Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
          </div>
          <h3>{t(locale, 'batchResizer.content.feat3Title')}</h3>
          <p>{t(locale, 'batchResizer.content.feat3Desc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3>{t(locale, 'batchResizer.content.feat4Title')}</h3>
          <p>{t(locale, 'batchResizer.content.feat4Desc')}</p>
        </div>
      </div>

      <!-- Section 2: How It Works -->
      <h2>{t(locale, 'batchResizer.content.h2')}</h2>
      <p>{t(locale, 'batchResizer.content.p2a')}</p>
      <p>{t(locale, 'batchResizer.content.p2b')}</p>

      <!-- Section 3: Understanding Width, Height, Aspect Ratio -->
      <h2>{t(locale, 'batchResizer.content.h3')}</h2>
      <p>{t(locale, 'batchResizer.content.p3a')}</p>
      <p>{t(locale, 'batchResizer.content.p3b')}</p>

      <!-- Section 4: Master Dimensions Reference Table -->
      <h2>{t(locale, 'batchResizer.content.h4')}</h2>
      <p>{t(locale, 'batchResizer.content.p4a')}</p>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>{t(locale, 'batchResizer.table.thPlatform')}</th>
              <th>{t(locale, 'batchResizer.table.thUseCase')}</th>
              <th>{t(locale, 'batchResizer.table.thTargetSize')}</th>
              <th>{t(locale, 'batchResizer.table.thAspectRatio')}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Shopify / Amazon</strong></td>
              <td>{t(locale, 'batchResizer.table.row1UseCase')}</td>
              <td>{t(locale, 'batchResizer.table.row1Size')}</td>
              <td>{t(locale, 'batchResizer.table.row1Ratio')}</td>
            </tr>
            <tr>
              <td><strong>WooCommerce / Etsy</strong></td>
              <td>{t(locale, 'batchResizer.table.row2UseCase')}</td>
              <td>800 × 800 px</td>
              <td>{t(locale, 'batchResizer.table.row2Ratio')}</td>
            </tr>
            <tr>
              <td><strong>Blog / WordPress</strong></td>
              <td>{t(locale, 'batchResizer.table.row3UseCase')}</td>
              <td>1200 × 630 px</td>
              <td>{t(locale, 'batchResizer.table.row3Ratio')}</td>
            </tr>
            <tr>
              <td><strong>Instagram Feed</strong></td>
              <td>{t(locale, 'batchResizer.table.row4UseCase')}</td>
              <td>1080 × 1350 px</td>
              <td>{t(locale, 'batchResizer.table.row4Ratio')}</td>
            </tr>
            <tr>
              <td><strong>Instagram / Facebook</strong></td>
              <td>{t(locale, 'batchResizer.table.row5UseCase')}</td>
              <td>1080 × 1080 px</td>
              <td>{t(locale, 'batchResizer.table.row5Ratio')}</td>
            </tr>
            <tr>
              <td><strong>X (Twitter)</strong></td>
              <td>{t(locale, 'batchResizer.table.row6UseCase')}</td>
              <td>1200 × 675 px</td>
              <td>{t(locale, 'batchResizer.table.row6Ratio')}</td>
            </tr>
            <tr>
              <td><strong>Real Estate / Portfolio</strong></td>
              <td>{t(locale, 'batchResizer.table.row7UseCase')}</td>
              <td>1920 × 1080 px</td>
              <td>{t(locale, 'batchResizer.table.row7Ratio')}</td>
            </tr>
            <tr>
              <td><strong>Email Newsletters</strong></td>
              <td>{t(locale, 'batchResizer.table.row8UseCase')}</td>
              <td>600 × 300 px</td>
              <td>{t(locale, 'batchResizer.table.row8Ratio')}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 5: Key Use Cases -->
      <h2>{t(locale, 'batchResizer.content.h5')}</h2>
      <p>{t(locale, 'batchResizer.content.p5a')}</p>
      <p>{t(locale, 'batchResizer.content.p5b')}</p>

      <!-- Section 6: Pro Tips -->
      <h2>{t(locale, 'batchResizer.content.h6')}</h2>
      <p>{t(locale, 'batchResizer.content.p6a')}</p>
      <p>{t(locale, 'batchResizer.content.p6b')}</p>

      <!-- Section 7: Step-by-Step Instructions -->
      <h2>{t(locale, 'batchResizer.content.h7')}</h2>
      <p>{t(locale, 'batchResizer.content.p7Intro')}</p>

      <ol class="steps-ordered-list">
        <li>
          <strong>{t(locale, 'batchResizer.steps.s1Title')}</strong> — {t(locale, 'batchResizer.steps.s1Desc')}
        </li>
        <li>
          <strong>{t(locale, 'batchResizer.steps.s2Title')}</strong> — {t(locale, 'batchResizer.steps.s2Desc')}
        </li>
        <li>
          <strong>{t(locale, 'batchResizer.steps.s3Title')}</strong> — {t(locale, 'batchResizer.steps.s3Desc')}
        </li>
        <li>
          <strong>{t(locale, 'batchResizer.steps.s4Title')}</strong> — {t(locale, 'batchResizer.steps.s4Desc')}
        </li>
        <li>
          <strong>{t(locale, 'batchResizer.steps.s5Title')}</strong> — {t(locale, 'batchResizer.steps.s5Desc')}
        </li>
      </ol>

      <!-- Related Tools Cross Links -->
      <div class="cross-tools-container">
        <h3>{t(locale, 'batchResizer.cross.heading')}</h3>
        <div class="cross-tools-grid">
          <a href={exactUrl} class="cross-tool-card">
            <span class="cross-tool-title">{t(locale, 'batchResizer.cross.exact')}</span>
            <span class="cross-tool-desc">{t(locale, 'batchResizer.cross.exactDesc')}</span>
          </a>
          <a href={splitterUrl} class="cross-tool-card">
            <span class="cross-tool-title">{t(locale, 'batchResizer.cross.splitter')}</span>
            <span class="cross-tool-desc">{t(locale, 'batchResizer.cross.splitterDesc')}</span>
          </a>
          <a href={stitcherUrl} class="cross-tool-card">
            <span class="cross-tool-title">{t(locale, 'batchResizer.cross.stitcher')}</span>
            <span class="cross-tool-desc">{t(locale, 'batchResizer.cross.stitcherDesc')}</span>
          </a>
          <a href={compressUrl} class="cross-tool-card">
            <span class="cross-tool-title">{t(locale, 'batchResizer.cross.compress')}</span>
            <span class="cross-tool-desc">{t(locale, 'batchResizer.cross.compressDesc')}</span>
          </a>
          <a href={cropperUrl} class="cross-tool-card">
            <span class="cross-tool-title">{t(locale, 'batchResizer.cross.cropper')}</span>
            <span class="cross-tool-desc">{t(locale, 'batchResizer.cross.cropperDesc')}</span>
          </a>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="faq-container">
        <h2>{t(locale, 'batchResizer.faq.heading')}</h2>
        
        <div class="faq-accordion">
          <details class="faq-item" open>
            <summary class="faq-question"><h3>{t(locale, 'batchResizer.faq.q1')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'batchResizer.faq.a1')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'batchResizer.faq.q2')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'batchResizer.faq.a2')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'batchResizer.faq.q3')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'batchResizer.faq.a3')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'batchResizer.faq.q4')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'batchResizer.faq.a4')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'batchResizer.faq.q5')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'batchResizer.faq.a5')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'batchResizer.faq.q6')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'batchResizer.faq.a6')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'batchResizer.faq.q7')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'batchResizer.faq.a7')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'batchResizer.faq.q8')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'batchResizer.faq.a8')}</p></div>
          </details>
        </div>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .content-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-12) 0;
  }

  .content-body {
    max-width: var(--container-narrow);
    margin-inline: auto;
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.75;
  }

  .content-body h2 {
    color: var(--color-text);
    font-size: var(--text-2xl);
    font-weight: 800;
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .content-body h2:first-child {
    margin-top: 0;
  }

  .content-body p {
    margin-bottom: var(--space-4);
  }

  .content-body ul,
  .content-body ol {
    margin-bottom: var(--space-6);
    padding-left: var(--space-5);
  }

  .steps-ordered-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: var(--space-4) 0 var(--space-8) 0;
    padding-left: var(--space-5);
  }

  .steps-ordered-list li {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .steps-ordered-list strong {
    color: var(--color-text);
  }

  kbd {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 2px 5px;
    font-size: 11px;
    font-family: inherit;
    color: var(--color-text);
  }

  /* 4-Feature Cards Grid */
  .feature-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin: var(--space-6) 0 var(--space-8) 0;
  }

  @media (min-width: 640px) {
    .feature-cards-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .feature-card {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .feature-card-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-card h3 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .feature-card p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  /* Reference Data Table */
  .table-responsive {
    overflow-x: auto;
    margin: var(--space-6) 0 var(--space-8) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .data-table th,
  .data-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  .data-table th {
    background: var(--color-surface-subtle);
    font-weight: 700;
    color: var(--color-text);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  /* Cross Tools Links */
  .cross-tools-container {
    margin: var(--space-10) 0;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
  }

  .cross-tools-container h3 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
  }

  .cross-tools-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .cross-tools-grid {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
  }

  .cross-tool-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 3px;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .cross-tool-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .cross-tool-title {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent);
  }

  .cross-tool-desc {
    font-size: 11px;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  /* FAQ Accordion */
  .faq-container {
    margin-top: var(--space-10);
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
    overflow: hidden;
  }

  .faq-question {
    padding: var(--space-4);
    cursor: pointer;
    font-weight: 600;
    user-select: none;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question h3 {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: 700;
  }

  .faq-answer {
    padding: 0 var(--space-4) var(--space-4) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .faq-answer p {
    margin: 0;
  }
</style>

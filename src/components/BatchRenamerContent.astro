---
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": t(locale, 'renamer.faq.q1'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'renamer.faq.a1')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'renamer.faq.q2'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'renamer.faq.a2')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'renamer.faq.q3'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'renamer.faq.a3')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'renamer.faq.q4'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'renamer.faq.a4')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'renamer.faq.q5'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'renamer.faq.a5')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'renamer.faq.q6'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'renamer.faq.a6')
      }
    },
    {
      "@type": "Question",
      "name": t(locale, 'renamer.faq.q7'),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(locale, 'renamer.faq.a7')
      }
    }
  ]
};
---

<section class="section content-section">
  <div class="container">
    <article class="content-body">
      <!-- Section 1: Intro -->
      <h2>{t(locale, 'renamer.content.introTitle')}</h2>
      <p>{t(locale, 'renamer.content.introP1')}</p>
      <p>{t(locale, 'renamer.content.introP2')}</p>

      <!-- Section 2: How to Rename Multiple Images Online -->
      <h2>{t(locale, 'renamer.content.howToTitle')}</h2>
      <p>{t(locale, 'renamer.content.howToDesc')}</p>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number">1</div>
          <div class="step-content">
            <h3>{t(locale, 'renamer.content.step1Title')}</h3>
            <p>{t(locale, 'renamer.content.step1Desc')}</p>
          </div>
        </div>
        <div class="step-card">
          <div class="step-number">2</div>
          <div class="step-content">
            <h3>{t(locale, 'renamer.content.step2Title')}</h3>
            <p>{t(locale, 'renamer.content.step2Desc')}</p>
          </div>
        </div>
        <div class="step-card">
          <div class="step-number">3</div>
          <div class="step-content">
            <h3>{t(locale, 'renamer.content.step3Title')}</h3>
            <p>{t(locale, 'renamer.content.step3Desc')}</p>
          </div>
        </div>
        <div class="step-card">
          <div class="step-number">4</div>
          <div class="step-content">
            <h3>{t(locale, 'renamer.content.step4Title')}</h3>
            <p>{t(locale, 'renamer.content.step4Desc')}</p>
          </div>
        </div>
        <div class="step-card">
          <div class="step-number">5</div>
          <div class="step-content">
            <h3>{t(locale, 'renamer.content.step5Title')}</h3>
            <p>{t(locale, 'renamer.content.step5Desc')}</p>
          </div>
        </div>
      </div>

      <!-- Section 3: Why Rename in Bulk? -->
      <h2>{t(locale, 'renamer.content.whyBulkTitle')}</h2>
      <p>{t(locale, 'renamer.content.whyBulkP1')}</p>
      <p>{t(locale, 'renamer.content.whyBulkP2')}</p>

      <!-- Section 4: Benefits -->
      <h2>{t(locale, 'renamer.content.benefitsTitle')}</h2>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <h3>{t(locale, 'renamer.content.benefit1Title')}</h3>
          <p>{t(locale, 'renamer.content.benefit1Desc')}</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            </svg>
          </div>
          <h3>{t(locale, 'renamer.content.benefit2Title')}</h3>
          <p>{t(locale, 'renamer.content.benefit2Desc')}</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <h3>{t(locale, 'renamer.content.benefit3Title')}</h3>
          <p>{t(locale, 'renamer.content.benefit3Desc')}</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h3>{t(locale, 'renamer.content.benefit4Title')}</h3>
          <p>{t(locale, 'renamer.content.benefit4Desc')}</p>
        </div>
      </div>

      <!-- Section 5: How to Create Better Image File Names -->
      <h2>{t(locale, 'renamer.content.betterNamesTitle')}</h2>
      <p>{t(locale, 'renamer.content.betterNamesDesc')}</p>
      <div class="tips-list">
        <div class="tip-item">
          <strong>{t(locale, 'renamer.content.tip1Title')}:</strong>
          <span>{t(locale, 'renamer.content.tip1Desc')}</span>
        </div>
        <div class="tip-item">
          <strong>{t(locale, 'renamer.content.tip2Title')}:</strong>
          <span>{t(locale, 'renamer.content.tip2Desc')}</span>
        </div>
        <div class="tip-item">
          <strong>{t(locale, 'renamer.content.tip3Title')}:</strong>
          <span>{t(locale, 'renamer.content.tip3Desc')}</span>
        </div>
        <div class="tip-item">
          <strong>{t(locale, 'renamer.content.tip4Title')}:</strong>
          <span>{t(locale, 'renamer.content.tip4Desc')}</span>
        </div>
      </div>

      <!-- Section 6: Use Cases -->
      <h2>{t(locale, 'renamer.content.useCasesTitle')}</h2>
      <div class="types-grid">
        <div class="type-card">
          <h3>{t(locale, 'renamer.content.uc1Title')}</h3>
          <p>{t(locale, 'renamer.content.uc1Desc')}</p>
        </div>
        <div class="type-card">
          <h3>{t(locale, 'renamer.content.uc2Title')}</h3>
          <p>{t(locale, 'renamer.content.uc2Desc')}</p>
        </div>
        <div class="type-card">
          <h3>{t(locale, 'renamer.content.uc3Title')}</h3>
          <p>{t(locale, 'renamer.content.uc3Desc')}</p>
        </div>
        <div class="type-card">
          <h3>{t(locale, 'renamer.content.uc4Title')}</h3>
          <p>{t(locale, 'renamer.content.uc4Desc')}</p>
        </div>
      </div>

      <!-- Section 7: Security & Privacy -->
      <h2>{t(locale, 'renamer.content.privacyTitle')}</h2>
      <p>{t(locale, 'renamer.content.privacyP1')}</p>
      <p>{t(locale, 'renamer.content.privacyP2')}</p>

      <!-- Section 8: FAQ Accordion -->
      <h2>{t(locale, 'renamer.content.faqTitle')}</h2>
      <div class="faq-accordion">
        <details class="faq-item">
          <summary class="faq-question">
            <span>{t(locale, 'renamer.faq.q1')}</span>
            <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </summary>
          <div class="faq-answer"><p>{t(locale, 'renamer.faq.a1')}</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">
            <span>{t(locale, 'renamer.faq.q2')}</span>
            <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </summary>
          <div class="faq-answer"><p>{t(locale, 'renamer.faq.a2')}</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">
            <span>{t(locale, 'renamer.faq.q3')}</span>
            <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </summary>
          <div class="faq-answer"><p>{t(locale, 'renamer.faq.a3')}</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">
            <span>{t(locale, 'renamer.faq.q4')}</span>
            <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </summary>
          <div class="faq-answer"><p>{t(locale, 'renamer.faq.a4')}</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">
            <span>{t(locale, 'renamer.faq.q5')}</span>
            <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </summary>
          <div class="faq-answer"><p>{t(locale, 'renamer.faq.a5')}</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">
            <span>{t(locale, 'renamer.faq.q6')}</span>
            <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </summary>
          <div class="faq-answer"><p>{t(locale, 'renamer.faq.a6')}</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">
            <span>{t(locale, 'renamer.faq.q7')}</span>
            <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </summary>
          <div class="faq-answer"><p>{t(locale, 'renamer.faq.a7')}</p></div>
        </details>
      </div>
    </article>
  </div>
</section>

<!-- JSON-LD FAQ Schema -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .content-section {
    padding: var(--space-8) 0 var(--space-16);
    background: var(--color-background);
    border-top: 1px solid var(--color-border);
  }

  .content-body {
    max-width: 900px;
    margin-inline: auto;
    color: var(--color-text);
    font-size: var(--text-base);
    line-height: 1.7;
  }

  .content-body h2 {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .content-body h2:first-of-type {
    margin-top: 0;
  }

  .content-body p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    line-height: 1.7;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin: var(--space-6) 0 var(--space-8);
  }

  @media (min-width: 600px) {
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .step-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 16px 18px;
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .step-number {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #4f46e5;
    color: #fff;
    font-weight: 800;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .step-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .step-content h3 {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .step-content p {
    font-size: 12.5px;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin: var(--space-6) 0 var(--space-8);
  }

  @media (min-width: 600px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .feature-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .feature-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: rgba(79, 70, 229, 0.08);
    color: #4f46e5;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2px;
  }

  .feature-card h3 {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .feature-card p {
    font-size: 12.5px;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .tips-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: var(--space-4) 0 var(--space-8);
  }

  .tip-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 12px 16px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .tip-item strong {
    color: var(--color-text);
  }

  .types-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin: var(--space-5) 0 var(--space-8);
  }

  @media (min-width: 600px) {
    .types-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .type-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .type-card h3 {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
    line-height: 1.35;
  }

  .type-card p {
    font-size: 12.5px;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: var(--space-5) 0 var(--space-10);
  }

  .faq-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .faq-question {
    padding: 16px 18px;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    color: var(--color-text-secondary);
    flex-shrink: 0;
    transition: transform 0.2s ease;
    margin-left: 10px;
  }

  details[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 18px 16px;
  }

  .faq-answer p {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
</style>

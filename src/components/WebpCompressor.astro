---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div
  class="webp-compressor-app"
  id="webp-compressor-app"
  data-i18n-invalid={t(locale, 'webpcomp.error.invalidFile')}
  data-i18n-load-failed={t(locale, 'webpcomp.error.loadFailed')}
  data-i18n-process-failed={t(locale, 'webpcomp.error.processFailed')}
  data-i18n-processing={t(locale, 'webpcomp.status.processing')}
  data-i18n-compress={t(locale, 'webpcomp.action.compress')}
>
  <!-- Dropzone (Initial State) -->
  <div class="dropzone" id="webp-dropzone">
    <input
      type="file"
      id="webp-file-input"
      accept="image/webp,image/jpeg,image/png,image/jpg"
      hidden
    />
    <div class="dropzone-content">
      <div class="dropzone-icon">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </div>
      <p class="dropzone-title">{t(locale, 'webpcomp.dropzone.title')}</p>
      <p class="dropzone-subtitle">{t(locale, 'webpcomp.dropzone.subtitle')}</p>
      <button type="button" class="btn btn-primary btn-browse" id="webp-btn-browse">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
        <span>{t(locale, 'webpcomp.dropzone.browse')}</span>
      </button>
      <span class="dropzone-formats">{t(locale, 'webpcomp.dropzone.formats')}</span>
    </div>
  </div>

  <!-- Editor & Controls Area (Shown after upload) -->
  <div class="webp-editor-area" id="webp-editor-area" hidden>
    <div class="webp-controls-card">
      <div class="controls-header">
        <h3 class="controls-title">{t(locale, 'webpcomp.label.compressionLevel')}</h3>
      </div>

      <!-- Presets -->
      <div class="presets-row">
        <button type="button" class="webp-preset-btn active" data-preset="balanced">
          {t(locale, 'webpcomp.preset.balanced')}
        </button>
        <button type="button" class="webp-preset-btn" data-preset="high">
          {t(locale, 'webpcomp.preset.high')}
        </button>
        <button type="button" class="webp-preset-btn" data-preset="max">
          {t(locale, 'webpcomp.preset.max')}
        </button>
        <button type="button" class="webp-preset-btn" data-preset="custom">
          {t(locale, 'webpcomp.preset.custom')}
        </button>
        <button type="button" class="webp-preset-btn" data-preset="target">
          {t(locale, 'webpcomp.preset.target')}
        </button>
      </div>

      <!-- Custom Slider (Hidden by default) -->
      <div class="slider-group" id="webp-quality-group" hidden>
        <div class="slider-header">
          <label for="webp-quality-slider">{t(locale, 'webpcomp.label.customQuality')}</label>
          <span class="slider-val" id="webp-quality-val">80%</span>
        </div>
        <input
          type="range"
          id="webp-quality-slider"
          min="10"
          max="100"
          value="80"
          class="quality-range"
        />
      </div>

      <!-- Target KB Input (Hidden by default) -->
      <div class="target-group" id="webp-target-group" hidden>
        <label for="webp-target-input">{t(locale, 'webpcomp.label.targetKb')}</label>
        <input
          type="number"
          id="webp-target-input"
          min="5"
          max="5000"
          value="100"
          class="target-num-input"
        />
      </div>

      <div class="action-btn-row">
        <button type="button" class="btn btn-primary btn-lg" id="webp-btn-compress">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
          <span>{t(locale, 'webpcomp.action.compress')}</span>
        </button>
      </div>
    </div>

    <!-- Result Area -->
    <div class="webp-result-area" id="webp-result-area" hidden>
      <div class="result-card">
        <div class="result-header">
          <div class="result-title-row">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <h4 class="result-title">{t(locale, 'webpcomp.result.title')}</h4>
          </div>
        </div>

        <div class="stats-grid">
          <div class="stat-box">
            <span class="stat-label">{t(locale, 'webpcomp.info.filename')}</span>
            <span class="stat-value truncate" id="webp-info-filename">-</span>
          </div>
          <div class="stat-box">
            <span class="stat-label">{t(locale, 'webpcomp.info.dimensions')}</span>
            <span class="stat-value" id="webp-info-dim">-</span>
          </div>
          <div class="stat-box">
            <span class="stat-label">{t(locale, 'webpcomp.info.origSize')}</span>
            <span class="stat-value" id="webp-info-orig">-</span>
          </div>
          <div class="stat-box">
            <span class="stat-label">{t(locale, 'webpcomp.info.compSize')}</span>
            <span class="stat-value highlight" id="webp-info-comp">-</span>
          </div>
          <div class="stat-box full-width">
            <span class="stat-label">{t(locale, 'webpcomp.info.saved')}</span>
            <span class="saved-badge positive" id="webp-info-saved">-</span>
          </div>
        </div>

        <div class="preview-container">
          <img id="webp-preview-img" alt="Compressed WebP Preview" />
        </div>

        <div class="result-actions">
          <button type="button" class="btn btn-primary btn-lg" id="webp-btn-download">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>{t(locale, 'webpcomp.action.download')}</span>
          </button>
          <button type="button" class="btn btn-secondary" id="webp-btn-new">
            {t(locale, 'webpcomp.action.newImage')}
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Error Alert -->
  <div class="resizer-error" id="webp-error-area" hidden>
    <p id="webp-error-message"></p>
  </div>
</div>

<script>
  import '@/scripts/webp-compressor';
</script>

<style>
  .webp-compressor-app {
    max-width: var(--container-narrow);
    margin-inline: auto;
  }

  /* Dropzone */
  .dropzone {
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-10) var(--space-6);
    text-align: center;
    background: var(--color-surface);
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-sm);
  }

  .dropzone:hover,
  .dropzone.drag-over {
    border-color: var(--color-accent);
    background: var(--color-accent-light);
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .dropzone-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: var(--radius-full);
    background: var(--color-accent-light);
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .dropzone-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .dropzone-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .btn-browse {
    margin-top: var(--space-2);
  }

  .dropzone-formats {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }

  /* Editor Area */
  .webp-editor-area {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .webp-controls-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    box-shadow: var(--shadow-xs);
  }

  .controls-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .presets-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
  }

  @media (min-width: 540px) {
    .presets-row {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .webp-preset-btn {
    padding: var(--space-2-5) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 600;
    border: 1px solid var(--color-border);
    background: var(--color-surface-subtle);
    color: var(--color-text-secondary);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: center;
  }

  .webp-preset-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .webp-preset-btn.active {
    background: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
  }

  /* Slider */
  .slider-group,
  .target-group {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .slider-header {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .slider-val {
    color: var(--color-accent);
    font-weight: 700;
  }

  .quality-range {
    width: 100%;
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  .target-group label {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .target-num-input {
    width: 100%;
    max-width: 200px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .action-btn-row {
    display: flex;
    justify-content: center;
  }

  .action-btn-row .btn {
    width: 100%;
    max-width: 320px;
  }

  /* Result Area */
  .webp-result-area {
    scroll-margin-top: var(--space-8);
  }

  .result-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    box-shadow: var(--shadow-sm);
    scroll-margin-top: var(--space-8);
  }

  .result-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .result-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  @media (min-width: 500px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    padding: var(--space-3);
  }

  .stat-box.full-width {
    grid-column: 1 / -1;
    align-items: center;
    justify-content: center;
  }

  .stat-label {
    font-size: var(--text-2xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }

  .stat-value {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
  }

  .stat-value.truncate {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stat-value.highlight {
    color: var(--color-accent);
  }

  .saved-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .saved-badge.positive {
    background: #dcfce7;
    color: #15803d;
  }

  .saved-badge.neutral {
    background: #f1f5f9;
    color: #475569;
  }

  .preview-container {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0f172a;
    border-radius: var(--radius-md);
    padding: var(--space-4);
    min-height: 180px;
    max-height: 360px;
    overflow: hidden;
  }

  .preview-container img {
    max-width: 100%;
    max-height: 320px;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .result-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (min-width: 500px) {
    .result-actions {
      flex-direction: row;
    }
    .result-actions .btn-primary {
      flex: 1;
    }
  }

  /* Error Alert */
  .resizer-error {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #b91c1c;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    text-align: center;
  }
</style>

---
import { t, getLocalizedPath } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="res-tool-wrapper" id="resCheckerApp" data-locale={locale}>
  <!-- Dropzone / Upload State -->
  <div class="res-dropzone-card" id="resDropzone">
    <div class="res-dropzone-content">
      <div class="res-icon-circle">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
          <line x1="8" y1="21" x2="16" y2="21"></line>
          <line x1="12" y1="17" x2="12" y2="21"></line>
        </svg>
      </div>

      <h2 class="res-drop-title">{t(locale, 'rescheck.dropzone.title')}</h2>
      <p class="res-drop-subtitle">{t(locale, 'rescheck.dropzone.subtitle')}</p>

      <div class="res-dropzone-actions">
        <label class="res-btn res-btn-primary" for="resFileInput">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'rescheck.dropzone.browse')}</span>
        </label>
        <input type="file" id="resFileInput" accept="image/*" class="sr-only" />

        <button type="button" class="res-btn res-btn-secondary" id="resSampleBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          <span>{t(locale, 'rescheck.dropzone.sample')}</span>
        </button>
      </div>

      <p class="res-formats-note">{t(locale, 'rescheck.dropzone.formats')}</p>

      <div class="res-privacy-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span>{t(locale, 'rescheck.privacy.badge')}</span>
      </div>
    </div>
  </div>

  <!-- Loading State -->
  <div class="res-loading-card" id="resLoadingCard" style="display: none;">
    <div class="res-spinner"></div>
    <p class="res-loading-text">Analyzing image resolution...</p>
  </div>

  <!-- Results Dashboard -->
  <div class="res-results-view" id="resResultsView" style="display: none;">
    <!-- Action Bar -->
    <div class="res-action-bar">
      <div class="res-status-badge">
        <span class="res-status-dot"></span>
        <span>{t(locale, 'rescheck.status.analyzed')}</span>
      </div>

      <div class="res-actions-group">
        <button type="button" class="res-btn res-btn-sm res-btn-secondary" id="resCopyResBtn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span id="resCopyResLabel">{t(locale, 'rescheck.action.copyRes')}</span>
        </button>

        <button type="button" class="res-btn res-btn-sm res-btn-secondary" id="resCopyReportBtn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
          </svg>
          <span id="resCopyReportLabel">{t(locale, 'rescheck.action.copyReport')}</span>
        </button>

        <button type="button" class="res-btn res-btn-sm res-btn-primary" id="resNewImageBtn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="1 4 1 10 7 10"></polyline>
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
          </svg>
          <span>{t(locale, 'rescheck.action.newImage')}</span>
        </button>
      </div>
    </div>

    <!-- Main Visual Split: Preview & Primary Metrics -->
    <div class="res-hero-grid">
      <!-- Image Preview with Overlay -->
      <div class="res-preview-box">
        <div class="res-preview-canvas-wrap">
          <img id="resPreviewImg" src="" alt="Preview of uploaded image" class="res-preview-image" />
          <div class="res-preview-overlay">
            <span class="res-overlay-tag" id="resOverlayRes">0 × 0 px</span>
            <span class="res-overlay-tag res-tag-accent" id="resOverlayMP">0 MP</span>
          </div>
        </div>
      </div>

      <!-- 4 Key Resolution Metric Cards -->
      <div class="res-metrics-grid">
        <div class="res-metric-card">
          <div class="res-metric-header">
            <div class="res-metric-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            </div>
            <span class="res-metric-label">{t(locale, 'rescheck.metric.resolution')}</span>
          </div>
          <div class="res-metric-value" id="resCardResolution">0 × 0 px</div>
          <span class="res-metric-sub" id="resCardOrientation">Landscape Orientation</span>
        </div>

        <div class="res-metric-card">
          <div class="res-metric-header">
            <div class="res-metric-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                <rect x="3" y="14" width="7" height="7" rx="1"></rect>
              </svg>
            </div>
            <span class="res-metric-label">{t(locale, 'rescheck.metric.megapixels')}</span>
          </div>
          <div class="res-metric-value" id="resCardMP">0.00 MP</div>
          <span class="res-metric-sub" id="resCardPixels">0 Total Pixels</span>
        </div>

        <div class="res-metric-card">
          <div class="res-metric-header">
            <div class="res-metric-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 2v14a2 2 0 0 0 2 2h14"></path>
                <path d="M18 22V8a2 2 0 0 0-2-2H2"></path>
              </svg>
            </div>
            <span class="res-metric-label">{t(locale, 'rescheck.metric.aspectRatio')}</span>
          </div>
          <div class="res-metric-value" id="resCardAspectRatio">0:0</div>
          <span class="res-metric-sub" id="resCardAspectDecimal">0.00:1 Ratio</span>
        </div>

        <div class="res-metric-card highlight-card">
          <div class="res-metric-header">
            <div class="res-metric-icon highlight-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            </div>
            <span class="res-metric-label">{t(locale, 'rescheck.metric.standardMatch')}</span>
          </div>
          <div class="res-metric-value res-text-accent" id="resCardStandard">Standard Match</div>
          <span class="res-metric-sub" id="resCardStandardCat">Display Category</span>
        </div>
      </div>
    </div>

    <!-- Section: Maximum Sharp Print Sizes -->
    <div class="res-detail-card">
      <div class="res-detail-header">
        <div class="res-detail-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
        </div>
        <div>
          <h3 class="res-detail-title">{t(locale, 'rescheck.section.printSizes')}</h3>
          <p class="res-detail-subtitle">{t(locale, 'rescheck.section.printSizesSub')}</p>
        </div>
      </div>

      <div class="res-table-wrap">
        <table class="res-data-table">
          <thead>
            <tr>
              <th>{t(locale, 'rescheck.print.colDpi')}</th>
              <th>{t(locale, 'rescheck.print.colInches')}</th>
              <th>{t(locale, 'rescheck.print.colCm')}</th>
              <th>{t(locale, 'rescheck.print.colMm')}</th>
              <th>{t(locale, 'rescheck.print.colQuality')}</th>
            </tr>
          </thead>
          <tbody id="resPrintTableBody">
            <!-- Populated dynamically via JS -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Section: Display & Screen Clarity Rating -->
    <div class="res-detail-card">
      <div class="res-detail-header">
        <div class="res-detail-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </div>
        <div>
          <h3 class="res-detail-title">{t(locale, 'rescheck.section.screenClarity')}</h3>
          <p class="res-detail-subtitle">{t(locale, 'rescheck.section.screenClaritySub')}</p>
        </div>
      </div>

      <div class="res-clarity-grid">
        <div class="res-clarity-item">
          <span class="res-clarity-device">Smartphones & Mobile</span>
          <span class="res-clarity-rating" id="resMobileClarity">Retina Sharp</span>
        </div>
        <div class="res-clarity-item">
          <span class="res-clarity-device">Laptops & Desktop Monitors</span>
          <span class="res-clarity-rating" id="resDesktopClarity">1080p FHD Native</span>
        </div>
        <div class="res-clarity-item">
          <span class="res-clarity-device">Large TVs & 4K Displays</span>
          <span class="res-clarity-rating" id="resTvClarity">4K Ready</span>
        </div>
      </div>
    </div>

    <!-- Section: Technical & Color Properties -->
    <div class="res-detail-card">
      <div class="res-detail-header">
        <div class="res-detail-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
        </div>
        <div>
          <h3 class="res-detail-title">{t(locale, 'rescheck.section.technical')}</h3>
          <p class="res-detail-subtitle">{t(locale, 'rescheck.section.technicalSub')}</p>
        </div>
      </div>

      <div class="res-table-wrap">
        <table class="res-data-table">
          <tbody>
            <tr>
              <td class="res-prop-label">{t(locale, 'rescheck.table.filename')}</td>
              <td class="res-prop-val" id="resPropFileName">-</td>
            </tr>
            <tr>
              <td class="res-prop-label">{t(locale, 'rescheck.table.fileSize')}</td>
              <td class="res-prop-val" id="resPropFileSize">-</td>
            </tr>
            <tr>
              <td class="res-prop-label">{t(locale, 'rescheck.table.detectedFormat')}</td>
              <td class="res-prop-val" id="resPropFormat">-</td>
            </tr>
            <tr>
              <td class="res-prop-label">{t(locale, 'rescheck.table.colorDepth')}</td>
              <td class="res-prop-val" id="resPropColorDepth">-</td>
            </tr>
            <tr>
              <td class="res-prop-label">{t(locale, 'rescheck.table.embeddedDpi')}</td>
              <td class="res-prop-val" id="resPropDpi">None / Web Default (72–96 DPI)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Recommended Next Actions -->
    <div class="res-next-actions">
      <h4 class="res-next-title">{t(locale, 'rescheck.nextActions.title')}</h4>
      <div class="res-next-btns">
        <a href={getLocalizedPath('/tools/resize-image-to-exact-dimensions/', locale)} class="res-btn res-btn-sm res-btn-secondary">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 3h6v6"></path>
            <path d="M9 21H3v-6"></path>
            <path d="M21 3l-7 7"></path>
            <path d="M3 21l7-7"></path>
          </svg>
          <span>{t(locale, 'rescheck.nextActions.resize')}</span>
        </a>

        <a href={getLocalizedPath('/tools/webp-image-compressor/', locale)} class="res-btn res-btn-sm res-btn-secondary">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="4 14 10 14 10 20"></polyline>
            <polyline points="20 10 14 10 14 4"></polyline>
            <line x1="14" y1="10" x2="21" y2="3"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
          <span>{t(locale, 'rescheck.nextActions.compress')}</span>
        </a>

        <a href={getLocalizedPath('/tools/image-file-size-checker/', locale)} class="res-btn res-btn-sm res-btn-secondary">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="12" y1="18" x2="12" y2="12"></line>
            <line x1="9" y1="15" x2="15" y2="15"></line>
          </svg>
          <span>{t(locale, 'rescheck.nextActions.fileSize')}</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  import { analyzeImageResolution, generateSampleImage, type ResolutionAnalysis } from '@/scripts/resolution-checker';

  function initResolutionChecker() {
    const app = document.getElementById('resCheckerApp');
    if (!app) return;

    const dropzone = document.getElementById('resDropzone');
    const fileInput = document.getElementById('resFileInput') as HTMLInputElement | null;
    const sampleBtn = document.getElementById('resSampleBtn');
    const loadingCard = document.getElementById('resLoadingCard');
    const resultsView = document.getElementById('resResultsView');
    const previewImg = document.getElementById('resPreviewImg') as HTMLImageElement | null;
    const overlayRes = document.getElementById('resOverlayRes');
    const overlayMP = document.getElementById('resOverlayMP');

    // Cards
    const cardRes = document.getElementById('resCardResolution');
    const cardOrient = document.getElementById('resCardOrientation');
    const cardMP = document.getElementById('resCardMP');
    const cardPixels = document.getElementById('resCardPixels');
    const cardAspect = document.getElementById('resCardAspectRatio');
    const cardAspectDec = document.getElementById('resCardAspectDecimal');
    const cardStandard = document.getElementById('resCardStandard');
    const cardStandardCat = document.getElementById('resCardStandardCat');

    // Table bodies
    const printTableBody = document.getElementById('resPrintTableBody');
    const mobileClarity = document.getElementById('resMobileClarity');
    const desktopClarity = document.getElementById('resDesktopClarity');
    const tvClarity = document.getElementById('resTvClarity');

    // Properties
    const propFileName = document.getElementById('resPropFileName');
    const propFileSize = document.getElementById('resPropFileSize');
    const propFormat = document.getElementById('resPropFormat');
    const propColorDepth = document.getElementById('resPropColorDepth');
    const propDpi = document.getElementById('resPropDpi');

    // Action buttons
    const copyResBtn = document.getElementById('resCopyResBtn');
    const copyResLabel = document.getElementById('resCopyResLabel');
    const copyReportBtn = document.getElementById('resCopyReportBtn');
    const copyReportLabel = document.getElementById('resCopyReportLabel');
    const newImageBtn = document.getElementById('resNewImageBtn');

    let currentAnalysis: ResolutionAnalysis | null = null;

    async function handleFile(file: File) {
      if (!file || !file.type.startsWith('image/')) return;

      if (dropzone) dropzone.style.display = 'none';
      if (resultsView) resultsView.style.display = 'none';
      if (loadingCard) loadingCard.style.display = 'flex';

      try {
        currentAnalysis = await analyzeImageResolution(file);
        renderAnalysis(currentAnalysis);
        if (loadingCard) loadingCard.style.display = 'none';
        if (resultsView) resultsView.style.display = 'flex';
      } catch (err) {
        console.error(err);
        if (loadingCard) loadingCard.style.display = 'none';
        if (dropzone) dropzone.style.display = 'block';
        alert('Could not inspect image resolution. Please ensure the file is a valid image.');
      }
    }

    function renderAnalysis(data: ResolutionAnalysis) {
      if (previewImg) previewImg.src = data.previewUrl;
      if (overlayRes) overlayRes.textContent = `${data.width.toLocaleString()} × ${data.height.toLocaleString()} px`;
      if (overlayMP) overlayMP.textContent = `${data.megapixels} MP`;

      if (cardRes) cardRes.textContent = `${data.width.toLocaleString()} × ${data.height.toLocaleString()} px`;
      if (cardOrient) cardOrient.textContent = `${data.orientation} Orientation`;

      if (cardMP) cardMP.textContent = `${data.megapixels} MP`;
      if (cardPixels) cardPixels.textContent = `${data.totalPixels.toLocaleString()} Total Pixels`;

      if (cardAspect) cardAspect.textContent = data.aspectRatio;
      if (cardAspectDec) cardAspectDec.textContent = `${data.aspectRatioDecimal}:1 Ratio`;

      if (cardStandard) cardStandard.textContent = data.standardMatch;
      if (cardStandardCat) cardStandardCat.textContent = data.standardCategory;

      // Print table
      if (printTableBody) {
        printTableBody.innerHTML = data.printSizes
          .map(
            (p) => `
          <tr>
            <td><strong>${p.label}</strong></td>
            <td>${p.widthIn}″ × ${p.heightIn}″</td>
            <td>${p.widthCm} × ${p.heightCm} cm</td>
            <td>${p.widthMm} × ${p.heightMm} mm</td>
            <td><span class="res-quality-badge">${p.qualityBadge}</span></td>
          </tr>
        `
          )
          .join('');
      }

      // Screen clarity
      if (mobileClarity) mobileClarity.textContent = data.screenClarity.mobilePhone;
      if (desktopClarity) desktopClarity.textContent = data.screenClarity.desktopMonitor;
      if (tvClarity) tvClarity.textContent = data.screenClarity.tvScreen;

      // Properties
      if (propFileName) propFileName.textContent = data.fileName;
      if (propFileSize) propFileSize.textContent = data.fileSizeFormatted;
      if (propFormat) propFormat.textContent = data.detectedFormat;
      if (propColorDepth) propColorDepth.textContent = data.colorDepth;
      if (propDpi) propDpi.textContent = data.embeddedDpi ? `${data.embeddedDpi} DPI (Embedded)` : 'None / Web Default (72–96 DPI)';
    }

    function resetView() {
      currentAnalysis = null;
      if (fileInput) fileInput.value = '';
      if (resultsView) resultsView.style.display = 'none';
      if (loadingCard) loadingCard.style.display = 'none';
      if (dropzone) dropzone.style.display = 'block';
    }

    // Drag and Drop
    if (dropzone) {
      ['dragenter', 'dragover'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('res-drag-active');
        });
      });

      ['dragleave', 'drop'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('res-drag-active');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        if (dt && dt.files && dt.files[0]) {
          handleFile(dt.files[0]);
        }
      });
    }

    if (fileInput) {
      fileInput.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        if (target.files && target.files[0]) {
          handleFile(target.files[0]);
        }
      });
    }

    // Sample Image Button
    if (sampleBtn) {
      sampleBtn.addEventListener('click', async () => {
        const sampleFile = await generateSampleImage();
        handleFile(sampleFile);
      });
    }

    // Global Paste Listener (Ctrl+V)
    window.addEventListener('paste', (e: ClipboardEvent) => {
      const items = e.clipboardData?.items;
      if (!items) return;
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.indexOf('image') !== -1) {
          const file = items[i].getAsFile();
          if (file) {
            handleFile(file);
            break;
          }
        }
      }
    });

    // Copy Resolution
    if (copyResBtn && copyResLabel) {
      copyResBtn.addEventListener('click', () => {
        if (!currentAnalysis) return;
        const text = `${currentAnalysis.width} × ${currentAnalysis.height} px (${currentAnalysis.megapixels} MP, ${currentAnalysis.aspectRatio})`;
        navigator.clipboard.writeText(text).then(() => {
          const original = copyResLabel.textContent;
          copyResLabel.textContent = 'Copied!';
          setTimeout(() => {
            copyResLabel.textContent = original;
          }, 2000);
        });
      });
    }

    // Copy Full Report
    if (copyReportBtn && copyReportLabel) {
      copyReportBtn.addEventListener('click', () => {
        if (!currentAnalysis) return;
        const p300 = currentAnalysis.printSizes[0];
        const report = `### Image Resolution Report (${currentAnalysis.fileName})
- **Resolution**: ${currentAnalysis.width} × ${currentAnalysis.height} px
- **Megapixels**: ${currentAnalysis.megapixels} MP (${currentAnalysis.totalPixels.toLocaleString()} total pixels)
- **Aspect Ratio**: ${currentAnalysis.aspectRatio} (${currentAnalysis.aspectRatioDecimal}:1)
- **Orientation**: ${currentAnalysis.orientation}

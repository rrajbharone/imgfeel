---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const i18nDict = {
  statusReady: t(locale, 'batchResizer.status.ready'),
  statusProcessing: t(locale, 'batchResizer.status.processing'),
  statusCompleted: t(locale, 'batchResizer.status.completed'),
  statusItemResized: t(locale, 'batchResizer.status.itemResized'),
  statusLoading: t(locale, 'batchResizer.status.loading'),
  statusSampleGenerating: t(locale, 'batchResizer.status.sampleGenerating'),
  actionDownload: t(locale, 'batchResizer.action.download'),
  actionResizeAll: t(locale, 'batchResizer.action.resizeAll'),
  actionRemove: t(locale, 'batchResizer.action.remove'),
  summaryCount: t(locale, 'batchResizer.summary.count'),
  errorLoad: t(locale, 'batchResizer.error.load'),
  errorZip: t(locale, 'batchResizer.error.zip'),
};
---

<div class="batch-resizer-wrapper" id="batchResizerApp" data-i18n={JSON.stringify(i18nDict)}>
  <!-- Dropzone Card (Visible when 0 images loaded) -->
  <div class="batch-dropzone-card" id="batchDropzone">
    <div class="batch-dropzone-content">
      <div class="batch-icon-circle">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 3 21 3 21 9"></polyline>
          <polyline points="9 21 3 21 3 15"></polyline>
          <line x1="21" y1="3" x2="14" y2="10"></line>
          <line x1="3" y1="21" x2="10" y2="14"></line>
        </svg>
      </div>

      <h2 class="batch-drop-title">{t(locale, 'batchResizer.dropzone.title')}</h2>
      <p class="batch-drop-subtitle">{t(locale, 'batchResizer.dropzone.subtitle')}</p>

      <div class="batch-btn-row">
        <label class="btn btn-primary batch-btn-primary" for="batchFileInput">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'batchResizer.dropzone.browse')}</span>
        </label>
        <input type="file" id="batchFileInput" accept="image/*,.jpg,.jpeg,.png,.webp,.avif,.bmp" multiple class="sr-only" />

        <button type="button" class="btn btn-secondary batch-sample-btn" id="batchSampleBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span>{t(locale, 'batchResizer.dropzone.sample')}</span>
        </button>
      </div>

      <p class="batch-formats-hint">{t(locale, 'batchResizer.dropzone.formats')}</p>

      <div class="batch-privacy-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span>{t(locale, 'batchResizer.privacy.badge')}</span>
      </div>
    </div>
  </div>

  <!-- Loading State Card -->
  <div class="batch-loading-card" id="batchLoadingCard" style="display: none;">
    <div class="batch-spinner"></div>
    <p class="batch-loading-text" id="batchLoadingText">{t(locale, 'batchResizer.status.processing')}</p>
  </div>

  <!-- Main Batch Workspace (Visible when 1+ images loaded) -->
  <div class="batch-workspace" id="batchWorkspace" style="display: none;">
    <!-- Top Configuration Card -->
    <div class="batch-controls-card">
      <div class="controls-top-row">
        <div class="controls-count-badge">
          <span class="count-indicator-dot"></span>
          <span id="batchCountBadge" class="count-badge-text">{t(locale, 'batchResizer.summary.count').replace('{n}', '0')}</span>
        </div>

        <div class="controls-top-actions">
          <label for="batchAddMoreInput" class="btn btn-secondary btn-sm add-more-label">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>{t(locale, 'batchResizer.action.addMore')}</span>
          </label>
          <input type="file" id="batchAddMoreInput" accept="image/*,.jpg,.jpeg,.png,.webp,.avif,.bmp" multiple class="sr-only" />

          <button type="button" class="btn btn-secondary btn-sm clear-all-btn" id="batchClearAllBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
            <span>{t(locale, 'batchResizer.action.clearAll')}</span>
          </button>
        </div>
      </div>

      <!-- Dimension Inputs & Settings -->
      <div class="dimensions-settings-grid">
        <div class="input-field-group">
          <label class="field-label" for="targetWidthInput">{t(locale, 'batchResizer.controls.width')}</label>
          <div class="input-unit-wrapper">
            <input type="number" id="targetWidthInput" min="1" max="10000" placeholder="1200" class="dimension-input" />
            <span class="unit-tag">px</span>
          </div>
        </div>

        <div class="input-field-group">
          <label class="field-label" for="targetHeightInput">{t(locale, 'batchResizer.controls.height')}</label>
          <div class="input-unit-wrapper">
            <input type="number" id="targetHeightInput" min="1" max="10000" placeholder="800" class="dimension-input" />
            <span class="unit-tag">px</span>
          </div>
        </div>

        <div class="lock-ratio-group">
          <label class="checkbox-container" for="lockRatioCheckbox">
            <input type="checkbox" id="lockRatioCheckbox" checked />
            <span class="custom-checkmark"></span>
            <span class="checkbox-label-text">{t(locale, 'batchResizer.controls.lockRatio')}</span>
          </label>
        </div>
      </div>

      <!-- Quick Scale Chips -->
      <div class="quick-scale-row">
        <span class="scale-label">{t(locale, 'batchResizer.controls.scale')}:</span>
        <div class="scale-chips-wrapper">
          <button type="button" class="scale-chip" data-scale="25">25%</button>
          <button type="button" class="scale-chip active" data-scale="50">50%</button>
          <button type="button" class="scale-chip" data-scale="75">75%</button>
          <button type="button" class="scale-chip" data-scale="100">100%</button>
        </div>
      </div>

      <!-- Target File Size Control -->
      <div class="target-size-control-box">
        <div class="target-size-header">
          <label class="field-label" for="targetFileSizeInput">
            {t(locale, 'batchResizer.controls.targetSize')}
            <span class="field-hint-text">({t(locale, 'batchResizer.controls.targetSizeHint')})</span>
          </label>
        </div>

        <div class="target-size-body">
          <div class="target-size-input-wrapper">
            <input
              type="number"
              id="targetFileSizeInput"
              min="1"
              max="50000"
              placeholder="500"
              class="dimension-input target-size-number-input"
            />
            <select id="targetSizeUnitSelect" class="unit-select">
              <option value="KB" selected>KB</option>
              <option value="MB">MB</option>
            </select>
          </div>

          <div class="target-size-presets-col">
            <span class="presets-label">{t(locale, 'batchResizer.controls.presets')}</span>
            <div class="size-preset-chips-wrapper">
              <button type="button" class="size-preset-chip" data-size="100" data-unit="KB">100 KB</button>
              <button type="button" class="size-preset-chip" data-size="250" data-unit="KB">250 KB</button>
              <button type="button" class="size-preset-chip" data-size="500" data-unit="KB">500 KB</button>
              <button type="button" class="size-preset-chip" data-size="1" data-unit="MB">1 MB</button>
              <button type="button" class="size-preset-chip" data-size="2" data-unit="MB">2 MB</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Button & Progress Bar -->
      <div class="action-execute-box">
        <button type="button" class="btn btn-primary btn-lg batch-execute-btn" id="batchExecuteBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 3 21 3 21 9"></polyline>
            <polyline points="9 21 3 21 3 15"></polyline>
            <line x1="21" y1="3" x2="14" y2="10"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
          <span id="executeBtnText">{t(locale, 'batchResizer.action.resizeAll')}</span>
        </button>

        <!-- Progress Tracker -->
        <div class="progress-bar-container" id="progressBarContainer" style="display: none;">
          <div class="progress-bar-track">
            <div class="progress-bar-fill" id="progressBarFill" style="width: 0%;"></div>
          </div>
          <span class="progress-text" id="progressStatusText">Processing...</span>
        </div>
      </div>
    </div>

    <!-- Completed Actions Banner (Shown after batch resizing) -->
    <div class="batch-completed-banner" id="batchCompletedBanner" style="display: none;">
      <div class="completed-info-col">
        <div class="completed-success-badge">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <span id="completedSummaryText" class="completed-title-text">All images resized successfully!</span>
        </div>
      </div>

      <div class="completed-btn-group">
        <button type="button" class="btn btn-secondary btn-sm" id="batchResetBtn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
            <path d="M3 3v5h5"></path>
          </svg>
          <span>{t(locale, 'batchResizer.action.reset')}</span>
        </button>

        <button type="button" class="btn btn-primary btn-md download-zip-btn" id="batchDownloadZipBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>{t(locale, 'batchResizer.action.downloadAll')}</span>
        </button>
      </div>
    </div>

    <!-- Compact File-Row Style List -->
    <div class="compact-files-list-container" id="compactFilesList"></div>
  </div>
</div>

<script>
  import { BatchResizerEngine, type BatchImageItem, type BatchResizeOptions } from '@/scripts/batch-resizer';

  document.addEventListener('DOMContentLoaded', () => {
    const appEl = document.getElementById('batchResizerApp');
    if (!appEl) return;

    let i18n = {
      statusReady: 'Ready to Resize',
      statusProcessing: 'Resizing Images ({current}/{total})...',
      statusCompleted: 'All {n} images resized successfully!',
      statusItemResized: 'Resized',
      statusLoading: 'Loading images...',
      statusSampleGenerating: 'Generating sample images...',
      actionDownload: 'Download',
      actionResizeAll: 'Resize All Images',
      actionRemove: 'Remove file',
      summaryCount: '{n} Images Uploaded',
      errorLoad: 'Failed to load one or more images.',
      errorZip: 'Failed to generate ZIP archive.',
    };

    try {
      if (appEl.dataset.i18n) {
        i18n = { ...i18n, ...JSON.parse(appEl.dataset.i18n) };
      }
    } catch (e) {
      console.warn('Failed to parse i18n data', e);
    }

    // Elements
    const dropzone = document.getElementById('batchDropzone')!;
    const fileInput = document.getElementById('batchFileInput') as HTMLInputElement;
    const addMoreInput = document.getElementById('batchAddMoreInput') as HTMLInputElement;
    const sampleBtn = document.getElementById('batchSampleBtn')!;
    const loadingCard = document.getElementById('batchLoadingCard')!;
    const loadingText = document.getElementById('batchLoadingText')!;
    const workspace = document.getElementById('batchWorkspace')!;
    const countBadge = document.getElementById('batchCountBadge')!;
    const clearAllBtn = document.getElementById('batchClearAllBtn')!;
    const targetWidthInput = document.getElementById('targetWidthInput') as HTMLInputElement;
    const targetHeightInput = document.getElementById('targetHeightInput') as HTMLInputElement;
    const targetFileSizeInput = document.getElementById('targetFileSizeInput') as HTMLInputElement;
    const targetSizeUnitSelect = document.getElementById('targetSizeUnitSelect') as HTMLSelectElement;
    const sizePresetChips = document.querySelectorAll('.size-preset-chip');
    const lockRatioCheckbox = document.getElementById('lockRatioCheckbox') as HTMLInputElement;
    const scaleChips = document.querySelectorAll('.scale-chip');
    const executeBtn = document.getElementById('batchExecuteBtn')!;
    const executeBtnText = document.getElementById('executeBtnText')!;
    const progressBarContainer = document.getElementById('progressBarContainer')!;
    const progressBarFill = document.getElementById('progressBarFill')!;
    const progressStatusText = document.getElementById('progressStatusText')!;
    const completedBanner = document.getElementById('batchCompletedBanner')!;
    const completedSummaryText = document.getElementById('completedSummaryText')!;
    const resetBtn = document.getElementById('batchResetBtn')!;
    const downloadZipBtn = document.getElementById('batchDownloadZipBtn')!;
    const compactFilesList = document.getElementById('compactFilesList')!;

    // State
    let items: BatchImageItem[] = [];
    let currentMode: 'dimensions' | 'percentage' = 'percentage';
    let currentPercentage: number = 50;

    function updateCountBadge() {
      countBadge.textContent = i18n.summaryCount.replace('{n}', items.length.toString());
      executeBtnText.textContent = `${i18n.actionResizeAll} (${items.length})`;
    }

    function syncDimensionsFromPrimary() {
      if (items.length === 0) return;
      const ref = items[0];

      if (currentMode === 'percentage') {
        const scale = currentPercentage / 100;
        targetWidthInput.value = Math.max(1, Math.round(ref.originalWidth * scale)).toString();
        targetHeightInput.value = Math.max(1, Math.round(ref.originalHeight * scale)).toString();
      }
    }

    function renderFilesList() {
      compactFilesList.innerHTML = '';

      if (items.length === 0) {
        workspace.style.display = 'none';
        dropzone.style.display = 'block';
        completedBanner.style.display = 'none';
        return;
      }

      workspace.style.display = 'flex';
      dropzone.style.display = 'none';
      updateCountBadge();

      const options: BatchResizeOptions = {
        mode: currentMode,
        width: parseInt(targetWidthInput.value) || items[0].originalWidth,
        height: parseInt(targetHeightInput.value) || items[0].originalHeight,
        lockAspectRatio: lockRatioCheckbox.checked,
        percentage: currentPercentage,
        quality: 0.92,
      };

      items.forEach((item, index) => {
        const targetDims = BatchResizerEngine.calculateTargetDimensions(item, options);
        item.targetWidth = targetDims.width;
        item.targetHeight = targetDims.height;

        const row = document.createElement('div');
        row.className = `compact-file-row ${item.isResized ? 'is-resized' : ''}`;
        row.id = `row_${item.id}`;

        // Left Col: Thumbnail & Info
        const leftCol = document.createElement('div');
        leftCol.className = 'row-left-col';

        const thumb = document.createElement('img');
        thumb.src = item.thumbnailUrl;
        thumb.alt = item.name;
        thumb.className = 'row-thumbnail';
        thumb.loading = 'lazy';

        const infoBox = document.createElement('div');
        infoBox.className = 'row-info-box';

        const nameLabel = document.createElement('div');
        nameLabel.className = 'row-filename';
        nameLabel.textContent = item.name;
        nameLabel.title = item.name;

        const metaLabel = document.createElement('div');
        metaLabel.className = 'row-meta';
        metaLabel.textContent = `${item.originalWidth} × ${item.originalHeight} px • ${item.formattedOriginalSize}`;

        infoBox.appendChild(nameLabel);
        infoBox.appendChild(metaLabel);

        leftCol.appendChild(thumb);
        leftCol.appendChild(infoBox);

        // Center Col: Resized Dimension Preview
        const centerCol = document.createElement('div');
        centerCol.className = 'row-center-col';

        const targetDimTag = document.createElement('span');
        targetDimTag.className = 'row-target-dim';
        targetDimTag.innerHTML = `→ <strong>${targetDims.width} × ${targetDims.height}</strong> px`;
        centerCol.appendChild(targetDimTag);

        // Right Col: Status & Actions
        const rightCol = document.createElement('div');
        rightCol.className = 'row-right-col';

        if (item.isResized && item.resizedUrl) {
          const statusTag = document.createElement('span');
          statusTag.className = 'row-status-tag status-done';
          statusTag.textContent = `${i18n.statusItemResized} (${item.formattedResizedSize})`;

          const dlBtn = document.createElement('button');
          dlBtn.type = 'button';
          dlBtn.className = 'btn btn-primary btn-xs row-download-btn';
          dlBtn.innerHTML = `
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>${i18n.actionDownload}</span>
          `;
          dlBtn.addEventListener('click', () => {
            const outName = item.name.replace(/\.[^/.]+$/, '') + `_resized_${item.targetWidth}x${item.targetHeight}.${item.extension}`;
            BatchResizerEngine.downloadFile(item.resizedUrl!, outName);
          });

          rightCol.appendChild(statusTag);
          rightCol.appendChild(dlBtn);
        } else {
          const statusTag = document.createElement('span');
          statusTag.className = 'row-status-tag status-pending';
          statusTag.textContent = i18n.statusReady;
          rightCol.appendChild(statusTag);
        }

        // Remove row button
        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'row-remove-btn';
        removeBtn.title = i18n.actionRemove;
        removeBtn.innerHTML = `
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        `;
        removeBtn.addEventListener('click', () => {
          if (item.thumbnailUrl) URL.revokeObjectURL(item.thumbnailUrl);
          if (item.resizedUrl) URL.revokeObjectURL(item.resizedUrl);
          items.splice(index, 1);
          renderFilesList();
        });

        rightCol.appendChild(removeBtn);

        row.appendChild(leftCol);
        row.appendChild(centerCol);
        row.appendChild(rightCol);

        compactFilesList.appendChild(row);
      });
    }

    async function handleIncomingFiles(files: FileList | File[]) {
      try {
        loadingCard.style.display = 'flex';
        loadingText.textContent = i18n.statusLoading;

        const newItems = await BatchResizerEngine.inspectFiles(files);
        if (newItems.length === 0) {
          alert(i18n.errorLoad);
          loadingCard.style.display = 'none';
          return;
        }

        items = [...items, ...newItems];

        if (!targetWidthInput.value && items.length > 0) {
          currentPercentage = 50;
          currentMode = 'percentage';
          syncDimensionsFromPrimary();
        }

        loadingCard.style.display = 'none';
        renderFilesList();
      } catch (err) {
        console.error(err);
        alert(i18n.errorLoad);
        loadingCard.style.display = 'none';
      }
    }

    // Execute Batch Resize
    async function executeBatchResize() {
      if (items.length === 0) return;

      try {
        executeBtn.setAttribute('disabled', 'true');
        progressBarContainer.style.display = 'flex';
        progressBarFill.style.width = '0%';
        progressStatusText.textContent = i18n.statusProcessing.replace('{current}', '0').replace('{total}', items.length.toString());

        const w = parseInt(targetWidthInput.value) || items[0].originalWidth;
        const h = parseInt(targetHeightInput.value) || items[0].originalHeight;
        const targetSizeVal = parseFloat(targetFileSizeInput.value);

        const options: BatchResizeOptions = {
          mode: currentMode,
          width: w,
          height: h,
          lockAspectRatio: lockRatioCheckbox.checked,
          percentage: currentPercentage,
          quality: 0.92,
          targetSizeValue: !isNaN(targetSizeVal) && targetSizeVal > 0 ? targetSizeVal : undefined,
          targetSizeUnit: (targetSizeUnitSelect.value as 'KB' | 'MB') || 'KB',
        };

        items = await BatchResizerEngine.resizeBatch(items, options, (cur, tot) => {
          const pct = Math.round((cur / tot) * 100);
          progressBarFill.style.width = `${pct}%`;
          progressStatusText.textContent = i18n.statusProcessing.replace('{current}', cur.toString()).replace('{total}', tot.toString());
        });

        progressBarContainer.style.display = 'none';
        executeBtn.removeAttribute('disabled');

        completedSummaryText.textContent = i18n.statusCompleted.replace('{n}', items.length.toString());
        completedBanner.style.display = 'flex';
        renderFilesList();
        completedBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } catch (err) {
        console.error(err);
        alert(i18n.errorLoad);
        progressBarContainer.style.display = 'none';
        executeBtn.removeAttribute('disabled');
      }
    }

    // Download All ZIP
    downloadZipBtn.addEventListener('click', async () => {
      if (items.length === 0) return;
      try {
        downloadZipBtn.setAttribute('disabled', 'true');
        const zipBlob = await BatchResizerEngine.createZipArchive(items, 'resized_images');
        const zipUrl = URL.createObjectURL(zipBlob);
        BatchResizerEngine.downloadFile(zipUrl, 'resized_images.zip');
        setTimeout(() => URL.revokeObjectURL(zipUrl), 30000);
      } catch (err) {
        console.error(err);
        alert(i18n.errorZip);
      } finally {
        downloadZipBtn.removeAttribute('disabled');
      }
    });

    // File Input
    fileInput.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.files && target.files.length > 0) {
        handleIncomingFiles(target.files);
        fileInput.value = '';
      }
    });

    addMoreInput.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.files && target.files.length > 0) {
        handleIncomingFiles(target.files);
        addMoreInput.value = '';
      }
    });

    // Sample Batch Button
    sampleBtn.addEventListener('click', async () => {
      try {
        loadingCard.style.display = 'flex';
        loadingText.textContent = i18n.statusSampleGenerating;
        const sampleFiles = await BatchResizerEngine.generateSampleBatch();
        await handleIncomingFiles(sampleFiles);
      } catch (e) {
        console.error(e);
        loadingCard.style.display = 'none';
      }
    });

    // Clear All
    clearAllBtn.addEventListener('click', () => {
      BatchResizerEngine.cleanup(items);
      items = [];
      renderFilesList();
    });

    // Reset
    resetBtn.addEventListener('click', () => {
      items.forEach((item) => {
        item.isResized = false;
        if (item.resizedUrl) {
          URL.revokeObjectURL(item.resizedUrl);
          item.resizedUrl = undefined;
          item.resizedBlob = undefined;
        }
      });
      completedBanner.style.display = 'none';
      renderFilesList();
      workspace.scrollIntoView({ behavior: 'smooth' });
    });

    // Scale Chips
    scaleChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        scaleChips.forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');

        const pct = parseInt(chip.getAttribute('data-scale') || '50');
        currentPercentage = pct;
        currentMode = 'percentage';

        syncDimensionsFromPrimary();
        renderFilesList();
      });
    });

    // Inputs: Width & Height
    targetWidthInput.addEventListener('input', () => {
      scaleChips.forEach((c) => c.classList.remove('active'));
      currentMode = 'dimensions';

      if (lockRatioCheckbox.checked && items.length > 0) {
        const ref = items[0];
        const w = parseInt(targetWidthInput.value) || ref.originalWidth;
        const ratio = ref.originalWidth / ref.originalHeight;
        targetHeightInput.value = Math.max(1, Math.round(w / ratio)).toString();
      }
      renderFilesList();
    });

    targetHeightInput.addEventListener('input', () => {
      scaleChips.forEach((c) => c.classList.remove('active'));
      currentMode = 'dimensions';

      if (lockRatioCheckbox.checked && items.length > 0) {
        const ref = items[0];
        const h = parseInt(targetHeightInput.value) || ref.originalHeight;
        const ratio = ref.originalWidth / ref.originalHeight;
        targetWidthInput.value = Math.max(1, Math.round(h * ratio)).toString();
      }
      renderFilesList();
    });

    lockRatioCheckbox.addEventListener('change', () => {
      if (lockRatioCheckbox.checked && items.length > 0) {
        const ref = items[0];
        const w = parseInt(targetWidthInput.value) || ref.originalWidth;
        const ratio = ref.originalWidth / ref.originalHeight;
        targetHeightInput.value = Math.max(1, Math.round(w / ratio)).toString();
      }
      renderFilesList();
    });

    // Target File Size Presets
    sizePresetChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const sizeVal = chip.getAttribute('data-size');
        const unitVal = chip.getAttribute('data-unit');

        if (chip.classList.contains('active')) {
          chip.classList.remove('active');
          targetFileSizeInput.value = '';
        } else {
          sizePresetChips.forEach((c) => c.classList.remove('active'));
          chip.classList.add('active');
          if (sizeVal) targetFileSizeInput.value = sizeVal;
          if (unitVal) targetSizeUnitSelect.value = unitVal;
        }
      });
    });

    targetFileSizeInput.addEventListener('input', () => {
      sizePresetChips.forEach((c) => c.classList.remove('active'));
    });

    targetSizeUnitSelect.addEventListener('change', () => {
      sizePresetChips.forEach((c) => c.classList.remove('active'));
    });

    // Execute Button
    executeBtn.addEventListener('click', executeBatchResize);

    // Drag & Drop
    ['dragenter', 'dragover'].forEach((ev) => {
      dropzone.addEventListener(ev, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('drag-active');
      });
    });

    ['dragleave', 'drop'].forEach((ev) => {
      dropzone.addEventListener(ev, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('drag-active');
      });
    });

    dropzone.addEventListener('drop', (e) => {
      if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
        handleIncomingFiles(e.dataTransfer.files);
      }
    });

    // Clipboard Paste
    document.addEventListener('paste', (e) => {
      const pasteItems = e.clipboardData?.items;
      if (!pasteItems) return;
      const files: File[] = [];
      for (const item of pasteItems) {
        if (item.type.startsWith('image/')) {
          const file = item.getAsFile();
          if (file) files.push(file);
        }
      }
      if (files.length > 0) {
        handleIncomingFiles(files);
      }
    });
  });
</script>


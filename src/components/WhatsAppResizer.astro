---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div id="wa-resizer-container" class="wa-resizer-card">
  <!-- Hidden File Input -->
  <input type="file" id="wa-file-input" accept="image/jpeg,image/png,image/webp" class="sr-only" />

  <!-- Upload Dropzone -->
  <div id="wa-dropzone" class="wa-dropzone">
    <div class="dropzone-icon">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="17 8 12 3 7 8"></polyline>
        <line x1="12" y1="3" x2="12" y2="15"></line>
      </svg>
    </div>
    <h3 class="dropzone-title">{t(locale, 'waresizer.dropzone.title')}</h3>
    <p class="dropzone-subtitle">{t(locale, 'waresizer.dropzone.subtitle')}</p>
  </div>

  <!-- Main Editor Area (Hidden until image upload) -->
  <div id="wa-editor-area" class="wa-editor-area" hidden>
    <!-- Circle Guidance Tip -->
    <div class="wa-tip-box">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
      <span>{t(locale, 'waresizer.circleTip')}</span>
    </div>

    <div class="editor-grid">
      <!-- Left Column: Interactive Canvas & Previews -->
      <div class="canvas-column">
        <div class="canvas-wrapper">
          <canvas id="wa-main-canvas" width="800" height="800" class="wa-canvas"></canvas>
          <!-- Circular Safe Area Overlay -->
          <div class="circle-overlay" aria-hidden="true"></div>
          <span class="drag-badge">{t(locale, 'waresizer.circleTip')}</span>
        </div>

        <!-- Live Circular Preview Card -->
        <div class="preview-card">
          <div class="preview-item">
            <div class="circle-preview-frame">
              <canvas id="wa-circle-canvas" width="160" height="160"></canvas>
            </div>
            <span class="preview-label">{t(locale, 'waresizer.preview.circle')}</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Controls -->
      <div class="controls-column">
        <!-- Mode Switcher -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'home.howItWorks.step2.title')}</label>
          <div class="mode-tabs">
            <button type="button" class="wa-mode-btn active" data-mode="fit">
              {t(locale, 'waresizer.mode.fit')}
            </button>
            <button type="button" class="wa-mode-btn" data-mode="fill">
              {t(locale, 'waresizer.mode.fill')}
            </button>
          </div>
        </div>

        <!-- Background Options (Conditional: Shown in Fit mode) -->
        <div id="wa-bg-controls" class="control-group">
          <label class="control-label">{t(locale, 'waresizer.bg.label')}</label>
          <div class="bg-tabs">
            <button type="button" class="wa-bg-btn active" data-bg="blur">
              {t(locale, 'waresizer.bg.blur')}
            </button>
            <button type="button" class="wa-bg-btn" data-bg="solid">
              {t(locale, 'waresizer.bg.solid')}
            </button>
          </div>

          <!-- Blur Strength Slider (Conditional: Shown when bg is blur) -->
          <div id="wa-blur-group" class="sub-control">
            <div class="slider-header">
              <label for="wa-blur-input" class="sub-label">{t(locale, 'waresizer.label.blurStrength')}</label>
            </div>
            <input type="range" id="wa-blur-input" min="5" max="40" value="20" class="wa-range" />
          </div>

          <!-- Color Picker (Conditional: Shown when bg is solid) -->
          <div id="wa-color-group" class="sub-control" hidden>
            <label class="sub-label">{t(locale, 'waresizer.bg.color')}</label>
            <div class="color-picker-row">
              <button type="button" class="wa-color-pill" data-color="#ffffff" style="background:#ffffff" title="White"></button>
              <button type="button" class="wa-color-pill" data-color="#000000" style="background:#000000" title="Black"></button>
              <button type="button" class="wa-color-pill" data-color="#25D366" style="background:#25D366" title="WhatsApp Green"></button>
              <button type="button" class="wa-color-pill" data-color="#075E54" style="background:#075E54" title="Dark Teal"></button>
              <input type="color" id="wa-custom-color" value="#ffffff" class="wa-color-picker" title="Custom color" />
            </div>
          </div>
        </div>

        <!-- Zoom / Scale Control -->
        <div class="control-group">
          <div class="slider-header">
            <label for="wa-zoom-input" class="control-label">{t(locale, 'waresizer.label.zoom')}</label>
          </div>
          <input type="range" id="wa-zoom-input" min="0.8" max="3.0" step="0.05" value="1.0" class="wa-range" />
        </div>

        <!-- Preset Resolution Selector -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'waresizer.label.resolution')}</label>
          <div class="preset-buttons">
            <button type="button" class="wa-preset-btn" data-size="500">{t(locale, 'waresizer.preset.500')}</button>
            <button type="button" class="wa-preset-btn active" data-size="800">{t(locale, 'waresizer.preset.800')}</button>
            <button type="button" class="wa-preset-btn" data-size="1000">{t(locale, 'waresizer.preset.1000')}</button>
          </div>
        </div>

        <!-- Output Format -->
        <div class="control-group">
          <label for="wa-format-select" class="control-label">{t(locale, 'resizer.label.outputFormat')}</label>
          <select id="wa-format-select" class="wa-select">
            <option value="image/jpeg">JPG (Recommended)</option>
            <option value="image/png">PNG</option>
            <option value="image/webp">WebP</option>
          </select>
        </div>

        <!-- Action Buttons -->
        <div class="actions-row">
          <button type="button" id="wa-download-btn" class="btn btn-primary btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>{t(locale, 'waresizer.action.download')}</span>
          </button>
          <button type="button" id="wa-change-img-btn" class="btn btn-secondary">
            {t(locale, 'waresizer.action.newImage')}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import '@/scripts/whatsapp-resizer';
</script>

<style>
  .wa-resizer-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-md);
  }

  .wa-dropzone {
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-12) var(--space-6);
    text-align: center;
    cursor: pointer;
    transition: border-color .15s, background-color .15s;
    background: var(--color-surface);
  }
  .wa-dropzone:hover,
  .wa-dropzone.drag-over {
    border-color: var(--color-accent);
    background: var(--color-accent-light);
  }
  .dropzone-icon {
    color: var(--color-accent);
    margin-bottom: var(--space-4);
    display: flex;
    justify-content: center;
  }
  .dropzone-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }
  .dropzone-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .wa-tip-box {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-accent-light);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }
  .wa-tip-box svg {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }
  @media (min-width: 768px) {
    .editor-grid {
      grid-template-columns: 340px 1fr;
    }
  }

  .canvas-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .canvas-wrapper {
    position: relative;
    width: 280px;
    height: 280px;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 2px solid var(--color-border);
    touch-action: none;
    cursor: grab;
  }
  .canvas-wrapper:active {
    cursor: grabbing;
  }

  .wa-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .circle-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at center, transparent 48%, rgba(15, 23, 42, 0.55) 49%);
    border-radius: var(--radius-md);
  }

  .drag-badge {
    position: absolute;
    bottom: var(--space-2);
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 12px;
    pointer-events: none;
  }

  .preview-card {
    display: flex;
    justify-content: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    width: 100%;
  }

  .preview-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .circle-preview-frame {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--color-accent);
    box-shadow: var(--shadow-sm);
  }

  .circle-preview-frame canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .preview-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .controls-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .control-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .mode-tabs,
  .bg-tabs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
  }

  .wa-mode-btn,
  .wa-bg-btn,
  .wa-preset-btn {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 600;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    transition: all .15s;
  }

  .wa-mode-btn.active,
  .wa-bg-btn.active,
  .wa-preset-btn.active {
    background: var(--color-accent-light);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .sub-control {
    margin-top: var(--space-3);
    padding: var(--space-3);
    background: var(--color-surface);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .sub-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
    display: block;
  }

  .wa-range {
    width: 100%;
    accent-color: var(--color-accent);
  }

  .color-picker-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .wa-color-pill {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid var(--color-border);
    cursor: pointer;
    transition: transform .15s;
  }
  .wa-color-pill:hover {
    transform: scale(1.1);
  }

  .wa-color-picker {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    cursor: pointer;
    padding: 0;
    background: none;
  }

  .preset-buttons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
  }

  .wa-select {
    width: 100%;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  .actions-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  @media (min-width: 500px) {
    .actions-row {
      flex-direction: row;
    }
  }
</style>

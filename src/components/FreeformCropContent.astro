---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: t(locale, 'freeformCrop.faq.q1'),
      acceptedAnswer: {
        '@type': 'Answer',
        text: t(locale, 'freeformCrop.faq.a1'),
      },
    },
    {
      '@type': 'Question',
      name: t(locale, 'freeformCrop.faq.q2'),
      acceptedAnswer: {
        '@type': 'Answer',
        text: t(locale, 'freeformCrop.faq.a2'),
      },
    },
    {
      '@type': 'Question',
      name: t(locale, 'freeformCrop.faq.q3'),
      acceptedAnswer: {
        '@type': 'Answer',
        text: t(locale, 'freeformCrop.faq.a3'),
      },
    },
    {
      '@type': 'Question',
      name: t(locale, 'freeformCrop.faq.q4'),
      acceptedAnswer: {
        '@type': 'Answer',
        text: t(locale, 'freeformCrop.faq.a4'),
      },
    },
    {
      '@type': 'Question',
      name: t(locale, 'freeformCrop.faq.q5'),
      acceptedAnswer: {
        '@type': 'Answer',
        text: t(locale, 'freeformCrop.faq.a5'),
      },
    },
    {
      '@type': 'Question',
      name: t(locale, 'freeformCrop.faq.q6'),
      acceptedAnswer: {
        '@type': 'Answer',
        text: t(locale, 'freeformCrop.faq.a6'),
      },
    },
    {
      '@type': 'Question',
      name: t(locale, 'freeformCrop.faq.q7'),
      acceptedAnswer: {
        '@type': 'Answer',
        text: t(locale, 'freeformCrop.faq.a7'),
      },
    },
  ],
};
---

<section class="content-section" aria-label="Freeform Image Cropper Guide">
  <div class="container">
    <div class="content-body">
      <!-- Section 1: Introduction -->
      <h2>{t(locale, 'freeformCrop.content.h1')}</h2>
      <p>{t(locale, 'freeformCrop.content.p1a')}</p>
      <p>{t(locale, 'freeformCrop.content.p1b')}</p>

      <!-- Key Capabilities Cards -->
      <div class="feature-cards-grid">
        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 2v14a2 2 0 0 0 2 2h14"></path>
              <path d="M18 22V8a2 2 0 0 0-2-2H2"></path>
            </svg>
          </div>
          <h3>{t(locale, 'freeformCrop.feat.freeTitle')}</h3>
          <p>{t(locale, 'freeformCrop.feat.freeDesc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2"></rect>
              <line x1="3" y1="9" x2="21" y2="9"></line>
              <line x1="3" y1="15" x2="21" y2="15"></line>
              <line x1="9" y1="3" x2="9" y2="21"></line>
              <line x1="15" y1="3" x2="15" y2="21"></line>
            </svg>
          </div>
          <h3>{t(locale, 'freeformCrop.feat.gridTitle')}</h3>
          <p>{t(locale, 'freeformCrop.feat.gridDesc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
            </svg>
          </div>
          <h3>{t(locale, 'freeformCrop.feat.transformTitle')}</h3>
          <p>{t(locale, 'freeformCrop.feat.transformDesc')}</p>
        </div>

        <div class="feature-card">
          <div class="feature-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3>{t(locale, 'freeformCrop.feat.privacyTitle')}</h3>
          <p>{t(locale, 'freeformCrop.feat.privacyDesc')}</p>
        </div>
      </div>

      <!-- Section 2: Fixed vs Freeform Cropping -->
      <h2>{t(locale, 'freeformCrop.content.h2')}</h2>
      <p>{t(locale, 'freeformCrop.content.p2a')}</p>
      <p>{t(locale, 'freeformCrop.content.p2b')}</p>

      <!-- Comparison Data Table -->
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Cropping Mode</th>
              <th>Bounding Geometry</th>
              <th>Best Practical Use Cases</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Freeform Unconstrained</strong></td>
              <td>Arbitrary Width × Height</td>
              <td>Removing photo clutter, custom banners, signature isolation, object clipping</td>
            </tr>
            <tr>
              <td><strong>1:1 Square</strong></td>
              <td>Equal width and height</td>
              <td>Instagram feed, avatars, WhatsApp profiles, app product icons</td>
            </tr>
            <tr>
              <td><strong>16:9 Widescreen</strong></td>
              <td>1.777:1 Landscape</td>
              <td>YouTube thumbnails, presentation slides, desktop wallpaper, video frames</td>
            </tr>
            <tr>
              <td><strong>9:16 Vertical</strong></td>
              <td>0.562:1 Portrait</td>
              <td>TikTok clips, Instagram Reels, YouTube Shorts, mobile wallpapers</td>
            </tr>
            <tr>
              <td><strong>4:3 Standard</strong></td>
              <td>1.333:1 Ratio</td>
              <td>Digital photography, iPad displays, printed photo albums</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 3: The Composition & Rule of Thirds Advantage -->
      <h2>{t(locale, 'freeformCrop.content.h3')}</h2>
      <p>{t(locale, 'freeformCrop.content.p3a')}</p>
      <p>{t(locale, 'freeformCrop.content.p3b')}</p>

      <!-- Section 4: High Resolution Quality & Pixel Precision -->
      <h2>{t(locale, 'freeformCrop.content.h4')}</h2>
      <p>{t(locale, 'freeformCrop.content.p4a')}</p>
      <p>{t(locale, 'freeformCrop.content.p4b')}</p>

      <!-- Section 5: Common Practical Workflows & Scenarios -->
      <h2>{t(locale, 'freeformCrop.content.h5')}</h2>
      <p>{t(locale, 'freeformCrop.content.p5a')}</p>
      <p>{t(locale, 'freeformCrop.content.p5b')}</p>

      <!-- Section 6: Step-by-Step Tutorial -->
      <h2>{t(locale, 'freeformCrop.content.h6')}</h2>
      <ol class="tutorial-steps-list">
        <li><strong>{t(locale, 'freeformCrop.content.step1Title')}:</strong> {t(locale, 'freeformCrop.content.step1Desc')}</li>
        <li><strong>{t(locale, 'freeformCrop.content.step2Title')}:</strong> {t(locale, 'freeformCrop.content.step2Desc')}</li>
        <li><strong>{t(locale, 'freeformCrop.content.step3Title')}:</strong> {t(locale, 'freeformCrop.content.step3Desc')}</li>
        <li><strong>{t(locale, 'freeformCrop.content.step4Title')}:</strong> {t(locale, 'freeformCrop.content.step4Desc')}</li>
      </ol>

      <!-- Section 7: FAQ Accordion -->
      <div class="faq-container">
        <h2>{t(locale, 'freeformCrop.faq.heading')}</h2>
        
        <div class="faq-accordion">
          <details class="faq-item" open>
            <summary class="faq-question"><h3>{t(locale, 'freeformCrop.faq.q1')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'freeformCrop.faq.a1')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'freeformCrop.faq.q2')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'freeformCrop.faq.a2')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'freeformCrop.faq.q3')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'freeformCrop.faq.a3')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'freeformCrop.faq.q4')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'freeformCrop.faq.a4')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'freeformCrop.faq.q5')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'freeformCrop.faq.a5')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'freeformCrop.faq.q6')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'freeformCrop.faq.a6')}</p></div>
          </details>

          <details class="faq-item">
            <summary class="faq-question"><h3>{t(locale, 'freeformCrop.faq.q7')}</h3></summary>
            <div class="faq-answer"><p>{t(locale, 'freeformCrop.faq.a7')}</p></div>
          </details>
        </div>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .content-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-10) 0;
  }

  @media (min-width: 640px) {
    .content-section {
      padding: var(--space-12) 0;
    }
  }

  .content-body {
    max-width: var(--container-narrow);
    margin-inline: auto;
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.75;
    box-sizing: border-box;
  }

  .content-body h2 {
    color: var(--color-text);
    font-size: var(--text-xl);
    font-weight: 800;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    letter-spacing: -0.02em;
    line-height: 1.3;
    word-break: break-word;
  }

  @media (min-width: 640px) {
    .content-body h2 {
      font-size: var(--text-2xl);
      margin-top: var(--space-10);
      margin-bottom: var(--space-4);
    }
  }

  .content-body h2:first-child {
    margin-top: 0;
  }

  .content-body p {
    margin-bottom: var(--space-4);
  }

  .content-body ul,
  .content-body ol {
    margin-bottom: var(--space-6);
    padding-left: var(--space-5);
  }

  .content-body li {
    margin-bottom: var(--space-2-5);
  }

  .content-body strong {
    color: var(--color-text);
  }

  .feature-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin: var(--space-6) 0 var(--space-8) 0;
  }

  @media (min-width: 640px) {
    .feature-cards-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .feature-card {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .feature-card-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-card h3 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .feature-card p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .table-responsive {
    overflow-x: auto;
    margin: var(--space-6) 0 var(--space-8) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .data-table th,
  .data-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  .data-table th {
    background: var(--color-surface-subtle);
    font-weight: 700;
    color: var(--color-text);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  /* FAQ */
  .faq-container {
    margin-top: var(--space-12);
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
    overflow: hidden;
  }

  .faq-question {
    padding: var(--space-4);
    cursor: pointer;
    font-weight: 600;
    user-select: none;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question h3 {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: 700;
  }

  .faq-answer {
    padding: 0 var(--space-4) var(--space-4) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .faq-answer p {
    margin: 0;
  }
</style>

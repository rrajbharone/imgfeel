---
import { t } from '@/i18n/utils';
import SEOHead from './SEOHead.astro';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const faqs = [
  { qKey: 'home.faq.q1.question', aKey: 'home.faq.q1.answer' },
  { qKey: 'home.faq.q2.question', aKey: 'home.faq.q2.answer' },
  { qKey: 'home.faq.q3.question', aKey: 'home.faq.q3.answer' },
  { qKey: 'home.faq.q4.question', aKey: 'home.faq.q4.answer' },
  { qKey: 'home.faq.q5.question', aKey: 'home.faq.q5.answer' },
  { qKey: 'home.faq.q6.question', aKey: 'home.faq.q6.answer' },
  { qKey: 'home.faq.q7.question', aKey: 'home.faq.q7.answer' },
  { qKey: 'home.faq.q8.question', aKey: 'home.faq.q8.answer' },
  { qKey: 'home.faq.q9.question', aKey: 'home.faq.q9.answer' },
  { qKey: 'home.faq.q10.question', aKey: 'home.faq.q10.answer' },
  { qKey: 'home.faq.q11.question', aKey: 'home.faq.q11.answer' },
  { qKey: 'home.faq.q12.question', aKey: 'home.faq.q12.answer' },
  { qKey: 'home.faq.q13.question', aKey: 'home.faq.q13.answer' },
  { qKey: 'home.faq.q14.question', aKey: 'home.faq.q14.answer' },
  { qKey: 'home.faq.q15.question', aKey: 'home.faq.q15.answer' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: t(locale, faq.qKey),
    acceptedAnswer: {
      '@type': 'Answer',
      text: t(locale, faq.aKey),
    },
  })),
};
---

<section class="section faq-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{t(locale, 'home.faq.title')}</h2>
    </div>
    <div class="faq-list">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary class="faq-question">
            <span>{t(locale, faq.qKey)}</span>
            <span class="faq-icon-indicator" aria-hidden="true"></span>
          </summary>
          <div class="faq-answer-wrapper">
            <p class="faq-answer">{t(locale, faq.aKey)}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
  <SEOHead schema={faqSchema} />
</section>

<style>
  .section-header {
    text-align: center;
    margin-bottom: var(--space-8);
  }
  .section-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
    margin-bottom: 0;
  }
  .faq-list {
    max-width: var(--container-narrow);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .faq-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    overflow: hidden;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .faq-item:hover {
    border-color: var(--color-border-hover);
  }
  .faq-item[open] {
    border-color: var(--color-accent-border);
    box-shadow: var(--shadow-sm);
  }
  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    min-height: 48px;
    gap: var(--space-3);
    user-select: none;
  }
  @media (min-width: 640px) {
    .faq-question {
      font-size: var(--text-base);
    }
  }
  .faq-question::-webkit-details-marker {
    display: none;
  }
  .faq-question::marker {
    display: none;
    content: '';
  }
  .faq-icon-indicator {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-sm);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    transition: all 0.15s ease;
  }
  .faq-icon-indicator::before,
  .faq-icon-indicator::after {
    content: '';
    position: absolute;
    background: var(--color-text-secondary);
    transition: all 0.15s ease;
  }
  .faq-icon-indicator::before {
    width: 10px;
    height: 2px;
  }
  .faq-icon-indicator::after {
    width: 2px;
    height: 10px;
  }
  .faq-item[open] .faq-icon-indicator {
    background: var(--color-accent-light);
    border-color: var(--color-accent-border);
  }
  .faq-item[open] .faq-icon-indicator::before {
    background: var(--color-accent);
  }
  .faq-item[open] .faq-icon-indicator::after {
    transform: rotate(90deg);
    opacity: 0;
  }
  .faq-answer-wrapper {
    padding: 0 var(--space-5) var(--space-4);
  }
  .faq-answer {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.65;
  }
  @media (min-width: 640px) {
    .faq-answer {
      font-size: var(--text-sm);
    }
    .section-title {
      font-size: var(--text-3xl);
    }
  }
</style>

---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div
  class="dimensions-checker"
  id="dimensions-checker-app"
>
  <!-- Upload State -->
  <div class="checker-upload" id="dim-upload">
    <div class="dropzone" id="dim-dropzone">
      <div class="dropzone-icon-box">
        <svg class="dropzone-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 7V5a2 2 0 0 1 2-2h2"></path>
          <path d="M17 3h2a2 2 0 0 1 2 2v2"></path>
          <path d="M21 17v2a2 2 0 0 1-2 2h-2"></path>
          <path d="M7 21H5a2 2 0 0 1-2-2v-2"></path>
          <rect x="7" y="7" width="10" height="10" rx="1.5"></rect>
          <path d="m14 10-4 4"></path>
          <path d="M10 10h4v4"></path>
        </svg>
      </div>
      <p class="dropzone-title">{t(locale, 'dimcheck.dropzone.title')}</p>
      <p class="dropzone-subtitle">{t(locale, 'dimcheck.dropzone.subtitle')}</p>
      
      <div class="dropzone-actions">
        <button type="button" class="btn btn-primary btn-browse">{t(locale, 'dimcheck.dropzone.browse')}</button>
        <button type="button" class="btn btn-secondary btn-sm" id="dim-btn-sample">{t(locale, 'dimcheck.dropzone.sample')}</button>
      </div>

      <div class="dropzone-footer">
        <p class="dropzone-formats">{t(locale, 'dimcheck.dropzone.formats')}</p>
        <span class="privacy-badge">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>{t(locale, 'dimcheck.privacy.badge')}</span>
        </span>
      </div>

      <input
        type="file"
        id="dim-file-input"
        accept="image/*,.jpg,.jpeg,.png,.webp,.gif,.svg,.avif,.bmp,.ico,.tiff"
        class="sr-only"
      />
    </div>
  </div>

  <!-- Editor / Results State (Hidden initially) -->
  <div class="checker-editor" id="dim-editor" hidden>
    <!-- Top Action Bar -->
    <div class="top-action-bar">
      <div class="bar-left">
        <span class="status-indicator"></span>
        <span class="status-text">{t(locale, 'dimcheck.status.analyzed')}</span>
      </div>
      <div class="bar-right">
        <button type="button" class="btn btn-secondary btn-sm action-btn" id="dim-btn-copy-dim">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span>{t(locale, 'dimcheck.action.copyDim')}</span>
        </button>
        <button type="button" class="btn btn-secondary btn-sm action-btn" id="dim-btn-copy-specs">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
          </svg>
          <span>{t(locale, 'dimcheck.action.copySpecs')}</span>
        </button>
        <button type="button" class="btn btn-primary btn-sm action-btn action-new" id="dim-btn-new">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'dimcheck.action.newImage')}</span>
        </button>
      </div>
    </div>

    <!-- Main Grid: Preview & Core Metrics -->
    <div class="editor-grid">
      <!-- Left: Interactive Preview -->
      <div class="preview-column">
        <div class="preview-card">
          <div class="preview-viewport">
            <img id="dim-preview" class="preview-img" alt="Uploaded image preview" />
            <!-- Live Overlay Badges -->
            <div class="preview-overlay">
              <span class="preview-tag tag-dimensions" id="dim-badge-dimensions">—</span>
              <span class="preview-tag tag-aspect" id="dim-badge-aspect">—</span>
              <span class="preview-tag tag-format" id="dim-badge-format">—</span>
            </div>
          </div>
        </div>

        <!-- Color Palette Extraction Box -->
        <div class="palette-card">
          <div class="card-header-compact">
            <span class="header-title">{t(locale, 'dimcheck.section.palette')}</span>
            <span class="header-hint">{t(locale, 'dimcheck.palette.hint')}</span>
          </div>
          <div class="palette-swatches" id="dim-palette-list">
            <!-- Dynamically populated -->
          </div>
        </div>
      </div>

      <!-- Right: Primary 4 Key Metric Summary Cards & Detailed Sections -->
      <div class="metrics-column">
        <div class="summary-cards-grid">
          <!-- Card 1: Dimensions -->
          <div class="metric-card highlight-card">
            <div class="metric-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 3 21 3 21 9"></polyline>
                <polyline points="9 21 3 21 3 15"></polyline>
                <line x1="21" y1="3" x2="14" y2="10"></line>
                <line x1="3" y1="21" x2="10" y2="14"></line>
              </svg>
            </div>
            <div class="metric-info">
              <span class="metric-label">{t(locale, 'dimcheck.metric.dimensions')}</span>
              <span class="metric-value-lg" id="dim-val-resolution">—</span>
            </div>
          </div>

          <!-- Card 2: Megapixels -->
          <div class="metric-card">
            <div class="metric-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
            </div>
            <div class="metric-info">
              <span class="metric-label">{t(locale, 'dimcheck.metric.megapixels')}</span>
              <span class="metric-value" id="dim-val-megapixels">—</span>
            </div>
          </div>

          <!-- Card 3: Aspect Ratio -->
          <div class="metric-card">
            <div class="metric-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <line x1="12" y1="4" x2="12" y2="20"></line>
              </svg>
            </div>
            <div class="metric-info">
              <span class="metric-label">{t(locale, 'dimcheck.metric.aspectRatio')}</span>
              <span class="metric-value" id="dim-val-aspect">—</span>
            </div>
          </div>

          <!-- Card 4: File Size -->
          <div class="metric-card">
            <div class="metric-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
                <polyline points="13 2 13 9 20 9"></polyline>
              </svg>
            </div>
            <div class="metric-info">
              <span class="metric-label">{t(locale, 'dimcheck.metric.fileSize')}</span>
              <span class="metric-value" id="dim-val-size">—</span>
            </div>
          </div>
        </div>

        <!-- Section 1: Interactive Physical Print Calculator -->
        <div class="detail-card">
          <div class="detail-header">
            <div class="header-with-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                <rect x="6" y="14" width="12" height="8"></rect>
              </svg>
              <h3 class="detail-title">{t(locale, 'dimcheck.section.print')}</h3>
            </div>
            <div class="dpi-controls">
              <label for="dim-dpi-select" class="dpi-label">{t(locale, 'dimcheck.print.density')}:</label>
              <select id="dim-dpi-select" class="custom-select select-sm">
                <option value="300" selected>300 DPI ({t(locale, 'dimcheck.dpi.photo')})</option>
                <option value="150">150 DPI ({t(locale, 'dimcheck.dpi.draft')})</option>
                <option value="72">72 DPI ({t(locale, 'dimcheck.dpi.screen')})</option>
                <option value="600">600 DPI ({t(locale, 'dimcheck.dpi.fineart')})</option>
                <option value="custom">{t(locale, 'dimcheck.dpi.custom')}</option>
              </select>
            </div>
          </div>

          <div class="custom-dpi-row" id="dim-custom-dpi-group" style="display: none;">
            <label for="dim-custom-dpi-input">{t(locale, 'dimcheck.print.enterDpi')}:</label>
            <input type="number" id="dim-custom-dpi-input" class="custom-input" min="1" max="2400" value="300" />
          </div>

          <div class="print-results-grid">
            <div class="print-unit-box">
              <span class="unit-tag">{t(locale, 'dimcheck.unit.inches')}</span>
              <span class="unit-val" id="dim-print-in">—</span>
            </div>
            <div class="print-unit-box">
              <span class="unit-tag">{t(locale, 'dimcheck.unit.cm')}</span>
              <span class="unit-val" id="dim-print-cm">—</span>
            </div>
            <div class="print-unit-box">
              <span class="unit-tag">{t(locale, 'dimcheck.unit.mm')}</span>
              <span class="unit-val" id="dim-print-mm">—</span>
            </div>
          </div>
        </div>

        <!-- Section 2: Technical & File Properties -->
        <div class="detail-card">
          <div class="header-with-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <h3 class="detail-title">{t(locale, 'dimcheck.section.fileProps')}</h3>
          </div>

          <div class="specs-table">
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'dimcheck.table.filename')}</span>
              <span class="spec-value" id="dim-table-filename">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'dimcheck.table.mime')}</span>
              <span class="spec-value" id="dim-table-mime">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'dimcheck.table.stdmatch')}</span>
              <span class="spec-value" id="dim-table-stdmatch">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'dimcheck.table.bpp')}</span>
              <span class="spec-value" id="dim-table-bpp">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'dimcheck.table.alpha')}</span>
              <span class="spec-value" id="dim-table-alpha">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'dimcheck.table.colordepth')}</span>
              <span class="spec-value" id="dim-table-colordepth">—</span>
            </div>
          </div>
        </div>

        <!-- Section 3: Camera EXIF Metadata (Shown when EXIF exists) -->
        <div class="detail-card" id="dim-exif-card" style="display: none;">
          <div class="header-with-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
              <circle cx="12" cy="13" r="4"></circle>
            </svg>
            <h3 class="detail-title">{t(locale, 'dimcheck.section.exif')}</h3>
          </div>

          <div class="specs-table">
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'dimcheck.exif.camera')}</span>
              <span class="spec-value" id="dim-exif-camera">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'dimcheck.exif.date')}</span>
              <span class="spec-value" id="dim-exif-date">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'dimcheck.exif.exposure')}</span>
              <span class="spec-value" id="dim-exif-exposure">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'dimcheck.exif.aperture')}</span>
              <span class="spec-value" id="dim-exif-aperture">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'dimcheck.exif.iso')}</span>
              <span class="spec-value" id="dim-exif-iso">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'dimcheck.exif.focal')}</span>
              <span class="spec-value" id="dim-exif-focal">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'dimcheck.exif.lens')}</span>
              <span class="spec-value" id="dim-exif-lens">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'dimcheck.exif.software')}</span>
              <span class="spec-value" id="dim-exif-software">—</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">{t(locale, 'dimcheck.exif.gps')}</span>
              <span class="spec-value" id="dim-exif-gps">—</span>
            </div>
          </div>
        </div>

        <!-- Section 4: Social & Web Fit Guide -->
        <div class="detail-card">
          <div class="header-with-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            <h3 class="detail-title">{t(locale, 'dimcheck.section.socialFit')}</h3>
          </div>

          <div class="platform-badges-grid">
            <span class="platform-status-pill" id="plat-ig-square">Instagram Square</span>
            <span class="platform-status-pill" id="plat-ig-story">Instagram Story / Reel</span>
            <span class="platform-status-pill" id="plat-yt-thumb">YouTube Thumbnail</span>
            <span class="platform-status-pill" id="plat-yt-banner">YouTube Banner</span>
            <span class="platform-status-pill" id="plat-fb-share">Facebook Share</span>
            <span class="platform-status-pill" id="plat-x-header">X / Twitter Header</span>
          </div>
        </div>

        <!-- Next Actions / Tool Suggestions -->
        <div class="tool-links-box">
          <p class="tool-links-title">{t(locale, 'dimcheck.nextActions.title')}</p>
          <div class="tool-quick-links">
            <a href={locale === 'en' ? '/tools/resize-image-to-exact-dimensions/' : `/${locale}/tools/redimensionar-imagen-a-dimensiones-exactas/`} class="btn btn-secondary btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 3 21 3 21 9"></polyline>
                <polyline points="9 21 3 21 3 15"></polyline>
                <line x1="21" y1="3" x2="14" y2="10"></line>
                <line x1="3" y1="21" x2="10" y2="14"></line>
              </svg>
              <span>{t(locale, 'dimcheck.nextActions.resize')}</span>
            </a>
            <a href={locale === 'en' ? '/tools/webp-image-compressor/' : `/${locale}/tools/compresor-de-imagenes-webp/`} class="btn btn-secondary btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
              <span>{t(locale, 'dimcheck.nextActions.compress')}</span>
            </a>
            <a href={locale === 'en' ? '/tools/resize-image-in-cm-mm/' : `/${locale}/tools/redimensionar-imagen-en-cm-mm/`} class="btn btn-secondary btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21.3 8.7 8.7 21.3a1 1 0 0 1-1.4 0l-4.6-4.6a1 1 0 0 1 0-1.4L15.3 2.7a1 1 0 0 1 1.4 0l4.6 4.6a1 1 0 0 1 0 1.4Z"></path>
              </svg>
              <span>{t(locale, 'dimcheck.nextActions.cmMm')}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Error State -->
  <div class="checker-error" id="dim-error" hidden>
    <p id="dim-error-msg"></p>
  </div>
</div>

<script src="@/scripts/dimensions-checker.ts"></script>

<style>
  .dimensions-checker {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    box-sizing: border-box;
  }

  /* --- Dropzone --- */
  .dropzone {
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8) var(--space-4);
    text-align: center;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    max-width: 680px;
    margin-inline: auto;
    box-shadow: var(--shadow-sm);
    box-sizing: border-box;
    width: 100%;
  }

  @media (min-width: 640px) {
    .dropzone {
      padding: var(--space-12) var(--space-6);
    }
  }

  .dropzone:hover,
  .dropzone-active {
    border-color: var(--color-accent);
    background: var(--color-accent-light);
    transform: translateY(-2px);
  }

  .dropzone-icon-box {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-lg);
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-1);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .dropzone-icon-box {
      width: 60px;
      height: 60px;
    }
  }

  .dropzone:hover .dropzone-icon-box {
    transform: scale(1.05);
  }

  .dropzone-title {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--color-text);
    margin: 0;
    letter-spacing: -0.01em;
  }

  @media (min-width: 640px) {
    .dropzone-title {
      font-size: var(--text-xl);
    }
  }

  .dropzone-subtitle {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    max-width: 440px;
    line-height: 1.5;
    margin: 0;
  }

  @media (min-width: 640px) {
    .dropzone-subtitle {
      font-size: var(--text-sm);
    }
  }

  .dropzone-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-block: var(--space-1);
    width: 100%;
  }

  .btn-browse {
    pointer-events: none;
  }

  .dropzone-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
    width: 100%;
  }

  .dropzone-formats {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.4;
    max-width: 100%;
    word-break: break-word;
  }

  .privacy-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    color: #065f46;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    max-width: 100%;
    text-align: center;
  }

  /* --- Editor Layout --- */
  .checker-editor {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .checker-editor {
      gap: var(--space-6);
    }
  }

  /* Top Action Bar */
  .top-action-bar {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 640px) {
    .top-action-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;

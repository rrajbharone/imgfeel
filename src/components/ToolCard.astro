---
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  href: string;
  id?: string;
  icon?: string;
  badge?: 'POPULAR' | 'NEW';
}

const { title, description, href, id = '', icon, badge } = Astro.props;

// Determine icon type from icon prop or id
const iconType = icon || (
  id.includes('cm-mm') ? 'ruler' :
  id.includes('pan') ? 'idCard' :
  id.includes('whatsapp') ? 'user' :
  id.includes('ssc') ? 'fileCheck' :
  id.includes('youtube') ? 'youtube' :
  id.includes('base64') ? 'code' :
  id.includes('data-uri') ? 'link' : 'resize'
);
---

<a href={href} class="compact-tool-card" data-tool-id={id}>
  <div class="card-top">
    <div class="tool-icon-box">
      {iconType === 'resize' && (
        <svg class="tool-icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 3 21 3 21 9"></polyline>
          <polyline points="9 21 3 21 3 15"></polyline>
          <line x1="21" y1="3" x2="14" y2="10"></line>
          <line x1="3" y1="21" x2="10" y2="14"></line>
        </svg>
      )}
      {iconType === 'image' && (
        <svg class="tool-icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="3"></rect>
          <circle cx="8.5" cy="8.5" r="1.5"></circle>
          <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
      )}
      {iconType === 'ruler' && (
        <svg class="tool-icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21.3 8.7 8.7 21.3a1 1 0 0 1-1.4 0l-4.6-4.6a1 1 0 0 1 0-1.4L15.3 2.7a1 1 0 0 1 1.4 0l4.6 4.6a1 1 0 0 1 0 1.4Z"></path>
          <path d="m7.5 10.5 2 2"></path>
          <path d="m10.5 7.5 2 2"></path>
          <path d="m13.5 4.5 2 2"></path>
        </svg>
      )}
      {iconType === 'idCard' && (
        <svg class="tool-icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="16" rx="2"></rect>
          <circle cx="9" cy="10" r="2"></circle>
          <line x1="15" y1="8" x2="17" y2="8"></line>
          <line x1="15" y1="12" x2="17" y2="12"></line>
          <line x1="7" y1="16" x2="17" y2="16"></line>
        </svg>
      )}
      {iconType === 'user' && (
        <svg class="tool-icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      )}
      {iconType === 'fileCheck' && (
        <svg class="tool-icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <polyline points="9 15 11 17 15 13"></polyline>
        </svg>
      )}
      {iconType === 'youtube' && (
        <svg class="tool-icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="5" width="20" height="14" rx="4"></rect>
          <polygon points="10 9 15 12 10 15 10 9" fill="currentColor"></polygon>
        </svg>
      )}
      {iconType === 'code' && (
        <svg class="tool-icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
      )}
      {iconType === 'link' && (
        <svg class="tool-icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
        </svg>
      )}
    </div>

    {badge && (
      <span class={`tool-badge badge-${badge.toLowerCase()}`}>
        {badge}
      </span>
    )}
  </div>

  <div class="card-content">
    <h3 class="tool-card-title">{title}</h3>
    <p class="tool-card-desc">{description}</p>
  </div>
</a>

<style>
  .compact-tool-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px 10px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    position: relative;
    height: 100%;
    text-decoration: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .compact-tool-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.08);
    transform: translateY(-2px);
  }

  .compact-tool-card:active {
    transform: translateY(0);
  }

  .compact-tool-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 6px;
  }

  .tool-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: var(--color-accent-light);
    color: var(--color-accent);
    flex-shrink: 0;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .compact-tool-card:hover .tool-icon-box {
    background: var(--color-accent);
    color: #ffffff;
  }

  .tool-icon-svg {
    display: block;
  }

  .tool-badge {
    font-size: 8.5px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 2.5px 5px;
    border-radius: 3px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .badge-popular {
    background: #f5f3ff;
    color: #6366f1;
    border: 1px solid #ddd6fe;
  }

  .badge-new {
    background: #ecfdf5;
    color: #059669;
    border: 1px solid #a7f3d0;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 1;
  }

  .tool-card-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tool-card-desc {
    font-size: 11px;
    color: var(--color-text-secondary);
    line-height: 1.35;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .compact-tool-card {
      padding: var(--space-4);
      gap: 10px;
      border-radius: var(--radius-lg);
    }
    .tool-icon-box {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-sm);
    }
    .tool-icon-svg {
      width: 18px;
      height: 18px;
    }
    .tool-badge {
      font-size: 9.5px;
      padding: 3px 6px;
      border-radius: var(--radius-xs);
    }
    .tool-card-title {
      font-size: 14px;
      line-height: 1.35;
    }
    .tool-card-desc {
      font-size: 12px;
      line-height: 1.45;
      -webkit-line-clamp: 2;
    }
  }
</style>

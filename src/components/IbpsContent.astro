---
/**
 * IBPS Photo & Signature Resizer SEO Content & FAQ Component
 * Strict compliance with ImgFeel UI/UX Design System Standards
 */

const faqItems = [
  {
    q: 'What are the official IBPS photo and signature dimensions for 2026 applications?',
    a: 'For all IBPS online applications (including IBPS PO, Clerk, SO, RRB PO, and RRB Clerk), the official photograph dimensions are preferred at 200 × 230 pixels (standard 4.5 cm × 3.5 cm passport size). The official signature dimensions are preferred at 140 × 60 pixels (roughly 3.5 cm × 1.5 cm).',
  },
  {
    q: 'What are the required file size limits for IBPS photograph and signature uploads?',
    a: 'The photograph file size must be strictly between 20 KB and 50 KB in JPG or JPEG format. The scanned signature file size must be strictly between 10 KB and 20 KB in JPG or JPEG format. Files smaller than the minimum or exceeding the maximum limit are automatically rejected by the IBPS application server.',
  },
  {
    q: 'Does this resizer replace the Live Photograph requirement on the IBPS portal?',
    a: 'No. The IBPS online registration portal requires BOTH: (1) uploading a scanned color passport photograph file (200 × 230 px, 20–50 KB JPG) in the document upload section, and (2) capturing a real-time Live Photo via webcam or mobile QR-code scanning during the registration steps. This tool formats your uploaded photo file to satisfy portal criteria, but you must still complete the live camera capture on ibps.in.',
  },
  {
    q: 'Can I sign using blue ink or capital letters for IBPS examinations?',
    a: 'No. IBPS guidelines strictly mandate that signatures must be done in dark black ink pen on a clean, unruled white sheet of paper. Signatures signed in blue ink, pencils, or written in CAPITAL / BLOCK LETTERS will not be accepted and will lead to application cancellation.',
  },
  {
    q: 'Are requirements different for IBPS RRB compared to IBPS PO or Clerk?',
    a: 'Both IBPS Common Recruitment Process (CRP PO, Clerk, SO) and IBPS Regional Rural Banks (RRB PO Scale I/II/III and RRB Clerk Office Assistant) share the exact same technical image upload specifications: 200 × 230 px (20–50 KB) for photographs and 140 × 60 px (10–20 KB) for signatures. Selecting your specific exam in our dropdown confirms compliance with your notification.',
  },
  {
    q: 'Can I upload my photo or signature in PNG, WebP, or PDF format?',
    a: 'No. The IBPS portal validator strictly accepts files in .jpg or .jpeg format only. Uploading PNG, WebP, or PDF files will trigger an upload error. Our tool automatically converts any uploaded image into a fully compliant JPG file.',
  },
  {
    q: 'Why does the IBPS portal say "File size must be between 10 KB and 20 KB" for my signature?',
    a: 'Clean signatures on plain white paper compress very efficiently, often resulting in file sizes under 10 KB. The IBPS server enforces a strict 10.0 KB minimum floor. Our resizer uses an intelligent multi-stage compression engine that safely keeps your signature between 13 KB and 17 KB so it passes portal validation without errors.',
  },
  {
    q: 'Are my uploaded documents or signatures stored on your servers?',
    a: 'No. ImgFeel processes 100% of your images locally in your web browser using HTML5 Canvas. Your photograph, signature, and personal documents never leave your computer or smartphone, ensuring complete privacy and security.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'IBPS Photo & Signature Resizer',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires JavaScript. Requires HTML5 Canvas.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(appSchema)} />

<section class="section content-section">
  <div class="container">
    <div class="content-body">
      <!-- Section 1: Introduction to IBPS Guidelines -->
      <h2>Official IBPS Photo &amp; Signature Guidelines (2026 Examination Standards)</h2>
      <p>
        The Institute of Banking Personnel Selection (IBPS) administers recruitment across participating public sector banks and Regional Rural Banks throughout India. Whether submitting an application for <strong>IBPS PO (Probationary Officers / Management Trainees)</strong>, <strong>IBPS Clerk (Customer Support &amp; Sales)</strong>, <strong>IBPS SO (Specialist Officers)</strong>, <strong>IBPS RRB Officer Scale I / II / III (RRB PO)</strong>, or <strong>IBPS RRB Office Assistant (RRB Clerk)</strong>, strict digital specifications are enforced on the official application portal (<strong>ibps.in</strong>).
      </p>
      <p>
        Incorrect image dimensions, file sizes outside the mandatory brackets, or signatures in block letters trigger immediate upload failure or application rejection. This free, client-side <strong>IBPS Photo &amp; Signature Resizer</strong> automatically formats your files to official dimensions (<strong>200 × 230 px for photos</strong> and <strong>140 × 60 px for signatures</strong>), whitens backgrounds, improves ink contrast, and compresses files strictly within required limits (<strong>20 KB – 50 KB for photos</strong> and <strong>10 KB – 20 KB for signatures</strong>) with zero server uploads.
      </p>

      <!-- Section 2: Uploaded Scanned Photo vs Live Webcam Capture Distinction -->
      <h2>Understanding IBPS Photo Requirements: Uploaded File vs. Live Photo Capture</h2>
      <p>
        In recent recruitment cycles, IBPS implemented a dual-photo verification mechanism to combat impersonation and biometric fraud:
      </p>
      <div class="notice-comparison-box">
        <div class="notice-card upload-card">
          <div class="card-badge upload-badge">Step 1: File Upload</div>
          <h3>Scanned Photograph File (200 × 230 px • 20–50 KB)</h3>
          <p>
            Candidates must upload a recent, high-quality scanned color passport-style photograph file in the document upload section. The file must be strictly between <strong>20 KB and 50 KB</strong> in JPG format with a clear, light-colored or pure white background.
          </p>
          <p class="card-usage">
            <strong>What this tool does:</strong> Resizes, crops, and compresses your photo snapshot to exact 200 × 230 px and 20–50 KB specifications ready for direct portal upload.
          </p>
        </div>

        <div class="notice-card live-card">
          <div class="card-badge live-badge">Step 2: Real-Time Capture</div>
          <h3>Live Photograph Capture (Webcam / Mobile QR)</h3>
          <p>
            In addition to the uploaded file, the IBPS portal prompts you to capture a real-time live picture using your computer's webcam or by scanning a QR code with your mobile phone camera. The portal's facial recognition software compares this live capture against your uploaded photograph.
          </p>
          <p class="card-usage">
            <strong>Important note:</strong> This tool prepares your compliant digital upload file; it does not replace or bypass the portal's live webcam verification step on ibps.in.
          </p>
        </div>
      </div>

      <!-- Section 3: Official Specifications Comparison Table -->
      <h2>Official IBPS 2026 Examination Specifications Summary</h2>
      <p>
        Review the mandatory dimensions, file sizes, and formats enforced across all major IBPS banking examinations:
      </p>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Examination</th>
              <th>Document Type</th>
              <th>Pixel Dimensions</th>
              <th>File Size Limit</th>
              <th>Format &amp; Background</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>General IBPS Standard</strong></td>
              <td>Photograph</td>
              <td>200 × 230 px (4.5 × 3.5 cm)</td>
              <td><strong>20 KB – 50 KB</strong></td>
              <td>JPG / JPEG &bull; Pure White / Light background</td>
            </tr>
            <tr>
              <td><strong>General IBPS Standard</strong></td>
              <td>Signature</td>
              <td>140 × 60 px (3.5 × 1.5 cm)</td>
              <td><strong>10 KB – 20 KB</strong></td>
              <td>JPG / JPEG &bull; Black ink on white paper</td>
            </tr>
            <tr>
              <td><strong>IBPS PO (CRP PO/MT)</strong></td>
              <td>Photograph &amp; Signature</td>
              <td>Photo: 200×230 px &bull; Sig: 140×60 px</td>
              <td>Photo: 20–50 KB &bull; Sig: 10–20 KB</td>
              <td>JPG / JPEG &bull; Running hand signature</td>
            </tr>
            <tr>
              <td><strong>IBPS Clerk (CRP Clerical)</strong></td>
              <td>Photograph &amp; Signature</td>
              <td>Photo: 200×230 px &bull; Sig: 140×60 px</td>
              <td>Photo: 20–50 KB &bull; Sig: 10–20 KB</td>
              <td>JPG / JPEG &bull; Black ink pen strictly</td>
            </tr>
            <tr>
              <td><strong>IBPS SO (Specialist Officers)</strong></td>
              <td>Photograph &amp; Signature</td>
              <td>Photo: 200×230 px &bull; Sig: 140×60 px</td>
              <td>Photo: 20–50 KB &bull; Sig: 10–20 KB</td>
              <td>JPG / JPEG &bull; Clear facial visibility</td>
            </tr>
            <tr>
              <td><strong>IBPS RRB PO (Officer Scale I/II/III)</strong></td>
              <td>Photograph &amp; Signature</td>
              <td>Photo: 200×230 px &bull; Sig: 140×60 px</td>
              <td>Photo: 20–50 KB &bull; Sig: 10–20 KB</td>
              <td>JPG / JPEG &bull; White background</td>
            </tr>
            <tr>
              <td><strong>IBPS RRB Clerk (Office Assistant)</strong></td>
              <td>Photograph &amp; Signature</td>
              <td>Photo: 200×230 px &bull; Sig: 140×60 px</td>
              <td>Photo: 20–50 KB &bull; Sig: 10–20 KB</td>
              <td>JPG / JPEG &bull; No capital letter signatures</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 4: Signature Technical Requirements -->
      <h2>Essential Rules for IBPS Signature Uploads</h2>
      <p>
        The IBPS digital validator automatically inspects uploaded signature images. Ensure your file satisfies all official rules below:
      </p>
      <div class="benefits-grid">
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
            </svg>
          </div>
          <h3>Black Ink Pen Only</h3>
          <p>Sign strictly with a dark black ink pen on clean unruled white printer paper. Blue ink, gel pens that smudge, or pencils are strictly prohibited by IBPS.</p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
          </div>
          <h3>No Capital / Block Letters</h3>
          <p>Signatures written in full CAPITAL / BLOCK LETTERS will NOT be accepted. The signature must be in your natural running handwriting.</p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="3" y1="9" x2="21" y2="9"></line>
              <line x1="3" y1="15" x2="21" y2="15"></line>
            </svg>
          </div>
          <h3>140 × 60 Pixel Aspect Ratio</h3>
          <p>The standard rectangular ratio is 7:3 (140 × 60 px). Cropping too wide or too narrow causes distortion during portal rendering.</p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
          </div>
          <h3>Strict 10 KB – 20 KB Range</h3>
          <p>The portal validator has hard byte thresholds. Files under 10.0 KB or over 20.0 KB are immediately blocked by the upload module.</p>
        </div>
      </div>

      <!-- Section 5: Step-by-Step Instructions -->
      <h2>How to Resize IBPS Photo and Signature in 4 Easy Steps</h2>
      <ol class="steps-ordered-list">
        <li>
          <strong>Select Your Exam (Optional):</strong> Choose your recruitment exam (IBPS PO, Clerk, SO, RRB PO, or RRB Clerk) from the dropdown, or keep <em>General IBPS</em>.
        </li>
        <li>
          <strong>Choose Document Mode:</strong> Toggle between the <em>Photograph (20–50 KB)</em> and <em>Signature (10–20 KB)</em> tabs.
        </li>
        <li>
          <strong>Upload Your Image:</strong> Drag and drop your photo or signature file (JPG, PNG, or WebP). The tool automatically whitens paper background shadows, centers your document, and applies exact pixel dimensions.
        </li>
        <li>
          <strong>Review &amp; Download:</strong> Verify the live green compliance badges confirming dimensions, format (JPG), and file size. Click <strong>Download Compliant Image</strong> to save your ready-to-upload file.
        </li>
      </ol>

      <!-- Section 6: Common IBPS Portal Rejection Reasons -->
      <h2>Common Reasons IBPS Portal Rejects Uploads &amp; How to Avoid Them</h2>
      <ul class="mistakes-list">
        <li>
          <strong>Signature File Size Under 10.0 KB:</strong> High-compression scans of signatures on white paper often drop below 10 KB. Our tool automatically pads JPEG comment bytes to safely maintain file size at 13–17 KB.
        </li>
        <li>
          <strong>Photo File Size Exceeding 50.0 KB:</strong> High-resolution phone camera photos usually measure 2–4 MB. Our engine compresses images down to ~30–40 KB without blurring facial details.
        </li>
        <li>
          <strong>Signatures Signed in Blue Ink:</strong> IBPS notifications explicitly require dark black ink pen. Avoid blue or colored inks.
        </li>
        <li>
          <strong>Signature in Full Capital Letters:</strong> Signing in block letters violates IBPS identification rules and leads to candidate disqualification.
        </li>
        <li>
          <strong>Heavy Shadows or Patterned Background:</strong> Photos taken against colorful walls, doorframes, or with harsh flash reflections on spectacles are disqualified. Always use a pure white or very light background.
        </li>
      </ul>

      <!-- Section 7: FAQ Accordion Section -->
      <div class="faq-container">
        <h2 class="faq-section-title">Frequently Asked Questions (IBPS Photo &amp; Signature)</h2>
        <div class="faq-list">

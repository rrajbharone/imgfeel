---
/**
 * UPSC Photo & Signature Resizer SEO Content & FAQ Component
 * Strict compliance with ImgFeel UI/UX Design System Standards
 */

const faqItems = [
  {
    q: 'What are the official UPSC photo and signature dimensions for 2026 applications?',
    a: 'For UPSC online applications (including Civil Services IAS/IPS, CDS, NDA, CMS, and OTR), both photograph and signature images must have pixel dimensions between 350 × 350 pixels (minimum) and 1000 × 1000 pixels (maximum). The UPSC portal validator strictly checks that both width and height fall within this 350–1000 pixel range.',
  },
  {
    q: 'What is the required file size for UPSC photograph and signature?',
    a: 'For UPSC online applications, the photograph file size must be strictly between 20 KB and 300 KB, while the signature file size must be strictly between 20 KB and 100 KB. Files outside these limits are automatically rejected by the upsconline.nic.in portal. Our tool automatically compresses your files within these exact required limits.',
  },
  {
    q: 'Why does the UPSC portal reject my signature with a dimension error?',
    a: 'The UPSC server checks that both width AND height are at least 350 pixels. If you upload a standard wide rectangular signature (such as 350 × 150 px or 400 × 200 px), the portal rejects it because the height is under 350 px. Our tool automatically centers your signature onto a clean white square canvas (e.g., 550 × 550 px) so both dimensions satisfy the rule and upload seamlessly.',
  },
  {
    q: 'What is the UPSC "Triple Signature" requirement?',
    a: 'For examinations like the Civil Services Examination, UPSC instructions require candidates to sign three times vertically (one below the other) on a single sheet of plain white paper using a black ink pen, and scan all three signatures together as a single image file. Our tool supports both Triple Signature and Single Signature formats.',
  },
  {
    q: 'Is candidate name and date of photo mandatory on UPSC photograph?',
    a: 'UPSC Civil Services Examination guidelines mandate that the photograph must be recent (taken within 10 days of the start of the online application process) and must clearly display the candidate’s name and date on which the photo was taken inscribed at the bottom. Our tool provides a dedicated one-click option to inscribe your name and date cleanly per UPSC notice standards.',
  },
  {
    q: 'Can I upload a PNG or PDF photo to the UPSC application portal?',
    a: 'No. The UPSC portal strictly accepts JPG / JPEG files only. PNG, WebP, TIFF, or PDF uploads will be rejected. Our resizer automatically converts any uploaded PNG, JPG, or WebP photo into a compliant JPG file.',
  },
  {
    q: 'What background color is required for UPSC photograph?',
    a: 'UPSC requires a plain white or very light off-white background. Colored, dark, scenic, or patterned backgrounds will lead to application rejection. Your face must be clearly visible, centered, and occupy approximately 75% (3/4th) of the photograph area with both ears visible.',
  },
  {
    q: 'Are my uploaded photographs and signatures stored on your server?',
    a: 'No. ImgFeel processes 100% of your images locally in your web browser using client-side HTML5 Canvas. Your photograph, signature, and personal details are never uploaded to any server, database, or external service, ensuring complete privacy.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'UPSC Photo & Signature Resizer',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires JavaScript. Requires HTML5 Canvas.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(appSchema)} />

<section class="section content-section">
  <div class="container">
    <div class="content-body">
      <!-- Section 1: Introduction to UPSC Guidelines -->
      <h2>Official UPSC Photo & Signature Guidelines (2026 Examination Standards)</h2>
      <p>
        The Union Public Service Commission (UPSC) enforces strict digital file validation on its official application portal (<strong>upsconline.nic.in</strong>). Whether submitting the Common Application Form for the <strong>Civil Services Examination (CSE / IAS / IPS / IFS)</strong>, NDA, CDS, CAPF, Combined Medical Services (CMS), Engineering Services (ESE), or completing your <strong>One Time Registration (OTR)</strong>, non-compliant photographs and signatures trigger immediate portal rejection or application cancellation.
      </p>
      <p>
        This free, client-side UPSC Photo & Signature Resizer automatically adjusts your image dimensions, enforces the mandatory pure white background, checks 75% facial composition, and compresses the final JPG strictly within the required file size limits (<strong>20 KB to 300 KB</strong> for photos and <strong>20 KB to 100 KB</strong> for signatures) with zero loss in visual clarity.
      </p>

      <!-- Section 2: Official Specification Comparison Table -->
      <h2>Official UPSC 2026 Image Specifications Summary</h2>
      <p>
        Review the mandatory specifications enforced by the UPSC online application validator before uploading:
      </p>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Parameter</th>
              <th>UPSC Photograph Requirements</th>
              <th>UPSC Signature Requirements</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Allowed Dimensions</strong></td>
              <td>Minimum 350 × 350 px &bull; Maximum 1000 × 1000 px</td>
              <td>Minimum 350 × 350 px &bull; Maximum 1000 × 1000 px</td>
            </tr>
            <tr>
              <td><strong>Aspect Ratio</strong></td>
              <td>Square (1:1 aspect ratio)</td>
              <td>Square (1:1) or Rectangular (both sides &ge; 350 px)</td>
            </tr>
            <tr>
              <td><strong>File Size Limits</strong></td>
              <td>Strictly between <strong>20 KB and 300 KB</strong></td>
              <td>Strictly between <strong>20 KB and 100 KB</strong></td>
            </tr>
            <tr>
              <td><strong>File Format</strong></td>
              <td>JPG / JPEG only (no PNG or PDF)</td>
              <td>JPG / JPEG only</td>
            </tr>
            <tr>
              <td><strong>Background Color</strong></td>
              <td>Plain White (#FFFFFF)</td>
              <td>Plain White paper (no lines or grid)</td>
            </tr>
            <tr>
              <td><strong>Pen / Ink Type</strong></td>
              <td>N/A</td>
              <td><strong>Black Ink Pen</strong> strictly required</td>
            </tr>
            <tr>
              <td><strong>Special Rules</strong></td>
              <td>Face 75% of frame, name &amp; DOP printed within 10 days</td>
              <td>Triple signature rule for CSE, running handwriting only</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 3: In-Depth UPSC Photograph Rules -->
      <h2>UPSC Photograph Requirements: Composition, Recency, & Name/Date Stamp</h2>
      <p>
        To ensure biometric accuracy and prevent identity discrepancies during the examination and personality test stages, UPSC mandates specific photographic parameters:
      </p>
      <ul class="guidelines-list">
        <li>
          <strong>75% Face Coverage:</strong> The candidate's face must occupy approximately three-fourths (75%) of the photograph space, framed from the crown of the head to the shoulders.
        </li>
        <li>
          <strong>Frontal Angle & Eye Contact:</strong> Face must directly front the camera with a neutral facial expression, closed mouth, and both ears clearly visible. Tilting, profile shots, or casual selfies are disqualified.
        </li>
        <li>
          <strong>10-Day Recency Mandate:</strong> The photograph must be recent, taken not more than 10 days before the commencement of the online application form filling.
        </li>
        <li>
          <strong>Name and Date Inscription (DOP):</strong> UPSC exam notifications stipulate that the candidate's full name in capital letters along with the date on which the photograph was taken (DOP) must be legibly inscribed at the bottom. Our tool enables you to automatically add this formatted banner with one click.
        </li>
        <li>
          <strong>No Accessories:</strong> Caps, hats, tinted glasses, sunglasses, heavy shadows across the face, and facial coverings are prohibited. Clear prescription spectacles are permissible only if lenses do not produce flash reflections.
        </li>
      </ul>

      <!-- Section 4: UPSC Signature & "Triple Signature" Guidelines -->
      <h2>UPSC Signature Rules & Resolving the "350 Pixels" Upload Error</h2>
      <p>
        Many UPSC candidates face persistent frustration when uploading signatures:
      </p>
      <div class="benefits-grid">
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
            </svg>
          </div>
          <h3>Black Ink Pen Only</h3>
          <p>Sign strictly with a black ink pen on clean unruled white printer paper. Blue ink, pencils, gel smudges, or colored inks are strictly prohibited.</p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="3" y1="9" x2="21" y2="9"></line>
              <line x1="3" y1="15" x2="21" y2="15"></line>
            </svg>
          </div>
          <h3>The Triple Signature Rule</h3>
          <p>For UPSC CSE, sign three times vertically (one under the other) on one sheet of paper and scan as one file so invigilators can verify consistency.</p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
          </div>
          <h3>Solving the 350px Portal Error</h3>
          <p>Standard cropped signatures are wide and short (e.g., 300 × 120 px). The portal rejects any image under 350 px height. We center it on a 550 × 550 px canvas to pass.</p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3>Running Handwriting Only</h3>
          <p>Signatures must be in running hand. Signatures in full capital block letters or initials only are invalid and will cause immediate disqualification.</p>
        </div>
      </div>

      <!-- Section 5: Step-by-Step Instructions -->
      <h2>How to Resize UPSC Photo and Signature in 4 Easy Steps</h2>
      <ol class="steps-ordered-list">
        <li>
          <strong>Select Document Type:</strong> Switch between the <em>Photograph</em> and <em>Signature</em> tabs at the top of the resizer tool.
        </li>
        <li>
          <strong>Choose Official Preset:</strong> Keep the default recommended preset (<em>UPSC Online Portal Standard 550 × 550 px</em>) which universally satisfies all UPSC examinations.
        </li>
        <li>
          <strong>Upload Your Image:</strong> Drag and drop your photo or signature file (JPG, PNG, or WebP). The tool instantly centers your file on a pure white background. If uploading a photo for Civil Services, check <em>Inscribe Name &amp; Date</em> and enter your details.
        </li>
        <li>
          <strong>Verify &amp; Download:</strong> Check the live green compliance badges confirming dimensions (350–1000 px), format (JPG), and file size (20–300 KB for photo, 20–100 KB for signature). Click <strong>Download Compliant Image</strong> to save your ready-to-upload file.
        </li>
      </ol>

      <!-- Section 6: Common UPSC Portal Rejection Reasons -->
      <h2>Common Reasons UPSC Portal Rejects Uploads & How to Avoid Them</h2>
      <ul class="mistakes-list">
        <li>
          <strong>File Size Below 20 KB:</strong> The upsconline portal server has a hard floor of 20.0 KB. Overly compressed files trigger the error <em>"File size must be greater than 20 KB"</em>. Our intelligent compression engine guarantees file size stays safely above 25 KB.
        </li>
        <li>
          <strong>File Size Exceeding Maximum Limit:</strong> Files exceeding 300 KB for photos or 100 KB for signatures will trigger portal rejection errors. Our engine automatically compresses your image to optimal size (~35–60 KB) without visible pixelation.
        </li>
        <li>
          <strong>Wrong Aspect Ratio or Dimension Under 350 px:</strong> Rectangular images under 350 px trigger validation errors. Our tool pads the canvas with pure white to maintain the compliant square ratio.
        </li>
        <li>
          <strong>Non-White Background:</strong> Blue, red, or natural outdoor backgrounds violate UPSC guidelines. Always upload photos taken against a clean white wall or backdrop.
        </li>
      </ul>


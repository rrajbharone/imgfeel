---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';
import { getToolUrl } from '@/data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const inverterUrl = getToolUrl('image-inverter', locale);
const grayscaleUrl = getToolUrl('image-grayscale-converter', locale);
const squareUrl = getToolUrl('resize-image-to-1-1', locale);
const circleUrl = getToolUrl('circle-image-cropper', locale);

const i18nDict = {
  statusReady: t(locale, 'blur.status.ready'),
  statusProcessing: t(locale, 'blur.status.processing'),
  errorLoad: t(locale, 'blur.error.load'),
  originalLabel: t(locale, 'blur.split.original'),
  blurredLabel: t(locale, 'blur.split.blurred'),
  downloadName: t(locale, 'blur.download.filename'),
};
---

<div class="blur-tool-wrapper" id="blurApp" data-i18n={JSON.stringify(i18nDict)}>
  <!-- Dropzone / Upload State -->
  <div class="blur-dropzone-card" id="blurDropzone">
    <div class="blur-dropzone-content">
      <div class="blur-icon-circle">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke-dasharray="2 3"></circle>
          <circle cx="12" cy="12" r="5" stroke-dasharray="1 2"></circle>
          <circle cx="12" cy="12" r="1.5" fill="currentColor"></circle>
        </svg>
      </div>

      <h2 class="blur-drop-title">{t(locale, 'blur.dropzone.title')}</h2>
      <p class="blur-drop-subtitle">{t(locale, 'blur.dropzone.subtitle')}</p>

      <div class="blur-btn-row">
        <label class="btn btn-primary blur-btn-primary" for="blurFileInput">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'blur.dropzone.browse')}</span>
        </label>
        <input type="file" id="blurFileInput" accept="image/*,.jpg,.jpeg,.png,.webp,.avif,.bmp" class="sr-only" />

        <button type="button" class="btn btn-secondary blur-sample-btn" id="blurSampleBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
          <span>{t(locale, 'blur.dropzone.sample')}</span>
        </button>
      </div>

      <p class="blur-formats-hint">{t(locale, 'blur.dropzone.formats')}</p>

      <div class="blur-privacy-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span>{t(locale, 'blur.privacy.badge')}</span>
      </div>
    </div>
  </div>

  <!-- Loading State -->
  <div class="blur-loading-card" id="blurLoadingCard" style="display: none;">
    <div class="blur-spinner"></div>
    <p class="blur-loading-text">{t(locale, 'blur.status.processing')}</p>
  </div>

  <!-- Main Blur Workspace -->
  <div class="blur-workspace" id="blurWorkspace" style="display: none;">
    <!-- Header Bar -->
    <div class="blur-workspace-header">
      <div class="blur-meta-badge">
        <span class="blur-status-dot"></span>
        <span id="blurFileName" class="blur-filename-label">image.png</span>
        <span class="blur-meta-tag" id="blurOriginalDimsTag">1200 × 800 px</span>
        <span class="blur-meta-tag" id="blurOriginalSizeTag">250 KB</span>
      </div>

      <div class="blur-header-actions">
        <button type="button" class="btn btn-secondary btn-sm" id="blurChangeImageBtn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'blur.action.changeImage')}</span>
        </button>
      </div>
    </div>

    <!-- 2-Column Main Layout: Interactive Preview on Left, Blur Controls on Right -->
    <div class="blur-main-grid">
      <!-- Left Column: Interactive Before/After Preview -->
      <div class="blur-preview-card">
        <!-- View Mode Tabs -->
        <div class="preview-mode-tabs">
          <button type="button" class="preview-tab active" data-view="split" id="viewModeSplitBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="3" x2="12" y2="21"></line>
              <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            </svg>
            <span>{t(locale, 'blur.view.split')}</span>
          </button>
          <button type="button" class="preview-tab" data-view="side" id="viewModeSideBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="9" height="18" rx="2"></rect>
              <rect x="13" y="3" width="9" height="18" rx="2"></rect>
            </svg>
            <span>{t(locale, 'blur.view.side')}</span>
          </button>
          <button type="button" class="preview-tab" data-view="result" id="viewModeResultBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
            </svg>
            <span>{t(locale, 'blur.view.result')}</span>
          </button>
        </div>

        <!-- Split Slider Container -->
        <div class="split-viewport-wrapper" id="splitViewportWrapper">
          <div class="split-comparison-box" id="splitComparisonBox">
            <canvas id="blurCanvasUnder" class="split-canvas"></canvas>
            <canvas id="blurCanvasOver" class="split-canvas over-canvas"></canvas>
            
            <div class="split-divider-line" id="splitDividerLine" style="left: 50%;">
              <div class="split-drag-handle" title="Drag to compare">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </div>
            </div>

            <!-- Interactive Selection Overlay Box for Area Blurring -->
            <div class="blur-selection-overlay" id="blurSelectionOverlay" style="display: none;">
              <div class="selection-rect" id="selectionRect">
                <div class="selection-drag-banner">
                  <span id="selectionLabel">Area Blur</span>
                </div>
                <div class="handle handle-nw" data-handle="nw"></div>
                <div class="handle handle-n" data-handle="n"></div>
                <div class="handle handle-ne" data-handle="ne"></div>
                <div class="handle handle-e" data-handle="e"></div>
                <div class="handle handle-se" data-handle="se"></div>
                <div class="handle handle-s" data-handle="s"></div>
                <div class="handle handle-sw" data-handle="sw"></div>
                <div class="handle handle-w" data-handle="w"></div>
              </div>
            </div>

            <span class="split-tag tag-left">{t(locale, 'blur.split.original')}</span>
            <span class="split-tag tag-right">{t(locale, 'blur.split.blurred')}</span>
          </div>

          <!-- Selection Area Helper Bar (Visible when in partial area mode) -->
          <div class="selection-helper-bar" id="selectionHelperBar" style="display: none;">
            <span class="selection-tip-text">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
              {t(locale, 'blur.scope.selectionHint')}
            </span>
            <button type="button" class="btn btn-secondary btn-sm" id="resetSelectionAreaBtn">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
              </svg>
              <span>{t(locale, 'blur.scope.resetArea')}</span>
            </button>
          </div>

          <p class="split-hint-text" id="splitHintText">{t(locale, 'blur.split.hint')}</p>
        </div>

        <!-- Side-by-Side Container (Hidden by default) -->
        <div class="side-viewport-wrapper" id="sideViewportWrapper" style="display: none;">
          <div class="side-box">
            <span class="side-badge">{t(locale, 'blur.split.original')}</span>
            <img id="sideOriginalImg" src="" alt="Original" class="side-img" />
          </div>
          <div class="side-box">
            <span class="side-badge">{t(locale, 'blur.split.blurred')}</span>
            <img id="sideBlurredImg" src="" alt="Blurred" class="side-img" />
          </div>
        </div>

        <!-- Blurred Only Viewport (Hidden by default) -->
        <div class="single-viewport-wrapper" id="singleViewportWrapper" style="display: none;">
          <img id="singleBlurredImg" src="" alt="Blurred preview" class="single-img" />
        </div>
      </div>

      <!-- Right Column: Blur Controls & Export Settings -->
      <div class="blur-controls-panel">
        <!-- Section 1: Blur Scope (Full vs Selected Area vs Background) -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'blur.scope.label')}</label>
          <div class="scope-chips-grid">
            <button type="button" class="blur-scope-btn active" data-scope="entire">
              <div class="scope-btn-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                </svg>
                <strong>{t(locale, 'blur.scope.entire')}</strong>
              </div>
              <span>{t(locale, 'blur.scope.entireDesc')}</span>
            </button>

            <button type="button" class="blur-scope-btn" data-scope="selected">
              <div class="scope-btn-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <strong>{t(locale, 'blur.scope.selected')}</strong>
              </div>
              <span>{t(locale, 'blur.scope.selectedDesc')}</span>
            </button>

            <button type="button" class="blur-scope-btn" data-scope="background">
              <div class="scope-btn-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <circle cx="12" cy="12" r="4"></circle>
                </svg>
                <strong>{t(locale, 'blur.scope.background')}</strong>
              </div>
              <span>{t(locale, 'blur.scope.backgroundDesc')}</span>
            </button>
          </div>
        </div>

        <!-- Section 2: Blur Style Modes -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'blur.mode.label')}</label>
          <div class="mode-chips-grid">
            <button type="button" class="blur-mode-btn active" data-mode="gaussian">
              <strong>{t(locale, 'blur.mode.gaussian')}</strong>
              <span>{t(locale, 'blur.mode.gaussianDesc')}</span>
            </button>
            <button type="button" class="blur-mode-btn" data-mode="privacy">
              <strong>{t(locale, 'blur.mode.privacy')}</strong>
              <span>{t(locale, 'blur.mode.privacyDesc')}</span>
            </button>
            <button type="button" class="blur-mode-btn" data-mode="dreamy">
              <strong>{t(locale, 'blur.mode.dreamy')}</strong>
              <span>{t(locale, 'blur.mode.dreamyDesc')}</span>
            </button>
            <button type="button" class="blur-mode-btn" data-mode="motion">
              <strong>{t(locale, 'blur.mode.motion')}</strong>
              <span>{t(locale, 'blur.mode.motionDesc')}</span>
            </button>
          </div>
        </div>

        <!-- Section 3: Fine-Tuning Sliders -->
        <div class="control-group">
          <div class="slider-header-row">
            <label for="blurRadiusSlider" class="control-label">{t(locale, 'blur.slider.radius')}</label>
            <span id="blurRadiusVal" class="val-pill">16 px</span>
          </div>
          <input type="range" id="blurRadiusSlider" min="0" max="100" value="16" step="1" class="blur-range" />
        </div>

        <div class="control-group">
          <div class="slider-header-row">
            <label for="blurBrightnessSlider" class="control-label">{t(locale, 'blur.slider.brightness')}</label>
            <span id="blurBrightnessVal" class="val-pill">0</span>
          </div>
          <input type="range" id="blurBrightnessSlider" min="-100" max="100" value="0" step="1" class="blur-range" />
        </div>

        <div class="control-group">
          <div class="slider-header-row">
            <label for="blurContrastSlider" class="control-label">{t(locale, 'blur.slider.contrast')}</label>
            <span id="blurContrastVal" class="val-pill">0</span>
          </div>
          <input type="range" id="blurContrastSlider" min="-100" max="100" value="0" step="1" class="blur-range" />
        </div>

        <div class="reset-adjustments-row">
          <button type="button" class="btn btn-secondary btn-sm" id="blurResetAdjustmentsBtn">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
              <path d="M3 3v5h5"></path>
            </svg>
            <span>{t(locale, 'blur.action.resetSliders')}</span>
          </button>
        </div>

        <!-- Section 4: Format & Quality Selection -->
        <div class="control-group">
          <label for="blurFormatSelect" class="control-label">{t(locale, 'blur.format.label')}</label>
          <select id="blurFormatSelect" class="blur-select">
            <option value="original" selected>{t(locale, 'blur.format.original')}</option>
            <option value="image/png">PNG (Lossless / Transparent)</option>
            <option value="image/jpeg">JPG / JPEG (Standard)</option>
            <option value="image/webp">WebP (Modern Compressed)</option>
          </select>
        </div>

        <!-- Section 5: Live Metrics & Download -->
        <div class="blur-metrics-card">
          <div class="metric-row">
            <span class="metric-label">{t(locale, 'blur.metrics.dimensions')}:</span>
            <strong id="blurMetricDims">1200 × 800 px</strong>
          </div>
          <div class="metric-row">
            <span class="metric-label">{t(locale, 'blur.metrics.fileWeight')}:</span>
            <strong id="blurMetricWeight">-- KB</strong>
          </div>
          <div class="metric-row">
            <span class="metric-label">{t(locale, 'blur.metrics.privacyStatus')}:</span>
            <strong>{t(locale, 'blur.metrics.clientSafe')}</strong>
          </div>
        </div>

        <!-- Single-Click Download Button -->
        <button type="button" class="btn btn-primary blur-download-btn" id="blurDownloadBtn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>{t(locale, 'blur.action.download')}</span>
        </button>
      </div>
    </div>

    <!-- Quick Navigation to Related Tools -->
    <div class="blur-cross-links-row">
      <a href={inverterUrl} class="btn btn-secondary blur-cross-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v18"></path>
          <path d="M12 3a9 9 0 0 1 9 9 9 9 0 0 1-9 9"></path>
          <path d="M12 3a9 9 0 0 0-9 9 9 9 0 0 0 9 9" fill="currentColor"></path>
        </svg>
        <span>{t(locale, 'blur.cross.inverter')}</span>
      </a>

      <a href={grayscaleUrl} class="btn btn-secondary blur-cross-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 3a9 9 0 0 1 0 18v-18z" fill="currentColor"></path>
        </svg>
        <span>{t(locale, 'blur.cross.grayscale')}</span>
      </a>

      <a href={squareUrl} class="btn btn-secondary blur-cross-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        </svg>
        <span>{t(locale, 'blur.cross.square')}</span>
      </a>

      <a href={circleUrl} class="btn btn-secondary blur-cross-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
        </svg>
        <span>{t(locale, 'blur.cross.circle')}</span>
      </a>
    </div>
  </div>
</div>

<script>
  import {
    blurImage,
    generateSampleBlurImage,
    loadImage,
    applyBlurToCanvas,
    type BlurMode,
    type BlurScope,
    type BlurResult,
  } from '@/scripts/image-blur';

  function initBlurApp() {
    const container = document.getElementById('blurApp');
    if (!container) return;

    let i18n = {
      statusReady: 'Ready',
      statusProcessing: 'Blurring Image...',
      errorLoad: 'Failed to process image file',
      downloadName: 'image-blurred',
    };

    try {
      const dataAttr = container.getAttribute('data-i18n');
      if (dataAttr) i18n = JSON.parse(dataAttr);
    } catch {}

    // Elements
    const dropzone = document.getElementById('blurDropzone');
    const fileInput = document.getElementById('blurFileInput') as HTMLInputElement | null;
    const sampleBtn = document.getElementById('blurSampleBtn');
    const loadingCard = document.getElementById('blurLoadingCard');
    const workspace = document.getElementById('blurWorkspace');

    // Header
    const fileNameEl = document.getElementById('blurFileName');
    const origDimsTag = document.getElementById('blurOriginalDimsTag');
    const origSizeTag = document.getElementById('blurOriginalSizeTag');
    const changeImageBtn = document.getElementById('blurChangeImageBtn');

    // View tabs
    const viewTabs = document.querySelectorAll('.preview-tab');
    const splitWrapper = document.getElementById('splitViewportWrapper');
    const sideWrapper = document.getElementById('sideViewportWrapper');
    const singleWrapper = document.getElementById('singleViewportWrapper');

    // Canvases for Split View
    const canvasUnder = document.getElementById('blurCanvasUnder') as HTMLCanvasElement | null;
    const canvasOver = document.getElementById('blurCanvasOver') as HTMLCanvasElement | null;
    const splitBox = document.getElementById('splitComparisonBox');
    const splitDivider = document.getElementById('splitDividerLine');

    // Selection Overlay & Box Elements
    const selectionOverlay = document.getElementById('blurSelectionOverlay');
    const selectionRect = document.getElementById('selectionRect');
    const selectionHelperBar = document.getElementById('selectionHelperBar');
    const resetSelectionAreaBtn = document.getElementById('resetSelectionAreaBtn');
    const handles = document.querySelectorAll('.handle');

    // Side & Single images
    const sideOrigImg = document.getElementById('sideOriginalImg') as HTMLImageElement | null;
    const sideBlurredImg = document.getElementById('sideBlurredImg') as HTMLImageElement | null;
    const singleBlurredImg = document.getElementById('singleBlurredImg') as HTMLImageElement | null;

    // Controls
    const scopeBtns = document.querySelectorAll('.blur-scope-btn');
    const modeBtns = document.querySelectorAll('.blur-mode-btn');
    const radiusSlider = document.getElementById('blurRadiusSlider') as HTMLInputElement | null;
    const radiusVal = document.getElementById('blurRadiusVal');
    const brightnessSlider = document.getElementById('blurBrightnessSlider') as HTMLInputElement | null;
    const brightnessVal = document.getElementById('blurBrightnessVal');
    const contrastSlider = document.getElementById('blurContrastSlider') as HTMLInputElement | null;
    const contrastVal = document.getElementById('blurContrastVal');
    const resetAdjustmentsBtn = document.getElementById('blurResetAdjustmentsBtn');
    const formatSelect = document.getElementById('blurFormatSelect') as HTMLSelectElement | null;

    // Metrics & Download
    const metricDims = document.getElementById('blurMetricDims');
    const metricWeight = document.getElementById('blurMetricWeight');
    const downloadBtn = document.getElementById('blurDownloadBtn');

    // State
    let currentFile: File | null = null;
    let loadedImageObj: HTMLImageElement | null = null;
    let originalWidth = 0;
    let originalHeight = 0;

    let activeScope: BlurScope = 'entire';
    let activeMode: BlurMode = 'gaussian';
    let radius = 16;
    let brightness = 0;
    let contrast = 0;
    let splitPosPercent = 50;
    let isDraggingSplit = false;

    // Selection coordinates normalized 0..1
    let selection = {
      x: 0.25,
      y: 0.25,
      width: 0.5,
      height: 0.5,
    };

    // Selection Drag/Resize State
    let isMovingSelection = false;
    let isResizingHandle: string | null = null;
    let startDragPoint = { x: 0, y: 0 };
    let initialSelection = { ...selection };

    let lastResult: BlurResult | null = null;
    let renderDebounceTimer: number | null = null;

    function updateSelectionOverlayDom() {
      if (!selectionRect || !selectionOverlay) return;
      if (activeScope === 'entire') {
        selectionOverlay.style.display = 'none';
        if (selectionHelperBar) selectionHelperBar.style.display = 'none';
        return;
      }

      selectionOverlay.style.display = 'block';
      if (selectionHelperBar) selectionHelperBar.style.display = 'flex';

      const left = Math.max(0, Math.min(100, selection.x * 100));
      const top = Math.max(0, Math.min(100, selection.y * 100));
      const width = Math.max(5, Math.min(100 - left, selection.width * 100));
      const height = Math.max(5, Math.min(100 - top, selection.height * 100));

      selectionRect.style.left = `${left}%`;
      selectionRect.style.top = `${top}%`;
      selectionRect.style.width = `${width}%`;
      selectionRect.style.height = `${height}%`;
    }

    function renderSplitCanvases() {
      if (!canvasUnder || !canvasOver || !loadedImageObj) return;

      const maxDisplayW = 600;
      const aspect = originalHeight / originalWidth;
      const displayW = Math.min(originalWidth, maxDisplayW);
      const displayH = Math.round(displayW * aspect);

      canvasUnder.width = displayW;
      canvasUnder.height = displayH;
      canvasOver.width = displayW;
      canvasOver.height = displayH;

      const ctxUnder = canvasUnder.getContext('2d');
      if (!ctxUnder) return;

      // 1. Draw original crisp image in Under canvas
      ctxUnder.drawImage(loadedImageObj, 0, 0, displayW, displayH);

      // 2. Draw and process blurred version in Over canvas with current scope and selection
      applyBlurToCanvas(loadedImageObj, canvasOver, {
        mode: activeMode,
        scope: activeScope,
        selection,
        radius,
        brightness,
        contrast,
        format: 'image/png',
        quality: 0.9,
      });

      // Apply clip-path to Over canvas based on splitPosPercent
      canvasOver.style.clipPath = `inset(0 0 0 ${splitPosPercent}%)`;
      if (splitDivider) {
        splitDivider.style.left = `${splitPosPercent}%`;
      }

      updateSelectionOverlayDom();
    }

    async function processFullExport() {
      if (!currentFile) return;

      const format = (formatSelect?.value as 'image/jpeg' | 'image/png' | 'image/webp' | 'original') || 'original';

      try {
        const result = await blurImage(currentFile, {
          mode: activeMode,
          scope: activeScope,
          selection,
          radius,
          brightness,
          contrast,
          format,
          quality: 0.92,
        });

        lastResult = result;

        if (sideBlurredImg) sideBlurredImg.src = result.dataUrl;
        if (singleBlurredImg) singleBlurredImg.src = result.dataUrl;
        if (metricDims) metricDims.textContent = `${result.width} × ${result.height} px`;
        if (metricWeight) metricWeight.textContent = result.fileSizeFormatted;
      } catch (err) {
        console.error('Blur export error:', err);
      }
    }

    function triggerUpdate() {
      renderSplitCanvases();
      if (renderDebounceTimer) clearTimeout(renderDebounceTimer);
      renderDebounceTimer = window.setTimeout(processFullExport, 60);
    }

    async function loadFile(file: File) {
      if (!dropzone || !loadingCard || !workspace) return;

      dropzone.style.display = 'none';
      workspace.style.display = 'none';
      loadingCard.style.display = 'flex';

      try {
        currentFile = file;
        loadedImageObj = await loadImage(file);
        originalWidth = loadedImageObj.naturalWidth || loadedImageObj.width;
        originalHeight = loadedImageObj.naturalHeight || loadedImageObj.height;

        // Reset scope & adjustments
        activeScope = 'entire';
        scopeBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-scope') === 'entire'));
        activeMode = 'gaussian';
        modeBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-mode') === 'gaussian'));
        radius = 16;
        brightness = 0;
        contrast = 0;
        splitPosPercent = 50;

        selection = {
          x: 0.25,
          y: 0.25,
          width: 0.5,
          height: 0.5,
        };

        if (radiusSlider) radiusSlider.value = '16';
        if (radiusVal) radiusVal.textContent = '16 px';
        if (brightnessSlider) brightnessSlider.value = '0';
        if (brightnessVal) brightnessVal.textContent = '0';
        if (contrastSlider) contrastSlider.value = '0';
        if (contrastVal) contrastVal.textContent = '0';

        // Header info
        if (fileNameEl) fileNameEl.textContent = file.name;
        if (origDimsTag) origDimsTag.textContent = `${originalWidth} × ${originalHeight} px`;
        if (origSizeTag) origSizeTag.textContent = `${(file.size / 1024).toFixed(1)} KB`;

        const origUrl = URL.createObjectURL(file);
        if (sideOrigImg) sideOrigImg.src = origUrl;

        renderSplitCanvases();
        await processFullExport();

        loadingCard.style.display = 'none';
        workspace.style.display = 'flex';
      } catch (err) {
        alert(err instanceof Error ? err.message : i18n.errorLoad);
        resetToDropzone();
      }
    }

    function resetToDropzone() {
      currentFile = null;
      loadedImageObj = null;
      if (fileInput) fileInput.value = '';
      if (loadingCard) loadingCard.style.display = 'none';
      if (workspace) workspace.style.display = 'none';
      if (dropzone) dropzone.style.display = 'block';
    }

    if (changeImageBtn) changeImageBtn.addEventListener('click', resetToDropzone);

    // View mode switching
    viewTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        viewTabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');

        const mode = tab.getAttribute('data-view');
        if (splitWrapper) splitWrapper.style.display = mode === 'split' ? 'flex' : 'none';
        if (sideWrapper) sideWrapper.style.display = mode === 'side' ? 'grid' : 'none';
        if (singleWrapper) singleWrapper.style.display = mode === 'result' ? 'block' : 'none';
      });
    });

    // Split dragging logic
    function handleSplitMove(clientX: number) {
      if (!splitBox) return;
      const rect = splitBox.getBoundingClientRect();
      const x = Math.max(0, Math.min(rect.width, clientX - rect.left));
      splitPosPercent = Math.round((x / rect.width) * 100);

      if (splitDivider) splitDivider.style.left = `${splitPosPercent}%`;
      if (canvasOver) canvasOver.style.clipPath = `inset(0 0 0 ${splitPosPercent}%)`;
    }

    if (splitDivider) {
      splitDivider.addEventListener('mousedown', (e) => {
        e.stopPropagation();
        isDraggingSplit = true;
        handleSplitMove(e.clientX);
      });

      splitDivider.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          e.stopPropagation();
          isDraggingSplit = true;
          handleSplitMove(e.touches[0].clientX);
        }
      }, { passive: true });
    }

    // Global mousemove/mouseup for Split Divider
    window.addEventListener('mousemove', (e) => {
      if (isDraggingSplit) {
        handleSplitMove(e.clientX);
      }
    });

    window.addEventListener('mouseup', () => {
      isDraggingSplit = false;
    });

    window.addEventListener('touchmove', (e) => {
      if (isDraggingSplit && e.touches.length === 1) {
        handleSplitMove(e.touches[0].clientX);
      }
    }, { passive: true });

    window.addEventListener('touchend', () => {
      isDraggingSplit = false;
    });

    // Selection Dragging & Resizing Listeners
    if (selectionRect && splitBox) {
      // 1. Move selection box
      selectionRect.addEventListener('mousedown', (e) => {
        const target = e.target as HTMLElement;
        if (target.classList.contains('handle')) return; // handled by handle listener
        e.stopPropagation();
        isMovingSelection = true;
        startDragPoint = { x: e.clientX, y: e.clientY };
        initialSelection = { ...selection };
      });

      selectionRect.addEventListener('touchstart', (e) => {
        const target = e.target as HTMLElement;
        if (target.classList.contains('handle') || e.touches.length !== 1) return;
        e.stopPropagation();
        isMovingSelection = true;
        startDragPoint = { x: e.touches[0].clientX, y: e.touches[0].clientY };
        initialSelection = { ...selection };
      }, { passive: true });

      // 2. Resize handles
      handles.forEach((handle) => {
        handle.addEventListener('mousedown', (e) => {
          e.stopPropagation();
          const me = e as MouseEvent;
          isResizingHandle = (handle as HTMLElement).getAttribute('data-handle');
          startDragPoint = { x: me.clientX, y: me.clientY };
          initialSelection = { ...selection };
        });

        handle.addEventListener('touchstart', (e) => {
          const te = e as TouchEvent;
          if (te.touches.length !== 1) return;
          te.stopPropagation();
          isResizingHandle = (handle as HTMLElement).getAttribute('data-handle');
          startDragPoint = { x: te.touches[0].clientX, y: te.touches[0].clientY };
          initialSelection = { ...selection };
        }, { passive: true });
      });

      // Window Move & Resize processing
      function onPointerMove(clientX: number, clientY: number) {
        if (!splitBox) return;
        const boxRect = splitBox.getBoundingClientRect();
        const deltaXNorm = (clientX - startDragPoint.x) / boxRect.width;
        const deltaYNorm = (clientY - startDragPoint.y) / boxRect.height;

        if (isMovingSelection) {
          let newX = initialSelection.x + deltaXNorm;
          let newY = initialSelection.y + deltaYNorm;
          newX = Math.max(0, Math.min(1 - initialSelection.width, newX));
          newY = Math.max(0, Math.min(1 - initialSelection.height, newY));
          selection.x = newX;
          selection.y = newY;
          triggerUpdate();
        } else if (isResizingHandle) {
          let { x, y, width, height } = initialSelection;
          const minSize = 0.05;

          if (isResizingHandle.includes('e')) {
            width = Math.max(minSize, Math.min(1 - x, initialSelection.width + deltaXNorm));
          }
          if (isResizingHandle.includes('s')) {
            height = Math.max(minSize, Math.min(1 - y, initialSelection.height + deltaYNorm));
          }
          if (isResizingHandle.includes('w')) {
            const maxDeltaW = initialSelection.width - minSize;
            const appliedDelta = Math.max(-initialSelection.x, Math.min(maxDeltaW, deltaXNorm));
            x = initialSelection.x + appliedDelta;
            width = initialSelection.width - appliedDelta;
          }
          if (isResizingHandle.includes('n')) {
            const maxDeltaH = initialSelection.height - minSize;
            const appliedDelta = Math.max(-initialSelection.y, Math.min(maxDeltaH, deltaYNorm));
            y = initialSelection.y + appliedDelta;
            height = initialSelection.height - appliedDelta;
          }

          selection = { x, y, width, height };
          triggerUpdate();
        }
      }

      window.addEventListener('mousemove', (e) => {
        if (isMovingSelection || isResizingHandle) {
          onPointerMove(e.clientX, e.clientY);
        }
      });

      window.addEventListener('mouseup', () => {
        if (isMovingSelection || isResizingHandle) {
          isMovingSelection = false;
          isResizingHandle = null;
        }
      });

      window.addEventListener('touchmove', (e) => {
        if ((isMovingSelection || isResizingHandle) && e.touches.length === 1) {
          onPointerMove(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: true });

      window.addEventListener('touchend', () => {
        isMovingSelection = false;
        isResizingHandle = null;
      });
    }

    // Reset selection box button
    if (resetSelectionAreaBtn) {
      resetSelectionAreaBtn.addEventListener('click', () => {
        selection = {
          x: 0.2,
          y: 0.2,
          width: 0.6,
          height: 0.6,
        };
        triggerUpdate();
      });
    }

    // Scope switching (entire vs selected area vs background)
    scopeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        scopeBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeScope = (btn.getAttribute('data-scope') as BlurScope) || 'entire';
        triggerUpdate();
      });
    });

    // Modes
    modeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        modeBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeMode = (btn.getAttribute('data-mode') as BlurMode) || 'gaussian';
        triggerUpdate();
      });
    });

    // Sliders
    if (radiusSlider) {
      radiusSlider.addEventListener('input', () => {
        radius = parseInt(radiusSlider.value, 10);
        if (radiusVal) radiusVal.textContent = `${radius} px`;
        triggerUpdate();
      });
    }

    if (brightnessSlider) {
      brightnessSlider.addEventListener('input', () => {
        brightness = parseInt(brightnessSlider.value, 10);
        if (brightnessVal) brightnessVal.textContent = `${brightness > 0 ? '+' : ''}${brightness}`;
        triggerUpdate();
      });
    }

    if (contrastSlider) {
      contrastSlider.addEventListener('input', () => {
        contrast = parseInt(contrastSlider.value, 10);
        if (contrastVal) contrastVal.textContent = `${contrast > 0 ? '+' : ''}${contrast}`;
        triggerUpdate();
      });
    }

    if (resetAdjustmentsBtn) {
      resetAdjustmentsBtn.addEventListener('click', () => {
        radius = 16;
        brightness = 0;
        contrast = 0;
        if (radiusSlider) radiusSlider.value = '16';
        if (radiusVal) radiusVal.textContent = '16 px';
        if (brightnessSlider) brightnessSlider.value = '0';
        if (brightnessVal) brightnessVal.textContent = '0';
        if (contrastSlider) contrastSlider.value = '0';
        if (contrastVal) contrastVal.textContent = '0';
        triggerUpdate();
      });
    }

    // Format select
    if (formatSelect) {
      formatSelect.addEventListener('change', triggerUpdate);
    }

    // Download Button
    if (downloadBtn) {
      downloadBtn.addEventListener('click', () => {
        if (!lastResult) return;

        let ext = '.png';
        const selFormat = formatSelect?.value || 'original';
        if (selFormat === 'image/png') ext = '.png';
        else if (selFormat === 'image/webp') ext = '.webp';
        else if (selFormat === 'image/jpeg') ext = '.jpg';
        else if (currentFile) {
          const match = currentFile.name.match(/\.[^/.]+$/);
          if (match) ext = match[0];
        }

        const baseName = currentFile ? currentFile.name.replace(/\.[^/.]+$/, '') : 'image';
        const filename = `${baseName}-blurred${ext}`;

        const a = document.createElement('a');
        a.href = lastResult.dataUrl;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      });
    }

    // Sample button
    if (sampleBtn) {
      sampleBtn.addEventListener('click', async () => {
        const file = await generateSampleBlurImage();
        loadFile(file);
      });
    }

    // File input change
    if (fileInput) {
      fileInput.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        if (target.files && target.files[0]) {
          loadFile(target.files[0]);
        }
      });
    }

    // Drag and drop
    if (dropzone) {
      ['dragenter', 'dragover'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('blur-drag-active');
        });
      });

      ['dragleave', 'drop'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('blur-drag-active');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        if (dt && dt.files && dt.files[0]) {
          loadFile(dt.files[0]);
        }
      });
    }

    // Paste listener (Ctrl+V)
    window.addEventListener('paste', (e: ClipboardEvent) => {
      const items = e.clipboardData?.items;
      if (!items) return;
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.indexOf('image') !== -1) {
          const file = items[i].getAsFile();
          if (file) {
            loadFile(file);
            break;
          }
        }
      }
    });
  }

  initBlurApp();
  document.addEventListener('astro:page-load', initBlurApp);
</script>


---
import { t, getLocalizedPath } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';
import { getToolUrl } from '@/data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const resizerUrl = locale === 'en' ? '/#resizer' : getLocalizedPath('/#resizer', locale);
const cmMmUrl = getToolUrl('cm-mm-resizer', locale);
const base64Url = getToolUrl('image-to-base64-converter', locale);
const dataUriUrl = getToolUrl('image-to-data-uri-converter', locale);
---

<div class="content-section">
  <div class="container">
    <div class="content-wrapper">
      <article class="prose">
        <h2>{t(locale, 'heic.content.heading1')}</h2>
        <p>{t(locale, 'heic.content.p1')}</p>

        <h2>{t(locale, 'heic.content.heading2')}</h2>
        <p>{t(locale, 'heic.content.p2')}</p>
        <ul class="feature-list">
          <li><strong>{t(locale, 'heic.content.benefit1').split(':')[0]}:</strong>{t(locale, 'heic.content.benefit1').split(':')[1]}</li>
          <li><strong>{t(locale, 'heic.content.benefit2').split(':')[0]}:</strong>{t(locale, 'heic.content.benefit2').split(':')[1]}</li>
          <li><strong>{t(locale, 'heic.content.benefit3').split(':')[0]}:</strong>{t(locale, 'heic.content.benefit3').split(':')[1]}</li>
          <li><strong>{t(locale, 'heic.content.benefit4').split(':')[0]}:</strong>{t(locale, 'heic.content.benefit4').split(':')[1]}</li>
        </ul>

        <h2>{t(locale, 'heic.content.heading3')}</h2>
        <p>{t(locale, 'heic.content.p3')}</p>
        <div class="steps-grid">
          <div class="step-card">
            <span class="step-num">1</span>
            <p>{t(locale, 'heic.content.step1')}</p>
          </div>
          <div class="step-card">
            <span class="step-num">2</span>
            <p>{t(locale, 'heic.content.step2')}</p>
          </div>
          <div class="step-card">
            <span class="step-num">3</span>
            <p>{t(locale, 'heic.content.step3')}</p>
          </div>
          <div class="step-card">
            <span class="step-num">4</span>
            <p>{t(locale, 'heic.content.step4')}</p>
          </div>
        </div>

        <h2>{t(locale, 'heic.content.heading4')}</h2>
        <p>{t(locale, 'heic.content.p4')}</p>
        <ul class="feature-list">
          <li><strong>{t(locale, 'heic.content.diff1').split(':')[0]}:</strong>{t(locale, 'heic.content.diff1').split(':')[1]}</li>
          <li><strong>{t(locale, 'heic.content.diff2').split(':')[0]}:</strong>{t(locale, 'heic.content.diff2').split(':')[1]}</li>
          <li><strong>{t(locale, 'heic.content.diff3').split(':')[0]}:</strong>{t(locale, 'heic.content.diff3').split(':')[1]}</li>
        </ul>

        <h2>{t(locale, 'heic.content.heading5')}</h2>
        <p>{t(locale, 'heic.content.p5')}</p>

        <!-- Internal Links to Companion Tools -->
        <div class="related-tools-box">
          <h3>Explore More Free Image Tools on ImgFeel</h3>
          <div class="related-links">
            <a href={resizerUrl} class="related-link">
              <span class="related-icon">⚡</span>
              <span><strong>Image Resizer & Compressor</strong> — Resize in px, %, or KB</span>
            </a>
            <a href={cmMmUrl} class="related-link">
              <span class="related-icon">📐</span>
              <span><strong>Resize in CM & MM</strong> — Physical print dimensions & DPI</span>
            </a>
            <a href={base64Url} class="related-link">
              <span class="related-icon">🔤</span>
              <span><strong>Image to Base64</strong> — Client-side Data URL encoder</span>
            </a>
            <a href={dataUriUrl} class="related-link">
              <span class="related-icon">🔗</span>
              <span><strong>Image to Data URI</strong> — RFC 2397 HTML & CSS generator</span>
            </a>
          </div>
        </div>

        <!-- FAQ Section -->
        <h2>Frequently Asked Questions</h2>
        <div class="faq-accordion">
          <details class="faq-item" open>
            <summary class="faq-question">{t(locale, 'heic.faq.q1')}</summary>
            <div class="faq-answer">
              <p>{t(locale, 'heic.faq.a1')}</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">{t(locale, 'heic.faq.q2')}</summary>
            <div class="faq-answer">
              <p>{t(locale, 'heic.faq.a2')}</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">{t(locale, 'heic.faq.q3')}</summary>
            <div class="faq-answer">
              <p>{t(locale, 'heic.faq.a3')}</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">{t(locale, 'heic.faq.q4')}</summary>
            <div class="faq-answer">
              <p>{t(locale, 'heic.faq.a4')}</p>
            </div>
          </details>
        </div>
      </article>
    </div>
  </div>
</div>

<style>
  .content-section {
    padding-block: var(--space-12) var(--space-16);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-12);
  }
  .content-wrapper {
    max-width: 820px;
    margin-inline: auto;
  }
  .prose h2 {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    line-height: 1.25;
  }
  .prose h2:first-child {
    margin-top: 0;
  }
  .prose p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }
  .feature-list {
    list-style: none;
    padding: 0;
    margin-bottom: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .feature-list li {
    position: relative;
    padding-left: var(--space-6);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .feature-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 800;
  }
  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-block: var(--space-6);
  }
  @media (min-width: 640px) {
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .step-card {
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: var(--color-accent);
    color: #ffffff;
    border-radius: 50%;
    font-weight: 700;
    font-size: var(--text-sm);
    flex-shrink: 0;
  }
  .step-card p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .related-tools-box {
    margin-block: var(--space-8);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .related-tools-box h3 {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }
  .related-links {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  @media (min-width: 640px) {
    .related-links {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .related-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text);
    font-size: var(--text-sm);
    transition: all 0.15s ease;
  }
  .related-link:hover {
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }
  .related-icon {
    font-size: 1.25rem;
  }

  /* FAQ Accordion */
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .faq-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .faq-question {
    padding: var(--space-4);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    cursor: pointer;
    user-select: none;
  }
  .faq-answer {
    padding: 0 var(--space-4) var(--space-4);
  }
  .faq-answer p {
    margin: 0;
  }
</style>

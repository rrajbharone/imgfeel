---
import { t, getLocalizedPath } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const links = [
  { label: t(locale, 'footer.tools'), href: getLocalizedPath('/tools/', locale) },
  { label: t(locale, 'footer.blog'), href: '/blog/' },
  { label: t(locale, 'footer.privacy'), href: '/privacy-policy/' },
  { label: t(locale, 'footer.terms'), href: '/terms-and-conditions/' },
  { label: t(locale, 'footer.cookies'), href: '/cookie-policy/' },
  { label: t(locale, 'footer.about'), href: '/about/' },
  { label: t(locale, 'footer.contact'), href: '/contact/' },
];
---

<footer class="footer">
  <div class="container footer-inner">
    <nav class="footer-links" aria-label="Footer">
      {links.map((link) => (
        <a href={link.href} class="footer-link">{link.label}</a>
      ))}
    </nav>
    <div class="footer-bottom">
      <p class="footer-tagline">{t(locale, 'footer.tagline')}</p>
      <p class="footer-copyright">{t(locale, 'footer.copyright')}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-8);
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    justify-content: center;
  }
  .footer-link {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    transition: color 0.15s;
  }
  .footer-link:hover {
    color: var(--color-text);
  }
  .footer-bottom {
    text-align: center;
  }
  .footer-tagline {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }
  .footer-copyright {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>

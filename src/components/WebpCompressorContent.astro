---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const faqItems = [
  { q: t(locale, 'webpcomp.faq.q1'), a: t(locale, 'webpcomp.faq.a1') },
  { q: t(locale, 'webpcomp.faq.q2'), a: t(locale, 'webpcomp.faq.a2') },
  { q: t(locale, 'webpcomp.faq.q3'), a: t(locale, 'webpcomp.faq.a3') },
  { q: t(locale, 'webpcomp.faq.q4'), a: t(locale, 'webpcomp.faq.a4') },
  { q: t(locale, 'webpcomp.faq.q5'), a: t(locale, 'webpcomp.faq.a5') },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="section content-section" aria-label="WebP Image Compressor Guide">
  <div class="container">
    <div class="content-body">
      <!-- Section 1: Introduction -->
      <h2>{t(locale, 'webpcomp.content.heading1')}</h2>
      <p>{t(locale, 'webpcomp.content.p1')}</p>
      <p>{t(locale, 'webpcomp.content.p1b')}</p>

      <!-- Section 2: Core Web Vitals & Web Performance -->
      <h2>{t(locale, 'webpcomp.content.heading2')}</h2>
      <p>{t(locale, 'webpcomp.content.p2')}</p>
      <div class="benefits-grid">
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <p>{t(locale, 'webpcomp.content.benefit1')}</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <p>{t(locale, 'webpcomp.content.benefit2')}</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            </svg>
          </div>
          <p>{t(locale, 'webpcomp.content.benefit3')}</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
          </div>
          <p>{t(locale, 'webpcomp.content.benefit4')}</p>
        </div>
      </div>

      <!-- Section 3: Lossy vs Lossless -->
      <h2>{t(locale, 'webpcomp.content.heading3')}</h2>
      <p>{t(locale, 'webpcomp.content.p3')}</p>
      <div class="modes-explanation">
        <div class="mode-item">
          <h3>{t(locale, 'webpcomp.content.mode1Title')}</h3>
          <p>{t(locale, 'webpcomp.content.mode1Desc')}</p>
        </div>
        <div class="mode-item">
          <h3>{t(locale, 'webpcomp.content.mode2Title')}</h3>
          <p>{t(locale, 'webpcomp.content.mode2Desc')}</p>
        </div>
      </div>

      <!-- Section 4: Format Comparison Table -->
      <h2>{t(locale, 'webpcomp.content.heading4')}</h2>
      <p>{t(locale, 'webpcomp.content.p4')}</p>
      <div class="specs-table-wrapper">
        <table class="specs-table">
          <thead>
            <tr>
              <th>Format</th>
              <th>Avg Size Reduction</th>
              <th>Transparency</th>
              <th>Browser Support</th>
              <th>Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>WebP (Lossy)</strong></td>
              <td>25%–35% vs JPG (up to 80% compressed)</td>
              <td><span class="badge-tag green">Yes (8-bit)</span></td>
              <td>97%+ (Universal)</td>
              <td>Photos, Hero Banners, Backgrounds</td>
            </tr>
            <tr>
              <td><strong>WebP (Lossless)</strong></td>
              <td>26% vs PNG</td>
              <td><span class="badge-tag green">Yes (8-bit)</span></td>
              <td>97%+ (Universal)</td>
              <td>Logos, Icons, UI Graphics, Screenshots</td>
            </tr>
            <tr>
              <td><strong>JPEG / JPG</strong></td>
              <td>Baseline</td>
              <td><span class="badge-tag red">No</span></td>
              <td>100%</td>
              <td>Legacy Photo Fallbacks</td>
            </tr>
            <tr>
              <td><strong>PNG</strong></td>
              <td>Baseline for Lossless</td>
              <td><span class="badge-tag green">Yes</span></td>
              <td>100%</td>
              <td>High-res Print Originals</td>
            </tr>
            <tr>
              <td><strong>AVIF</strong></td>
              <td>40%–50% vs JPG</td>
              <td><span class="badge-tag green">Yes</span></td>
              <td>93%</td>
              <td>Next-gen Static Asset Delivery</td>
            </tr>
          </tbody>
        </table>
      </div>
      <ul class="dimension-list">
        <li>{t(locale, 'webpcomp.content.comp1')}</li>
        <li>{t(locale, 'webpcomp.content.comp2')}</li>
        <li>{t(locale, 'webpcomp.content.comp3')}</li>
      </ul>

      <!-- Section 5: Recommended Settings -->
      <h2>{t(locale, 'webpcomp.content.heading5')}</h2>
      <p>{t(locale, 'webpcomp.content.p5')}</p>
      <ul class="dimension-list">
        <li>{t(locale, 'webpcomp.content.setting1')}</li>
        <li>{t(locale, 'webpcomp.content.setting2')}</li>
        <li>{t(locale, 'webpcomp.content.setting3')}</li>
        <li>{t(locale, 'webpcomp.content.setting4')}</li>
      </ul>

      <!-- Section 6: How-To Steps -->
      <h2>{t(locale, 'webpcomp.content.heading6')}</h2>
      <p>{t(locale, 'webpcomp.content.p6')}</p>
      <div class="steps-container">
        <div class="step-card">
          <div class="step-num">1</div>
          <p>{t(locale, 'webpcomp.content.step1')}</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <p>{t(locale, 'webpcomp.content.step2')}</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <p>{t(locale, 'webpcomp.content.step3')}</p>
        </div>
        <div class="step-card">
          <div class="step-num">4</div>
          <p>{t(locale, 'webpcomp.content.step4')}</p>
        </div>
      </div>

      <!-- Section 7: Security & Privacy -->
      <h2>{t(locale, 'webpcomp.content.heading7')}</h2>
      <p>{t(locale, 'webpcomp.content.p7')}</p>

      <!-- FAQ Section -->
      <h2 class="faq-heading">Frequently Asked Questions</h2>
      <div class="faq-list">
        {
          faqItems.map((faq) => (
            <details class="faq-item">
              <summary class="faq-question">
                <span>{faq.q}</span>
                <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </summary>
              <div class="faq-answer">
                <p>{faq.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .content-section {
    padding-block: var(--space-12);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .content-body {
    max-width: var(--container-narrow);
    margin-inline: auto;
  }

  .content-body h2 {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    letter-spacing: -0.01em;
  }

  .content-body h2:first-child {
    margin-top: 0;
  }

  .content-body p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-block: var(--space-6);
  }

  @media (min-width: 640px) {
    .benefits-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .benefit-card {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .benefit-card p {
    font-size: var(--text-sm);
    color: var(--color-text);
    margin: 0;
    line-height: 1.55;
  }

  .benefit-icon {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .modes-explanation {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-block: var(--space-5);
  }

  .mode-item {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
  }

  .mode-item h3 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 var(--space-1-5) 0;
  }

  .mode-item p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  .specs-table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    margin-block: var(--space-5);
    box-shadow: var(--shadow-xs);
  }

  .specs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
    min-width: 500px;
  }

  .specs-table th {
    background: var(--color-surface-subtle);
    padding: var(--space-3) var(--space-4);
    font-weight: 700;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
  }

  .specs-table td {
    padding: var(--space-3) var(--space-4);
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border-light);
  }

  .specs-table tr:last-child td {
    border-bottom: none;
  }

  .badge-tag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .badge-tag.green {
    background: #dcfce7;
    color: #15803d;
  }

  .badge-tag.red {
    background: #fee2e2;
    color: #991b1b;
  }

  .dimension-list {
    list-style: none;
    padding: 0;
    margin-block: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .dimension-list li {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .steps-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-block: var(--space-6);
  }

  .step-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
  }

  .step-num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #ffffff;
    font-size: var(--text-xs);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .step-card p {
    font-size: var(--text-sm);
    color: var(--color-text);
    margin: 0;
    line-height: 1.55;
  }

  .faq-heading {
    margin-top: var(--space-10) !important;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .faq-item[open] {
    border-color: var(--color-accent-border);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    color: var(--color-text-muted);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--color-accent);
  }

  .faq-answer {
    padding: 0 var(--space-5) var(--space-4);
  }

  .faq-answer p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
  }
</style>

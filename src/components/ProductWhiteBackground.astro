---
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';
import { getToolUrl } from '@/data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const noiseReducerUrl = getToolUrl('image-noise-reducer', locale);
const exactUrl = getToolUrl('exact-dimension-resizer', locale);
const webpUrl = getToolUrl('webp-compressor', locale);
const cropUrl = getToolUrl('freeform-image-cropper', locale);
const blurUrl = getToolUrl('image-blur-tool', locale);
---

<div class="product-app-container" id="productApp" data-locale={locale} data-i18n={JSON.stringify({
  copiedSuccess: t(locale, 'productWhiteBg.action.copied'),
})}>
  <!-- State 1: Upload-First Initial Dropzone Card -->
  <div class="product-dropzone-card" id="productDropzone">
    <div class="dropzone-inner">
      <div class="dropzone-icon-ring">
        <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
      </div>

      <h2 class="dropzone-headline">{t(locale, 'productWhiteBg.dropzone.title')}</h2>
      <p class="dropzone-subheadline">{t(locale, 'productWhiteBg.dropzone.subtitle')}</p>

      <div class="dropzone-action-group">
        <label for="productFileInput" class="btn btn-primary dropzone-browse-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'productWhiteBg.dropzone.browse')}</span>
        </label>
        <input type="file" id="productFileInput" accept="image/jpeg,image/png,image/webp,image/avif,image/bmp" class="visually-hidden" />

        <button type="button" class="btn btn-secondary sample-demo-btn" id="productSampleBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span>{t(locale, 'productWhiteBg.dropzone.sample')}</span>
        </button>
      </div>

      <div class="dropzone-badges-row">
        <span class="badge-pill">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          JPG, PNG, WebP, AVIF, BMP
        </span>
        <span class="badge-pill badge-pill-green">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          {t(locale, 'productWhiteBg.privacy.badge')}
        </span>
      </div>
    </div>
  </div>

  <!-- Loading State Card -->
  <div class="product-loading-card" id="productLoadingCard" style="display: none;">
    <div class="loading-spinner"></div>
    <p class="loading-text">{t(locale, 'productWhiteBg.status.processing')}</p>
  </div>

  <!-- State 2: Active Workspace (Hidden until image upload) -->
  <div class="product-workspace-card" id="productWorkspace" style="display: none;">
    <!-- Workspace Top Header Bar -->
    <div class="workspace-header-bar">
      <div class="image-meta-info">
        <span class="file-name-tag" id="productFileName">product.jpg</span>
        <span class="file-dim-pill" id="productOriginalDimsTag">-- × -- px</span>
        <span class="file-size-pill" id="productOriginalSizeTag">-- KB</span>
      </div>

      <div class="workspace-header-actions">
        <button type="button" class="btn btn-secondary btn-sm change-image-btn" id="productChangeImageBtn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'productWhiteBg.action.changeImage')}</span>
        </button>
      </div>
    </div>

    <!-- 2-Column Responsive Layout -->
    <div class="product-main-grid">
      <!-- Left Column: Interactive Comparison Preview -->
      <div class="product-preview-card">
        <!-- View Mode Navigation Tabs -->
        <div class="preview-mode-tabs">
          <button type="button" class="preview-tab active" data-view="split" id="viewModeSplitBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="3" x2="12" y2="21"></line>
              <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            </svg>
            <span>{t(locale, 'productWhiteBg.view.split')}</span>
          </button>
          <button type="button" class="preview-tab" data-view="side" id="viewModeSideBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="9" height="18" rx="2"></rect>
              <rect x="13" y="3" width="9" height="18" rx="2"></rect>
            </svg>
            <span>{t(locale, 'productWhiteBg.view.side')}</span>
          </button>
          <button type="button" class="preview-tab" data-view="result" id="viewModeResultBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
            </svg>
            <span>{t(locale, 'productWhiteBg.view.result')}</span>
          </button>
        </div>

        <!-- Split Slider Container -->
        <div class="split-viewport-wrapper" id="splitViewportWrapper">
          <div class="split-comparison-box" id="splitComparisonBox">
            <canvas id="productCanvasUnder" class="split-canvas"></canvas>
            <canvas id="productCanvasOver" class="split-canvas over-canvas"></canvas>
            
            <div class="split-divider-line" id="splitDividerLine" style="left: 50%;">
              <div class="split-drag-handle" title="Drag to compare">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </div>
            </div>

            <span class="split-tag tag-left">{t(locale, 'productWhiteBg.split.original')}</span>
            <span class="split-tag tag-right">{t(locale, 'productWhiteBg.split.whiteBg')}</span>
          </div>
          <p class="split-hint-text">{t(locale, 'productWhiteBg.split.hint')}</p>
        </div>

        <!-- Side-by-Side Container (Hidden by default) -->
        <div class="side-viewport-wrapper" id="sideViewportWrapper" style="display: none;">
          <div class="side-box">
            <span class="side-badge">{t(locale, 'productWhiteBg.split.original')}</span>
            <img id="sideOriginalImg" src="" alt="Original Product" class="side-img" />
          </div>
          <div class="side-box">
            <span class="side-badge">{t(locale, 'productWhiteBg.split.whiteBg')}</span>
            <img id="sideWhiteBgImg" src="" alt="Product on White Background" class="side-img" />
          </div>
        </div>

        <!-- Result Only Viewport (Hidden by default) -->
        <div class="single-viewport-wrapper" id="singleViewportWrapper" style="display: none;">
          <div class="single-box">
            <span class="single-badge">{t(locale, 'productWhiteBg.split.whiteBg')}</span>
            <img id="singleWhiteBgImg" src="" alt="Product on White Background preview" class="single-img" />
          </div>
        </div>

        <!-- Live Metrics Bar -->
        <div class="preview-metrics-strip">
          <div class="metric-item">
            <span class="metric-lbl">{t(locale, 'productWhiteBg.metrics.original')}:</span>
            <strong id="liveMetricOrigDims">-- × -- px</strong>
          </div>
          <div class="metric-item">
            <span class="metric-lbl">{t(locale, 'productWhiteBg.metrics.profile')}:</span>
            <span class="profile-chip" id="liveMetricProfile">Amazon Main Image</span>
          </div>
          <div class="metric-item">
            <span class="metric-lbl">RGB:</span>
            <strong class="privacy-green">255, 255, 255</strong>
          </div>
        </div>

        <!-- Primary Action Buttons Row -->
        <div class="product-action-buttons-grid">
          <button type="button" class="btn btn-primary product-download-btn" id="productDownloadBtn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>{t(locale, 'productWhiteBg.action.download')}</span>
          </button>

          <button type="button" class="btn btn-secondary product-copy-btn" id="productCopyBtn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="productCopyBtnText">{t(locale, 'productWhiteBg.action.copyImage')}</span>
          </button>

          <button type="button" class="btn btn-secondary product-reset-btn" id="productResetBtn" title={t(locale, 'productWhiteBg.action.reset')}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
              <path d="M3 3v5h5"></path>
            </svg>
            <span>{t(locale, 'productWhiteBg.action.reset')}</span>
          </button>
        </div>
      </div>

      <!-- Right Column: Product Controls Panel -->
      <div class="product-controls-panel">
        <!-- Section 1: Presets -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'productWhiteBg.section.presets')}</label>
          <div class="preset-chips-grid">
            <button type="button" class="tone-preset-btn active" data-preset="amazon">
              <strong>{t(locale, 'productWhiteBg.preset.amazon')}</strong>
              <span>{t(locale, 'productWhiteBg.preset.amazonDesc')}</span>
            </button>

            <button type="button" class="tone-preset-btn" data-preset="shopify">
              <strong>{t(locale, 'productWhiteBg.preset.shopify')}</strong>
              <span>{t(locale, 'productWhiteBg.preset.shopifyDesc')}</span>
            </button>

            <button type="button" class="tone-preset-btn" data-preset="warmStudio">
              <strong>{t(locale, 'productWhiteBg.preset.warmStudio')}</strong>
              <span>{t(locale, 'productWhiteBg.preset.warmStudioDesc')}</span>
            </button>

            <button type="button" class="tone-preset-btn" data-preset="cutoutOnly">
              <strong>{t(locale, 'productWhiteBg.preset.cutoutOnly')}</strong>
              <span>{t(locale, 'productWhiteBg.preset.cutoutOnlyDesc')}</span>
            </button>
          </div>
        </div>

        <!-- Section 2: Backdrop Canvas Style -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'productWhiteBg.section.backdrop')}</label>
          <div class="chip-selector-grid">
            <button type="button" class="chip-opt-btn active" data-bg="pure-white">
              <span class="color-dot dot-white"></span>
              <span>{t(locale, 'productWhiteBg.backdrop.pureWhite')}</span>
            </button>
            <button type="button" class="chip-opt-btn" data-bg="studio-warm">
              <span class="color-dot dot-warm"></span>
              <span>{t(locale, 'productWhiteBg.backdrop.warmWhite')}</span>
            </button>
            <button type="button" class="chip-opt-btn" data-bg="studio-cool">
              <span class="color-dot dot-cool"></span>
              <span>{t(locale, 'productWhiteBg.backdrop.coolWhite')}</span>
            </button>
            <button type="button" class="chip-opt-btn" data-bg="transparent">
              <span class="color-dot dot-trans"></span>
              <span>{t(locale, 'productWhiteBg.backdrop.transparent')}</span>
            </button>
          </div>
        </div>

        <!-- Section 3: Grounding & Contact Shadow -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'productWhiteBg.section.shadow')}</label>
          <div class="chip-selector-grid">
            <button type="button" class="chip-opt-btn active" data-shadow="soft-floor">
              <span>{t(locale, 'productWhiteBg.shadow.softFloor')}</span>
            </button>
            <button type="button" class="chip-opt-btn" data-shadow="drop">
              <span>{t(locale, 'productWhiteBg.shadow.drop')}</span>
            </button>
            <button type="button" class="chip-opt-btn" data-shadow="reflection">
              <span>{t(locale, 'productWhiteBg.shadow.reflection')}</span>
            </button>
            <button type="button" class="chip-opt-btn" data-shadow="none">
              <span>{t(locale, 'productWhiteBg.shadow.none')}</span>
            </button>
          </div>

          <div class="slider-header-row" style="margin-top: 6px;">
            <label for="shadowOpacitySlider" class="sub-label">{t(locale, 'productWhiteBg.shadow.opacity')}</label>
            <span class="val-pill" id="shadowOpacityValPill">35%</span>
          </div>
          <input type="range" id="shadowOpacitySlider" min="0" max="100" value="35" step="1" class="product-range" />
        </div>

        <!-- Section 4: Edge Matting & Defringe -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'productWhiteBg.section.edge')}</label>
          
          <div class="slider-header-row">
            <label for="toleranceSlider" class="sub-label">{t(locale, 'productWhiteBg.control.tolerance')}</label>
            <span class="val-pill" id="toleranceValPill">28%</span>
          </div>
          <input type="range" id="toleranceSlider" min="5" max="90" value="28" step="1" class="product-range" />
          <p class="slider-help">{t(locale, 'productWhiteBg.control.toleranceHelp')}</p>

          <div class="slider-header-row" style="margin-top: 6px;">
            <label for="featherSlider" class="sub-label">{t(locale, 'productWhiteBg.control.feather')}</label>
            <span class="val-pill" id="featherValPill">2 px</span>
          </div>
          <input type="range" id="featherSlider" min="0" max="6" value="2" step="1" class="product-range" />

          <div class="slider-header-row" style="margin-top: 6px;">
            <label for="despillSlider" class="sub-label">{t(locale, 'productWhiteBg.control.despill')}</label>
            <span class="val-pill" id="despillValPill">60%</span>
          </div>
          <input type="range" id="despillSlider" min="0" max="100" value="60" step="1" class="product-range" />
          <p class="slider-help">{t(locale, 'productWhiteBg.control.despillHelp')}</p>
        </div>

        <!-- Section 5: Framing, Padding & Aspect Ratio -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'productWhiteBg.section.framing')}</label>
          
          <div class="slider-header-row">
            <label for="paddingSlider" class="sub-label">{t(locale, 'productWhiteBg.control.padding')}</label>
            <span class="val-pill" id="paddingValPill">10%</span>
          </div>
          <input type="range" id="paddingSlider" min="0" max="30" value="10" step="1" class="product-range" />
          <p class="slider-help">{t(locale, 'productWhiteBg.control.paddingHelp')}</p>

          <div class="select-field" style="margin-top: 6px;">
            <label for="aspectRatioSelect" class="sub-label">{t(locale, 'productWhiteBg.control.aspectRatio')}</label>
            <select id="aspectRatioSelect" class="product-select">
              <option value="1:1" selected>{t(locale, 'productWhiteBg.aspect.square')}</option>
              <option value="original">{t(locale, 'productWhiteBg.aspect.original')}</option>
              <option value="4:3">{t(locale, 'productWhiteBg.aspect.fourThree')}</option>
              <option value="3:4">{t(locale, 'productWhiteBg.aspect.threeFour')}</option>
            </select>
          </div>
        </div>

        <!-- Section 6: Export Format & Quality -->
        <div class="control-group">
          <label class="control-label">{t(locale, 'productWhiteBg.section.export')}</label>
          <div class="select-field">
            <label for="exportFormatSelect" class="sub-label">{t(locale, 'productWhiteBg.export.format')}</label>
            <select id="exportFormatSelect" class="product-select">
              <option value="image/jpeg" selected>JPG / JPEG (Standard E-Commerce White Background)</option>
              <option value="image/webp">WebP (Optimized & High Speed)</option>
              <option value="image/png">PNG (Lossless & Transparent Support)</option>
            </select>
          </div>

          <div class="quality-field" id="qualityFieldBox">
            <div class="slider-header-row">
              <label for="exportQualitySlider" class="sub-label">{t(locale, 'productWhiteBg.export.quality')}</label>
              <span class="val-pill" id="qualityValPill">92%</span>
            </div>
            <input type="range" id="exportQualitySlider" min="10" max="100" value="92" step="1" class="product-range" />
          </div>
        </div>
      </div>
    </div>

    <!-- Related Cross Navigation Links -->
    <div class="product-cross-links-row">
      <a href={noiseReducerUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
        <span>{t(locale, 'productWhiteBg.cross.noiseReducer')}</span>
      </a>

      <a href={exactUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="4" y1="21" x2="4" y2="14"></line>
          <line x1="4" y1="10" x2="4" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12" y2="3"></line>
          <line x1="20" y1="21" x2="20" y2="16"></line>
          <line x1="20" y1="12" x2="20" y2="3"></line>
        </svg>
        <span>{t(locale, 'productWhiteBg.cross.exact')}</span>
      </a>

      <a href={webpUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <span>{t(locale, 'productWhiteBg.cross.compressor')}</span>
      </a>

      <a href={cropUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 2v14a2 2 0 0 0 2 2h14"></path>
          <path d="M18 22V8a2 2 0 0 0-2-2H2"></path>
        </svg>
        <span>{t(locale, 'productWhiteBg.cross.cropper')}</span>
      </a>

      <a href={blurUrl} class="btn btn-secondary cross-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="9" stroke-dasharray="2 3"></circle>
          <circle cx="12" cy="12" r="5" stroke-dasharray="1 2"></circle>
        </svg>
        <span>{t(locale, 'productWhiteBg.cross.blur')}</span>
      </a>
    </div>
  </div>
</div>

<script>
  import {
    loadProductImageFromFile,
    renderComposedProductCanvas,
    generateSampleProductImage,
    exportProductImage,
    copyProductCanvasToClipboard,
    DEFAULT_PRODUCT_OPTIONS,
    PRODUCT_PRESETS,
    type ProductWhiteBgOptions,
    type LoadedProductImageInfo,
  } from '@/scripts/product-white-bg';

  const appEl = document.getElementById('productApp');
  const i18n = appEl?.dataset.i18n ? JSON.parse(appEl.dataset.i18n) : {};

  // State
  let currentFile: File | null = null;
  let loadedImageObj: LoadedProductImageInfo | null = null;
  let originalWidth = 0;
  let originalHeight = 0;
  let splitPosPercent = 50;
  let isDraggingSplit = false;

  let productOptions: ProductWhiteBgOptions = { ...DEFAULT_PRODUCT_OPTIONS };
  let exportFormat: string = 'image/jpeg';
  let exportQuality: number = 0.92;

  let renderDebounceTimer: number | null = null;

  // DOM Elements
  const dropzone = document.getElementById('productDropzone') as HTMLElement;
  const fileInput = document.getElementById('productFileInput') as HTMLInputElement;
  const sampleBtn = document.getElementById('productSampleBtn') as HTMLButtonElement;
  const loadingCard = document.getElementById('productLoadingCard') as HTMLElement;
  const workspace = document.getElementById('productWorkspace') as HTMLElement;

  const fileNameEl = document.getElementById('productFileName') as HTMLElement;
  const origDimsTag = document.getElementById('productOriginalDimsTag') as HTMLElement;
  const origSizeTag = document.getElementById('productOriginalSizeTag') as HTMLElement;
  const changeImageBtn = document.getElementById('productChangeImageBtn') as HTMLButtonElement;

  const viewTabs = document.querySelectorAll('.preview-tab') as NodeListOf<HTMLButtonElement>;
  const splitWrapper = document.getElementById('splitViewportWrapper') as HTMLElement;
  const sideWrapper = document.getElementById('sideViewportWrapper') as HTMLElement;
  const singleWrapper = document.getElementById('singleViewportWrapper') as HTMLElement;

  const splitBox = document.getElementById('splitComparisonBox') as HTMLElement;
  const canvasUnder = document.getElementById('productCanvasUnder') as HTMLCanvasElement;
  const canvasOver = document.getElementById('productCanvasOver') as HTMLCanvasElement;
  const splitDivider = document.getElementById('splitDividerLine') as HTMLElement;

  const sideOrigImg = document.getElementById('sideOriginalImg') as HTMLImageElement;
  const sideWhiteBgImg = document.getElementById('sideWhiteBgImg') as HTMLImageElement;
  const singleWhiteBgImg = document.getElementById('singleWhiteBgImg') as HTMLImageElement;

  const liveMetricOrigDims = document.getElementById('liveMetricOrigDims') as HTMLElement;
  const liveMetricProfile = document.getElementById('liveMetricProfile') as HTMLElement;

  const presetBtns = document.querySelectorAll('.tone-preset-btn') as NodeListOf<HTMLButtonElement>;
  const bgBtns = document.querySelectorAll('.chip-opt-btn[data-bg]') as NodeListOf<HTMLButtonElement>;
  const shadowBtns = document.querySelectorAll('.chip-opt-btn[data-shadow]') as NodeListOf<HTMLButtonElement>;

  const shadowOpacitySlider = document.getElementById('shadowOpacitySlider') as HTMLInputElement;
  const shadowOpacityValPill = document.getElementById('shadowOpacityValPill') as HTMLElement;

  const toleranceSlider = document.getElementById('toleranceSlider') as HTMLInputElement;
  const toleranceValPill = document.getElementById('toleranceValPill') as HTMLElement;
  const featherSlider = document.getElementById('featherSlider') as HTMLInputElement;
  const featherValPill = document.getElementById('featherValPill') as HTMLElement;
  const despillSlider = document.getElementById('despillSlider') as HTMLInputElement;
  const despillValPill = document.getElementById('despillValPill') as HTMLElement;

  const paddingSlider = document.getElementById('paddingSlider') as HTMLInputElement;
  const paddingValPill = document.getElementById('paddingValPill') as HTMLElement;
  const aspectRatioSelect = document.getElementById('aspectRatioSelect') as HTMLSelectElement;

  const exportFormatSelect = document.getElementById('exportFormatSelect') as HTMLSelectElement;
  const qualityFieldBox = document.getElementById('qualityFieldBox') as HTMLElement;
  const exportQualitySlider = document.getElementById('exportQualitySlider') as HTMLInputElement;
  const qualityValPill = document.getElementById('qualityValPill') as HTMLElement;

  const downloadBtn = document.getElementById('productDownloadBtn') as HTMLButtonElement;
  const copyBtn = document.getElementById('productCopyBtn') as HTMLButtonElement;
  const copyBtnText = document.getElementById('productCopyBtnText') as HTMLElement;
  const resetBtn = document.getElementById('productResetBtn') as HTMLButtonElement;

  function renderCanvases() {
    if (!loadedImageObj || !canvasUnder || !canvasOver) return;

    const maxDim = 850;
    // 1. Render composed white background canvas
    const composed = renderComposedProductCanvas(loadedImageObj.img, productOptions, maxDim);

    const targetW = composed.width;
    const targetH = composed.height;

    canvasUnder.width = targetW;
    canvasUnder.height = targetH;
    canvasOver.width = targetW;
    canvasOver.height = targetH;

    const ctxUnder = canvasUnder.getContext('2d');
    const ctxOver = canvasOver.getContext('2d');
    if (!ctxUnder || !ctxOver) return;

    // Original scaled in center for under canvas
    ctxUnder.fillStyle = '#f8fafc';
    ctxUnder.fillRect(0, 0, targetW, targetH);
    const origScale = Math.min(targetW / loadedImageObj.originalWidth, targetH / loadedImageObj.originalHeight);
    const oW = loadedImageObj.originalWidth * origScale;
    const oH = loadedImageObj.originalHeight * origScale;
    ctxUnder.drawImage(loadedImageObj.img, (targetW - oW) / 2, (targetH - oH) / 2, oW, oH);

    // Over canvas gets the composed result
    ctxOver.drawImage(composed, 0, 0);

    if (canvasOver) {
      canvasOver.style.clipPath = `inset(0 0 0 ${splitPosPercent}%)`;
    }

    // Immediately update preview images for Side-by-Side and Result Only
    const previewDataUrl = composed.toDataURL('image/png');
    if (sideWhiteBgImg) sideWhiteBgImg.src = previewDataUrl;
    if (singleWhiteBgImg) singleWhiteBgImg.src = previewDataUrl;
  }

  function triggerUpdate() {
    renderCanvases();
  }

  async function loadFile(file: File) {
    if (!dropzone || !loadingCard || !workspace) return;

    dropzone.style.display = 'none';
    workspace.style.display = 'none';
    loadingCard.style.display = 'flex';

    try {
      currentFile = file;
      loadedImageObj = await loadProductImageFromFile(file);
      originalWidth = loadedImageObj.originalWidth;
      originalHeight = loadedImageObj.originalHeight;

      // Reset options
      productOptions = { ...DEFAULT_PRODUCT_OPTIONS };
      splitPosPercent = 50;

      // Update UI controls
      presetBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-preset') === 'amazon'));
      bgBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-bg') === productOptions.bgType));
      shadowBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-shadow') === productOptions.shadowType));

      if (shadowOpacitySlider) shadowOpacitySlider.value = String(productOptions.shadowOpacity);
      if (shadowOpacityValPill) shadowOpacityValPill.textContent = `${productOptions.shadowOpacity}%`;

      if (toleranceSlider) toleranceSlider.value = String(productOptions.tolerance);
      if (toleranceValPill) toleranceValPill.textContent = `${productOptions.tolerance}%`;

      if (featherSlider) featherSlider.value = String(productOptions.feather);
      if (featherValPill) featherValPill.textContent = `${productOptions.feather} px`;

      if (despillSlider) despillSlider.value = String(productOptions.despill);
      if (despillValPill) despillValPill.textContent = `${productOptions.despill}%`;

      if (paddingSlider) paddingSlider.value = String(productOptions.paddingPercent);
      if (paddingValPill) paddingValPill.textContent = `${productOptions.paddingPercent}%`;

      if (aspectRatioSelect) aspectRatioSelect.value = productOptions.aspectRatio;

      // Header meta tags
      if (fileNameEl) fileNameEl.textContent = file.name;
      if (origDimsTag) origDimsTag.textContent = `${originalWidth} × ${originalHeight} px`;
      if (origSizeTag) origSizeTag.textContent = `${(file.size / 1024).toFixed(1)} KB`;
      if (liveMetricOrigDims) liveMetricOrigDims.textContent = `${originalWidth} × ${originalHeight} px`;
      if (liveMetricProfile) liveMetricProfile.textContent = 'Amazon Main Image';

      if (splitDivider) splitDivider.style.left = '50%';
      if (sideOrigImg) sideOrigImg.src = loadedImageObj.img.src;

      renderCanvases();

      loadingCard.style.display = 'none';
      workspace.style.display = 'block';
    } catch (err) {
      alert(err instanceof Error ? err.message : 'Failed to load image');
      resetToDropzone();
    }
  }

  function resetToDropzone() {
    currentFile = null;
    loadedImageObj = null;
    if (fileInput) fileInput.value = '';
    if (loadingCard) loadingCard.style.display = 'none';
    if (workspace) workspace.style.display = 'none';
    if (dropzone) dropzone.style.display = 'block';
  }

  if (changeImageBtn) changeImageBtn.addEventListener('click', resetToDropzone);

  // View mode tab switching
  viewTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      viewTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');

      const mode = tab.getAttribute('data-view');
      if (splitWrapper) splitWrapper.style.display = mode === 'split' ? 'flex' : 'none';
      if (sideWrapper) sideWrapper.style.display = mode === 'side' ? 'grid' : 'none';
      if (singleWrapper) singleWrapper.style.display = mode === 'result' ? 'block' : 'none';
    });
  });

  // Split dragging logic
  function handleSplitMove(clientX: number) {
    if (!splitBox) return;
    const rect = splitBox.getBoundingClientRect();
    const x = Math.max(0, Math.min(rect.width, clientX - rect.left));
    splitPosPercent = Math.round((x / rect.width) * 100);

    if (splitDivider) splitDivider.style.left = `${splitPosPercent}%`;
    if (canvasOver) canvasOver.style.clipPath = `inset(0 0 0 ${splitPosPercent}%)`;
  }

  if (splitBox) {
    splitBox.addEventListener('mousedown', (e) => {
      isDraggingSplit = true;
      handleSplitMove(e.clientX);
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDraggingSplit) return;
      handleSplitMove(e.clientX);
    });

    window.addEventListener('mouseup', () => {
      isDraggingSplit = false;
    });

    splitBox.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        isDraggingSplit = true;
        handleSplitMove(e.touches[0].clientX);
      }
    }, { passive: true });

    splitBox.addEventListener('touchmove', (e) => {
      if (!isDraggingSplit || e.touches.length !== 1) return;
      handleSplitMove(e.touches[0].clientX);
    }, { passive: true });

    splitBox.addEventListener('touchend', () => {
      isDraggingSplit = false;
    });
  }

  // Presets
  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      presetBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const presetKey = btn.getAttribute('data-preset') || 'amazon';
      const config = PRODUCT_PRESETS[presetKey];
      if (config) {
        productOptions = { ...productOptions, ...config };

        bgBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-bg') === productOptions.bgType));
        shadowBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-shadow') === productOptions.shadowType));

        if (shadowOpacitySlider) shadowOpacitySlider.value = String(productOptions.shadowOpacity);
        if (shadowOpacityValPill) shadowOpacityValPill.textContent = `${productOptions.shadowOpacity}%`;

        if (toleranceSlider) toleranceSlider.value = String(productOptions.tolerance);
        if (toleranceValPill) toleranceValPill.textContent = `${productOptions.tolerance}%`;

        if (featherSlider) featherSlider.value = String(productOptions.feather);
        if (featherValPill) featherValPill.textContent = `${productOptions.feather} px`;

        if (despillSlider) despillSlider.value = String(productOptions.despill);
        if (despillValPill) despillValPill.textContent = `${productOptions.despill}%`;

        if (paddingSlider) paddingSlider.value = String(productOptions.paddingPercent);
        if (paddingValPill) paddingValPill.textContent = `${productOptions.paddingPercent}%`;

        if (aspectRatioSelect) aspectRatioSelect.value = productOptions.aspectRatio;

        if (liveMetricProfile) liveMetricProfile.textContent = btn.querySelector('strong')?.textContent || presetKey;
      }
      triggerUpdate();
    });
  });

  // Backdrop Selector
  bgBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      bgBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      productOptions.bgType = (btn.getAttribute('data-bg') as any) || 'pure-white';
      triggerUpdate();
    });
  });

  // Shadow Selector
  shadowBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      shadowBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      productOptions.shadowType = (btn.getAttribute('data-shadow') as any) || 'soft-floor';
      triggerUpdate();
    });
  });

  // Sliders
  if (shadowOpacitySlider) {
    shadowOpacitySlider.addEventListener('input', () => {
      productOptions.shadowOpacity = parseInt(shadowOpacitySlider.value, 10);
      if (shadowOpacityValPill) shadowOpacityValPill.textContent = `${productOptions.shadowOpacity}%`;
      triggerUpdate();
    });
  }

  if (toleranceSlider) {
    toleranceSlider.addEventListener('input', () => {
      productOptions.tolerance = parseInt(toleranceSlider.value, 10);
      if (toleranceValPill) toleranceValPill.textContent = `${productOptions.tolerance}%`;
      triggerUpdate();
    });
  }

  if (featherSlider) {
    featherSlider.addEventListener('input', () => {
      productOptions.feather = parseInt(featherSlider.value, 10);
      if (featherValPill) featherValPill.textContent = `${productOptions.feather} px`;
      triggerUpdate();
    });
  }

  if (despillSlider) {
    despillSlider.addEventListener('input', () => {
      productOptions.despill = parseInt(despillSlider.value, 10);
      if (despillValPill) despillValPill.textContent = `${productOptions.despill}%`;
      triggerUpdate();
    });
  }

  if (paddingSlider) {
    paddingSlider.addEventListener('input', () => {
      productOptions.paddingPercent = parseInt(paddingSlider.value, 10);
      if (paddingValPill) paddingValPill.textContent = `${productOptions.paddingPercent}%`;
      triggerUpdate();
    });
  }

  if (aspectRatioSelect) {
    aspectRatioSelect.addEventListener('change', () => {
      productOptions.aspectRatio = (aspectRatioSelect.value as any) || '1:1';
      triggerUpdate();
    });
  }

  // Export Settings
  if (exportFormatSelect) {
    exportFormatSelect.addEventListener('change', () => {
      exportFormat = exportFormatSelect.value;
      if (qualityFieldBox) {
        qualityFieldBox.style.display = exportFormat === 'image/png' ? 'none' : 'block';
      }
    });
  }

  if (exportQualitySlider) {
    exportQualitySlider.addEventListener('input', () => {
      const q = parseInt(exportQualitySlider.value, 10);
      exportQuality = q / 100;
      if (qualityValPill) qualityValPill.textContent = `${q}%`;
    });
  }

  // Reset Button
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      productOptions = { ...DEFAULT_PRODUCT_OPTIONS };
      presetBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-preset') === 'amazon'));
      bgBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-bg') === productOptions.bgType));
      shadowBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-shadow') === productOptions.shadowType));

      if (shadowOpacitySlider) shadowOpacitySlider.value = String(productOptions.shadowOpacity);
      if (shadowOpacityValPill) shadowOpacityValPill.textContent = `${productOptions.shadowOpacity}%`;
      if (toleranceSlider) toleranceSlider.value = String(productOptions.tolerance);
      if (toleranceValPill) toleranceValPill.textContent = `${productOptions.tolerance}%`;
      if (featherSlider) featherSlider.value = String(productOptions.feather);
      if (featherValPill) featherValPill.textContent = `${productOptions.feather} px`;
      if (despillSlider) despillSlider.value = String(productOptions.despill);
      if (despillValPill) despillValPill.textContent = `${productOptions.despill}%`;
      if (paddingSlider) paddingSlider.value = String(productOptions.paddingPercent);
      if (paddingValPill) paddingValPill.textContent = `${productOptions.paddingPercent}%`;
      if (aspectRatioSelect) aspectRatioSelect.value = productOptions.aspectRatio;
      if (liveMetricProfile) liveMetricProfile.textContent = 'Amazon Main Image';
      triggerUpdate();
    });
  }

  // Download Action
  if (downloadBtn) {
    downloadBtn.addEventListener('click', () => {
      if (!loadedImageObj) return;

      const baseName = loadedImageObj.name.replace(/\.[^/.]+$/, '');
      const fullCanvas = renderComposedProductCanvas(loadedImageObj.img, productOptions);
      exportProductImage(fullCanvas, exportFormat as any, exportQuality, `${baseName}-white-bg`);
    });
  }

  // Copy to Clipboard Action
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      if (!loadedImageObj) return;
      try {
        const fullCanvas = renderComposedProductCanvas(loadedImageObj.img, productOptions);
        const success = await copyProductCanvasToClipboard(fullCanvas);
        if (success) {
          if (copyBtnText) copyBtnText.textContent = i18n.copiedSuccess || 'Copied!';
          copyBtn.classList.add('btn-success');
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = 'Copy Image';
            copyBtn.classList.remove('btn-success');
          }, 2000);
        } else {
          alert('Clipboard copy is not supported in this browser.');
        }
      } catch (err) {
        alert('Could not copy image to clipboard.');
      }
    });
  }

  // File Upload Handlers
  if (fileInput) {
    fileInput.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files && files[0]) loadFile(files[0]);
    });
  }

  if (sampleBtn) {
    sampleBtn.addEventListener('click', async () => {
      showLoading(true);
      try {
        const sampleFile = await generateSampleProductImage();
        loadedImageObj = sampleFile;
        originalWidth = sampleFile.originalWidth;
        originalHeight = sampleFile.originalHeight;

        productOptions = { ...DEFAULT_PRODUCT_OPTIONS };
        splitPosPercent = 50;

        presetBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-preset') === 'amazon'));
        bgBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-bg') === productOptions.bgType));
        shadowBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-shadow') === productOptions.shadowType));

        if (shadowOpacitySlider) shadowOpacitySlider.value = String(productOptions.shadowOpacity);
        if (shadowOpacityValPill) shadowOpacityValPill.textContent = `${productOptions.shadowOpacity}%`;
        if (toleranceSlider) toleranceSlider.value = String(productOptions.tolerance);
        if (toleranceValPill) toleranceValPill.textContent = `${productOptions.tolerance}%`;
        if (featherSlider) featherSlider.value = String(productOptions.feather);
        if (featherValPill) featherValPill.textContent = `${productOptions.feather} px`;
        if (despillSlider) despillSlider.value = String(productOptions.despill);
        if (despillValPill) despillValPill.textContent = `${productOptions.despill}%`;
        if (paddingSlider) paddingSlider.value = String(productOptions.paddingPercent);
        if (paddingValPill) paddingValPill.textContent = `${productOptions.paddingPercent}%`;
        if (aspectRatioSelect) aspectRatioSelect.value = productOptions.aspectRatio;

        if (fileNameEl) fileNameEl.textContent = sampleFile.name;
        if (origDimsTag) origDimsTag.textContent = `${originalWidth} × ${originalHeight} px`;
        if (origSizeTag) origSizeTag.textContent = `${(sampleFile.fileSize / 1024).toFixed(1)} KB`;
        if (liveMetricOrigDims) liveMetricOrigDims.textContent = `${originalWidth} × ${originalHeight} px`;
        if (liveMetricProfile) liveMetricProfile.textContent = 'Amazon Main Image';

        if (splitDivider) splitDivider.style.left = '50%';
        if (sideOrigImg) sideOrigImg.src = sampleFile.img.src;

        renderCanvases();

        loadingCard.style.display = 'none';
        dropzone.style.display = 'none';
        workspace.style.display = 'block';
      } catch (err) {
        showLoading(false);
      }
    });
  }

  function showLoading(show: boolean) {
    if (show) {
      loadingCard.style.display = 'flex';
      workspace.style.display = 'none';
      dropzone.style.display = 'none';
    } else {
      loadingCard.style.display = 'none';
    }
  }

  // Drag & Drop onto Dropzone
  if (dropzone) {
    ['dragenter', 'dragover'].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropzone.classList.add('dragover');
      });
    });
    ['dragleave', 'drop'].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropzone.classList.remove('dragover');
      });
    });
    dropzone.addEventListener('drop', (e) => {
      const dt = e.dataTransfer;
      if (dt?.files?.[0]) loadFile(dt.files[0]);
    });
  }

  // Global Clipboard Paste
  window.addEventListener('paste', (e) => {
    const items = e.clipboardData?.items;
    if (!items) return;
    for (let i = 0; i < items.length; i++) {
      if (items[i].type.startsWith('image/')) {
        const file = items[i].getAsFile();
        if (file) loadFile(file);
        break;
      }
    }
  });
</script>


---
import { t } from '@/i18n/utils';
import SEOHead from './SEOHead.astro';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const faqs = [
  { qKey: 'sscresizer.faq.q1', aKey: 'sscresizer.faq.a1' },
  { qKey: 'sscresizer.faq.q2', aKey: 'sscresizer.faq.a2' },
  { qKey: 'sscresizer.faq.q3', aKey: 'sscresizer.faq.a3' },
  { qKey: 'sscresizer.faq.q4', aKey: 'sscresizer.faq.a4' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: t(locale, faq.qKey),
    acceptedAnswer: {
      '@type': 'Answer',
      text: t(locale, faq.aKey),
    },
  })),
};
---

<article class="tool-content">
  <div class="container content-inner">
    <h2>{t(locale, 'sscresizer.content.heading1')}</h2>
    <p>{t(locale, 'sscresizer.content.p1')}</p>

    <h2>{t(locale, 'sscresizer.content.heading2')}</h2>
    <p>{t(locale, 'sscresizer.content.p2')}</p>
    <ul class="req-list">
      <li>{t(locale, 'sscresizer.content.reqPhoto')}</li>
      <li>{t(locale, 'sscresizer.content.reqSig')}</li>
    </ul>

    <h2>{t(locale, 'sscresizer.content.heading3')}</h2>
    <p>{t(locale, 'sscresizer.content.p3')}</p>
    <ol class="step-list">
      <li>{t(locale, 'sscresizer.content.step1')}</li>
      <li>{t(locale, 'sscresizer.content.step2')}</li>
      <li>{t(locale, 'sscresizer.content.step3')}</li>
      <li>{t(locale, 'sscresizer.content.step4')}</li>
      <li>{t(locale, 'sscresizer.content.step5')}</li>
      <li>{t(locale, 'sscresizer.content.step6')}</li>
    </ol>

    <h2>{t(locale, 'sscresizer.content.heading4')}</h2>
    <p>{t(locale, 'sscresizer.content.p4')}</p>

    <h2>{t(locale, 'sscresizer.content.heading5')}</h2>
    <p>{t(locale, 'sscresizer.content.p5')}</p>

    <h2>{t(locale, 'sscresizer.content.heading6')}</h2>
    <p>{t(locale, 'sscresizer.content.p6')}</p>
    <ul class="mistake-list">
      <li>{t(locale, 'sscresizer.content.mistake1')}</li>
      <li>{t(locale, 'sscresizer.content.mistake2')}</li>
      <li>{t(locale, 'sscresizer.content.mistake3')}</li>
    </ul>

    <h2>{t(locale, 'sscresizer.content.heading7')}</h2>
    <p>{t(locale, 'sscresizer.content.p7')}</p>

    <!-- FAQ Section -->
    <section class="content-faq">
      <h2>{t(locale, 'home.faq.title')}</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{t(locale, faq.qKey)}</summary>
            <p class="faq-answer">{t(locale, faq.aKey)}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
  <SEOHead schema={faqSchema} />
</article>

<style>
  .tool-content {
    padding-block: var(--space-12);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-12);
  }
  .content-inner {
    max-width: var(--container-narrow);
    margin-inline: auto;
  }
  .tool-content h2 {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }
  .tool-content p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }
  .req-list,
  .step-list,
  .mistake-list {
    padding-left: var(--space-5);
    margin-bottom: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .req-list li,
  .step-list li,
  .mistake-list li {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .content-faq {
    margin-top: var(--space-10);
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }
  .faq-question {
    padding: var(--space-4) 0;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
  }
  .faq-answer {
    padding-bottom: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
</style>

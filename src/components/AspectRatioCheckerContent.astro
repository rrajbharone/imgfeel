---
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const faqItems = [
  { q: t(locale, 'ratiocheck.faq.q1'), a: t(locale, 'ratiocheck.faq.a1') },
  { q: t(locale, 'ratiocheck.faq.q2'), a: t(locale, 'ratiocheck.faq.a2') },
  { q: t(locale, 'ratiocheck.faq.q3'), a: t(locale, 'ratiocheck.faq.a3') },
  { q: t(locale, 'ratiocheck.faq.q4'), a: t(locale, 'ratiocheck.faq.a4') },
  { q: t(locale, 'ratiocheck.faq.q5'), a: t(locale, 'ratiocheck.faq.a5') },
  { q: t(locale, 'ratiocheck.faq.q6'), a: t(locale, 'ratiocheck.faq.a6') },
  { q: t(locale, 'ratiocheck.faq.q7'), a: t(locale, 'ratiocheck.faq.a7') },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="section content-section">
  <div class="container">
    <div class="content-body">
      <!-- Section 1: Introduction & Key Benefits -->
      <h2>{t(locale, 'ratiocheck.content.h1')}</h2>
      <p>{t(locale, 'ratiocheck.content.p1a')}</p>
      <p>{t(locale, 'ratiocheck.content.p1b')}</p>

      <div class="features-summary-grid">
        <div class="feature-box">
          <div class="feature-box-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 2v14a2 2 0 0 0 2 2h14"></path>
              <path d="M18 22V8a2 2 0 0 0-2-2H2"></path>
            </svg>
          </div>
          <h4>{t(locale, 'ratiocheck.content.feat1Title')}</h4>
          <p>{t(locale, 'ratiocheck.content.feat1Desc')}</p>
        </div>

        <div class="feature-box">
          <div class="feature-box-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <h4>{t(locale, 'ratiocheck.content.feat2Title')}</h4>
          <p>{t(locale, 'ratiocheck.content.feat2Desc')}</p>
        </div>

        <div class="feature-box">
          <div class="feature-box-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          <h4>{t(locale, 'ratiocheck.content.feat3Title')}</h4>
          <p>{t(locale, 'ratiocheck.content.feat3Desc')}</p>
        </div>

        <div class="feature-box">
          <div class="feature-box-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h4>{t(locale, 'ratiocheck.content.feat4Title')}</h4>
          <p>{t(locale, 'ratiocheck.content.feat4Desc')}</p>
        </div>
      </div>

      <!-- Section 2: Mathematical Calculation Formula -->
      <h2>{t(locale, 'ratiocheck.content.h2')}</h2>
      <p>{t(locale, 'ratiocheck.content.p2a')}</p>
      <p>{t(locale, 'ratiocheck.content.p2b')}</p>

      <div class="formula-box">
        <span class="formula-label">Mathematical Aspect Ratio Formula:</span>
        <code class="formula-code">Simplified Aspect Ratio = (Width ÷ GCD(Width, Height)) : (Height ÷ GCD(Width, Height))</code>
        <code class="formula-code">Decimal Aspect Ratio = Width ÷ Height : 1</code>
        <code class="formula-code">CSS Padding-Top Hack % = (Height ÷ Width) × 100%</code>
        <span class="formula-note">Example: For a 1920 × 1080 Full HD image, GCD is 120. (1920 ÷ 120) : (1080 ÷ 120) = <strong>16:9</strong> (1.78:1 decimal, 56.25% CSS height).</span>
      </div>

      <!-- Section 3: Aspect Ratio vs Image Resolution -->
      <h2>{t(locale, 'ratiocheck.content.h3')}</h2>
      <p>{t(locale, 'ratiocheck.content.p3a')}</p>
      <p>{t(locale, 'ratiocheck.content.p3b')}</p>

      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>Concept</th>
              <th>What It Measures</th>
              <th>Standard Units</th>
              <th>Example Values</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Aspect Ratio</strong></td>
              <td>Proportional relationship between width & height</td>
              <td>Ratio string (W:H) or decimal</td>
              <td><code>16:9</code>, <code>4:3</code>, <code>1:1</code>, <code>9:16</code>, <code>1.78:1</code></td>
            </tr>
            <tr>
              <td><strong>Image Resolution</strong></td>
              <td>Total number of pixels in the digital image grid</td>
              <td>Pixels (W × H) and Megapixels</td>
              <td><code>1920 × 1080 px</code> (2.07 MP), <code>3840 × 2160 px</code> (8.29 MP)</td>
            </tr>
            <tr>
              <td><strong>Print Density (DPI)</strong></td>
              <td>Physical ink dots per linear inch on printed media</td>
              <td>Dots Per Inch (DPI)</td>
              <td><code>300 DPI</code> (Fine photo), <code>150 DPI</code> (Flyer)</td>
            </tr>
            <tr>
              <td><strong>Display Density (PPI)</strong></td>
              <td>Physical hardware pixel density of a screen panel</td>
              <td>Pixels Per Inch (PPI)</td>
              <td><code>460 PPI</code> (iPhone Super Retina), <code>163 PPI</code> (4K Monitor)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 4: Popular Aspect Ratios Cheat Sheet -->
      <h2>{t(locale, 'ratiocheck.content.h4')}</h2>
      <p>{t(locale, 'ratiocheck.content.p4a')}</p>

      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>Ratio</th>
              <th>Decimal</th>
              <th>Standard Name</th>
              <th>Primary Application</th>
              <th>Common Resolutions</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>16:9</strong></td>
              <td>1.78:1</td>
              <td>Widescreen (HD/4K)</td>
              <td>YouTube videos, TVs, PC monitors, PowerPoint</td>
              <td><code>1920×1080</code>, <code>2560×1440</code>, <code>3840×2160</code></td>
            </tr>
            <tr>
              <td><strong>9:16</strong></td>
              <td>0.56:1</td>
              <td>Vertical Story / Reel</td>
              <td>TikTok, Instagram Reels, YouTube Shorts, Snapchat</td>
              <td><code>1080×1920</code>, <code>720×1280</code></td>
            </tr>
            <tr>
              <td><strong>1:1</strong></td>
              <td>1.00:1</td>
              <td>Square</td>
              <td>Instagram feed, profile photos, product thumbnails</td>
              <td><code>1080×1080</code>, <code>1200×1200</code>, <code>500×500</code></td>
            </tr>
            <tr>
              <td><strong>4:5</strong></td>
              <td>0.80:1</td>
              <td>Social Portrait</td>
              <td>Instagram feed portrait (maximum screen real estate)</td>
              <td><code>1080×1350</code></td>
            </tr>
            <tr>
              <td><strong>4:3</strong></td>
              <td>1.33:1</td>
              <td>Classic Standard</td>
              <td>iPad displays, Micro Four Thirds cameras, CRT TV</td>
              <td><code>1024×768</code>, <code>2048×1536</code></td>
            </tr>
            <tr>
              <td><strong>3:2</strong></td>
              <td>1.50:1</td>
              <td>Classic 35mm DSLR</td>
              <td>Full-frame cameras, 4×6 photo prints, Surface laptops</td>
              <td><code>6000×4000</code>, <code>3000×2000</code></td>
            </tr>
            <tr>
              <td><strong>21:9</strong></td>
              <td>2.33:1</td>
              <td>Ultrawide Cinema</td>
              <td>Anamorphic cinema movies, curved ultrawide monitors</td>
              <td><code>2560×1080</code>, <code>3440×1440</code>, <code>5120×2160</code></td>
            </tr>
            <tr>
              <td><strong>1.91:1</strong></td>
              <td>1.91:1</td>
              <td>Social Landscape</td>
              <td>Facebook feed link previews, Twitter / X summary cards</td>
              <td><code>1200×628</code>, <code>1200×630</code></td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 5: Social Media Aspect Ratio Guide -->
      <h2>{t(locale, 'ratiocheck.content.h5')}</h2>
      <p>{t(locale, 'ratiocheck.content.p5a')}</p>

      <!-- Section 6: Web Development & CSS aspect-ratio -->
      <h2>{t(locale, 'ratiocheck.content.h6')}</h2>
      <p>{t(locale, 'ratiocheck.content.p6a')}</p>
      <p>{t(locale, 'ratiocheck.content.p6b')}</p>

      <!-- Section 7: Cropping vs Resizing vs Letterboxing -->
      <h2>{t(locale, 'ratiocheck.content.h7')}</h2>
      <p>{t(locale, 'ratiocheck.content.p7a')}</p>

      <!-- Section 8: How to Check Aspect Ratio on Any Device -->
      <h2>{t(locale, 'ratiocheck.content.h8')}</h2>
      <p>{t(locale, 'ratiocheck.content.p8Intro')}</p>

      <div class="features-summary-grid">
        <div class="feature-box">
          <h4>Windows</h4>
          <p>Right-click image &gt; <strong>Properties</strong> &gt; <strong>Details</strong>. Check Dimensions (e.g. 1920 × 1080) and divide Width by Height.</p>
        </div>
        <div class="feature-box">
          <h4>macOS</h4>
          <p>Select image and press <kbd>Cmd</kbd> + <kbd>I</kbd> or open in <strong>Preview</strong> and press <kbd>Cmd</kbd> + <kbd>I</kbd> to inspect pixel dimensions.</p>
        </div>
        <div class="feature-box">
          <h4>iPhone / iOS</h4>
          <p>Open image in <strong>Photos</strong> app and tap the <strong>(i) Info</strong> button to inspect resolution and proportions.</p>
        </div>
        <div class="feature-box">
          <h4>Android</h4>
          <p>Open image in <strong>Google Photos</strong> or <strong>Gallery</strong>, swipe up to view technical details, dimensions, and Megapixels.</p>
        </div>
      </div>

      <!-- Section 9: FAQ Section -->
      <div class="faq-container">
        <h2>{t(locale, 'ratiocheck.faq.heading')}</h2>
        <div class="faq-list">
          {
            faqItems.map((item) => (
              <details class="faq-item">
                <summary class="faq-question">{item.q}</summary>
                <div class="faq-answer">
                  <p>{item.a}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .content-section {
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 640px) {
    .content-section {
      padding-block: var(--space-12);
    }
  }

  .content-body {
    max-width: var(--container-narrow);
    margin-inline: auto;
    width: 100%;
    box-sizing: border-box;
  }

  .content-body h2 {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-text);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  @media (min-width: 640px) {
    .content-body h2 {
      font-size: var(--text-2xl);
      margin-top: var(--space-10);
    }
  }

  .content-body h2:first-child {
    margin-top: 0;
  }

  .content-body p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: var(--space-4);
  }

  @media (min-width: 640px) {
    .content-body p {
      font-size: var(--text-base);
      line-height: 1.75;
    }
  }

  /* Feature Summary Grid */
  .features-summary-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-block: var(--space-5);
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 600px) {
    .features-summary-grid {
      grid-template-columns: 1fr 1fr;
      margin-block: var(--space-6);
    }
  }

  .feature-box {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: var(--space-3-5) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    box-sizing: border-box;
  }

  @media (min-width: 640px) {
    .feature-box {
      padding: var(--space-4) var(--space-5);
    }
  }

  .feature-box-icon {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .feature-box-icon {
      width: 36px;
      height: 36px;
    }
  }

  .feature-box h4 {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .feature-box p {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.55;
  }

  .feature-box kbd {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 1px 4px;
    font-size: 10.5px;
    font-family: inherit;
  }

  /* Formula Box */
  .formula-box {
    background: #0f172a;
    color: #f8fafc;
    border-radius: var(--radius-md);
    padding: var(--space-3-5) var(--space-4);
    margin-block: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 640px) {
    .formula-box {
      border-radius: var(--radius-lg);
      padding: var(--space-5) var(--space-6);
      margin-block: var(--space-5);
      gap: 8px;
    }
  }

  .formula-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #94a3b8;
  }

  .formula-code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 11.5px;
    color: #38bdf8;
    background: rgba(0, 0, 0, 0.3);
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-all;
  }

  @media (min-width: 640px) {
    .formula-code {
      font-size: 12.5px;
      padding: 8px 12px;
      white-space: nowrap;
    }
  }

  .formula-note {
    font-size: 11.5px;
    color: #cbd5e1;
    line-height: 1.5;
    margin-top: 2px;
  }

  @media (min-width: 640px) {
    .formula-note {
      font-size: 12.5px;
    }
  }

  /* Data Table */
  .table-container {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-block: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-xs);
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 640px) {
    .table-container {
      border-radius: var(--radius-lg);
      margin-block: var(--space-6);
    }
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 11.5px;
    text-align: left;
    min-width: 440px;
  }

  @media (min-width: 640px) {
    .data-table {
      font-size: var(--text-xs);
      min-width: auto;
    }
  }

  .data-table th,
  .data-table td {
    padding: 8px 12px;
    border-bottom: 1px solid var(--color-border-light);
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .data-table th,
    .data-table td {
      padding: 10px 14px;
    }
  }

  .data-table th {
    background: var(--color-surface-subtle);
    font-weight: 700;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 10.5px;
  }

  @media (min-width: 640px) {
    .data-table th {
      font-size: 11px;
    }
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  .data-table tr:hover td {
    background: rgba(99, 102, 241, 0.02);
  }

  /* FAQ */
  .faq-container {
    margin-top: var(--space-8);
  }

  @media (min-width: 640px) {
    .faq-container {
      margin-top: var(--space-10);
    }
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2-5);
    margin-top: var(--space-4);
  }

  .faq-item {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  @media (min-width: 640px) {
    .faq-item {
      border-radius: var(--radius-lg);
    }
  }

  .faq-item[open] {
    border-color: var(--color-accent);
  }

  .faq-question {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
    cursor: pointer;
    user-select: none;
    line-height: 1.4;
  }

  @media (min-width: 640px) {
    .faq-question {
      padding: var(--space-3-5) var(--space-5);
      font-size: 14.5px;
    }
  }

  .faq-answer {
    padding: 0 var(--space-4) var(--space-3-5) var(--space-4);
  }

  @media (min-width: 640px) {
    .faq-answer {
      padding: 0 var(--space-5) var(--space-4) var(--space-5);
    }
  }

  .faq-answer p {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  @media (min-width: 640px) {
    .faq-answer p {
      font-size: var(--text-sm);
    }
  }
</style>

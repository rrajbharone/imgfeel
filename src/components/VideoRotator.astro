---
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const i18nDict = {
  statusAnalyzed: t(locale, 'vidrot.status.analyzed'),
  errorLoad: t(locale, 'vidrot.error.load'),
  errorFormat: t(locale, 'vidrot.error.format'),
  originalSize: t(locale, 'vidrot.stat.originalSize'),
  rotatedSize: t(locale, 'vidrot.stat.rotatedSize'),
  newResolution: t(locale, 'vidrot.stat.newResolution'),
  landscape: t(locale, 'vidrot.orientation.landscape'),
  portrait: t(locale, 'vidrot.orientation.portrait'),
  square: t(locale, 'vidrot.orientation.square'),
};
---

<div class="video-tool-wrapper" id="videoRotatorApp" data-i18n={JSON.stringify(i18nDict)}>
  <!-- Dropzone / Upload State -->
  <div class="video-dropzone-card" id="rotDropzone">
    <div class="video-dropzone-content">
      <div class="video-icon-circle">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
        </svg>
      </div>

      <h2 class="video-drop-title">{t(locale, 'vidrot.dropzone.title')}</h2>
      <p class="video-drop-subtitle">{t(locale, 'vidrot.dropzone.subtitle')}</p>

      <div class="video-btn-row">
        <label class="btn btn-primary video-btn-primary" for="rotFileInput">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'vidrot.dropzone.browse')}</span>
        </label>
        <input type="file" id="rotFileInput" accept="video/*,.mp4,.webm,.mov,.m4v,.mkv,.avi" class="sr-only" />

        <button type="button" class="btn btn-secondary video-sample-btn" id="rotSampleBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="5 3 19 12 5 21 5 3" fill="currentColor"></polygon>
          </svg>
          <span>{t(locale, 'vidrot.dropzone.sample')}</span>
        </button>
      </div>

      <p class="video-formats-hint">{t(locale, 'vidrot.dropzone.formats')}</p>

      <div class="video-privacy-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span>{t(locale, 'vidrot.privacy.badge')}</span>
      </div>
    </div>
  </div>

  <!-- Loading State -->
  <div class="video-loading-card" id="rotLoadingCard" style="display: none;">
    <div class="video-spinner"></div>
    <p class="video-loading-text" id="rotLoadingText">{t(locale, 'vidrot.status.analyzing')}</p>
  </div>

  <!-- Main Video Rotator Workspace -->
  <div class="video-editor-view" id="rotEditorView" style="display: none;">
    <!-- Top Action & Info Bar -->
    <div class="video-editor-header">
      <div class="video-meta-badge">
        <span class="video-status-dot"></span>
        <span id="rotMetaFileName" class="video-filename-label">video.mp4</span>
        <span class="video-meta-tag" id="rotMetaResolution">1920 × 1080</span>
        <span class="video-meta-tag" id="rotMetaDuration">00:06</span>
      </div>

      <div class="video-header-actions">
        <button type="button" class="btn btn-secondary btn-sm" id="rotResetTransformBtn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="1 4 1 10 7 10"></polyline>
            <polyline points="23 20 23 14 17 14"></polyline>
            <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
          </svg>
          <span>{t(locale, 'vidrot.action.reset')}</span>
        </button>
        <button type="button" class="btn btn-secondary btn-sm" id="rotNewVideoBtn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{t(locale, 'vidrot.action.newVideo')}</span>
        </button>
      </div>
    </div>

    <!-- Video Preview Screen with Live CSS Transformation -->
    <div class="rot-screen-container">
      <div class="rot-screen-stage" id="rotStage">
        <video id="rotPlayer" class="rot-main-player" playsinline preload="auto" loop></video>
        <div class="rot-player-overlay" id="rotPlayerOverlay">
          <button type="button" class="rot-big-play-btn" id="rotBigPlayBtn" aria-label="Play video">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </button>
        </div>
      </div>

      <!-- Playback Mini-Controls Bar -->
      <div class="rot-controls-bar">
        <div class="rot-ctrl-left">
          <button type="button" class="ctrl-btn" id="rotPlayPauseBtn" title="Play/Pause">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" id="rotPlayIcon" aria-hidden="true">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" id="rotPauseIcon" style="display: none;" aria-hidden="true">
              <rect x="6" y="4" width="4" height="16"></rect>
              <rect x="14" y="4" width="4" height="16"></rect>
            </svg>
          </button>

          <div class="rot-time-display">
            <span id="rotCurrentTimeText">00:00</span> / <span id="rotTotalDurationText">00:00</span>
          </div>
        </div>

        <div class="rot-ctrl-right">
          <button type="button" class="ctrl-btn ctrl-btn-step" id="rotStepBackBtn" title="Step Back 0.1s">-0.1s</button>
          <button type="button" class="ctrl-btn ctrl-btn-step" id="rotStepFwdBtn" title="Step Forward 0.1s">+0.1s</button>
          <button type="button" class="ctrl-btn" id="rotMuteBtn" title="Mute/Unmute">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="rotVolumeIcon" aria-hidden="true">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            </svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="rotMutedIcon" style="display: none;" aria-hidden="true">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <line x1="23" y1="9" x2="17" y2="15"></line>
              <line x1="17" y1="9" x2="23" y2="15"></line>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Rotation & Orientation Controls Toolbar -->
    <div class="rotation-tools-card">
      <div class="rot-tools-header">
        <span class="rot-tools-title">{t(locale, 'vidrot.controls.heading')}</span>
        <div class="current-angle-pill">
          <span>{t(locale, 'vidrot.controls.angle')}:</span>
          <strong id="rotAngleBadge">0°</strong>
        </div>
      </div>

      <!-- Main Action Rotation Buttons Grid -->
      <div class="rot-buttons-grid">
        <!-- 90° Clockwise -->
        <button type="button" class="rot-action-btn" id="rotBtn90CW">
          <div class="rot-btn-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
            </svg>
          </div>
          <span class="rot-btn-title">{t(locale, 'vidrot.btn.cw90')}</span>
          <span class="rot-btn-desc">{t(locale, 'vidrot.btn.cw90sub')}</span>
        </button>

        <!-- 90° Counter-Clockwise -->
        <button type="button" class="rot-action-btn" id="rotBtn90CCW">
          <div class="rot-btn-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2.5 2v6h6M2.66 15.57a10 10 0 1 0 .57-8.38L-2.44 1.52"></path>
            </svg>
          </div>
          <span class="rot-btn-title">{t(locale, 'vidrot.btn.ccw90')}</span>
          <span class="rot-btn-desc">{t(locale, 'vidrot.btn.ccw90sub')}</span>
        </button>

        <!-- 180° Flip Upside Down -->
        <button type="button" class="rot-action-btn" id="rotBtn180">
          <div class="rot-btn-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 10v12M17 14v-12M11 6l-4-4-4 4M21 18l-4 4-4-4"></path>
            </svg>
          </div>
          <span class="rot-btn-title">{t(locale, 'vidrot.btn.rot180')}</span>
          <span class="rot-btn-desc">{t(locale, 'vidrot.btn.rot180sub')}</span>
        </button>

        <!-- Flip Horizontal (Mirror) -->
        <button type="button" class="rot-action-btn" id="rotBtnFlipH">
          <div class="rot-btn-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="7 8 3 12 7 16"></polyline>
              <polyline points="17 8 21 12 17 16"></polyline>
              <line x1="12" y1="2" x2="12" y2="22" stroke-dasharray="3 3"></line>
            </svg>
          </div>
          <span class="rot-btn-title">{t(locale, 'vidrot.btn.flipH')}</span>
          <span class="rot-btn-desc">{t(locale, 'vidrot.btn.flipHsub')}</span>
        </button>

        <!-- Flip Vertical -->
        <button type="button" class="rot-action-btn" id="rotBtnFlipV">
          <div class="rot-btn-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="8 7 12 3 16 7"></polyline>
              <polyline points="8 17 12 21 16 17"></polyline>
              <line x1="2" y1="12" x2="22" y2="12" stroke-dasharray="3 3"></line>
            </svg>
          </div>
          <span class="rot-btn-title">{t(locale, 'vidrot.btn.flipV')}</span>
          <span class="rot-btn-desc">{t(locale, 'vidrot.btn.flipVsub')}</span>
        </button>
      </div>
    </div>

    <!-- Live Dimension & Aspect Ratio Transformation Card -->
    <div class="rot-dimensions-card">
      <div class="dim-compare-grid">
        <div class="dim-compare-box">
          <span class="dim-box-label">{t(locale, 'vidrot.dim.original')}</span>
          <strong id="rotDimOrigText">1920 × 1080</strong>
          <span class="dim-badge" id="rotRatioOrigText">16:9 Landscape</span>
        </div>

        <div class="dim-arrow-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </div>

        <div class="dim-compare-box highlight-box">
          <span class="dim-box-label">{t(locale, 'vidrot.dim.output')}</span>
          <strong id="rotDimOutText">1920 × 1080</strong>
          <span class="dim-badge badge-accent" id="rotRatioOutText">16:9 Landscape</span>
        </div>
      </div>
    </div>

    <!-- Export & Audio Options -->
    <div class="export-card">
      <div class="export-options-row">
        <!-- Audio Track Toggle -->
        <label class="audio-toggle-label">
          <input type="checkbox" id="rotKeepAudioCheckbox" checked class="checkbox-custom" />
          <span class="toggle-text">
            <strong>{t(locale, 'vidrot.export.audioTitle')}</strong>
            <span class="toggle-subtext">{t(locale, 'vidrot.export.audioSub')}</span>
          </span>
        </label>

        <!-- Format Selector -->
        <div class="format-select-wrap">
          <label for="rotFormatSelect" class="format-label">{t(locale, 'vidrot.export.format')}:</label>
          <select id="rotFormatSelect" class="format-select">
            <option value="mp4">MP4 (Universal)</option>
            <option value="webm">WebM (Optimized)</option>
          </select>
        </div>
      </div>

      <!-- Main Action Button -->
      <button type="button" class="btn btn-primary btn-lg video-export-btn" id="rotExportBtn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
        </svg>
        <span>{t(locale, 'vidrot.action.rotateVideo')}</span>
      </button>
    </div>
  </div>

  <!-- Processing Modal / Progress State -->
  <div class="video-progress-card" id="rotProgressCard" style="display: none;">
    <div class="progress-header">
      <h3>{t(locale, 'vidrot.progress.title')}</h3>
      <p>{t(locale, 'vidrot.progress.subtitle')}</p>
    </div>

    <div class="progress-bar-wrap">
      <div class="progress-bar-fill" id="rotProgressBarFill" style="width: 0%;"></div>
    </div>

    <div class="progress-stats">
      <span id="rotProgressPercentText">0%</span>
      <span id="rotProgressTimeText">Rendering rotated video frames...</span>
    </div>
  </div>

  <!-- Completed / Download Card -->
  <div class="video-completed-card" id="rotCompletedCard" style="display: none;">
    <div class="completed-header">
      <div class="completed-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <h3>{t(locale, 'vidrot.done.title')}</h3>
      <p>{t(locale, 'vidrot.done.subtitle')}</p>
    </div>

    <!-- Rotated Result Video Player -->
    <div class="result-player-wrap">
      <video id="rotResultPlayer" controls playsinline class="result-video"></video>
    </div>

    <!-- Stats Comparison Grid -->
    <div class="completed-stats-grid">
      <div class="stat-box">
        <span class="stat-label">{t(locale, 'vidrot.stat.originalSize')}</span>
        <strong id="rotStatOrigSize">0 MB</strong>
      </div>
      <div class="stat-box">
        <span class="stat-label">{t(locale, 'vidrot.stat.rotatedSize')}</span>
        <strong id="rotStatRotatedSize" class="stat-highlight">0 MB</strong>
      </div>
      <div class="stat-box">
        <span class="stat-label">{t(locale, 'vidrot.stat.newResolution')}</span>
        <strong id="rotStatNewRes">1920 × 1080</strong>
      </div>
    </div>

    <!-- Download & Next Action Buttons -->
    <div class="completed-actions">
      <a id="rotDownloadLink" href="#" download="rotated-video.mp4" class="btn btn-primary btn-lg download-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>{t(locale, 'vidrot.action.download')}</span>
      </a>

      <button type="button" class="btn btn-secondary btn-lg" id="rotRotateAnotherBtn">
        <span>{t(locale, 'vidrot.action.rotateAnother')}</span>
      </button>
    </div>
  </div>
</div>

<script>
  import {
    loadVideoMetadata,
    rotateVideo,
    generateSampleVideo,
    calculateAspectRatio,
    formatTime,
    type VideoMetadata,
  } from '@/scripts/video-rotator';

  function initVideoRotator() {
    const container = document.getElementById('videoRotatorApp');
    if (!container) return;

    let i18n = {
      statusAnalyzed: 'Video Loaded',
      errorLoad: 'Failed to load video',
      errorFormat: 'Unsupported video format',
      originalSize: 'Original Size',
      rotatedSize: 'Rotated Size',
      newResolution: 'New Resolution',
      landscape: 'Landscape',
      portrait: 'Portrait',
      square: 'Square',
    };

    try {
      const dataAttr = container.getAttribute('data-i18n');
      if (dataAttr) i18n = JSON.parse(dataAttr);
    } catch {
      // fallback
    }

    // Elements
    const dropzone = document.getElementById('rotDropzone');
    const fileInput = document.getElementById('rotFileInput') as HTMLInputElement | null;
    const sampleBtn = document.getElementById('rotSampleBtn');
    const loadingCard = document.getElementById('rotLoadingCard');
    const loadingText = document.getElementById('rotLoadingText');
    const editorView = document.getElementById('rotEditorView');
    const progressCard = document.getElementById('rotProgressCard');
    const completedCard = document.getElementById('rotCompletedCard');

    // Video Player
    const player = document.getElementById('rotPlayer') as HTMLVideoElement | null;
    const stage = document.getElementById('rotStage');
    const playerOverlay = document.getElementById('rotPlayerOverlay');
    const bigPlayBtn = document.getElementById('rotBigPlayBtn');
    const playPauseBtn = document.getElementById('rotPlayPauseBtn');
    const playIcon = document.getElementById('rotPlayIcon');
    const pauseIcon = document.getElementById('rotPauseIcon');
    const currentTimeText = document.getElementById('rotCurrentTimeText');
    const totalDurationText = document.getElementById('rotTotalDurationText');
    const stepBackBtn = document.getElementById('rotStepBackBtn');
    const stepFwdBtn = document.getElementById('rotStepFwdBtn');
    const muteBtn = document.getElementById('rotMuteBtn');
    const volumeIcon = document.getElementById('rotVolumeIcon');
    const mutedIcon = document.getElementById('rotMutedIcon');

    // Header & Meta Elements
    const metaFileName = document.getElementById('rotMetaFileName');
    const metaResolution = document.getElementById('rotMetaResolution');
    const metaDuration = document.getElementById('rotMetaDuration');
    const resetTransformBtn = document.getElementById('rotResetTransformBtn');
    const newVideoBtn = document.getElementById('rotNewVideoBtn');

    // Transformation Buttons & Badges
    const rotAngleBadge = document.getElementById('rotAngleBadge');
    const btn90CW = document.getElementById('rotBtn90CW');
    const btn90CCW = document.getElementById('rotBtn90CCW');
    const btn180 = document.getElementById('rotBtn180');
    const btnFlipH = document.getElementById('rotBtnFlipH');
    const btnFlipV = document.getElementById('rotBtnFlipV');

    // Dimension Compare Elements
    const dimOrigText = document.getElementById('rotDimOrigText');
    const ratioOrigText = document.getElementById('rotRatioOrigText');
    const dimOutText = document.getElementById('rotDimOutText');
    const ratioOutText = document.getElementById('rotRatioOutText');

    // Export Controls
    const keepAudioCheckbox = document.getElementById('rotKeepAudioCheckbox') as HTMLInputElement | null;
    const formatSelect = document.getElementById('rotFormatSelect') as HTMLSelectElement | null;
    const exportBtn = document.getElementById('rotExportBtn');

    // Progress Elements
    const progressBarFill = document.getElementById('rotProgressBarFill');
    const progressPercentText = document.getElementById('rotProgressPercentText');
    const progressTimeText = document.getElementById('rotProgressTimeText');

    // Completed Elements
    const resultPlayer = document.getElementById('rotResultPlayer') as HTMLVideoElement | null;
    const statOrigSize = document.getElementById('rotStatOrigSize');
    const statRotatedSize = document.getElementById('rotStatRotatedSize');
    const statNewRes = document.getElementById('rotStatNewRes');
    const downloadLink = document.getElementById('rotDownloadLink') as HTMLAnchorElement | null;
    const rotateAnotherBtn = document.getElementById('rotRotateAnotherBtn');

    // App State
    let currentVideo: VideoMetadata | null = null;
    let rotation = 0; // 0, 90, 180, 270
    let flipH = false;
    let flipV = false;

    // Load Video File
    async function handleFile(file: File) {
      if (!dropzone || !loadingCard || !editorView) return;

      dropzone.style.display = 'none';
      editorView.style.display = 'none';
      if (completedCard) completedCard.style.display = 'none';
      loadingCard.style.display = 'flex';

      try {
        currentVideo = await loadVideoMetadata(file);
        rotation = 0;
        flipH = false;
        flipV = false;

        // Player src
        if (player) {
          player.src = currentVideo.url;
          player.load();
        }

        // Header info
        if (metaFileName) metaFileName.textContent = currentVideo.name;
        if (metaResolution) metaResolution.textContent = `${currentVideo.width} × ${currentVideo.height} (${currentVideo.aspectRatio})`;
        if (metaDuration) metaDuration.textContent = currentVideo.durationFormatted;
        if (totalDurationText) totalDurationText.textContent = currentVideo.durationFormatted;

        // Dimension Compare
        if (dimOrigText) dimOrigText.textContent = `${currentVideo.width} × ${currentVideo.height}`;
        if (ratioOrigText) {
          const orientation = currentVideo.width > currentVideo.height ? i18n.landscape : (currentVideo.width < currentVideo.height ? i18n.portrait : i18n.square);
          ratioOrigText.textContent = `${currentVideo.aspectRatio} ${orientation}`;
        }

        updateTransformUI();

        loadingCard.style.display = 'none';
        editorView.style.display = 'flex';
      } catch (err) {
        alert(err instanceof Error ? err.message : i18n.errorLoad);
        resetToDropzone();
      }
    }

    function resetToDropzone() {
      currentVideo = null;
      if (player) {
        player.pause();
        player.src = '';
      }
      if (fileInput) fileInput.value = '';
      if (loadingCard) loadingCard.style.display = 'none';
      if (editorView) editorView.style.display = 'none';
      if (progressCard) progressCard.style.display = 'none';
      if (completedCard) completedCard.style.display = 'none';
      if (dropzone) dropzone.style.display = 'block';
    }

    function updateTransformUI() {
      if (!currentVideo) return;

      const isSwapped = rotation === 90 || rotation === 270;
      const outW = isSwapped ? currentVideo.height : currentVideo.width;
      const outH = isSwapped ? currentVideo.width : currentVideo.height;
      const { ratio } = calculateAspectRatio(outW, outH);

      // Update badge
      if (rotAngleBadge) {
        let text = `${rotation}°`;
        if (flipH) text += ' (Flip H)';
        if (flipV) text += ' (Flip V)';
        rotAngleBadge.textContent = text;
      }

      // Update Live CSS Transform
      if (player) {
        const scaleX = flipH ? -1 : 1;
        const scaleY = flipV ? -1 : 1;
        player.style.transform = `rotate(${rotation}deg) scale(${scaleX}, ${scaleY})`;
      }

      // Update Output Dimension Box
      if (dimOutText) dimOutText.textContent = `${outW} × ${outH}`;
      if (ratioOutText) {
        const orientation = outW > outH ? i18n.landscape : (outW < outH ? i18n.portrait : i18n.square);
        ratioOutText.textContent = `${ratio} ${orientation}`;
      }

      // Active state on buttons
      if (btnFlipH) btnFlipH.classList.toggle('active', flipH);
      if (btnFlipV) btnFlipV.classList.toggle('active', flipV);
    }

    // Rotation Control Button Events
    if (btn90CW) {
      btn90CW.addEventListener('click', () => {
        rotation = (rotation + 90) % 360;
        updateTransformUI();
      });
    }

    if (btn90CCW) {
      btn90CCW.addEventListener('click', () => {
        rotation = (rotation - 90 + 360) % 360;
        updateTransformUI();
      });
    }

    if (btn180) {
      btn180.addEventListener('click', () => {
        rotation = (rotation + 180) % 360;
        updateTransformUI();
      });
    }

    if (btnFlipH) {
      btnFlipH.addEventListener('click', () => {
        flipH = !flipH;
        updateTransformUI();
      });
    }

    if (btnFlipV) {
      btnFlipV.addEventListener('click', () => {
        flipV = !flipV;
        updateTransformUI();
      });
    }

    if (resetTransformBtn) {
      resetTransformBtn.addEventListener('click', () => {
        rotation = 0;
        flipH = false;
        flipV = false;
        updateTransformUI();
      });
    }

    if (newVideoBtn) newVideoBtn.addEventListener('click', resetToDropzone);

    // Player Playback Controls
    function togglePlay() {
      if (!player) return;
      if (player.paused) {
        player.play();
      } else {
        player.pause();
      }
    }

    if (playPauseBtn) playPauseBtn.addEventListener('click', togglePlay);
    if (bigPlayBtn) bigPlayBtn.addEventListener('click', togglePlay);

    if (player) {
      player.addEventListener('play', () => {
        if (playIcon) playIcon.style.display = 'none';
        if (pauseIcon) pauseIcon.style.display = 'block';
        if (playerOverlay) playerOverlay.style.opacity = '0';
      });

      player.addEventListener('pause', () => {
        if (playIcon) playIcon.style.display = 'block';
        if (pauseIcon) pauseIcon.style.display = 'none';
        if (playerOverlay) playerOverlay.style.opacity = '1';
      });

      player.addEventListener('timeupdate', () => {
        if (currentTimeText) currentTimeText.textContent = formatTime(player.currentTime);
      });
    }

    if (stepBackBtn) {
      stepBackBtn.addEventListener('click', () => {
        if (!player) return;
        player.currentTime = Math.max(0, player.currentTime - 0.1);
      });
    }

    if (stepFwdBtn) {
      stepFwdBtn.addEventListener('click', () => {
        if (!player || !currentVideo) return;
        player.currentTime = Math.min(currentVideo.duration, player.currentTime + 0.1);
      });
    }

    if (muteBtn && player) {
      muteBtn.addEventListener('click', () => {
        player.muted = !player.muted;
        if (volumeIcon) volumeIcon.style.display = player.muted ? 'none' : 'block';
        if (mutedIcon) mutedIcon.style.display = player.muted ? 'block' : 'none';
      });
    }

    // Export Process
    if (exportBtn) {
      exportBtn.addEventListener('click', async () => {
        if (!currentVideo) return;

        if (player) player.pause();
        if (editorView) editorView.style.display = 'none';
        if (progressCard) progressCard.style.display = 'block';

        const keepAudio = keepAudioCheckbox ? keepAudioCheckbox.checked : true;
        const outFormat = (formatSelect ? formatSelect.value : 'mp4') as 'mp4' | 'webm';

        try {
          const result = await rotateVideo(currentVideo.url, {
            rotation,
            flipH,
            flipV,
            keepAudio,
            outputFormat: outFormat,
            onProgress: (percent) => {
              if (progressBarFill) progressBarFill.style.width = `${percent}%`;
              if (progressPercentText) progressPercentText.textContent = `${percent}%`;
              if (progressTimeText) progressTimeText.textContent = `Rendering frame-accurate rotated video... ${percent}%`;
            },
          });

          if (progressCard) progressCard.style.display = 'none';
          if (completedCard) completedCard.style.display = 'block';

          if (resultPlayer) {
            resultPlayer.src = result.url;
            resultPlayer.load();
          }

          if (statOrigSize) statOrigSize.textContent = currentVideo.sizeFormatted;
          if (statRotatedSize) statRotatedSize.textContent = result.sizeFormatted;
          if (statNewRes) statNewRes.textContent = `${result.width} × ${result.height} (${result.aspectRatio})`;

          if (downloadLink) {
            const base = currentVideo.name.replace(/\.[^/.]+$/, '');
            downloadLink.href = result.url;
            downloadLink.download = `${base}-rotated-${rotation}deg.${result.format.toLowerCase()}`;
          }
        } catch (err) {
          alert(err instanceof Error ? err.message : 'Error processing video.');
          if (progressCard) progressCard.style.display = 'none';
          if (editorView) editorView.style.display = 'flex';
        }
      });
    }

    if (rotateAnotherBtn) {
      rotateAnotherBtn.addEventListener('click', resetToDropzone);
    }

    // Sample video button
    if (sampleBtn) {
      sampleBtn.addEventListener('click', async () => {
        if (dropzone && loadingCard) {
          dropzone.style.display = 'none';
          loadingCard.style.display = 'flex';
          if (loadingText) loadingText.textContent = 'Generating sample orientation video...';
        }
        const sampleFile = await generateSampleVideo();
        handleFile(sampleFile);
      });
    }

    // Drag and Drop files onto dropzone
    if (dropzone) {
      ['dragenter', 'dragover'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('video-drag-active');
        });
      });

      ['dragleave', 'drop'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('video-drag-active');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        if (dt && dt.files && dt.files[0]) {
          handleFile(dt.files[0]);
        }
      });
    }

    if (fileInput) {
      fileInput.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        if (target.files && target.files[0]) {
          handleFile(target.files[0]);
        }
      });
    }

    // Paste listener (Ctrl+V)
    window.addEventListener('paste', (e: ClipboardEvent) => {
      const items = e.clipboardData?.items;
      if (!items) return;
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.indexOf('video') !== -1) {
          const file = items[i].getAsFile();
          if (file) {
            handleFile(file);
            break;
          }
        }
      }
    });
  }

  initVideoRotator();
  document.addEventListener('astro:page-load', initVideoRotator);
</script>

